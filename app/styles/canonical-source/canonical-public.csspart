.home-premium__principles{
  width:min(1180px,100%);
  margin:20px auto 0;
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  border-top:1px solid rgba(36,29,22,.13);
  border-bottom:1px solid rgba(36,29,22,.13);
}/* @canonical-block:002491 */
.home-premium__principles article{
  display:grid;
  grid-template-columns:38px 1fr;
  gap:18px;
