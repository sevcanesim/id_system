/* @canonical-block:000172 */

.products-public-v2-notice {
  width:min(calc(100% - 48px),var(--content));
  margin:18px auto 0;
  padding:12px 16px;
  display:flex;
  align-items:center;
  gap:10px;
  border:1px solid rgba(153,117,57,.24);
  border-radius:12px;
  background:rgba(255,251,243,.86);
  color:#5c5348;
  font-size:14px;
}/* @canonical-block:000173 */
.products-public-v2-notice strong { color:#302a24; }/* @canonical-block:000174 */

.products-public-v2-hero {
  width:min(calc(100% - 48px),var(--wide));
  min-height:720px;
  margin:auto;
  display:grid;
  grid-template-columns:minmax(420px,.88fr) minmax(560px,1.12fr);
  align-items:center;
  gap:56px;
  padding:54px 0 78px;
}/* @canonical-block:000175 */
.products-public-v2-hero-copy { max-width:610px; padding:18px 0; }/* @canonical-block:000176 */
.products-public-v2-hero h1 {
  max-width:650px;
  margin:18px 0 22px;
  color:#151318;
  font-size:clamp(52px,5.8vw,82px);
  line-height:.98;
  letter-spacing:-.055em;
}/* @canonical-block:000177 */
.products-public-v2-lead { max-width:570px; margin:0; color:#59534d; font-size:16px; line-height:1.72; }/* @canonical-block:000178 */
.products-public-v2-price {
  width:min(100%,360px);
  margin:26px 0 18px;
  padding:16px 18px;
  border:1px solid rgba(153,117,57,.24);
  border-radius:14px;
  background:rgba(255,255,255,.78);
  box-shadow:0 14px 35px rgba(58,48,38,.08);
}/* @canonical-block:000179 */
.products-public-v2-price div { display:flex; align-items:baseline; justify-content:space-between; gap:24px; }/* @canonical-block:000180 */
.products-public-v2-price strong { color:#7f6333; font:700 28px var(--font-mono); }/* @canonical-block:000181 */
.products-public-v2-price small { display:block; margin-top:5px; color:#7b746d; font-size:12px; }/* @canonical-block:000182 */
.products-public-v2-actions { display:flex; flex-wrap:wrap; gap:10px; }/* @canonical-block:000183 */
.products-public-v2-button { min-height:48px; padding-inline:18px; border-radius:11px; }/* @canonical-block:000185 */
.products-public-v2-microproof { display:flex; flex-wrap:wrap; gap:9px 16px; margin-top:20px; color:#6e675f; font-size:12px; }/* @canonical-block:000186 */
.products-public-v2-microproof span { display:flex; align-items:center; gap:6px; }/* @canonical-block:000188 */

.products-public-v2-hero-art {
  position:relative;
  min-height:590px;
  display:grid;
  place-items:center;
  isolation:isolate;
}/* @canonical-block:000189 */
.products-public-v2-hero-art::before {
  content:"";
  position:absolute;
  inset:8% 2%;
  z-index:-2;
  border:1px solid rgba(153,117,57,.22);
  border-radius:34px;
  background:
    radial-gradient(circle at 58% 42%,rgba(109,61,224,.28),transparent 34%),
    radial-gradient(circle at 70% 70%,rgba(212,180,131,.12),transparent 38%),
    linear-gradient(145deg,#17131e,#08070b 74%);
  box-shadow:0 28px 70px rgba(34,28,24,.22),inset 0 1px rgba(255,255,255,.08);
}/* @canonical-block:000190 */
.products-public-v2-hero-art::after {
  content:"";
  position:absolute;
  width:78%;
  height:78%;
  z-index:-1;
  border:1px solid rgba(212,180,131,.13);
  border-radius:50%;
  transform:rotate(-18deg) scaleY(.56);
  box-shadow:0 0 0 42px rgba(212,180,131,.025),0 0 0 84px rgba(109,61,224,.025);
}/* @canonical-block:000191 */
.products-public-v2-hero-art img {
  width:min(100%,720px);
  height:auto;
  filter:drop-shadow(0 28px 40px rgba(0,0,0,.42));
  transform:translate(2%,-1%);
}/* @canonical-block:000192 */
.products-public-v2-art-label {
  position:absolute;
  z-index:3;
  top:10%;
  right:7%;
  padding:8px 11px;
  border:1px solid rgba(212,180,131,.25);
  border-radius:999px;
  background:rgba(18,14,25,.76);
  color:#e8d2a9;
  font:700 11px var(--font-mono);
  letter-spacing:.08em;
}/* @canonical-block:000193 */

.products-public-v2-model,
.products-public-v2-compare,
.products-public-v2-package,
.products-public-v2-addon,
.products-public-v2-final {
  width:min(calc(100% - 48px),var(--content));
  margin:auto;
  padding:92px 0;
}/* @canonical-block:000194 */
.products-public-v2-model { border-top:1px solid rgba(36,29,23,.08); }/* @canonical-block:000195 */
.products-public-v2-section-head { max-width:760px; margin-bottom:34px; }/* @canonical-block:000196 */
.products-public-v2-section-head h2,
.products-public-v2-package-copy h2,
.products-public-v2-addon h2 {
  max-width:760px;
  margin:10px 0 12px;
  color:#1b181b;
  font-size:clamp(34px,4vw,52px);
  line-height:1.02;
}/* @canonical-block:000197 */
.products-public-v2-section-head p,.products-public-v2-package-copy p { max-width:650px; color:#625c56; }/* @canonical-block:000198 */
.products-public-v2-flow { display:grid; grid-template-columns:minmax(0,1fr) 38px minmax(0,1fr) 38px minmax(0,1fr); align-items:stretch; gap:10px; }/* @canonical-block:000199 */
.products-public-v2-flow article,
.products-public-v2-choice,
.products-public-v2-package-card {
  padding:25px;
  border:1px solid rgba(36,29,23,.11);
  border-radius:20px;
  background:rgba(255,255,255,.74);
  box-shadow:0 14px 38px rgba(58,48,38,.07);
}/* @canonical-block:000200 */
.products-public-v2-flow article { min-height:205px; }/* @canonical-block:000201 */
.products-public-v2-flow article > span { color:#8e6c39; font:700 12px var(--font-mono); letter-spacing:.08em; }/* @canonical-block:000202 */
.products-public-v2-flow article div { display:grid; grid-template-columns:38px 1fr; gap:10px; align-items:flex-start; margin-top:18px; }/* @canonical-block:000204 */
.products-public-v2-flow h3 { margin:0 0 5px; font-size:18px; color:#1c1919; }/* @canonical-block:000205 */
.products-public-v2-flow p { grid-column:2; margin:0; font-size:14px; color:#6b645d; }/* @canonical-block:000206 */
.products-public-v2-flow-arrow { display:grid; place-items:center; color:#9d7b43; font-size:20px; }/* @canonical-block:000207 */
.products-public-v2-compare-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }/* @canonical-block:000208 */
.products-public-v2-choice { min-height:350px; display:flex; flex-direction:column; }/* @canonical-block:000210 */
.products-public-v2-choice h3 { margin:10px 0 8px; font-size:24px; color:#1b1818; }/* @canonical-block:000211 */
.products-public-v2-choice p { color:#625c55; }/* @canonical-block:000212 */
.products-public-v2-choice ul { display:grid; gap:8px; padding:0; margin:20px 0; list-style:none; }/* @canonical-block:000213 */
.products-public-v2-choice li { display:flex; gap:8px; color:#4e4944; font-size:14px; }/* @canonical-block:000214 */
.products-public-v2-choice li span { color:#8e6c39; font-weight:800; }/* @canonical-block:000215 */
.products-public-v2-choice-bottom { margin-top:auto; display:flex; align-items:center; justify-content:space-between; gap:16px; }/* @canonical-block:000216 */
.products-public-v2-choice-bottom > span { color:#7c705f; font-size:12px; }/* @canonical-block:000217 */
.products-public-v2-package { display:grid; grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr); gap:70px; align-items:center; }/* @canonical-block:000218 */
.products-public-v2-package-card { display:grid; gap:12px; }/* @canonical-block:000219 */
.products-public-v2-package-card strong { font:700 30px var(--font-mono); color:#856735; }/* @canonical-block:000220 */
.products-public-v2-package-card ul { margin:0; padding:0; list-style:none; display:grid; gap:8px; }/* @canonical-block:000221 */
.products-public-v2-package-card li { font-size:14px; color:#5d5750; }/* @canonical-block:000222 */
.products-public-v2-addon { display:grid; grid-template-columns:1fr .8fr; gap:30px; align-items:flex-start; }/* @canonical-block:000223 */
.products-public-v2-final { display:grid; grid-template-columns:1fr auto; align-items:center; gap:40px; padding-bottom:120px; }/* @canonical-block:000224 */
.products-public-v2-note { color:#6b645c; font-size:12px; }/* @canonical-block:000973 */
.nfc-symbol { display:grid; place-items:center; width:30px; height:30px; border:1px solid rgba(212,180,131,.34); border-radius:50%; color:#d4b483; font-style:normal; }/* @canonical-block:001451 */

/* How it works — light editorial product walkthrough */
.how-it-works-page { min-height:100vh; overflow:hidden; background:linear-gradient(180deg,#FAF9F5 0%,#F4F0E6 54%,#ECE6DA 100%); color:var(--ink); }/* @canonical-block:001453 */
.how-hero { position:relative; min-height:220px; display:grid; place-items:center; overflow:hidden; border-bottom:1px solid rgba(24,19,13,.08); background:radial-gradient(640px 280px at 50% 50%,rgba(163,123,44,.12),transparent 72%),linear-gradient(180deg,#FAF8F3,#F1ECE2); }/* @canonical-block:001454 */
.how-hero-inner { position:relative; z-index:3; width:min(calc(100% - 48px),var(--wide)); padding:38px 0 30px; text-align:center; }/* @canonical-block:001456 */
.how-hero h1 { margin:12px 0 10px; font-size:clamp(40px,5.2vw,64px); letter-spacing:-.05em; font-weight:750; line-height:1.12; }/* @canonical-block:001457 */
.how-hero h1 em { color:#17120C; font-style:normal; }/* @canonical-block:001458 */
.how-hero p { margin:0; color:#5C554E; font-size:18px; max-width:680px; margin-inline:auto; line-height:1.5; }/* @canonical-block:001459 */
.how-steps { position:relative; width:min(calc(100% - 48px),var(--wide)); margin:auto; padding:44px 0 36px; }/* @canonical-block:001460 */
.how-flow-line { position:absolute; z-index:0; top:48%; left:7%; right:7%; height:1px; background:linear-gradient(90deg,transparent,var(--gold),transparent); opacity:.48; }/* @canonical-block:001461 */
.how-step-grid { position:relative; z-index:1; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; align-items:stretch; }/* @canonical-block:001462 */
.how-step-card { position:relative; min-height:495px; overflow:hidden; display:flex; flex-direction:column; padding:20px 20px 22px; border:1px solid rgba(30,25,19,.14); border-radius:20px; background:linear-gradient(150deg,rgba(255,255,255,.94),rgba(244,239,230,.82)); box-shadow:0 18px 40px rgba(54,43,30,.08),inset 0 1px 0 rgba(255,255,255,.95); transition:transform var(--motion-standard) var(--ease-standard),border-color var(--motion-standard) var(--ease-standard),box-shadow var(--motion-standard) var(--ease-standard); }/* @canonical-block:001463 */
.how-step-card:hover { border-color:rgba(163,123,44,.45); box-shadow:0 22px 48px rgba(54,43,30,.12),inset 0 1px 0 rgba(255,255,255,1); }/* @canonical-block:001464 */
.how-step-card--premium { border-color:rgba(163,123,44,.52); background:linear-gradient(145deg,#FFFDF8,#EFE7D5); }/* @canonical-block:001465 */
.how-step-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }/* @canonical-block:001466 */
.how-step-number { width:max-content; padding:6px 9px; border:1px solid rgba(169,129,47,.52); border-radius:8px; color:#8a6828; background:rgba(169,129,47,.07); font:700 11px/1 var(--font-mono); }/* @canonical-block:001467 */
.how-premium-badge { padding:6px 9px; border-radius:7px; background:linear-gradient(135deg,#b8934d,#806127); color:#fffaf0; font:800 12px/1 var(--font-mono); letter-spacing:.05em; box-shadow:0 6px 18px rgba(132,99,38,.22); }/* @canonical-block:001468 */
.how-step-card h3 { margin:14px 0 7px; font-size:20px; letter-spacing:-.035em; }/* @canonical-block:001469 */
.how-step-card > p { min-height:67px; margin:0; color:#625c54; font-size:14px; line-height:1.55; }/* @canonical-block:001470 */
.how-step-visual { position:relative; flex:1; min-height:230px; margin:14px -18px -20px; overflow:hidden; display:flex; align-items:flex-end; justify-content:center; background:radial-gradient(circle at 50% 65%,rgba(169,129,47,.18),transparent 54%); }/* @canonical-block:001471 */
.how-step-visual::after { content:""; position:absolute; left:8%; right:8%; bottom:0; height:22px; border-radius:50%; background:radial-gradient(ellipse,rgba(50,39,25,.22),transparent 70%); filter:blur(7px); }/* @canonical-block:001472 */
.how-step-visual img { position:relative; z-index:1; width:92%; height:235px; object-fit:contain; object-position:center bottom; filter:drop-shadow(0 20px 24px rgba(45,35,23,.20)); }/* @canonical-block:001473 */
.how-step-visual--01 img { transform:rotate(-7deg) translateY(8px) scale(1.05); }/* @canonical-block:001474 */
 .how-step-visual--02 img { width:100%; height:100%; object-fit:cover; object-position:top center; }/* @canonical-block:001475 */
.how-phone-mockup { position:relative; z-index:2; width:150px; height:265px; padding:6px; border:2px solid #28231e; border-radius:25px; background:linear-gradient(145deg,#4a4339,#11100e); box-shadow:0 22px 35px rgba(29,22,14,.30); transform:rotate(-7deg) translateY(9px); }/* @canonical-block:001476 */
.how-phone-speaker { position:absolute; z-index:4; top:7px; left:50%; width:48px; height:10px; transform:translateX(-50%); border-radius:99px; background:#0b0a08; }/* @canonical-block:001477 */
.how-phone-screen { position:relative; width:100%; height:100%; overflow:hidden; border-radius:19px; background:#171514; }/* @canonical-block:001478 */
.how-phone-screen img { display:block; width:100%; height:100%; opacity:.72; }/* @canonical-block:001479 */
.how-phone-profile { position:absolute; left:9px; right:9px; bottom:10px; display:grid; gap:2px; padding:9px 8px; border:1px solid rgba(255,255,255,.16); border-radius:10px; background:rgba(17,14,11,.72); backdrop-filter:blur(8px); color:#fff; }/* @canonical-block:001480 */
.how-phone-profile strong { color:#f7f0e3; font-size:11px; letter-spacing:-.01em; }/* @canonical-block:001481 */
.how-phone-profile span { color:#c6bcae; font-size:11px; }/* @canonical-block:001482 */
.how-step-visual--03 img { transform:rotate(-8deg) translateY(14px) scale(1.03); }/* @canonical-block:001483 */
.how-qr { position:absolute; z-index:3; left:24px; bottom:22px; width:56px; height:56px; display:grid; grid-template-columns:repeat(3,1fr); gap:3px; padding:6px; border:1px solid rgba(169,129,47,.6); border-radius:8px; background:#f6ead1; box-shadow:0 8px 22px rgba(50,37,20,.20); }/* @canonical-block:001484 */
.how-qr i { background:#322719; border-radius:1px; }/* @canonical-block:001485 */
.how-qr i:nth-child(2),.how-qr i:nth-child(4),.how-qr i:nth-child(8) { background:transparent; }/* @canonical-block:001486 */
.how-step-arrow { position:absolute; z-index:4; bottom:10px; left:50%; width:43px; height:43px; display:grid; place-items:center; transform:translateX(-50%); border:1px solid rgba(169,129,47,.56); border-radius:50%; background:linear-gradient(145deg,#e2c27d,#a47c30); color:#241b10; font-size:24px; box-shadow:0 9px 20px rgba(113,81,28,.22); }/* @canonical-block:001487 */
.how-step-arrow:hover { transform:translateX(-50%) translateY(-2px); }/* @canonical-block:001488 */
.how-dashboard { position:relative; width:100%; height:220px; margin-top:16px; padding:10px; overflow:hidden; border:1px solid rgba(37,30,22,.16); border-radius:12px; background:linear-gradient(145deg,#29241e,#13110e); box-shadow:0 18px 30px rgba(0,0,0,.24); color:#eee5d5; }/* @canonical-block:001489 */
.how-dashboard-bar { display:flex; align-items:center; gap:5px; padding-bottom:8px; border-bottom:1px solid rgba(255,255,255,.08); color:#d8bc84; font:700 11px var(--font-mono); }/* @canonical-block:001490 */
.how-dashboard-bar i { width:5px; height:5px; margin-left:auto; border-radius:50%; background:#887b68; }/* @canonical-block:001491 */
.how-dashboard-bar i+i { margin-left:0; }/* @canonical-block:001492 */
.how-dashboard-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:5px; margin:8px 0; }/* @canonical-block:001493 */
.how-dashboard-kpis b { padding:7px; border:1px solid rgba(212,180,131,.15); border-radius:6px; color:#f3dfb4; font:700 11px var(--font-mono); background:rgba(255,255,255,.035); }/* @canonical-block:001494 */
.how-dashboard-kpis small { display:block; margin-top:3px; color:#8f887e; font:500 11px var(--font-ui); }/* @canonical-block:001495 */
.how-dashboard-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:6px; }/* @canonical-block:001496 */
.how-chart,.how-mini-list,.how-mini-chart { min-height:64px; padding:7px; border:1px solid rgba(255,255,255,.08); border-radius:6px; background:rgba(255,255,255,.025); }/* @canonical-block:001497 */
.how-chart { display:flex; align-items:flex-end; gap:5px; }/* @canonical-block:001498 */
.how-chart span { flex:1; height:35%; border-radius:2px 2px 0 0; background:linear-gradient(180deg,#d4b483,#79603b); }/* @canonical-block:001499 */
.how-chart span:nth-child(2){height:55%}/* @canonical-block:001500 */.how-chart span:nth-child(3){height:42%}/* @canonical-block:001501 */.how-chart span:nth-child(4){height:76%}/* @canonical-block:001502 */.how-chart span:nth-child(5){height:62%}/* @canonical-block:001503 */
.how-mini-list { display:grid; gap:5px; align-content:start; }/* @canonical-block:001504 */
.how-mini-list i { height:7px; border-radius:3px; background:rgba(255,255,255,.11); }/* @canonical-block:001505 */
.how-mini-chart { display:flex; align-items:flex-end; gap:4px; margin-top:6px; }/* @canonical-block:001506 */
.how-mini-chart span { flex:1; height:30%; background:#8060c6; border-radius:2px 2px 0 0; }/* @canonical-block:001507 */.how-mini-chart span:nth-child(2){height:65%}/* @canonical-block:001508 */.how-mini-chart span:nth-child(3){height:48%}/* @canonical-block:001509 */.how-mini-chart span:nth-child(4){height:78%}/* @canonical-block:001510 */
.how-toggle-badge { display:inline-flex; align-items:center; gap:8px; margin-top:10px; padding:5px 12px; border-radius:999px; background:rgba(255,255,255,.12); color:#fffaf0; font:700 11px var(--font-ui); }/* @canonical-block:001513 */

.how-bottom-timeline { margin-top:32px; position:relative; width:100%; }/* @canonical-block:001514 */
.how-timeline-line { position:absolute; top:50%; left:5%; right:5%; height:2px; background:rgba(163,123,44,.25); transform:translateY(-50%); }/* @canonical-block:001515 */
.how-timeline-markers { position:relative; z-index:2; display:grid; grid-template-columns:repeat(4,1fr); text-align:center; }/* @canonical-block:001516 */
.how-timeline-markers span { display:inline-block; margin-inline:auto; padding:6px 14px; border-radius:999px; background:#faf8f5; border:1px solid rgba(163,123,44,.35); color:#8b6835; font:700 12px var(--font-mono); box-shadow:0 4px 12px rgba(50,43,33,.05); }/* @canonical-block:001517 */
.how-benefits { width:min(calc(100% - 48px),var(--wide)); margin:0 auto 34px; padding:0 0 8px; }/* @canonical-block:001518 */
.how-benefits-grid { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid rgba(30,25,19,.15); border-radius:18px; background:rgba(255,255,255,.62); box-shadow:0 12px 30px rgba(54,43,30,.07); overflow:hidden; }/* @canonical-block:001519 */
.how-benefits-grid article { min-height:112px; display:flex; align-items:center; gap:14px; padding:22px 24px; border-right:1px solid rgba(30,25,19,.12); }/* @canonical-block:001520 */.how-benefits-grid article:last-child{border-right:0}/* @canonical-block:001521 */
.how-benefit-icon { width:44px; height:44px; flex:0 0 44px; display:grid; place-items:center; border:1px solid rgba(169,129,47,.52); border-radius:12px; color:#9a742e; background:rgba(169,129,47,.06); }/* @canonical-block:001523 */
.how-benefits-grid h3 { margin:0 0 4px; font-size:15px; }/* @canonical-block:001524 */.how-benefits-grid p { margin:0; color:#746d63; font-size:12px; line-height:1.45; }/* @canonical-block:001525 */
.how-account-note { margin:16px 0 0; color:#746d63; font-size:13px; line-height:1.5; }/* @canonical-block:001526 */
.how-account-note a { color:inherit; font-weight:800; }/* @canonical-block:001530 */
@media (max-width: 1100px) {
  .how-step-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .how-flow-line { display:none; }
  .how-benefits-grid { grid-template-columns:repeat(2,1fr); }.how-benefits-grid article:nth-child(2){border-right:0}.how-benefits-grid article:nth-child(-n+2){border-bottom:1px solid rgba(30,25,19,.12);}
}/* @canonical-block:001532 */
@media (max-width: 430px) {
  .how-hero h1 { font-size:32px; }
  .how-hero p { max-width:310px; margin-inline:auto; }
  .how-step-card { min-height:455px; padding-inline:15px; }
  .how-step-visual { margin-inline:-15px; }
  .how-step-arrow { width:40px; height:40px; font-size:20px; }
}/* @canonical-block:001533 */

@media (prefers-reduced-motion: reduce) {.how-step-card,.how-step-arrow{transition:none}.how-step-card:hover,.how-step-arrow:hover{transform:none;}}/* @canonical-block:001615 */

/* Final public-page polish — tighter editorial rhythm, no artificial viewport gaps. */
@media (min-width:761px) {
  .how-it-works-page {
    display:flex;
    flex-direction:column;
    height:100svh;
    min-height:0;
    overflow:hidden;
  }
  .how-it-works-page .how-hero {
    flex:0 0 clamp(142px,16svh,170px);
    min-height:0;
    height:auto;
  }
  .how-it-works-page .how-hero-inner { padding:14px 0 10px; }
  .how-it-works-page .how-hero h1 { margin:5px 0 4px; }
  .how-it-works-page .how-hero p { margin:0; }
  .how-it-works-page .how-steps {
    flex:1 1 auto;
    min-height:0;
    width:min(calc(100% - 48px),var(--wide));
    padding:clamp(18px,2.4svh,28px) 0 clamp(10px,1.4svh,16px);
    display:flex;
    align-items:stretch;
  }
  .how-it-works-page .how-step-grid { height:100%; gap:14px; }
  .how-it-works-page .how-step-card { min-height:0; height:100%; }
  .how-it-works-page .how-benefits {
    flex:0 0 auto;
    width:min(calc(100% - 48px),var(--wide));
    margin:0 auto clamp(10px,1.2svh,14px);
    padding:0;
  }
  .how-it-works-page .how-benefits-grid { min-height:clamp(72px,9svh,88px); }
  .how-it-works-page .how-benefits-grid article { min-height:0; padding:11px 18px; }
}/* @canonical-block:001616 */

@media (min-width:900px) and (min-height:900px) {
  .how-it-works-page .how-hero { flex-basis:clamp(150px,17svh,180px); }
  .how-it-works-page .how-steps { padding-top:20px; padding-bottom:14px; }
  .how-it-works-page .how-step-card { padding:16px 18px 18px; }
}/* @canonical-block:001617 */

@media (min-width:761px) and (max-width:1100px) {
  .how-it-works-page .how-hero { flex-basis:150px; }
  .how-it-works-page .how-hero h1 { font-size:clamp(34px,4vw,44px); }
  .how-it-works-page .how-steps { width:min(calc(100% - 32px),var(--wide)); padding-top:14px; }
  .how-it-works-page .how-step-grid { gap:10px; }
  .how-it-works-page .how-step-card { padding:11px 12px 13px; border-radius:14px; }
  .how-it-works-page .how-step-card h3 { font-size:16px; margin:8px 0 4px; }
  .how-it-works-page .how-step-card > p { font-size:11px; line-height:1.4; }
  .how-it-works-page .how-step-visual img { max-height:180px; }
  .how-it-works-page .how-benefits { width:min(calc(100% - 32px),var(--wide)); }
}/* @canonical-block:001620 */

/* Products & Pricing — single viewport public surface */
.products-single-page{min-height:100svh;background:var(--surface);color:var(--ink);display:flex;flex-direction:column;overflow:hidden}/* @canonical-block:001621 */
.products-single-main{flex:1;min-height:0;display:flex;flex-direction:column}/* @canonical-block:001622 */
