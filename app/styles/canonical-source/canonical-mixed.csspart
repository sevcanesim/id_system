.yi-cart-page{min-height:calc(100vh - 76px)}/* @canonical-block:001126 */
.yi-cart-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.85fr);gap:24px;align-items:stretch;min-height:min(72vh,760px)}/* @canonical-block:001127 */
.yi-cart-items{display:grid;align-content:start;gap:14px;min-width:0}/* @canonical-block:001128 */
.yi-cart-item{min-width:0;padding:28px;border:1px solid var(--border);border-radius:20px;background:var(--surface);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:center}/* @canonical-block:001129 */
.yi-cart-item>div:first-child>span,.yi-cart-empty>span{font-size:12px;color:#8b6835;font-weight:650;letter-spacing:.12em}/* @canonical-block:001130 */
.yi-cart-item h2,.yi-cart-item-title{margin:10px 0 8px;font-size:22px;line-height:1.25;letter-spacing:-.03em}/* @canonical-block:001131 */
.yi-cart-item-title{display:grid;gap:4px}/* @canonical-block:001132 */
.yi-cart-item-title b{font-size:22px;font-weight:800}/* @canonical-block:001133 */
.yi-cart-item-title em{color:var(--ink-3);font-size:15px;font-style:normal;font-weight:650}/* @canonical-block:001134 */
.yi-cart-item p{color:var(--ink-3);font-size:14px;margin:0}/* @canonical-block:001135 */
.yi-cart-item__controls{display:grid;grid-template-columns:auto auto;align-items:center;gap:12px;justify-items:end}/* @canonical-block:001136 */
.yi-cart-item__controls strong{font-size:16px;text-align:right;font-variant-numeric:tabular-nums}/* @canonical-block:001137 */
.yi-cart-item__controls .yi-stepper{display:flex;align-items:center;border:1px solid var(--border);border-radius:12px}/* @canonical-block:001138 */
.yi-cart-item__controls .yi-stepper button{width:44px;min-width:44px;height:44px;border:0;background:transparent;color:var(--ink);font-size:20px}/* @canonical-block:001139 */
.yi-cart-item__controls .yi-stepper button:disabled{opacity:.38;cursor:not-allowed}/* @canonical-block:001140 */
.yi-cart-item__controls .yi-stepper span{min-width:44px;text-align:center;font-size:15px;font-weight:750}/* @canonical-block:001141 */
.yi-remove{grid-column:1/-1;min-height:44px;padding:0 12px;justify-self:end;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--ink);font-size:13px;font-weight:750;cursor:pointer}/* @canonical-block:001142 */
.yi-remove:hover{border-color:var(--gold);color:var(--gold-hi)}/* @canonical-block:001143 */
.yi-cart-summary{position:sticky;top:100px;align-self:start;padding:26px;border:1px solid var(--border);border-radius:22px;background:#fff;color:#17131c;display:grid;gap:16px}/* @canonical-block:001144 */
.yi-cart-summary>span{font-size:12px;color:#8b6835;font-weight:650;letter-spacing:.12em}/* @canonical-block:001145 */
.yi-cart-summary-rows{display:grid;gap:10px}/* @canonical-block:001146 */
.yi-cart-summary-rows div{display:flex;justify-content:space-between;gap:16px;color:var(--ink-2);font-size:14px}/* @canonical-block:001147 */
.yi-cart-summary-rows .total{margin-top:6px;padding-top:12px;border-top:1px solid var(--border);color:var(--ink);font-weight:800}/* @canonical-block:001148 */
.yi-cart-summary-rows .total b{font:700 28px/1 var(--font-ui);font-variant-numeric:tabular-nums;letter-spacing:-.04em}/* @canonical-block:001149 */
.yi-cart-summary p{font-size:13px;color:#68645D;line-height:1.55;margin:0}/* @canonical-block:001150 */
.yi-cart-summary .yi-btn{min-height:48px}/* @canonical-block:001151 */
.yi-cart-summary .yi-btn--ghost{color:#17131c}/* @canonical-block:001152 */
.yi-cart-empty{min-height:440px;padding:50px;border:1px dashed var(--border);border-radius:24px;display:grid;place-content:center;justify-items:center;text-align:center}/* @canonical-block:001153 */
.yi-cart-empty h2{font-size:clamp(30px,5vw,52px);letter-spacing:-.05em;margin:12px 0 26px}/* @canonical-block:001154 */
@media(max-width:1023px){.yi-cart-layout{grid-template-columns:minmax(0,1fr);min-height:0}.yi-cart-summary{position:static}}/* @canonical-block:001155 */
@media(max-width:900px){.yi-cart-item{grid-template-columns:minmax(0,1fr)}.yi-cart-item__controls{justify-content:space-between;justify-items:stretch}}/* @canonical-block:001156 */

.yi-loading-view{display:grid;gap:10px;max-width:620px;padding:30px;border:1px solid #e5e0d7;border-radius:20px;background:#fff}/* @canonical-block:001157 */.yi-loading-view div{height:12px;background:#eeeae2;border-radius:999px}/* @canonical-block:001158 */.yi-loading-view div:nth-of-type(2){width:80%}/* @canonical-block:001159 */.yi-loading-view div:nth-of-type(3){width:55%}/* @canonical-block:001160 */
.yi-empty-app{min-height:460px;padding:50px;border:1px dashed #d7d1c6;border-radius:24px;background:#fff;display:grid;align-content:center;justify-items:start}/* @canonical-block:001161 */.yi-empty-app>span,.yi-app-card>span{color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.14em}/* @canonical-block:001162 */.yi-empty-app h2{font-size:clamp(36px,5vw,58px);letter-spacing:-.05em;margin:12px 0}/* @canonical-block:001163 */.yi-empty-app p{max-width:560px;color:#746d78;line-height:1.65;margin:0 0 28px}/* @canonical-block:001164 */
.yi-dashboard-grid{display:grid;gap:18px}/* @canonical-block:001165 */.yi-dashboard-hero{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px;padding:28px;border-radius:24px;background:#fff;border:1px solid var(--border);box-shadow:var(--shadow);color:var(--ink)}/* @canonical-block:001166 */.yi-dashboard-card{min-height:280px;padding:24px;border-radius:18px;background:linear-gradient(145deg,#fff,#f4f0e8);color:var(--ink);border:1px solid var(--border);display:flex;flex-direction:column;justify-content:flex-end;box-shadow:var(--shadow-soft)}/* @canonical-block:001167 */.yi-dashboard-card span{font-size:12px;letter-spacing:.15em;color:var(--gold-hi)}/* @canonical-block:001168 */.yi-dashboard-card strong{font-size:30px;letter-spacing:-.04em;margin-top:12px}/* @canonical-block:001169 */.yi-dashboard-card small{color:var(--ink-3);margin-top:6px}/* @canonical-block:001170 */.yi-dashboard-hero>div:last-child{padding:12px 16px;align-self:center}/* @canonical-block:001171 */.yi-dashboard-hero h2{font-size:32px;letter-spacing:-.04em;margin:16px 0 10px;color:var(--ink)}/* @canonical-block:001172 */.yi-dashboard-hero p{color:var(--ink-3);line-height:1.6}/* @canonical-block:001173 */.yi-dashboard-hero progress{width:100%;height:8px;accent-color:var(--gold)}/* @canonical-block:001174 */.yi-status{display:inline-flex;padding:6px 9px;border-radius:999px;font-size:12px;font-weight:700}/* @canonical-block:001175 */.yi-status--success{background:rgba(47,158,95,.12);color:#1f7a49}/* @canonical-block:001176 */.yi-status--warning{background:rgba(169,129,47,.12);color:var(--gold-hi)}/* @canonical-block:001177 */
.yi-metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}/* @canonical-block:001178 */.yi-metric-grid>div,.yi-app-card{padding:24px;border:1px solid #e5e0d7;border-radius:20px;background:#fff}/* @canonical-block:001179 */.yi-metric-grid small{display:block;color:#746d78;font-size:12px}/* @canonical-block:001180 */.yi-metric-grid strong{display:block;font-size:32px;margin-top:10px;letter-spacing:-.04em}/* @canonical-block:001181 */.yi-app-card h2{font-size:24px;margin:12px 0 8px}/* @canonical-block:001182 */.yi-app-card p{color:#746d78}/* @canonical-block:001183 */
@media(max-width:900px){.yi-dashboard-hero{grid-template-columns:1fr}.yi-metric-grid{grid-template-columns:1fr}}/* @canonical-block:001193 */
