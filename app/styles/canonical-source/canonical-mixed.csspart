.yi-feature{padding:28px;background:#fff;border:1px solid #e7e2d9;border-radius:22px}/* @canonical-block:001059 */
.yi-feature>span{color:var(--gold);font-size:14px}/* @canonical-block:001060 */
.yi-feature h3{font-size:20px;margin:20px 0 10px}/* @canonical-block:001061 */
.yi-feature p{color:#746d78;line-height:1.6;margin:0}/* @canonical-block:001062 */
.yi-corporate{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}/* @canonical-block:001063 */
.yi-corporate h2{font-size:clamp(36px,5vw,62px);letter-spacing:-.05em;line-height:1;margin:12px 0 20px}/* @canonical-block:001064 */
.yi-corporate__copy{color:var(--ink-3);line-height:1.7;max-width:540px}/* @canonical-block:001065 */
.yi-corporate__mock{position:relative;z-index:3;width:76%;padding:28px;border:1px solid rgba(255,255,255,.12);border-radius:20px;background:linear-gradient(145deg,#1a1624,#0c0a12);box-shadow:0 30px 70px rgba(20,16,10,.22);color:#f7f4ee}/* @canonical-block:001066 */
.yi-corporate__mock-top{display:flex;justify-content:space-between;color:#f7f4ee}/* @canonical-block:001067 */
.yi-corporate__mock-top span{color:#d8b56a}/* @canonical-block:001068 */
.yi-corporate__stat{color:#f7f4ee;border-color:rgba(255,255,255,.12)}/* @canonical-block:001069 */
.yi-corporate__stat small{color:#aaa3b5}/* @canonical-block:001070 */
.yi-corporate__stats{height:120px;margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:10px}/* @canonical-block:001071 */
.yi-corporate__stat{padding:14px;border:1px solid var(--border);border-radius:12px}/* @canonical-block:001072 */
.yi-corporate__stat small{color:var(--ink-3)}/* @canonical-block:001073 */
.yi-corporate__stat strong{display:block;font-size:20px;margin-top:8px}/* @canonical-block:001074 */
@media(max-width:900px){.yi-hero__grid,.yi-corporate{grid-template-columns:1fr}.yi-feature-grid{grid-template-columns:1fr}.yi-hero{padding-top:52px}}/* @canonical-block:001075 */
@media(max-width:620px){.yi-corporate__mock{width:100%}.yi-proof{gap:12px}}/* @canonical-block:001076 */
.yi-product-visual--corporate{min-height:430px}/* @canonical-block:001077 */

.yi-buybox{padding:28px;border:1px solid var(--border);border-radius:22px;background:rgba(255,255,255,.045)}/* @canonical-block:001078 */
.yi-buybox__price{display:grid;gap:6px}/* @canonical-block:001079 */.yi-buybox__price small{color:var(--gold);text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:700}/* @canonical-block:001080 */.yi-buybox__price strong{font-size:40px;letter-spacing:-.05em}/* @canonical-block:001081 */.yi-buybox__price span{color:var(--ink-3);font-size:14px}/* @canonical-block:001082 */
.yi-buybox__row{display:flex;align-items:center;justify-content:space-between;margin:24px 0}/* @canonical-block:001083 */.yi-buybox__row label{font-size:14px;color:var(--ink-3)}/* @canonical-block:001084 */
.yi-stepper{display:flex;align-items:center;border:1px solid var(--border);border-radius:12px;overflow:hidden}/* @canonical-block:001085 */.yi-stepper button{width:44px;min-width:44px;height:44px;border:0;background:transparent;color:inherit;font-size:18px;cursor:pointer}/* @canonical-block:001086 */.yi-stepper input,.yi-stepper span{min-width:44px;height:44px;display:grid;place-items:center;border:0;border-inline:1px solid var(--border);background:transparent;color:inherit;text-align:center;font-size:15px;font-weight:700}/* @canonical-block:001087 */.yi-buybox__cta{width:100%}/* @canonical-block:001088 */.yi-buybox__note{margin:14px 0 0;color:var(--ink-3);font-size:12px;line-height:1.6}/* @canonical-block:001089 */
.yi-product-page__hero{padding:70px 0 100px}/* @canonical-block:001090 */.yi-product-page__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}/* @canonical-block:001091 */.yi-product-page__copy h1{font-size:clamp(48px,6vw,78px);line-height:.94;letter-spacing:-.055em;margin:0}/* @canonical-block:001092 */.yi-product-page__copy>p{max-width:580px;color:var(--ink-3);font-size:18px;line-height:1.65;margin:24px 0 34px}/* @canonical-block:001093 */.yi-product-page__facts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}/* @canonical-block:001094 */.yi-product-page__fact{padding:15px;border:1px solid var(--border);border-radius:14px}/* @canonical-block:001095 */.yi-product-page__fact strong{display:block;font-size:14px}/* @canonical-block:001096 */.yi-product-page__fact span{display:block;color:var(--ink-3);font-size:12px;margin-top:5px}/* @canonical-block:001097 */
@media(max-width:900px){.yi-product-page__grid{grid-template-columns:1fr}.yi-product-page__hero{padding-top:46px}}/* @canonical-block:001098 */
@media(max-width:620px){.yi-product-page__facts{grid-template-columns:1fr}.yi-product-page__copy h1{font-size:48px}}/* @canonical-block:001099 */

.yi-products-hero{padding:70px 0 90px}/* @canonical-block:001100 */.yi-products-hero__grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}/* @canonical-block:001101 */.yi-products-hero h1{font-size:clamp(50px,6vw,78px);line-height:.93;letter-spacing:-.055em;margin:0}/* @canonical-block:001102 */.yi-products-hero p{max-width:560px;color:#746d78;font-size:18px;line-height:1.65;margin:24px 0 0}/* @canonical-block:001103 */
.yi-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}/* @canonical-block:001104 */.yi-product-card{padding:26px;border:1px solid #e2ddd4;border-radius:22px;background:#fff;min-height:260px;display:flex;flex-direction:column}/* @canonical-block:001105 */.yi-product-card--muted{background:#f2efe8;color:#817b84}/* @canonical-block:001106 */.yi-product-card__top{display:flex;justify-content:space-between;align-items:flex-start}/* @canonical-block:001107 */.yi-product-card__top span{font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--gold)}/* @canonical-block:001108 */.yi-product-card__top strong{font-size:16px}/* @canonical-block:001109 */.yi-product-card h3{font-size:24px;letter-spacing:-.03em;margin:42px 0 10px}/* @canonical-block:001110 */.yi-product-card p{color:#746d78;line-height:1.6;font-size:15px;margin:0}/* @canonical-block:001111 */.yi-product-card a{margin-top:auto;padding-top:22px;color:#17131c;font-size:14px;font-weight:700;text-decoration:none}/* @canonical-block:001112 */.yi-pricing-note{display:flex;justify-content:space-between;align-items:flex-end;gap:30px}/* @canonical-block:001113 */.yi-pricing-note h2{font-size:clamp(38px,5vw,62px);letter-spacing:-.05em;margin:0}/* @canonical-block:001114 */.yi-pricing-note p{color:var(--ink-3);line-height:1.6;max-width:500px}/* @canonical-block:001115 */.yi-story-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}/* @canonical-block:001116 */.yi-story-grid h2{font-size:clamp(40px,5vw,66px);letter-spacing:-.05em;margin:0}/* @canonical-block:001117 */.yi-story-list{display:grid;gap:0}/* @canonical-block:001118 */.yi-story-list p{padding:22px 0;margin:0;border-top:1px solid var(--border);color:var(--ink-3);line-height:1.65}/* @canonical-block:001119 */.yi-story-list strong{color:var(--ink)}/* @canonical-block:001120 */.yi-empty-product{min-height:60vh;display:grid;align-content:center}/* @canonical-block:001121 */.yi-empty-product h1{font-size:clamp(42px,6vw,72px);letter-spacing:-.05em;margin:0}/* @canonical-block:001122 */.yi-empty-product p{color:#746d78;max-width:600px}/* @canonical-block:001123 */
