# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified legal identity — Yenomi ID — by Yenomilabs
# Leave identifiers blank until verified; never use another entity as a fallback.
BRAND_NAME=Yenomilabs
PRODUCT_NAME="Yenomi ID"
BRAND_LINE="Yenomi ID — by Yenomilabs"
LEGAL_TRADE_NAME="Sevcan Eşim Karadeniz"
LEGAL_ENTITY_TYPE="Şahıs işletmesi"
LEGAL_TAX_NUMBER=
LEGAL_TAX_OFFICE="Hasan Tahsin Vergi Dairesi"
LEGAL_MERSIS_NUMBER=
LEGAL_TRADE_REGISTRY_NUMBER=
LEGAL_REGISTERED_ADDRESS="Kazım Dirik Mah. 296/2 Sk. No: 33, Bornova / İzmir 35100"
LEGAL_AUTHORIZED_PERSON="Sevcan Eşim Karadeniz"
LEGAL_PHONE="+90 506 957 36 72"
# Set the established production URL and the existing support/sales/KVKK inboxes in deployment.
LEGAL_WEBSITE=
LEGAL_CONTACT_EMAIL=
LEGAL_SALES_EMAIL=
LEGAL_KVKK_EMAIL=
LEGAL_PAYMENT_PROVIDER=PayTR
LEGAL_INVOICE_PROVIDER=Mysoft
LEGAL_EFFECTIVE_DATE=
LEGAL_CONTENT_APPROVED=false
LEGAL_CONTENT_APPROVED_AT=

# Payments
# PayTR is the only hosted payment provider. Keep these values server-only;
# its callback must be reachable at /api/payments/paytr/callback.
# Keep these values server-only; never prefix them with NEXT_PUBLIC_.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# Mysoft e-document integration. Use a separate Yenomi issuer account.
# Keep disabled until the Yenomi Mysoft sandbox acceptance is complete.
MYSOFT_INVOICING_ENABLED=false
MYSOFT_API_BASE_URL=
MYSOFT_API_BEARER_TOKEN=
MYSOFT_TENANT_IDENTIFIER_NUMBER=

# Maps
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Demo / local development
DEMO_SEED_PASSWORD=
VERCEL_OIDC_TOKEN=

# Commerce ops cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
OPS_ALERT_TO=
CORPORATE_LEAD_TO=
SLACK_WEBHOOK_URL=

# Used only to pseudonymize login telemetry. Use a unique high-entropy value.
AUTH_LOG_FINGERPRINT_KEY=

# Used only for daily de-duplication of card-view analytics. Never reuse the
# service-role key or an authentication secret for this value.
ANALYTICS_FINGERPRINT_SECRET=

# Per-organization CRM webhook secrets are encrypted at rest with this key.
# Use a unique high-entropy value in every deployment environment.
ORGANIZATION_INTEGRATIONS_ENCRYPTION_KEY=

# Encrypts new B2B offer-form contact details before they are persisted.
# Never reuse an auth, payment, or webhook secret for this value.
CORPORATE_LEAD_ENCRYPTION_KEY=

# Auth gates (optional)
# On Vercel production (VERCEL_ENV=production), TEST / @yenomi.test logins are refused.
# Isolated preview/staging that still needs demo fixtures can set:
# ALLOW_TEST_LOGINS=true
# To force the same block on a non-production deployment:
# YENOMI_BLOCK_TEST_LOGINS=true
