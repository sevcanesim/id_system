/* @canonical-block:000036 */

/* shared chrome */
.p4-announcement { min-height:36px; display:flex; align-items:center; justify-content:center; gap:12px; padding:8px 20px; background:var(--surface-2); border-bottom:1px solid var(--border); color:var(--ink-2); font-size:12px; font-weight:650; letter-spacing:.02em; text-align:center; }/* @canonical-block:000037 */
.p4-announcement__item { color:var(--ink-2); }/* @canonical-block:000038 */
.p4-announcement i { width:3px; height:3px; border-radius:50%; background:var(--gold); }/* @canonical-block:000074 */

/* dark public landing */
.p4-public-home { min-height:100vh; overflow:hidden; background:radial-gradient(760px 520px at 82% 8%,rgba(109,61,224,.05),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); }/* @canonical-block:000075 */
.p4-hero { position:relative; min-height:700px; display:grid; align-items:center; overflow:hidden; }/* @canonical-block:000076 */
.p4-hero::before { content:""; position:absolute; width:680px; height:680px; right:-180px; top:-220px; border:1px solid rgba(212,180,131,.16); border-radius:50%; box-shadow:0 0 0 80px rgba(212,180,131,.018),0 0 0 160px rgba(109,61,224,.018); transform:rotate(-14deg); pointer-events:none; }/* @canonical-block:000077 */
.p4-hero-grid { display:grid; grid-template-columns:minmax(0,1.02fr) minmax(480px,.98fr); align-items:center; gap:40px; min-height:700px; }/* @canonical-block:000078 */
.p4-hero-copy { max-width:650px; padding:70px 0; }/* @canonical-block:000079 */
.p4-display { max-width:700px; margin:18px 0 22px; font-size:clamp(48px,6.1vw,84px); font-weight:760; letter-spacing:-.055em; }/* @canonical-block:000080 */
.p4-lead { max-width:590px; margin-bottom:30px; font-size:18px; line-height:1.7; color:#b8b0a5; }/* @canonical-block:000086 */
.p4-hero-note { display:flex; flex-wrap:wrap; gap:10px 18px; margin-top:22px; color:var(--ink-3); font-size:12px; }/* @canonical-block:000087 */
.p4-hero-note span { display:inline-flex; align-items:center; gap:7px; }/* @canonical-block:000089 */
.p4-product-demo { position:relative; min-height:590px; display:flex; align-items:center; justify-content:center; }/* @canonical-block:000090 */
.p4-phone { position:absolute; z-index:2; width:270px; aspect-ratio:9/18; right:28%; top:12%; padding:10px; border:1px solid rgba(255,255,255,.2); border-radius:38px; background:#09080d; box-shadow:0 35px 90px rgba(0,0,0,.55); transform:rotate(7deg); }/* @canonical-block:000091 */
.p4-phone-screen { height:100%; padding:34px 18px 18px; display:flex; flex-direction:column; align-items:center; border-radius:30px; background:linear-gradient(180deg,#171222,#0c0911); text-align:center; }/* @canonical-block:000092 */
.p4-phone-cover { position:absolute; top:11px; left:50%; width:90px; height:22px; transform:translateX(-50%); border-radius:99px; background:#050509; }/* @canonical-block:000093 */
.p4-phone-screen img { width:72px; height:72px; margin:22px 0 12px; border-radius:50%; object-fit:cover; border:2px solid rgba(212,180,131,.45); }/* @canonical-block:000094 */
.p4-phone-live { color:#87d9a9; font:700 11px/1 var(--font-mono); letter-spacing:.12em; }/* @canonical-block:000095 */
.p4-phone-screen h2 { margin:10px 0 4px; font-size:18px; }/* @canonical-block:000096 */
.p4-phone-screen p { margin-bottom:15px; font-size:12px; color:#91897f; }/* @canonical-block:000097 */
.p4-phone-actions { display:flex; gap:8px; }/* @canonical-block:000098 */
.p4-phone-actions span { width:28px; height:28px; display:grid; place-items:center; border:1px solid var(--border); border-radius:50%; color:var(--gold); }/* @canonical-block:000100 */
.p4-phone-save { width:100%; margin-top:20px; padding:10px; border-radius:10px; background:var(--gold); color:#17120c; font-size:12px; font-weight:800; }/* @canonical-block:000101 */
.p4-physical-card { position:absolute; z-index:3; width:310px; aspect-ratio:1.585; left:32%; bottom:13%; padding:24px; display:flex; flex-direction:column; justify-content:space-between; border:1px solid rgba(212,180,131,.28); border-radius:18px; background:linear-gradient(145deg,#242127,#09080c 70%); box-shadow:0 35px 90px rgba(0,0,0,.6); transform:rotate(-9deg); }/* @canonical-block:000102 */
.p4-card-brand { font-size:18px; font-weight:800; letter-spacing:.13em; color:var(--gold-hi); }/* @canonical-block:000103 */
.p4-card-nfc { align-self:flex-end; font-size:30px; letter-spacing:-8px; color:var(--gold); }/* @canonical-block:000104 */
.p4-card-bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; color:#b7b0a5; }/* @canonical-block:000105 */
.p4-card-bottom small { font-size:12px; line-height:1.4; }/* @canonical-block:000106 */
.p4-card-qr { width:54px; height:54px; display:grid; grid-template-columns:repeat(4,1fr); gap:2px; padding:5px; border-radius:6px; background:#f0e7d8; }/* @canonical-block:000107 */
.p4-card-qr i { background:#1b1620; }/* @canonical-block:000108 */
.p4-flow-chip { position:absolute; top:12%; right:5%; z-index:4; display:inline-flex; align-items:center; gap:8px; padding:8px 11px; border:1px solid var(--border-gold); border-radius:99px; background:rgba(15,10,22,.7); color:var(--gold-hi); font-size:12px; backdrop-filter:blur(12px); }/* @canonical-block:000109 */
.p4-flow-chip i { width:6px; height:6px; border-radius:50%; background:var(--gold); box-shadow:0 0 15px var(--gold); }/* @canonical-block:000110 */

.p4-section { padding:110px 0; }/* @canonical-block:000111 */
.p4-section-head { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,.65fr); gap:60px; align-items:flex-end; margin-bottom:40px; }/* @canonical-block:000112 */
.p4-section-head h2,.p4-proof-copy h2,.p4-pack-copy h2 { margin:10px 0 0; font-size:clamp(34px,4vw,54px); }/* @canonical-block:000113 */
.p4-copy { margin:0; max-width:520px; font-size:15px; line-height:1.75; }/* @canonical-block:000114 */
.p4-benefit-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }/* @canonical-block:000115 */
.p4-benefit,.p4-step { min-height:260px; padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018)); box-shadow:var(--shadow-soft); }/* @canonical-block:000116 */
.p4-benefit:hover,.p4-step:hover { border-color:var(--border-gold); transform:translateY(-3px); }/* @canonical-block:000117 */
.p4-benefit-icon,.p4-proof-step-icon { width:42px; height:42px; display:grid; place-items:center; margin-bottom:36px; border:1px solid var(--border-gold); border-radius:12px; color:var(--gold); background:var(--gold-dim); }/* @canonical-block:000118 */
.p4-benefit small { color:var(--gold); font:700 12px var(--font-mono); }/* @canonical-block:000119 */
.p4-benefit h3,.p4-step h3 { margin:10px 0 8px; font-size:18px; }/* @canonical-block:000120 */
.p4-benefit p,.p4-step p { margin:0; font-size:14px; line-height:1.65; }/* @canonical-block:000121 */
.p4-proof { padding:30px 0 110px; }/* @canonical-block:000122 */
.p4-proof-card { width:min(calc(100% - 48px),var(--wide)); margin:auto; display:grid; grid-template-columns:.9fr 1.1fr; gap:70px; align-items:center; padding:48px; border:1px solid var(--border); border-radius:var(--radius-xl); background:linear-gradient(135deg,rgba(255,255,255,.055),rgba(255,255,255,.015)); box-shadow:var(--shadow); }/* @canonical-block:000123 */
.p4-proof-visual img { width:min(100%,560px); margin:auto; filter:drop-shadow(0 35px 50px rgba(0,0,0,.5)); }/* @canonical-block:000124 */
.p4-proof-steps { display:grid; gap:12px; margin-top:30px; }/* @canonical-block:000125 */
.p4-proof-steps > div { display:grid; grid-template-columns:42px 1fr; gap:12px; align-items:center; }/* @canonical-block:000126 */
.p4-proof-steps strong,.p4-proof-steps small { display:block; }/* @canonical-block:000127 */
.p4-proof-steps strong { color:var(--ink); font-size:14px; }/* @canonical-block:000128 */
.p4-proof-steps small { margin-top:2px; color:var(--ink-3); font-size:12px; }/* @canonical-block:000129 */
.p4-how-grid { display:grid; grid-template-columns:1fr 36px 1fr 36px 1fr; align-items:center; gap:10px; }/* @canonical-block:000130 */
.p4-step { min-height:210px; }/* @canonical-block:000131 */
.p4-step-badge { width:40px; height:40px; display:grid; place-items:center; border:1px solid var(--border-gold); border-radius:50%; color:var(--gold); font:700 11px var(--font-mono); }/* @canonical-block:000132 */
.p4-step-arrow { display:grid; place-items:center; color:var(--gold); }/* @canonical-block:000133 */
.p4-pack-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:70px; align-items:center; }/* @canonical-block:000134 */
.p4-pack-visual { min-height:400px; display:grid; place-items:center; perspective:1000px; }/* @canonical-block:000135 */
.p4-pack-body { position:relative; width:330px; height:220px; border:1px solid rgba(212,180,131,.25); border-radius:16px; background:linear-gradient(145deg,#221a2b,#0c0912); transform:rotate(-7deg); box-shadow:var(--shadow); }/* @canonical-block:000136 */
.p4-pack-lid { position:absolute; z-index:2; top:-58px; left:20px; width:290px; height:76px; display:grid; place-items:center; border:1px solid rgba(212,180,131,.25); border-radius:14px 14px 8px 8px; background:#15101d; color:var(--gold-hi); font-weight:800; letter-spacing:.16em; }/* @canonical-block:000137 */
.p4-pack-card { position:absolute; left:40px; top:48px; width:250px; aspect-ratio:1.585; padding:18px; border-radius:14px; background:linear-gradient(145deg,#26222a,#0c0a0f); box-shadow:0 20px 30px rgba(0,0,0,.45); color:var(--gold-hi); }/* @canonical-block:000138 */
.p4-pack-card i { float:right; font-style:normal; }/* @canonical-block:000139 */
.p4-pack-insert { position:absolute; right:22px; bottom:22px; width:70px; height:36px; border:1px solid var(--border); border-radius:8px; }/* @canonical-block:000140 */
.p4-pack-list { display:grid; gap:10px; padding:0; margin:28px 0; list-style:none; }/* @canonical-block:000141 */
.p4-pack-list li { display:flex; align-items:center; gap:10px; color:var(--ink-2); font-size:15px; }/* @canonical-block:000143 */
.p4-pack-price { width:max-content; min-width:250px; display:grid; gap:4px; padding:18px 20px; border:1px solid var(--border-gold); border-radius:14px; background:linear-gradient(145deg,rgba(212,180,131,.10),rgba(109,61,224,.06)); }/* @canonical-block:000144 */
.p4-pack-price small { color:var(--ink-3); }/* @canonical-block:000145 */
.p4-pack-price strong { font:700 30px var(--font-mono); color:var(--gold-hi); }/* @canonical-block:000146 */
.p4-pack-price span { font-size:12px; color:var(--ink-3); }/* @canonical-block:000556 */

/* legal */

.legal-page { min-height:100vh; background:radial-gradient(760px 520px at 82% 8%,rgba(109,61,224,.05),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); }/* @canonical-block:000557 */
.legal-shell { width:min(calc(100% - 48px),820px); margin:auto; padding:42px 0 100px; }/* @canonical-block:000558 */
.legal-shell > a:first-child { color:var(--gold); font-size:14px; }/* @canonical-block:000559 */
.legal-shell h1 { margin:0 0 10px; font-size:clamp(38px,5vw,60px); }/* @canonical-block:000560 */
.legal-updated { color:var(--ink-3); font-size:12px; }/* @canonical-block:000561 */
.legal-toc { display:grid; grid-template-columns:repeat(2,1fr); gap:7px; padding:18px; margin:30px 0; border:1px solid var(--border); border-radius:14px; background:var(--glass); list-style:none; }/* @canonical-block:000562 */
.legal-toc a { color:var(--ink-2); font-size:14px; }/* @canonical-block:000563 */
.legal-toc a:hover { color:var(--gold-hi); }/* @canonical-block:000564 */
.legal-shell section { padding:25px 0; border-top:1px solid var(--border); }/* @canonical-block:000565 */
.legal-shell h2 { margin-bottom:10px; font-size:24px; }/* @canonical-block:000566 */
.legal-shell p,.legal-shell li { color:var(--ink-2); font-size:15px; line-height:1.8; }/* @canonical-block:000567 */
.legal-shell table { width:100%; border-collapse:collapse; margin-top:18px; }/* @canonical-block:000568 */
.legal-shell th,.legal-shell td { padding:11px; border:1px solid var(--border); text-align:left; color:var(--ink-2); font-size:14px; vertical-align:top; }/* @canonical-block:000569 */
.legal-shell th { color:var(--ink); background:var(--glass); }/* @canonical-block:000570 */
.legal-notice { margin-top:24px; padding:16px; border:1px solid var(--border-gold); border-radius:12px; background:var(--gold-dim); color:var(--ink-2); font-size:14px; }/* @canonical-block:000953 */
@media (max-width:860px) { .p4-faq-layout { grid-template-columns:1fr; } }/* @canonical-block:000956 */
.legal-link { color:var(--gold); }/* @canonical-block:000957 */
.legal-link:hover { color:var(--gold-hi); text-decoration:underline; text-underline-offset:3px; }/* @canonical-block:001551 */

/* Help Center — single viewport public experience */
.support-page { min-height:100vh; overflow:hidden; background:linear-gradient(180deg,#fbfaf7 0%,#f5f2ec 58%,#efebe3 100%); color:var(--ink); }/* @canonical-block:001553 */
.support-hero { position:relative; min-height:175px; display:grid; place-items:center; overflow:hidden; border-bottom:1px solid rgba(24,19,13,.08); background:radial-gradient(560px 230px at 50% 54%,rgba(169,129,47,.10),transparent 68%),linear-gradient(180deg,#faf9f5,#f3f0e9); }/* @canonical-block:001554 */
.support-hero-inner { position:relative; z-index:3; width:min(calc(100% - 48px),var(--wide)); padding:24px 0 22px; text-align:center; }/* @canonical-block:001556 */
.support-hero h1 { margin:8px 0 6px; font-size:clamp(38px,4.8vw,58px); letter-spacing:-.055em; }/* @canonical-block:001557 */
.support-hero h1 em { color:#1A1918; font-style:normal; }/* @canonical-block:001558 */
.support-hero p { max-width:680px; margin:0 auto 14px; color:var(--ink-2); font-size:15px; line-height:1.55; }/* @canonical-block:001559 */
.support-search { width:min(100%,620px); margin:auto; display:grid; grid-template-columns:34px minmax(0,1fr) auto; align-items:center; min-height:46px; padding:4px 5px 4px 12px; border:1px solid rgba(169,129,47,.36); border-radius:12px; background:rgba(255,255,255,.72); box-shadow:0 10px 28px rgba(54,43,30,.08); }/* @canonical-block:001560 */
.support-search > span { color:#9a742e; font-size:20px; }/* @canonical-block:001561 */
.support-search input { min-width:0; border:0; outline:0; background:transparent; color:var(--ink); font:500 13px var(--font-ui); }/* @canonical-block:001562 */
.support-search input::placeholder { color:#8b847a; }/* @canonical-block:001563 */
.support-search button { min-height:36px; padding:0 15px; border:1px solid rgba(169,129,47,.5); border-radius:8px; background:linear-gradient(145deg,#d9b970,#ad8538); color:#241b10; font:800 11px var(--font-ui); cursor:pointer; }/* @canonical-block:001564 */
.support-search:focus-within { box-shadow:0 0 0 3px rgba(169,129,47,.10),0 12px 30px rgba(54,43,30,.09); }/* @canonical-block:001565 */
.support-orbit { position:absolute; z-index:0; border:1px solid rgba(169,129,47,.16); border-radius:50%; pointer-events:none; }/* @canonical-block:001566 */
.support-orbit--one { width:880px; height:250px; left:-260px; top:-130px; transform:rotate(-12deg); }/* @canonical-block:001567 */
.support-orbit--two { width:760px; height:210px; right:-250px; bottom:-120px; transform:rotate(-15deg); }/* @canonical-block:001568 */
.support-planet { position:absolute; z-index:1; width:64px; height:64px; right:8%; top:28px; border-radius:50%; background:radial-gradient(circle at 32% 28%,#fff6d7 0,#cdbd91 25%,#8f7e61 52%,#4e4538 80%,#302a24 100%); box-shadow:inset -10px -9px 18px rgba(22,18,14,.30),0 16px 44px rgba(67,50,22,.13); opacity:.72; }/* @canonical-block:001569 */
.support-planet::before,.support-planet::after { content:""; position:absolute; left:50%; top:50%; width:122px; height:30px; transform:translate(-50%,-50%) rotate(-18deg); border:1px solid rgba(169,129,47,.32); border-radius:50%; }/* @canonical-block:001570 */
.support-planet::after { width:100px; height:22px; border-color:rgba(169,129,47,.18); }/* @canonical-block:001571 */
.support-planet span { position:absolute; inset:17px; border-radius:50%; background:rgba(255,248,220,.14); filter:blur(2px); }/* @canonical-block:001572 */
.support-main { width:min(calc(100% - 48px),var(--wide)); margin:auto; padding:18px 0 14px; display:grid; grid-template-columns:minmax(0,1.42fr) minmax(340px,.8fr); gap:16px; }/* @canonical-block:001573 */
.support-topics,.support-faq { min-width:0; padding:22px; border:1px solid rgba(169,129,47,.2); border-radius:18px; background:rgba(255,255,255,.82); box-shadow:0 16px 36px rgba(45,36,25,.07); backdrop-filter:blur(6px); }/* @canonical-block:001574 */
.support-section-head { display:grid; gap:8px; align-items:start; margin-bottom:14px; }/* @canonical-block:001575 */
.support-section-head h2 { margin:6px 0 0; font-size:22px; font-weight:700; letter-spacing:-.035em; color:#1a1714; }/* @canonical-block:001576 */
.support-section-head > p { max-width:48ch; margin:0; color:#6b6256; font-size:13px; line-height:1.55; }/* @canonical-block:001577 */
.support-topic-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }/* @canonical-block:001578 */
.support-topic-card { position:relative; min-height:92px; display:grid; grid-template-columns:38px minmax(0,1fr) 18px; gap:10px; align-items:center; padding:13px 14px; border:1px solid rgba(30,25,19,.12); border-radius:14px; background:rgba(255,255,255,.75); color:inherit; text-decoration:none; transition:transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease; }/* @canonical-block:001579 */
.support-topic-card:hover { transform:translateY(-3px); border-color:rgba(169,129,47,.55); background:rgba(255,255,255,.95); box-shadow:0 14px 28px rgba(169,129,47,.12); }/* @canonical-block:001580 */
.support-topic-icon { width:38px; height:38px; display:grid; place-items:center; border:1px solid rgba(169,129,47,.48); border-radius:10px; background:rgba(169,129,47,.08); color:#9a742e; font-size:16px; }/* @canonical-block:001582 */ .support-search__icon { display:grid; place-items:center; }/* @canonical-block:001584 */
.support-topic-card h3 { margin:0 0 3px; font-size:15px; font-weight:700; letter-spacing:-.015em; color:#1a1714; }/* @canonical-block:001585 */
.support-topic-card p { margin:0; color:#6b6256; font-size:12px; line-height:1.45; }/* @canonical-block:001586 */
.support-topic-arrow { color:#9a742e; font-size:16px; text-align:right; transition:transform 0.2s ease; }/* @canonical-block:001587 */
.support-topic-card:hover .support-topic-arrow { transform:translateX(3px); }/* @canonical-block:001588 */
.support-faq .support-section-head { margin-bottom:10px; }/* @canonical-block:001589 */
.support-faq-list { display:grid; gap:8px; }/* @canonical-block:001590 */
.support-faq-group { display:grid; gap:8px; scroll-margin-top:116px; }/* @canonical-block:001591 */
.support-faq-group + .support-faq-group { margin-top:14px; }/* @canonical-block:001592 */
.support-faq-group > h3 { margin:0 0 4px; color:#9a742e; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }/* @canonical-block:001593 */
.support-empty { margin:0; color:#746d63; font-size:13px; line-height:1.5; }/* @canonical-block:001594 */
.support-faq details { border:1px solid rgba(169,129,47,.18); border-radius:12px; background:rgba(255,255,255,.75); transition:border-color 0.2s ease, box-shadow 0.2s ease; }/* @canonical-block:001595 */
.support-faq details:hover { border-color:rgba(169,129,47,.4); box-shadow:0 6px 16px rgba(45,36,25,.04); }/* @canonical-block:001596 */
.support-faq details[open] { border-color:rgba(169,129,47,.45); background:rgba(255,255,255,.95); box-shadow:0 8px 20px rgba(169,129,47,.08); }/* @canonical-block:001597 */
.support-faq summary { min-height:44px; display:flex; align-items:center; justify-content:space-between; gap:12px; padding:0 14px; color:var(--ink); font-size:13px; font-weight:700; cursor:pointer; list-style:none; }/* @canonical-block:001598 */
.support-faq summary::-webkit-details-marker { display:none; }/* @canonical-block:001599 */
.support-faq summary span { flex:0 0 auto; color:#9a742e; font-size:16px; font-weight:600; transition:transform 0.2s ease; }/* @canonical-block:001600 */
.support-faq details[open] summary span { transform:rotate(45deg); }/* @canonical-block:001601 */
.support-faq details p { margin:0; padding:0 14px 14px; color:#5c5449; font-size:12px; line-height:1.6; }/* @canonical-block:001602 */
.support-contact { width:min(calc(100% - 48px),var(--wide)); margin:0 auto 14px; display:grid; grid-template-columns:1.35fr .9fr auto; align-items:center; gap:24px; padding:18px 24px; border:1px solid rgba(169,129,47,.32); border-radius:16px; background:linear-gradient(135deg,rgba(255,255,255,.92),rgba(248,241,228,.85)); box-shadow:0 14px 30px rgba(54,43,30,.07); }/* @canonical-block:001603 */
.support-contact h2 { margin:5px 0 0; font-size:19px; font-weight:700; letter-spacing:-.025em; color:#1a1714; }/* @canonical-block:001604 */
.support-contact > p { margin:0; color:#6b6256; font-size:13px; line-height:1.55; }/* @canonical-block:001605 */
.support-contact-cta { justify-self:end; display:inline-flex; align-items:center; gap:10px; min-height:38px; padding:0 15px; border-radius:9px; background:#b38a3b; color:#fffaf0; text-decoration:none; font-size:12px; font-weight:800; white-space:nowrap; box-shadow:0 8px 18px rgba(113,81,28,.16); }/* @canonical-block:001606 */
.support-contact-actions { justify-self:end; display:grid; justify-items:end; gap:8px; }/* @canonical-block:001607 */
.support-contact-actions a:not(.support-contact-cta) { color:#6d665d; font-size:12px; font-weight:800; text-decoration:none; }/* @canonical-block:001611 */

@media (max-width:1100px) and (min-width:761px) {
  .support-main { grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr); }
  .support-topic-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .support-topic-card { min-height:76px; }
  .support-topic-card p { font-size:11px; }
  .support-contact { grid-template-columns:1.2fr .9fr auto; gap:14px; }
}/* @canonical-block:001612 */

@media (max-width:760px) {
  .support-page { overflow:visible; }
  .support-hero { min-height:auto; padding:42px 0 28px; }
  .support-hero-inner { width:min(calc(100% - 32px),var(--content)); }
  .support-hero h1 { font-size:clamp(38px,11vw,54px); }
  .support-hero p { font-size:14px; }
  .support-search { grid-template-columns:28px minmax(0,1fr) auto; }
  .support-main { width:min(calc(100% - 32px),var(--content)); grid-template-columns:1fr; padding:18px 0; }
  .support-topics,.support-faq { padding:16px; }
  .support-topic-grid { grid-template-columns:1fr; }
  .support-topic-card { min-height:82px; }
  .support-section-head { display:grid; gap:8px; }
  .support-contact { width:min(calc(100% - 32px),var(--content)); grid-template-columns:1fr; margin-bottom:32px; padding:18px; }
  .support-contact-cta,.support-contact-actions { justify-self:start; }
  .support-contact-actions { justify-items:start; }
  .support-planet { width:48px; height:48px; top:22px; right:3%; }
  .support-planet::before { width:92px; height:24px; }
  .support-planet::after { width:76px; height:18px; }
}/* @canonical-block:001613 */

@media (prefers-reduced-motion: reduce) {
  .support-topic-card,.support-faq summary span { transition:none; }
  .support-topic-card:hover { transform:none; }
}/* @canonical-block:001618 */

@media (min-width:761px) {
  .support-page {
    display:flex;
    flex-direction:column;
    height:100svh;
    min-height:0;
    overflow:hidden;
  }
  .support-page .support-hero {
    flex:0 0 clamp(150px,18svh,175px);
    min-height:0;
    height:auto;
  }
  .support-page .support-hero-inner { padding:16px 0 14px; }
  .support-page .support-hero h1 { margin:6px 0 4px; }
  .support-page .support-hero p { margin-bottom:10px; }
  .support-page .support-main {
    flex:1 1 auto;
    min-height:0;
    width:min(calc(100% - 48px),var(--wide));
    padding:clamp(14px,2svh,22px) 0 clamp(10px,1.2svh,14px);
    align-items:stretch;
  }
  .support-page .support-topics,
  .support-page .support-faq { height:100%; }
  .support-page .support-section-head { margin-bottom:9px; }
  .support-page .support-section-head h2 { font-size:20px; }
  .support-page .support-topic-grid { gap:8px; }
  .support-page .support-topic-card { min-height:0; }
  .support-page .support-contact {
    flex:0 0 auto;
    width:min(calc(100% - 48px),var(--wide));
    margin:0 auto clamp(10px,1.2svh,14px);
    padding:14px 18px;
  }
}/* @canonical-block:001619 */

@media (min-width:761px) and (max-width:1100px) {
  .support-page .support-hero { flex-basis:150px; }
  .support-page .support-main { width:min(calc(100% - 32px),var(--wide)); gap:12px; }
  .support-page .support-topics,
  .support-page .support-faq { padding:14px; }
  .support-page .support-section-head h2 { font-size:16px; }
  .support-page .support-topic-card { grid-template-columns:30px minmax(0,1fr) 14px; gap:7px; padding:9px; }
  .support-page .support-topic-icon { width:30px; height:30px; font-size:15px; }
  .support-page .support-topic-card h3 { font-size:12px; }
  .support-page .support-topic-card p { font-size:11px; }
  .support-page .support-faq summary { font-size:12px; }
  .support-page .support-contact { width:min(calc(100% - 32px),var(--wide)); gap:14px; padding:12px 16px; }
}/* @canonical-block:001754 */


/* ============================================================
   V27 — P2 visual stability & public rhythm
   ============================================================ */

/* Home hero: keep the product render continuously visible.
   Motion is transform-only; opacity is never animated. */
.p4-proof-visual { position:relative; min-height:520px; display:grid; place-items:center; }/* @canonical-block:001755 */
.p4-proof-visual img {
  opacity:1;
  visibility:visible;
  will-change:transform;
  animation: yi-home-product-float 7s ease-in-out infinite;
}/* @canonical-block:001757 */
@media (prefers-reduced-motion: reduce) {
  .p4-proof-visual img { animation:none; transform:none; }
}/* @canonical-block:001766 */

/* Help Center: balanced two-column content area. */
.support-main { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr); gap:16px; align-items:stretch; }/* @canonical-block:001767 */
.support-topics,.support-faq { height:100%; box-sizing:border-box; }/* @canonical-block:001768 */
.support-topic-grid { grid-auto-rows:minmax(88px,1fr); }/* @canonical-block:001769 */
.support-faq { display:flex; flex-direction:column; }/* @canonical-block:001770 */
.support-faq-list { flex:1; }/* @canonical-block:001771 */
@media (max-width: 900px) {
  .support-main { grid-template-columns:1fr; }
}/* @canonical-block:002155 */


/* V33-HOME-SINGLE-PAGE
   Homepage follows the same single-page narrative model as /nasil-calisir.
   Light theme is intentional; public pages remain conversion-first. */
.home-one-page{background:#f7f5ef;color:#17131c;overflow:hidden}/* @canonical-block:002156 */
.home-hero{position:relative;isolation:isolate;min-height:calc(100svh - 112px);display:grid;place-items:center;padding:80px 0 96px;background:radial-gradient(circle at 78% 28%,rgba(212,180,131,.18),transparent 24%),linear-gradient(180deg,#fbfaf7 0%,#f1eee7 100%);overflow:hidden}/* @canonical-block:002157 */
.home-hero__inner,.home-container{width:min(1180px,calc(100% - 48px));margin-inline:auto}/* @canonical-block:002158 */
.home-hero__inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.95fr);align-items:center;gap:56px;position:relative;z-index:2}/* @canonical-block:002159 */
.home-kicker{display:block;color:#a9812f;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}/* @canonical-block:002160 */
.home-hero h1{margin:18px 0 0;font-size:clamp(52px,7vw,92px);line-height:.9;letter-spacing:-.06em}/* @canonical-block:002161 */
.home-hero h1 em,.home-intro h2 em,.home-product h2 em,.home-final h2 em{font-style:normal;color:#a9812f}/* @canonical-block:002162 */
.home-hero__copy>p{max-width:610px;margin:28px 0 0;color:#6f6871;font-size:18px;line-height:1.7}/* @canonical-block:002163 */
.home-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}/* @canonical-block:002164 */
.home-button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:750;transition:transform var(--motion-standard) var(--ease-standard),box-shadow var(--motion-standard) var(--ease-standard),background var(--motion-standard) var(--ease-standard)}/* @canonical-block:002165 */
.home-button:hover{transform:translateY(-2px)}/* @canonical-block:002166 */
.home-button--gold{background:#a9812f;color:#fff;box-shadow:0 12px 28px rgba(169,129,47,.18)}/* @canonical-block:002167 */
.home-button--outline{border:1px solid rgba(24,21,27,.22);color:#17131c;background:rgba(255,255,255,.46)}/* @canonical-block:002168 */
.home-button--dark{background:#17131c;color:#fff}/* @canonical-block:002169 */
.home-proof{display:flex;gap:22px;flex-wrap:wrap;margin-top:28px;color:#716b73;font-size:13px}/* @canonical-block:002170 */
.home-hero__visual{position:relative;min-height:570px;display:grid;place-items:center}/* @canonical-block:002171 */
.home-card-orbit{position:absolute;width:92%;height:56%;border:1px solid rgba(169,129,47,.2);border-radius:50%;transform:rotate(-17deg)}/* @canonical-block:002172 */
.home-phone{position:absolute;right:5%;top:4%;z-index:2;width:38%;aspect-ratio:.53;border:8px solid #17131c;border-radius:34px;padding:8px;background:#17131c;box-shadow:0 30px 60px rgba(24,21,27,.24);transform:rotate(6deg)}/* @canonical-block:002173 */
.home-phone__screen{height:100%;overflow:hidden;border-radius:25px;background:#f4f1eb;position:relative}/* @canonical-block:002174 */
.home-phone__screen img{width:100%;height:100%;object-fit:cover;opacity:.88}/* @canonical-block:002175 */
.home-phone__profile{position:absolute;inset:auto 10px 10px;padding:14px;display:grid;gap:5px;border-radius:16px;background:rgba(255,255,255,.9);backdrop-filter:blur(12px)}/* @canonical-block:002176 */
.home-phone__profile strong{font-size:12px}/* @canonical-block:002177 */.home-phone__profile span{font-size:11px;color:#777}/* @canonical-block:002178 */.home-phone__profile b{margin-top:6px;padding:8px;border-radius:999px;background:#17131c;color:#fff;text-align:center;font-size:11px}/* @canonical-block:002179 */
.home-nfc-card{position:absolute;z-index:3;width:78%;height:auto;left:0;bottom:8%;filter:drop-shadow(0 32px 36px rgba(24,21,27,.28));transform:rotate(-7deg)}/* @canonical-block:002180 */
.home-orbit{position:absolute;border:1px solid rgba(169,129,47,.14);border-radius:50%;pointer-events:none}/* @canonical-block:002181 */
.home-orbit--one{width:620px;height:250px;right:-160px;top:10%;transform:rotate(-24deg)}/* @canonical-block:002182 */
.home-orbit--two{width:420px;height:180px;left:-220px;bottom:6%;transform:rotate(22deg)}/* @canonical-block:002183 */
.home-section{padding:112px 0}/* @canonical-block:002184 */
.home-section--intro{background:#fff}/* @canonical-block:002185 */
.home-intro{display:grid;grid-template-columns:1fr .8fr;gap:80px;align-items:end}/* @canonical-block:002186 */
.home-intro h2{margin:16px 0 0;font-size:clamp(40px,5vw,68px);line-height:.96;letter-spacing:-.055em}/* @canonical-block:002187 */
.home-intro>p{margin:0;color:#6f6871;font-size:18px;line-height:1.7;max-width:520px}/* @canonical-block:002188 */
.home-section--steps{background:#f7f5ef}/* @canonical-block:002189 */
.home-section-heading{max-width:720px;margin-bottom:42px}/* @canonical-block:002190 */
.home-section-heading h2{margin:14px 0 0;font-size:clamp(38px,5vw,62px);line-height:.96;letter-spacing:-.05em}/* @canonical-block:002191 */
.home-section-heading p{margin:18px 0 0;color:#716a72;font-size:16px;line-height:1.65}/* @canonical-block:002192 */
.home-step-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;position:relative}/* @canonical-block:002193 */
.home-step-card{position:relative;min-height:330px;padding:24px;background:#fff;border:1px solid #e4dfd7;border-radius:22px;display:flex;flex-direction:column;box-shadow:0 12px 32px rgba(24,21,27,.04)}/* @canonical-block:002194 */
.home-step-card--premium{border-color:rgba(169,129,47,.55);box-shadow:0 18px 40px rgba(169,129,47,.12)}/* @canonical-block:002195 */
.home-step-card__top{display:flex;justify-content:space-between;align-items:center;gap:10px;color:#a9812f;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}/* @canonical-block:002196 */
.home-step-card__top b{padding:5px 8px;border-radius:999px;background:#17131c;color:#fff;font-size:11px;letter-spacing:.1em}/* @canonical-block:002197 */
.home-step-card__number{margin-top:48px;color:#c7bda9;font-family:"IBM Plex Mono",monospace;font-size:12px}/* @canonical-block:002198 */
.home-step-card h3{margin:10px 0 10px;font-size:21px;letter-spacing:-.02em}/* @canonical-block:002199 */
.home-step-card p{margin:0;color:#716a72;line-height:1.65;font-size:14px}/* @canonical-block:002200 */
.home-step-card__arrow{margin-top:auto;align-self:flex-end;width:34px;height:34px;display:grid;place-items:center;border:1px solid #ded8cf;border-radius:50%;color:#a9812f}/* @canonical-block:002201 */
.home-section-cta{margin-top:30px;text-align:center}/* @canonical-block:002202 */.home-section-cta a{color:#17131c;font-weight:750;text-decoration:none;border-bottom:1px solid #a9812f;padding-bottom:4px}/* @canonical-block:002203 */
.home-section--product{background:#fff}/* @canonical-block:002204 */
.home-product{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}/* @canonical-block:002205 */
.home-product__visual{min-height:540px;position:relative;display:grid;place-items:center;border-radius:28px;background:#f1eee6;border:1px solid #e2ddd4;overflow:hidden}/* @canonical-block:002206 */
.home-product__halo{position:absolute;width:75%;height:55%;border:1px solid rgba(169,129,47,.25);border-radius:50%;transform:rotate(-20deg)}/* @canonical-block:002207 */
.home-product__visual img{width:92%;height:auto;position:relative;z-index:2;filter:drop-shadow(0 30px 30px rgba(24,21,27,.22));transform:rotate(-5deg)}/* @canonical-block:002208 */
.home-product h2{margin:14px 0 22px;font-size:clamp(40px,5vw,66px);line-height:.95;letter-spacing:-.055em}/* @canonical-block:002209 */
.home-product__copy>p{max-width:560px;color:#716a72;font-size:17px;line-height:1.7}/* @canonical-block:002210 */
.home-benefit-list{display:grid;gap:16px;margin:28px 0 30px}/* @canonical-block:002211 */
.home-benefit-list div{display:grid;grid-template-columns:150px 1fr;gap:16px;padding-top:14px;border-top:1px solid #e5e0d8}/* @canonical-block:002212 */
.home-benefit-list strong{font-size:14px}/* @canonical-block:002213 */.home-benefit-list span{color:#716a72;font-size:14px;line-height:1.55}/* @canonical-block:002214 */
.home-section--corporate{background:#17131c;color:#f7f4ee}/* @canonical-block:002215 */
.home-corporate{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}/* @canonical-block:002216 */
.home-corporate h2{margin:14px 0 22px;font-size:clamp(40px,5vw,64px);line-height:.95;letter-spacing:-.055em}/* @canonical-block:002217 */
.home-corporate__copy>p{max-width:560px;color:#b8b0a7;font-size:17px;line-height:1.7}/* @canonical-block:002218 */
.home-dashboard{padding:24px;border:1px solid rgba(212,180,131,.18);border-radius:22px;background:linear-gradient(145deg,#27212f,#100d15);box-shadow:0 30px 70px rgba(0,0,0,.28)}/* @canonical-block:002219 */
.home-dashboard__head{display:flex;justify-content:space-between;color:#f7f4ee}/* @canonical-block:002220 */.home-dashboard__head span{color:#d4b483;font-size:11px;letter-spacing:.12em}/* @canonical-block:002221 */
.home-dashboard__metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}/* @canonical-block:002222 */
.home-dashboard__metrics div{padding:16px;border:1px solid rgba(255,255,255,.08);border-radius:13px;background:rgba(255,255,255,.03)}/* @canonical-block:002223 */
.home-dashboard__metrics small{display:block;color:#9c948d;font-size:11px}/* @canonical-block:002224 */.home-dashboard__metrics strong{display:block;margin-top:8px;font-family:"IBM Plex Mono",monospace;font-size:20px;color:#f7f4ee}/* @canonical-block:002225 */
.home-dashboard__chart{height:130px;margin-top:14px;display:flex;align-items:end;gap:10px;padding:16px;border:1px solid rgba(255,255,255,.08);border-radius:13px}/* @canonical-block:002226 */
.home-dashboard__chart i{display:block;flex:1;background:#d4b483;border-radius:4px 4px 0 0;opacity:.8}/* @canonical-block:002227 */.home-dashboard__chart i:nth-child(1){height:34%}/* @canonical-block:002228 */.home-dashboard__chart i:nth-child(2){height:48%}/* @canonical-block:002229 */.home-dashboard__chart i:nth-child(3){height:42%}/* @canonical-block:002230 */.home-dashboard__chart i:nth-child(4){height:66%}/* @canonical-block:002231 */.home-dashboard__chart i:nth-child(5){height:58%}/* @canonical-block:002232 */.home-dashboard__chart i:nth-child(6){height:82%}/* @canonical-block:002233 */
.home-section--final{background:#f7f5ef;padding:130px 0}/* @canonical-block:002234 */
.home-final{width:min(900px,calc(100% - 48px));margin:auto;text-align:center}/* @canonical-block:002235 */
.home-final h2{margin:16px 0 20px;font-size:clamp(48px,7vw,88px);line-height:.9;letter-spacing:-.06em}/* @canonical-block:002236 */
.home-final p{max-width:620px;margin:0 auto;color:#716a72;font-size:17px;line-height:1.7}/* @canonical-block:002237 */
.home-final .home-actions{justify-content:center}/* @canonical-block:002238 */
@media(max-width:1000px){
 .home-hero__inner,.home-product,.home-corporate{grid-template-columns:1fr}
 .home-hero__visual{min-height:500px;max-width:680px;width:100%;margin:auto}
 .home-step-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .home-intro{grid-template-columns:1fr;gap:24px}
}/* @canonical-block:002239 */
@media(max-width:620px){
 .home-hero{min-height:auto;padding:54px 0 70px}
 .home-hero__inner,.home-container,.home-final{width:min(100% - 32px,1180px)}
 .home-hero__visual{min-height:390px;margin-top:18px}
 .home-phone{width:39%;right:1%;top:1%}
 .home-nfc-card{width:82%;left:-3%;bottom:5%}
 .home-step-grid{grid-template-columns:1fr}
 .home-step-card{min-height:280px}
 .home-section{padding:76px 0}
 .home-product__visual{min-height:360px}
 .home-benefit-list div{grid-template-columns:1fr;gap:6px}
 .home-dashboard__metrics{grid-template-columns:1fr}
 .home-actions .home-button{width:100%}
 .home-proof{gap:10px}
}/* @canonical-block:002240 */
@media(prefers-reduced-motion:reduce){
 .home-button{transition:none}
 .home-hero *{animation:none}
}/* @canonical-block:002290 */


/* V35-HOME-COMPACT
   Public homepage is intentionally short: hero + one horizontal story rail + final CTA.
   The rail provides motion/discovery without turning the page into a long scroll. */
.home-compact{background:#f7f5ef;color:#17131c;overflow:hidden}/* @canonical-block:002291 */
.home-compact__hero{position:relative;min-height:calc(100svh - 110px);display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center;gap:30px;padding:72px max(6vw,32px) 64px;background:linear-gradient(180deg,#fbfaf7,#f3efe7)}/* @canonical-block:002292 */
.home-compact__hero-copy{position:relative;z-index:2;max-width:690px;margin-left:auto}/* @canonical-block:002293 */
.home-compact__hero-copy h1{margin:16px 0 0;font-size:clamp(58px,6.5vw,96px);line-height:.88;letter-spacing:-.065em}/* @canonical-block:002294 */
.home-compact__hero-copy h1 em,.home-compact__journey h2 em,.home-compact__close h2 em{font-style:normal;color:#a9812f}/* @canonical-block:002295 */
.home-compact__hero-copy>p{max-width:610px;margin:26px 0 0;color:#716a72;font-size:18px;line-height:1.65}/* @canonical-block:002296 */
.home-compact__proof{display:flex;flex-wrap:wrap;gap:14px;margin-top:22px;color:#746d67;font-size:12px}/* @canonical-block:002297 */
.home-compact__hero-visual{position:relative;min-height:590px;display:grid;place-items:center}/* @canonical-block:002298 */
.home-compact__card{position:absolute;width:min(58%,620px);right:7%;bottom:12%;z-index:2;filter:drop-shadow(0 30px 30px rgba(0,0,0,.18));animation:yi-home-card-float 7s ease-in-out infinite}/* @canonical-block:002299 */
.home-compact__phone{position:absolute;width:min(34%,285px);right:34%;top:13%;z-index:3;transform:rotate(-5deg);padding:9px;border-radius:36px;background:#27231f;box-shadow:0 35px 70px rgba(0,0,0,.24);animation:yi-home-phone-float 8s ease-in-out 1s infinite}/* @canonical-block:002300 */
.home-compact__phone .home-phone__screen{height:500px;border-radius:28px;overflow:hidden;position:relative;background:#111}/* @canonical-block:002301 */
.home-compact__phone .home-phone__screen img{width:100%;height:100%;object-fit:cover}/* @canonical-block:002302 */
.home-compact__phone .home-phone__profile{position:absolute;left:12px;right:12px;bottom:12px;padding:16px;border-radius:17px;background:rgba(20,16,20,.82);color:#fff;backdrop-filter:blur(12px);display:grid;gap:4px}/* @canonical-block:002303 */
.home-compact__phone .home-phone__profile span{font-size:11px;color:#c7c0bb}/* @canonical-block:002304 */
.home-compact__phone .home-phone__profile b{margin-top:7px;padding:8px;border-radius:999px;text-align:center;background:#d4b483;color:#17131c;font-size:11px}/* @canonical-block:002305 */
.home-compact__orb{position:absolute;border:1px solid rgba(169,129,47,.18);border-radius:50%;pointer-events:none}/* @canonical-block:002306 */
.home-compact__orb--one{width:55vw;height:22vw;right:-14vw;top:10%;transform:rotate(-13deg)}/* @canonical-block:002307 */
.home-compact__orb--two{width:42vw;height:16vw;left:-18vw;bottom:4%;transform:rotate(15deg)}/* @canonical-block:002308 */
.home-compact__journey{padding:74px 0 82px;background:#fff}/* @canonical-block:002309 */
.home-compact__journey-head{width:min(1180px,calc(100% - 48px));margin:0 auto 32px;display:grid;grid-template-columns:1fr .7fr;gap:70px;align-items:end}/* @canonical-block:002310 */
.home-compact__journey-head h2{margin:14px 0 0;font-size:clamp(42px,5vw,68px);line-height:.92;letter-spacing:-.055em}/* @canonical-block:002311 */
.home-compact__journey-head p{margin:0;color:#716a72;font-size:14px;line-height:1.7}/* @canonical-block:002312 */
