  font-size: 12px;
  font-weight: 800;
}/* @canonical-block:002083 */
.p10-domain-panel > header > button:hover,
.p10-domain-panel > header > select:hover { border-color: var(--gold); }/* @canonical-block:002084 */

.p10-metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 14px;
}/* @canonical-block:002085 */
.p10-metric-grid article {
  min-width: 0;
  min-height: 96px;
  display: grid;
  align-content: center;
  gap: 5px;
  padding: 15px 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
}/* @canonical-block:002086 */
.p10-metric-grid small { color: var(--ink-3); font-size: 11px; font-weight: 750; }/* @canonical-block:002087 */
.p10-metric-grid strong { color: var(--ink); font: 800 clamp(20px, 3vw, 26px)/1 var(--font-mono); font-variant-numeric: tabular-nums; overflow-wrap:anywhere; }/* @canonical-block:002088 */

.p10-card-list,
.p10-ranking { margin-top: 14px; display: grid; gap: 8px; }/* @canonical-block:002089 */
.p10-card-list > article,
.p10-ranking > div {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
}/* @canonical-block:002090 */
.p10-card-list > article > div { min-width: 0; display: grid; gap: 3px; }/* @canonical-block:002091 */
.p10-card-list strong,
.p10-card-list small { min-width: 0; overflow-wrap:anywhere; }/* @canonical-block:002092 */
.p10-card-list strong { color: var(--ink); font-size: 13px; }/* @canonical-block:002093 */
.p10-card-list small { color: var(--ink-3); font-size: 11px; line-height: 1.4; }/* @canonical-block:002094 */
.p10-card-list [data-status] { white-space: nowrap; font-size: 11px; font-weight: 800; }/* @canonical-block:002095 */
.p10-card-list button { min-height: 34px; padding: 0 10px; border: 1px solid var(--border-gold); border-radius: 9px; background: var(--gold-dim); color: var(--ink); font-size: 11px; font-weight: 800; }/* @canonical-block:002096 */
.p10-card-list button:hover { border-color: var(--gold); box-shadow: var(--glow); }/* @canonical-block:002097 */
.p10-empty { margin: 0; padding: 28px 16px; border: 1px dashed var(--border-gold); border-radius: 12px; background: var(--surface-2); color: var(--ink-3); text-align:center; font-size: 13px; }/* @canonical-block:002098 */
.p10-ranking h3 { margin: 0 0 4px; font-size: 15px; }/* @canonical-block:002099 */
.p10-ranking > div { grid-template-columns: 28px minmax(0,1fr) auto; }/* @canonical-block:002100 */
.p10-ranking > div > span { font: 800 12px var(--font-mono); color: var(--gold-hi); }/* @canonical-block:002101 */
.p10-ranking > div > strong { min-width:0; overflow-wrap:anywhere; font-size:12px; }/* @canonical-block:002102 */
.p10-ranking > div > small { color:var(--ink-3); font-size:11px; }/* @canonical-block:002103 */

.p10-settings-grid button {
