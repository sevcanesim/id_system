.p9-order__progress span {
  flex: 1;
  height: 4px;
  border-radius: 99px;
  background: #E6E2D8;
}/* @canonical-block:004033 */
.p9-order__progress span[data-active="true"] {
  background: #A37B2C;
}/* @canonical-block:004034 */
.p9-order__meta {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}/* @canonical-block:004035 */
.p9-order__meta small,
.p9-service-fact small {
  color: #8b6835;
  font-size: 12px;
  font-weight: 650;
  letter-spacing: .12em;
}/* @canonical-block:004036 */
.p9-order__meta strong,
.p9-service-fact strong,
.p9-price strong {
  color: #1A1918;
}/* @canonical-block:004037 */
.p9-service__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}/* @canonical-block:004038 */
.p9-service-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}/* @canonical-block:004039 */
.p9-feature-list {
  display: grid;
  gap: 8px;
  margin: 16px 0;
}/* @canonical-block:004040 */
.p9-service-actions {
  margin-top: 16px;
}/* @canonical-block:004041 */

@media (max-width: 760px) {
  .p9-settings-grid,
  .p9-analytics-metrics,
  .p9-order__meta,
  .p9-service-facts {
    grid-template-columns: 1fr;
  }
}/* @canonical-block:004061 */
.p6-auth-socials {
  gap: 12px;
}/* @canonical-block:004062 */
.p6-auth-remember input {
  margin: 0;
  width: 16px;
  height: 16px;
}/* @canonical-block:004063 */
.p6-auth-remember {
  align-items: center;
}/* @canonical-block:004064 */

.p12-public-card-page {
  position: relative;
  overflow: hidden;
}/* @canonical-block:004065 */
.p12-public-card {
  position: relative;
  z-index: 1;
}/* @canonical-block:004066 */
.p12-profile-watermark {
  position: absolute;
  inset: -18%;
  z-index: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 28px;
  overflow: hidden;
  pointer-events: none;
  transform: rotate(-16deg);
  color: rgba(26, 25, 24, .11);
  font: 650 11px/1.8 var(--font-mono);
  letter-spacing: .08em;
  text-transform: uppercase;
}/* @canonical-block:004067 */
.p12-profile-watermark span {
  display: block;
  white-space: nowrap;
  padding-inline: 2.5em;
}/* @canonical-block:004070 */

@media (max-height: 900px) {
  .p6-auth-shell {
    align-items: start;
    min-height: 0;
    padding-top: 20px;
  }
}/* @canonical-block:004082 */

@media (max-width: 980px) {
  .p6-auth-product-flow {
    display: none;
  }
  .p6-auth-story > p {
    max-width: 42ch;
  }
}/* @canonical-block:004151 */

.p6-auth-features > li {
  padding: 14px 16px;
  gap: 12px;
  align-items: center;
}/* @canonical-block:004152 */
.p6-auth-features > li > span > small,
.p6-auth-security > span > small {
  color: #3f3a35;
  font-size: 13px;
  line-height: 1.45;
}/* @canonical-block:004153 */
.p6-auth-input {
  border-color: #c9c2b6;
}/* @canonical-block:004154 */
.p6-auth-input input {
  color: #1A1918;
}/* @canonical-block:004155 */
.p6-auth-input input::placeholder {
  color: #4f4943;
  opacity: 1;
}/* @canonical-block:004156 */
.p6-auth-input:focus-within {
  border-color: #6a4e1c;
  box-shadow: 0 0 0 3px rgba(163, 123, 44, .22);
}/* @canonical-block:004157 */
.p6-auth-submit {
  min-height: 48px;
}/* @canonical-block:004229 */

/* Login: portal tabs stay clickable above chrome/mockup overflow; errors stay on the card. */
.p6-auth-form-card {
  position: relative;
  z-index: 2;
}/* @canonical-block:004230 */
.p6-auth-visual-card,
.p6-auth-mini-phone {
  pointer-events: none;
}/* @canonical-block:004233 */
.p6-auth-portal-tabs {
  position: relative;
  z-index: 3;
}/* @canonical-block:004234 */
.p6-auth-portal-tabs a,
.p6-auth-portal-tabs button {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  pointer-events: auto;
  cursor: pointer;
  color: #3f3a35;
  text-decoration: none;
  font-weight: 650;
}/* @canonical-block:004236 */
.p6-auth-portal-tabs a:hover,
.p6-auth-portal-tabs button:hover {
  color: #1A1918;
}/* @canonical-block:004237 */
.p6-auth-portal-tabs a:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 2px;
}/* @canonical-block:004238 */
.p6-auth-message {
  position: relative;
  z-index: 2;
  margin: 0 0 16px;
}/* @canonical-block:004426 */

/* Gold Accent Text Clipping */
.p6-gold-text {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-hi) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}/* @canonical-block:004427 */

/* Floating 3D Mockup Scene with Ambient Glow */
.p6-auth-product-flow {
  position: relative;
  min-height: 0;
  margin-top: 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  perspective: 1000px;
  animation: p6FloatScene 6s ease-in-out infinite alternate;
}/* @canonical-block:004428 */

.p6-auth-product-flow::before {
  content: "";
  position: absolute;
  inset: -24px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(169, 129, 47, 0.22) 0%, rgba(109, 61, 224, 0.09) 50%, transparent 70%);
  filter: blur(24px);
  pointer-events: none;
  z-index: 0;
}/* @canonical-block:004429 */

.p6-auth-visual-card {
  width: 176px;
  flex: 0 0 auto;
  transform: perspective(1000px) rotateY(-8deg) rotateX(4deg) rotate(-5deg);
  filter: drop-shadow(0 20px 32px rgba(40, 34, 28, 0.16));
  transition: transform var(--motion-standard) var(--ease-emphasis);
}/* @canonical-block:004430 */

.p6-auth-visual-card:hover {
  transform: perspective(1000px) rotateY(-4deg) rotateX(2deg) rotate(-2deg) scale(1.02);
}/* @canonical-block:004431 */

.p6-auth-mini-phone {
  width: 136px;
  margin-left: -4px;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform: perspective(1000px) rotateY(6deg) rotateX(-2deg) rotate(4deg);
  filter: drop-shadow(0 16px 28px rgba(40, 34, 28, 0.14));
  color: inherit;
  text-align: left;
  transition: transform var(--motion-standard) var(--ease-emphasis);
}/* @canonical-block:004432 */

.p6-auth-mini-phone:hover {
  transform: perspective(1000px) rotateY(2deg) rotateX(0deg) rotate(2deg) scale(1.02);
}/* @canonical-block:004434 */

/* 2x2 Bento Grid Feature Layout */
.p6-auth-features-bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 24px;
}/* @canonical-block:004435 */

.p6-bento-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(250, 248, 243, 0.95);
  box-shadow: 0 2px 8px rgba(40, 34, 28, 0.03);
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004436 */

.p6-bento-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-gold);
  box-shadow: 0 8px 20px rgba(169, 129, 47, 0.14);
}/* @canonical-block:004437 */

.p6-bento-icon {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: var(--gold-dim);
  color: var(--gold-hi);
}/* @canonical-block:004439 */

.p6-bento-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}/* @canonical-block:004440 */

.p6-bento-content strong {
  color: var(--ink);
  font-size: 12px;
  font-weight: 750;
  line-height: 1.3;
}/* @canonical-block:004441 */

.p6-bento-content small {
  color: var(--ink-3);
  font-size: 11px;
  line-height: 1.35;
}/* @canonical-block:004442 */

/* Premium Auth Card & Apple Segmented Toggle */
.p6-auth-form-card {
  width: min(100%, 460px);
  padding: 34px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--surface);
  box-shadow: 0 24px 60px -12px rgba(40, 34, 28, 0.12), 0 2px 6px rgba(0, 0, 0, 0.03);
}/* @canonical-block:004443 */

.p6-auth-portal-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  padding: 4px;
  margin-bottom: 22px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-2);
}/* @canonical-block:004444 */

.p6-auth-portal-tabs a {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--ink-3);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: all var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004446 */

.p6-auth-message-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}/* @canonical-block:004447 */

.p6-auth-switch-tab-btn {
  align-self: flex-start;
  margin-top: 4px;
  padding: 6px 12px;
  border: 1px solid var(--border-gold);
  border-radius: 9px;
  background: var(--surface);
  color: var(--gold-hi);
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: background-color var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004448 */

.p6-auth-switch-tab-btn:hover {
  background: var(--gold-dim);
}/* @canonical-block:004449 */

.p6-auth-input {
  border-radius: 14px;
  transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004450 */

.p6-auth-input:focus-within {
  border-color: var(--gold-hi);
  box-shadow: 0 0 0 3px var(--gold-dim);
}/* @canonical-block:004451 */

.p6-auth-submit {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-hi) 100%);
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  border-radius: 14px;
  box-shadow: 0 6px 20px rgba(169, 129, 47, 0.35);
  transition: transform var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004452 */

.p6-auth-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(169, 129, 47, 0.45);
}