/* Yenomi ID — Corporate panel: public-site light theme alignment
 * The authenticated workspace shares the logged-out/public visual language:
 * warm light canvas, white surfaces, restrained gold accents and soft elevation.
 * Dark surfaces remain reserved for product/card previews only.
 */
.p10-corporate-platform {
  --cp-bg: var(--void);
  --cp-surface: var(--surface);
  --cp-surface-2: var(--surface-2);
  --cp-surface-3: var(--surface-3);
  --cp-line: var(--border);
  --cp-line-strong: var(--border-strong);
  --cp-text: var(--ink);
  --cp-text-2: var(--ink-2);
  --cp-text-3: var(--ink-3);
  --cp-gold: var(--gold);
  --cp-gold-hi: var(--gold-hi);
  --cp-green: var(--green);
  background: var(--background);
  color: var(--text-primary);
}/* @canonical-block:003105 */

.p10-corporate-platform::before {
  display: none;
}/* @canonical-block:003106 */

.p10-corporate-platform .enterprise-sidebar {
