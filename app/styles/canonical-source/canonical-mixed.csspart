.yi-brand-marquee__track {
  animation-duration: 96s;
}/* @canonical-block:003735 */

/* NFC specimen: ISO ID-1 / kartvizit (85.60 × 53.98 mm), matte black foil. */
.yi-product-ui--card-foil {
  width: 100%;
  height: auto;
  aspect-ratio: 85.6 / 53.98;
  display: grid;
  place-items: center;
  align-self: center;
  padding: clamp(12px, 6%, 20px) clamp(12px, 5%, 18px);
  color: #d7c09a;
  border-radius: 16px;
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(215, 192, 154, .18), transparent 52%),
    linear-gradient(180deg, #1a1a1a 0%, #0e0e0e 48%, #070707 100%);
  box-shadow: 0 28px 48px rgba(8, 6, 4, .36), inset 0 1px 0 rgba(215, 192, 154, .28), inset 0 0 0 1px rgba(255, 255, 255, .04);
}/* @canonical-block:003736 */
.yi-product-ui--card-foil:after {
  background: linear-gradient(118deg, transparent 38%, rgba(215, 192, 154, .12) 50%, transparent 62%);
}/* @canonical-block:003737 */
.yi-card-face {
  width: 100%;
  min-height: 0;
  display: grid;
  grid-template-rows: 1fr auto;
  align-items: center;
  justify-items: center;
  text-align: center;
  gap: 8px;
}/* @canonical-block:003738 */
.yi-card-identity {
  display: grid;
  gap: 8px;
  justify-items: center;
}/* @canonical-block:003739 */
.yi-card-identity strong {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(12px, 2.2vw, 17px);
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}/* @canonical-block:003740 */
.yi-card-role {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #cbb48a;
  font: 600 8px/1 var(--font-mono);
  letter-spacing: .22em;
  text-transform: uppercase;
}/* @canonical-block:003741 */
.yi-card-role::before,
.yi-card-role::after {
  content: "";
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: .4;
}/* @canonical-block:003742 */
.yi-card-identity b {
  font: 700 clamp(10px, 1.6vw, 12px)/1.1 var(--font-display);
  letter-spacing: .2em;
  text-transform: uppercase;
}/* @canonical-block:003743 */
.yi-card-nfc-mark {
  display: grid;
  justify-items: center;
  gap: 4px;
  color: #d7c09a;
}/* @canonical-block:003744 */
.yi-card-nfc-mark .yi-icon {
  width: 22px;
  height: 22px;
  min-width: 22px;
}/* @canonical-block:003745 */
.yi-card-nfc-mark small {
  font: 700 7px/1 var(--font-mono);
  letter-spacing: .28em;
}/* @canonical-block:003746 */
.yi-card-face--back {
  grid-template-rows: auto 1fr;
  gap: 8px;
}/* @canonical-block:003747 */
.yi-card-motto {
  margin: 0;
  max-width: 24ch;
  font-family: var(--font-display);
  font-size: clamp(10px, 1.5vw, 13px);
  font-style: italic;
  letter-spacing: .01em;
  line-height: 1.35;
}/* @canonical-block:003748 */
.yi-card-qr {
  width: min(38%, 88px);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  padding: 8px;
  border: 1px solid rgba(215, 192, 154, .38);
  color: #d7c09a;
}/* @canonical-block:003749 */
.yi-card-qr .yi-icon {
  width: 100%;
  height: 100%;
  min-width: 0;
}/* @canonical-block:003750 */
.yi-product-ui--compact.yi-product-ui--card-foil {
  padding: 14px 12px 12px;
}/* @canonical-block:003751 */
.yi-product-ui--compact .yi-card-identity strong {
  font-size: 11px;
  letter-spacing: .12em;
}/* @canonical-block:003752 */
.yi-product-ui--compact .yi-card-nfc-mark .yi-icon {
  width: 16px;
  height: 16px;
  min-width: 16px;
}/* @canonical-block:003753 */

.yi-product-visual--pair {
  min-height: 0;
  aspect-ratio: 2.15 / 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  justify-items: stretch;
  gap: 6%;
  padding: 7% 6%;
  background:
    radial-gradient(70% 55% at 50% 42%, rgba(215, 192, 154, .1), transparent 72%),
    linear-gradient(160deg, #1c1814, #0b0a09);
}/* @canonical-block:003754 */
.yi-product-visual--pair .yi-product-ui--card-foil {
  width: 100%;
  height: auto;
}/* @canonical-block:003755 */
.yi-product-visual--pair .yi-orbit {
  opacity: .28;
}/* @canonical-block:003756 */
.yi-product-visual--pair .yi-product-ui--card-front {
  transform: rotate(-7deg);
}/* @canonical-block:003757 */
.yi-product-visual--pair .yi-product-ui--card-back {
  transform: rotate(7deg);
}/* @canonical-block:003758 */

.products-single-visual .yi-product-visual--pair,
.nfc-product-hero__visual .yi-product-visual--pair {
  width: min(100%, 720px);
  max-height: none;
  aspect-ratio: 2.15 / 1;
  border-radius: 28px;
  filter: drop-shadow(0 30px 55px rgba(28, 20, 34, .16));
}/* @canonical-block:003759 */

.yi-product-ui--compact .yi-card-qr {
  width: min(40%, 56px);
  padding: 5px;
}/* @canonical-block:003760 */

@media (max-width: 700px) {
  .yi-product-visual--pair,
  .products-single-visual .yi-product-visual--pair,
  .nfc-product-hero__visual .yi-product-visual--pair {
    grid-template-columns: 1fr;
    aspect-ratio: auto;
    gap: 18px;
    padding: 22px 18px;
  }
  .yi-product-visual--pair .yi-product-ui--card-front,
  .yi-product-visual--pair .yi-product-ui--card-back {
    transform: none;
  }
}/* @canonical-block:003761 */

/* Digital card specimen: cream/gold live profile, generic identity, no personal portrait. */
.yi-product-ui--profile {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f5ef;
  border-color: #1A1918;
}/* @canonical-block:003762 */
.yi-profile-cover {
  position: relative;
  flex: 0 0 32%;
  min-height: 108px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12px 12px 36px;
  color: #f3e6c8;
  background:
    radial-gradient(ellipse 58% 72% at 50% 38%, rgba(232, 212, 168, .42), transparent 64%),
    linear-gradient(165deg, #3a3124 0%, #1c1812 48%, #12100c 100%);
  font: 700 8px/1 var(--font-mono);
  letter-spacing: .12em;
}/* @canonical-block:003763 */
.yi-profile-cover b {
  color: #d7c09a;
}/* @canonical-block:003764 */
.yi-profile-portrait {
  position: absolute;
  inset: 18px 0 10px;
  display: grid;
  place-items: center;
  pointer-events: none;
}/* @canonical-block:003765 */
.yi-profile-portrait em {
  width: min(46%, 86px);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 28%, #f6ead0, #d7c09a 42%, #A37B2C 78%);
  color: #17120c;
  font: 800 clamp(16px, 4.2vw, 24px)/1 var(--font-display);
  font-style: normal;
  letter-spacing: .08em;
  box-shadow: 0 10px 22px rgba(12, 8, 4, .28);
}/* @canonical-block:003766 */
.yi-profile-body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 6px;
  margin: -22px 8px 8px;
  padding: 14px 11px 10px;
  overflow: hidden;
  border: 1px solid rgba(163, 123, 44, .22);
  border-radius: 18px;
  background: #fbfaf7;
  box-shadow: 0 12px 24px rgba(23, 18, 12, .08);
  color: #1A1918;
  font-family: var(--font-ui);
}/* @canonical-block:003767 */
.yi-profile-body strong {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 750;
  letter-spacing: -.02em;
}/* @canonical-block:003768 */
.yi-profile-body > span {
  color: #6b655d;
  font-size: 10px;
  font-weight: 600;
}/* @canonical-block:003769 */
.yi-profile-bio {
  margin: 2px 0 0;
  color: #5f5a55;
  font: 400 10px/1.45 var(--font-ui);
}/* @canonical-block:003770 */
.yi-profile-cta-row {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 6px;
  margin-top: 4px;
}/* @canonical-block:003771 */
.yi-profile-save {
  min-height: 32px;
  margin-top: 0;
  display: grid;
  place-items: center;
  padding: 0 8px;
  border-radius: 999px;
  background: #A37B2C;
  color: #17120c;
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 750;
}/* @canonical-block:003772 */
.yi-profile-ghost {
  min-height: 32px;
  display: grid;
  place-items: center;
  padding: 0 8px;
  border: 1px solid rgba(26, 25, 24, .16);
  border-radius: 999px;
  background: transparent;
  color: #1A1918;
  font-size: 10px;
  font-weight: 700;
}/* @canonical-block:003773 */
.yi-profile-chips {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  margin-top: 2px;
}/* @canonical-block:003774 */
.yi-profile-chips > div {
  min-width: 0;
  padding: 7px 6px;
  border: 1px solid rgba(163, 123, 44, .2);
  border-radius: 10px;
  background: #fff;
}/* @canonical-block:003775 */
.yi-profile-chips small {
  display: block;
  color: #8a6a26;
  font: 700 7px/1.2 var(--font-ui);
  letter-spacing: .1em;
  text-transform: uppercase;
}/* @canonical-block:003776 */
.yi-profile-chips b {
  display: block;
  margin-top: 3px;
  color: #1A1918;
  font: 700 9px/1.2 var(--font-ui);
}/* @canonical-block:003777 */
.yi-profile-actions {
