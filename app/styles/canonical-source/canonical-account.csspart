  line-height: 1.55;
}/* @canonical-block:004013 */
.p9-settings-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(260px, .85fr);
  gap: 16px;
  align-items: start;
}/* @canonical-block:004014 */
