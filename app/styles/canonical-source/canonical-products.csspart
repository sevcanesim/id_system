/* --------------------------- How it works --------------------------------- */

/* Critical fix: the old desktop media query re-enabled overflow:hidden and
   trapped the document. The page must always be a normal scrolling document. */
html:has(.how-it-works-page),
body:has(.how-it-works-page) {
  overflow-x: clip;
  overflow-y: auto;
}/* @canonical-block:002865 */

.how-it-works-page {
  height: auto;
  min-height: 0;
  display: block;
  overflow: visible;
}/* @canonical-block:002866 */

.how-hero {
  min-height: 280px;
  height: auto;
  padding: clamp(56px, 7vw, 78px) 0 48px;
}/* @canonical-block:002867 */

.how-hero-inner {
  width: min(calc(100% - 48px), var(--wide));
  padding: 0;
}/* @canonical-block:002868 */

.how-hero h1 {
  font-family: var(--font-display);
  font-size: clamp(42px, 5vw, 64px);
  line-height: 1;
  letter-spacing: -.05em;
  text-wrap: balance;
}/* @canonical-block:002869 */

.how-hero p {
  max-width: 60ch;
  margin-inline: auto;
  font-family: var(--font-ui);
  font-size: 17px;
  line-height: 1.6;
}/* @canonical-block:002870 */

.how-steps {
  width: min(calc(100% - 48px), var(--wide));
  padding: 56px 0 28px;
}/* @canonical-block:002871 */

.how-step-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: stretch;
  gap: 16px;
}/* @canonical-block:002872 */

.how-step-card {
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: grid;
  grid-template-rows: auto auto auto minmax(230px, 1fr) auto;
  padding: 20px;
  overflow: hidden;
}/* @canonical-block:002873 */

.how-step-card h3 {
  min-width: 0;
  font-family: var(--font-display);
  font-size: 22px;
  line-height: 1.08;
  text-wrap: balance;
}/* @canonical-block:002874 */

.how-step-card > p {
  min-height: 0;
  font-family: var(--font-ui);
  font-size: 14px;
  line-height: 1.58;
}/* @canonical-block:002875 */

.how-step-visual {
  width: calc(100% + 40px);
  min-width: 0;
  min-height: 230px;
  height: auto;
  margin: 18px -20px -20px;
  align-self: stretch;
  display: grid;
  place-items: center;
  overflow: hidden;
}/* @canonical-block:002877 */

.how-step-visual--02 {
  height: 230px;
  min-height: 230px;
  place-items: end center;
}/* @canonical-block:002880 */

.how-dashboard {
  width: min(calc(100% - 24px), 300px);
  min-height: 170px;
  height: auto;
  aspect-ratio: 1.35;
  margin: auto;
  align-self: center;
}/* @canonical-block:002881 */

.how-step-arrow {
  position: absolute;
  right: 14px;
  bottom: 14px;
  width: 40px;
  height: 40px;
}/* @canonical-block:002882 */

.how-benefits {
  width: min(calc(100% - 48px), var(--wide));
  margin: 20px auto 72px;
}/* @canonical-block:002883 */

.how-benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: stretch;
}/* @canonical-block:002884 */

.how-benefits-grid article {
  min-width: 0;
  min-height: 0;
  height: 100%;
  padding: 22px 24px;
}/* @canonical-block:002885 */

.how-benefits-grid h3 {
  font-family: var(--font-display);
}/* @canonical-block:002930 */

/* Override the legacy desktop scroll-lock block for How It Works. */
@media (min-width: 900px) and (min-height: 760px) {
  html:has(.how-it-works-page),
  body:has(.how-it-works-page) {
    overflow-x: clip;
    overflow-y: auto;
  }

  .how-it-works-page {
    height: auto;
    min-height: 0;
    display: block;
    overflow: visible;
  }
}/* @canonical-block:002944 */

/* NFC PRODUCT SURFACE — aligned to the public Vercel product narrative */
