}/* @canonical-block:004376 */

/* Public hamburger: sticky chrome must not become a containing block for
   the drawer overlay, and the toggle stays above the open panel. */
.public-site-chrome {
  transform: none;
}/* @canonical-block:004377 */
.public-site-chrome .yi-menu {
  pointer-events: auto;
}/* @canonical-block:004378 */

.yi-footer__product {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 14px;
}/* @canonical-block:004379 */
.yi-footer__product a {
  color: #71695f;
  font-family: var(--font-ui);
  font-size: 12px;
  text-decoration: none;
