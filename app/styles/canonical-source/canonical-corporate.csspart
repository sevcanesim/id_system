  .p10-domain-panel > header > select { width:100%; }
  .p10-metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .p10-card-list > article { grid-template-columns: minmax(0,1fr) auto; }
  .p10-card-list > article > button,
  .p10-card-list > article > i { grid-column: 1 / -1; justify-self: start; }
  .p10-ranking > div { grid-template-columns: 24px minmax(0,1fr); }
  .p10-ranking > div > small { grid-column:2; }
}/* @canonical-block:002121 */


/* V32-CORPORATE-DOMAIN-UX
   Shared presentation contract for Employees / Licenses / Content / Drawers.
   No data or business-rule changes. */
.corp-domain-stack{display:grid;gap:24px}/* @canonical-block:002122 */
.corp-domain-header{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;min-width:0}/* @canonical-block:002123 */
.corp-domain-header__copy{min-width:0;display:grid;gap:6px}/* @canonical-block:002124 */
.corp-domain-header__title{margin:0;line-height:1.1}/* @canonical-block:002125 */
.corp-domain-header__description{margin:0;max-width:72ch;line-height:1.55}/* @canonical-block:002126 */
.corp-domain-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}/* @canonical-block:002127 */
.corp-metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}/* @canonical-block:002128 */
.corp-metric-card{min-width:0;min-height:118px;padding:18px;display:grid;align-content:space-between;gap:12px}/* @canonical-block:002129 */
.corp-metric-card__label{line-height:1.35;overflow-wrap:anywhere}/* @canonical-block:002130 */
.corp-metric-card__value{font-variant-numeric:tabular-nums;overflow-wrap:anywhere}/* @canonical-block:002131 */
.corp-data-surface{min-width:0;overflow:hidden}/* @canonical-block:002132 */
.corp-data-row{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(120px,.7fr) minmax(150px,.8fr) auto;align-items:center;gap:16px;min-height:68px;padding:12px 16px}/* @canonical-block:002133 */
.corp-data-row + .corp-data-row{border-top:1px solid var(--border-glass)}/* @canonical-block:002134 */
.corp-data-main{min-width:0;display:grid;gap:4px}/* @canonical-block:002135 */
.corp-data-main strong,.corp-data-main span{display:block;overflow-wrap:anywhere}/* @canonical-block:002136 */
.corp-data-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}/* @canonical-block:002137 */
.corp-drawer{width:min(560px,100vw);max-height:100dvh;overflow:auto}/* @canonical-block:002138 */
.corp-drawer__header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}/* @canonical-block:002139 */
.corp-drawer__body{display:grid;gap:20px}/* @canonical-block:002140 */
.corp-section{display:grid;gap:12px}/* @canonical-block:002141 */
.corp-section__heading{display:grid;gap:4px}/* @canonical-block:002142 */
.corp-section__heading strong,.corp-section__heading span{display:block}/* @canonical-block:002143 */
.corp-field-stack{display:grid;gap:6px}/* @canonical-block:002144 */
.corp-field-stack label{display:block;line-height:1.35}/* @canonical-block:002145 */
.corp-field-stack input,.corp-field-stack select,.corp-field-stack textarea{min-width:0}/* @canonical-block:002146 */
.corp-inline-status{display:inline-flex;align-items:center;gap:6px;max-width:100%;overflow-wrap:anywhere}/* @canonical-block:002147 */
.corp-empty,.corp-error{min-height:220px;display:grid;place-items:center;text-align:center;padding:32px}/* @canonical-block:002148 */
@media (max-width:1099px){
  .corp-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .corp-domain-header{align-items:flex-start;flex-direction:column}
  .corp-domain-actions{width:100%}
}/* @canonical-block:002149 */
@media (max-width:759px){
  .corp-domain-stack{gap:18px}
  .corp-metric-grid{grid-template-columns:1fr}
  .corp-domain-actions>*{width:100%}
  .corp-data-row{grid-template-columns:1fr;gap:10px;padding:16px}
  .corp-data-actions{justify-content:flex-start}
  .corp-empty,.corp-error{min-height:180px;padding:24px 16px}
}/* @canonical-block:002150 */
@media (prefers-reduced-motion:reduce){
  .corp-domain-stack *,.corp-domain-stack *::before,.corp-domain-stack *::after{scroll-behavior:auto;animation-duration:.001ms;animation-iteration-count:1;transition-duration:.001ms}
}/* @canonical-block:002530 */
.corporate-pricing-grid article strong { font-size: 24px; }/* @canonical-block:002621 */
.corp-logo-lockup { display:flex; align-items:center; gap:10px; min-width:0; }/* @canonical-block:002622 */
.corp-logo-lockup img { width:32px; height:32px; border-radius:9px; object-fit:cover; }/* @canonical-block:002623 */
.corp-logo-symbol { width:32px; height:32px; display:grid; place-items:center; border-radius:9px; background:var(--gold-dim); border:1px solid var(--border-gold); color:var(--gold-hi); font:800 13px var(--font-mono); }/* @canonical-block:002624 */
.corp-logo-lockup strong { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink); font-size:14px; }/* @canonical-block:002625 */

.corp-main-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin:20px 0; }/* @canonical-block:002626 */
.corp-main-actions a { min-height:56px; display:grid; place-items:center; gap:5px; padding:8px 6px; border-radius:12px; font-size:11px; font-weight:750; text-align:center; transition:transform var(--motion-standard) var(--ease-standard),border-color var(--motion-standard) var(--ease-standard),background var(--motion-standard) var(--ease-standard); }/* @canonical-block:002627 */
.corp-main-actions a:hover { transform:translateY(-1px); }/* @canonical-block:002629 */
.corp-main-actions-dark a { border:1px solid var(--border-gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:002630 */
.corp-main-actions-dark a:hover { background:var(--gold); color:#17120c; }/* @canonical-block:002631 */
.corp-main-actions-outline a { border:1px solid var(--border); background:var(--surface); color:var(--ink-2); }/* @canonical-block:002632 */
.corp-main-actions-outline a:hover { border-color:var(--gold); color:var(--gold-hi); }/* @canonical-block:002633 */
.corp-main-actions-executive a { border:1px solid rgba(212,180,131,.4); background:rgba(212,180,131,.08); color:var(--gold-hi); }/* @canonical-block:002634 */
.corp-main-actions-executive a:hover { background:var(--gold); color:#17120c; }/* @canonical-block:002635 */

.corp-social-strip,.corp-professional-socials,.corp-executive-socials { display:flex; flex-wrap:wrap; gap:7px; margin:14px 0 22px; }/* @canonical-block:002636 */
.corp-social-strip a,.corp-professional-socials a,.corp-executive-socials a { min-height:36px; display:inline-flex; align-items:center; gap:7px; padding:0 12px; border:1px solid var(--border); border-radius:999px; background:var(--surface); color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:002637 */
.corp-social-strip a:hover,.corp-professional-socials a:hover,.corp-executive-socials a:hover { border-color:var(--gold); color:var(--gold-hi); }/* @canonical-block:002639 */

.corp-info-section,.corp-professional-contact,.corp-executive-info,.corp-professional-company,.corp-executive-resources,.corp-professional-expertise { margin-top:26px; }/* @canonical-block:002640 */
.corp-info-section h2,.corp-professional-contact h2,.corp-executive-info h2,.corp-professional-company h2,.corp-executive-resources h2,.corp-professional-expertise h2 { margin:0 0 10px; color:var(--ink); font-size:12px; letter-spacing:.13em; text-transform:uppercase; }/* @canonical-block:002641 */
.corp-about-section p { margin:0; color:var(--ink-2); font-size:14px; line-height:1.7; }/* @canonical-block:002642 */

.corp-contact-table,.corp-executive-info,.corp-professional-contact > div { display:grid; gap:7px; }/* @canonical-block:002643 */
.corp-contact-table a,.corp-professional-contact > div a,.corp-executive-info a,.corp-resource-section a,.corp-company-grid a,.corp-executive-resources > div a {
  display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:11px;
  min-height:58px; padding:10px 12px; border:1px solid var(--border); border-radius:13px;
  background:var(--surface); transition:border-color var(--motion-standard) var(--ease-standard),transform var(--motion-standard) var(--ease-standard);
}/* @canonical-block:002644 */
.corp-executive-resources > div a,.corp-executive-info a { grid-template-columns:auto minmax(0,1fr); }/* @canonical-block:002645 */
.corp-contact-table a:hover,.corp-professional-contact > div a:hover,.corp-executive-info a:hover,
.corp-resource-section a:hover,.corp-company-grid a:hover { border-color:var(--gold); transform:translateY(-1px); }/* @canonical-block:002647 */

