.corp-card-footer { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:30px; padding-top:16px; border-top:1px solid var(--border); color:var(--ink-3); font-size:11px; }/* @canonical-block:002659 */
.corp-card-footer b { color:var(--gold-hi); font-weight:800; }/* @canonical-block:002660 */

.corp-employee-badge { display:inline-flex; align-items:center; gap:6px; margin-top:8px; padding:5px 10px; border:1px solid var(--border-gold); border-radius:999px; background:var(--gold-dim); color:var(--gold-hi); font-size:11px; font-weight:800; }/* @canonical-block:002662 */

.corp-menu-dot { color:var(--ink-3); font-size:16px; letter-spacing:2px; }/* @canonical-block:002663 */

/* ---- ESSENTIAL: koyu, sade premium kart ---- */
.corp-essential-card { padding:clamp(22px,5vw,32px); border-radius:28px; background:var(--ink); color:var(--surface); box-shadow:var(--shadow); }/* @canonical-block:002664 */
.corp-essential-card h1,.corp-essential-card h2 { color:#fff; }/* @canonical-block:002665 */
.corp-essential-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:26px; }/* @canonical-block:002666 */
.corp-essential-header strong { color:#fff; }/* @canonical-block:002667 */
.corp-essential-identity { display:flex; align-items:center; gap:16px; margin-bottom:8px; }/* @canonical-block:002668 */
.corp-essential-avatar,.corporate-avatar-fallback { width:76px; height:76px; min-width:76px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,.14); }/* @canonical-block:002669 */
.corp-essential-avatar.corporate-avatar-fallback,.corp-professional-avatar.corporate-avatar-fallback,.corp-executive-avatar.corporate-avatar-fallback { display:grid; place-items:center; background:var(--gold-dim); color:var(--gold-hi); font:800 22px var(--font-mono); }/* @canonical-block:002670 */
.corp-essential-identity h1 { margin:0; font-size:22px; }/* @canonical-block:002671 */
.corp-essential-identity p { margin:4px 0 0; color:rgba(255,255,255,.66); font-size:14px; font-weight:600; }/* @canonical-block:002672 */
.corp-essential-identity small { display:block; margin-top:2px; color:rgba(255,255,255,.4); font-size:12px; }/* @canonical-block:002673 */
.corp-essential-card .corp-info-section,.corp-essential-card .corp-resource-section { border-top:1px solid rgba(255,255,255,.1); padding-top:20px; }/* @canonical-block:002674 */
.corp-essential-card .corp-contact-table a,.corp-essential-card .corp-resource-section a { background:rgba(255,255,255,.04); border-color:rgba(255,255,255,.1); }/* @canonical-block:002675 */
.corp-essential-card .corp-contact-table b,.corp-essential-card .corp-resource-section b { color:#fff; }/* @canonical-block:002676 */
.corp-essential-card .corp-card-footer { border-top-color:rgba(255,255,255,.1); color:rgba(255,255,255,.4); }/* @canonical-block:002677 */

/* ---- PROFESSIONAL: açık zemin, outline vurgulu ---- */
.corp-professional-card { position:relative; padding:clamp(22px,5vw,32px); border-radius:28px; background:var(--surface); border:1px solid var(--border); box-shadow:var(--shadow-soft); overflow:hidden; }/* @canonical-block:002678 */
.corp-professional-pattern { position:absolute; inset:0 0 auto 0; height:120px; background:linear-gradient(160deg,var(--gold-dim),transparent 70%); pointer-events:none; }/* @canonical-block:002679 */
.corp-professional-header { position:relative; display:flex; align-items:center; justify-content:space-between; margin-bottom:22px; }/* @canonical-block:002680 */
.corp-professional-hero { position:relative; display:flex; align-items:center; gap:16px; margin-bottom:8px; }/* @canonical-block:002681 */
.corp-professional-avatar { width:84px; height:84px; min-width:84px; border-radius:20px; object-fit:cover; border:3px solid #fff; box-shadow:var(--shadow-soft); }/* @canonical-block:002682 */
.corp-professional-copy h1 { margin:0; font-size:23px; }/* @canonical-block:002683 */
.corp-professional-copy p { margin:4px 0 0; color:var(--ink-2); font-size:14px; font-weight:600; }/* @canonical-block:002684 */
.corp-professional-copy small,.corp-professional-copy span { display:flex; align-items:center; gap:5px; margin-top:4px; color:var(--ink-3); font-size:12px; }/* @canonical-block:002686 */

/* ---- EXECUTIVE: koyu, altın vurgulu, en üst seviye ---- */
.corp-executive-card { position:relative; padding:clamp(24px,5vw,36px); border-radius:30px; background:linear-gradient(160deg,#120d1c,#0a0612); color:#fff; box-shadow:0 26px 80px rgba(0,0,0,.4); overflow:hidden; }/* @canonical-block:002687 */
.corp-executive-card h1,.corp-executive-card h2 { color:#fff; }/* @canonical-block:002688 */
.corp-executive-network { position:absolute; inset:-30% -20% auto auto; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle,rgba(212,180,131,.16),transparent 70%); pointer-events:none; }/* @canonical-block:002689 */
.corp-executive-header { position:relative; display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }/* @canonical-block:002690 */
.corp-executive-header strong { color:#fff; }/* @canonical-block:002691 */
.corp-executive-hero { position:relative; display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:8px; }/* @canonical-block:002692 */
.corp-executive-identity { display:flex; align-items:center; gap:16px; min-width:0; }/* @canonical-block:002693 */
.corp-executive-avatar { width:80px; height:80px; min-width:80px; border-radius:50%; object-fit:cover; border:3px solid rgba(212,180,131,.4); }/* @canonical-block:002694 */
.corp-executive-kicker { display:block; color:var(--gold-hi); font:800 10px var(--font-mono); letter-spacing:.16em; }/* @canonical-block:002695 */
.corp-executive-identity h1 { margin:4px 0 0; font-size:22px; }/* @canonical-block:002696 */
.corp-executive-identity p { margin:4px 0 0; color:rgba(255,255,255,.66); font-size:14px; font-weight:600; }/* @canonical-block:002697 */
.corp-executive-identity small { display:block; margin-top:2px; color:rgba(255,255,255,.4); font-size:12px; }/* @canonical-block:002698 */
.corp-executive-qr { display:grid; justify-items:center; gap:6px; }/* @canonical-block:002699 */
.corp-executive-qr > div { width:64px; height:64px; display:grid; place-items:center; border-radius:12px; background:#fff; padding:6px; }/* @canonical-block:002700 */
.corp-executive-qr img { width:100%; height:100%; }/* @canonical-block:002701 */
.corp-executive-qr span { color:rgba(255,255,255,.4); font-size:11px; letter-spacing:.06em; }/* @canonical-block:002702 */
.corp-executive-card .corp-info-section,.corp-executive-card .corp-executive-resources { border-top:1px solid rgba(255,255,255,.1); padding-top:20px; }/* @canonical-block:002703 */
.corp-executive-card .corp-executive-info a,.corp-executive-card .corp-executive-resources a { background:rgba(255,255,255,.04); border-color:rgba(255,255,255,.1); }/* @canonical-block:002704 */
.corp-executive-card .corp-executive-info b,.corp-executive-card .corp-executive-resources b { color:#fff; }/* @canonical-block:002705 */
.corp-executive-footer { border-top-color:rgba(255,255,255,.1); color:rgba(255,255,255,.4); }/* @canonical-block:002706 */

@media (max-width:520px) {
  .corp-essential-card,.corp-professional-card,.corp-executive-card { border-radius:0; }
  .corp-main-actions { grid-template-columns:repeat(3,minmax(0,1fr)); }
}/* @canonical-block:002791 */

/* Corporate: keep the dashboard and capability cards inside their columns */
.corporate-single-page { min-height: 100vh; }/* @canonical-block:002792 */
.corporate-single-hero {
  min-height: 0;
  padding: clamp(64px, 7vw, 88px) 0 48px;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  gap: clamp(32px, 5vw, 72px);
}/* @canonical-block:002793 */
.corporate-single-copy h1 {
  font-size: clamp(42px, 4.8vw, 66px);
  line-height: .99;
  letter-spacing: -.04em;
}/* @canonical-block:002794 */
.corporate-single-copy > p { font-size: 16px; line-height: 1.65; }/* @canonical-block:002795 */
.corporate-single-proof { gap: 10px; }/* @canonical-block:002796 */
.corporate-single-proof div { min-width: 0; min-height: 68px; padding: 12px 14px; }/* @canonical-block:002797 */
.corporate-single-proof strong { font-size: 14px; }/* @canonical-block:002798 */
.corporate-single-proof span { font-size: 12px; line-height: 1.35; }/* @canonical-block:002799 */
.corporate-dashboard-stage { min-height: 430px; }/* @canonical-block:002800 */
.corporate-dashboard-window {
  width: min(100%, 720px);
  transform: perspective(1600px) rotateY(-2deg) rotateX(1deg);
}/* @canonical-block:002801 */
.corporate-dashboard-body { min-height: 360px; }/* @canonical-block:002802 */
.corporate-capability-bar {
  margin-bottom: 24px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}/* @canonical-block:002803 */
.corporate-capability-bar article {
  min-width: 0;
  padding: 20px;
  align-items: flex-start;
}/* @canonical-block:002804 */
.corporate-capability-bar h2 {
  margin: 0 0 5px;
  font-size: clamp(17px, 1.65vw, 21px);
  line-height: 1.08;
  letter-spacing: -.03em;
}/* @canonical-block:002805 */
.corporate-capability-bar p {
  font-size: 13px;
  line-height: 1.45;
}/* @canonical-block:002806 */
.corporate-single-cta {
  padding: 26px 28px;
}/* @canonical-block:002807 */
.corporate-single-cta h2 { font-size: 22px; }/* @canonical-block:002808 */
.corporate-single-cta p { font-size: 14px; }/* @canonical-block:002809 */
.corporate-single-details { padding-top: 88px; }/* @canonical-block:002882 */

/* ----------------------------- Corporate --------------------------------- */

.corporate-single-hero {
  width: min(calc(100% - 48px), var(--wide));
  min-height: clamp(480px, calc(100svh - 190px), 610px);
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  gap: clamp(28px, 4vw, 56px);
  padding: 42px 0 28px;
}/* @canonical-block:002883 */

.corporate-single-copy {
  min-width: 0;
}/* @canonical-block:002884 */

.corporate-single-copy h1 {
  max-width: 12ch;
  font-family: var(--font-display);
  font-size: clamp(44px, 4.6vw, 66px);
  line-height: .98;
  letter-spacing: -.052em;
  text-wrap: balance;
}/* @canonical-block:002885 */

.corporate-single-copy > p {
  max-width: 56ch;
  font-family: var(--font-ui);
  font-size: 16px;
  line-height: 1.65;
}/* @canonical-block:002886 */

.corporate-single-proof {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
}/* @canonical-block:002887 */

.corporate-single-proof div {
  min-width: 0;
  min-height: 0;
  height: 100%;
}/* @canonical-block:002888 */

.corporate-single-proof strong {
  font-family: var(--font-ui);
  font-variant-numeric: tabular-nums;
}/* @canonical-block:002889 */

.corporate-dashboard-stage {
  min-width: 0;
  min-height: 0;
  height: auto;
  aspect-ratio: 1.38 / 1;
}/* @canonical-block:002890 */

.corporate-dashboard-window {
  width: min(100%, 680px);
  max-width: 100%;
}/* @canonical-block:002891 */

.corporate-dashboard-content {
  min-width: 0;
}/* @canonical-block:002892 */

.corporate-dashboard-kpis,
.corporate-dashboard-grid {
  min-width: 0;
}/* @canonical-block:002893 */

.corporate-capability-bar {
  width: min(calc(100% - 48px), var(--wide));
  margin: 0 auto 24px;
}/* @canonical-block:002894 */

.corporate-capability-bar article {
  min-width: 0;
}/* @canonical-block:002895 */

.corporate-capability-bar h2 {
  font-family: var(--font-display);
  text-wrap: balance;
}/* @canonical-block:002896 */

.corporate-single-cta {
  width: min(calc(100% - 48px), var(--wide));
  min-width: 0;
  margin-inline: auto;
}/* @canonical-block:002897 */

.corporate-single-cta h2 {
  font-family: var(--font-display);
  font-size: clamp(22px, 2vw, 30px);
}/* @canonical-block:002898 */

.corporate-single-details {
  padding-top: clamp(72px, 8vw, 104px);
}/* @canonical-block:002899 */

.corporate-pricing-grid {
  align-items: stretch;
}/* @canonical-block:002900 */

.corporate-pricing-grid article {
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}/* @canonical-block:002901 */

.corporate-pricing-grid h3,
.corporate-section-heading h2,
.corporate-lead-copy h2 {
  font-family: var(--font-display);
}/* @canonical-block:002902 */

.corporate-pricing-grid p,
.corporate-pricing-grid li,
.corporate-lead-copy p,
.corporate-lead-copy li {
  font-family: var(--font-ui);
}/* @canonical-block:002903 */

.corporate-lead-section {
  min-width: 0;
}/* @canonical-block:002904 */

.corporate-lead-form {
  min-width: 0;
  position: relative;
}/* @canonical-block:002905 */

.corporate-lead-honeypot {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  border: 0;
  opacity: 0;
  pointer-events: none;
  clip-path: inset(50%);
  overflow: hidden;
  white-space: nowrap;
}/* @canonical-block:002906 */

.corporate-lead-form-grid {
  min-width: 0;
  align-items: start;
}/* @canonical-block:002907 */

.corporate-lead-form-grid > * {
  min-width: 0;
}/* @canonical-block:002908 */

.corporate-lead-form input,
.corporate-lead-form select,
.corporate-lead-form textarea {
  min-width: 0;
  width: 100%;
  font-family: var(--font-ui);
  font-size: 16px;
}/* @canonical-block:002909 */

.corporate-lead-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}/* @canonical-block:002910 */

.corporate-lead-note,
.corporate-lead-privacy {
  font-family: var(--font-ui);
}/* @canonical-block:003016 */

/* --------------------------------------------------------------------------
 * Corporate Panel — Premium Dark / Gold application shell
 * Phase 3 visual identity pass. Scoped to /kurumsal/panel only.
 * -------------------------------------------------------------------------- */
.p10-corporate-platform {
  --cp-bg: #0f0e0c;
  --cp-surface: #171512;
  --cp-surface-2: #1c1915;
  --cp-surface-3: #211d18;
  --cp-line: rgba(231, 204, 151, .13);
  --cp-line-strong: rgba(231, 204, 151, .24);
  --cp-text: #f5f0e6;
  --cp-text-2: #c7beb0;
  --cp-text-3: #8f887d;
  --cp-gold: #d4b483;
  --cp-gold-hi: #ebd19a;
  --cp-green: #78c995;
  position: relative;
  width: 100%;
  max-width: none;
  min-height: 100svh;
  margin: 0;
  padding: 0 0 64px;
  overflow: clip;
  background:
    radial-gradient(720px 520px at 72% -10%, rgba(212,180,131,.10), transparent 68%),
    radial-gradient(520px 420px at 100% 45%, rgba(212,180,131,.045), transparent 70%),
    var(--cp-bg);
  color: var(--cp-text);
}/* @canonical-block:003017 */

.p10-corporate-platform::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(to bottom, black, transparent 72%);
}/* @canonical-block:003018 */

.p10-corporate-platform .enterprise-dashboard-shell {
  position: relative;
  z-index: 1;
  grid-template-columns: 264px minmax(0, 1fr);
  min-height: 100svh;
}/* @canonical-block:003019 */

.p10-corporate-platform .enterprise-sidebar {
  position: sticky;
  top: 0;
  height: 100svh;
  padding: 20px 14px 16px;
  border-right: 1px solid var(--cp-line);
  background: linear-gradient(180deg, #12110f 0%, #0e0d0b 100%);
  box-shadow: 18px 0 50px rgba(0,0,0,.16);
}/* @canonical-block:003020 */

.p10-corporate-platform .enterprise-side-brand {
  min-height: 58px;
  margin-bottom: 14px;
  padding: 5px 9px 18px;
  border-bottom-color: var(--cp-line);
  color: var(--cp-text);
}/* @canonical-block:003021 */

.p10-corporate-platform .enterprise-yenomi-mark {
  width: 38px;
  height: 38px;
  border-color: var(--cp-line-strong);
  background: #0b0a08;
  box-shadow: 0 8px 24px rgba(0,0,0,.28);
}/* @canonical-block:003022 */

.p10-corporate-platform .enterprise-yenomi-copy strong { color: var(--cp-text); }/* @canonical-block:003023 */
.p10-corporate-platform .enterprise-yenomi-copy small { color: var(--cp-gold); }/* @canonical-block:003024 */

.p10-corporate-platform .enterprise-side-section-title {
  padding: 14px 10px 7px;
  color: #766f65;
  font-size: 11px;
}/* @canonical-block:003025 */

.p10-corporate-platform .enterprise-nav-entry {
  min-height: 43px;
  padding: 0 11px;
  border-color: transparent;
  border-radius: 11px;
  color: var(--cp-text-2);
  transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
}/* @canonical-block:003027 */
.p10-corporate-platform .enterprise-nav-entry:hover { background: rgba(255,255,255,.045); color: var(--cp-text); transform: translateX(1px); }/* @canonical-block:003030 */

.p10-corporate-platform .enterprise-side-links,
.p10-corporate-platform .enterprise-side-plan,
.p10-corporate-platform .enterprise-side-user { border-color: var(--cp-line); }/* @canonical-block:003031 */
.p10-corporate-platform .enterprise-side-links button,
.p10-corporate-platform .enterprise-side-links a {
  color: var(--cp-text-3);
  background: transparent;
  border: 0;
}/* @canonical-block:003032 */
.p10-corporate-platform .enterprise-side-links button:hover,
.p10-corporate-platform .enterprise-side-links a:hover { background: rgba(255,255,255,.04); color: var(--cp-text); }/* @canonical-block:003033 */
.p10-corporate-platform .enterprise-side-plan {
  margin-top: 12px;
  padding: 14px;
  border: 1px solid var(--cp-line);
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(212,180,131,.075), rgba(255,255,255,.018));
}/* @canonical-block:003034 */
.p10-corporate-platform .enterprise-side-plan small { color: var(--cp-gold); }/* @canonical-block:003035 */
.p10-corporate-platform .enterprise-side-plan strong { color: var(--cp-text-2); }/* @canonical-block:003036 */
.p10-corporate-platform .enterprise-plan-meter { background: rgba(255,255,255,.08); }/* @canonical-block:003037 */
.p10-corporate-platform .enterprise-plan-meter::before { background: linear-gradient(90deg, #8b6a34, var(--cp-gold)); }/* @canonical-block:003038 */
.p10-corporate-platform .enterprise-side-plan button {
  min-height: 34px;
  margin-top: 10px;
  padding: 0 11px;
  border: 1px solid var(--cp-line-strong);
  border-radius: 9px;
  background: rgba(212,180,131,.08);
  color: var(--cp-gold-hi);
  font-size: 11px;
  font-weight: 800;
}/* @canonical-block:003039 */
.p10-corporate-platform .enterprise-side-user {
  margin-top: 12px;
  padding-top: 12px;
}/* @canonical-block:003040 */
.p10-corporate-platform .enterprise-side-user > span {
  background: linear-gradient(145deg, #d9bd86, #8e6c35);
  color: #21190d;
  box-shadow: 0 8px 18px rgba(0,0,0,.24);
}/* @canonical-block:003041 */
.p10-corporate-platform .enterprise-side-user strong { color: var(--cp-text); }/* @canonical-block:003042 */
.p10-corporate-platform .enterprise-side-user small { color: var(--cp-text-3); }/* @canonical-block:003043 */
.p10-corporate-platform .enterprise-side-user b { color: var(--cp-gold); }/* @canonical-block:003044 */

.p10-corporate-platform .enterprise-dashboard-main {
  min-width: 0;
  background: transparent;
}/* @canonical-block:003045 */

.p10-corporate-platform .enterprise-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 82px;
  padding: 0 34px;
  border-bottom: 1px solid var(--cp-line);
  background: rgba(15,14,12,.88);
  backdrop-filter: blur(18px) saturate(120%);
}/* @canonical-block:003046 */
.p10-corporate-platform .enterprise-topbar h1 {
  margin: 0;
  color: var(--cp-text);
  font-size: 20px;
  letter-spacing: -.025em;
}/* @canonical-block:003047 */
.p10-corporate-platform .enterprise-topbar p {
  margin: 5px 0 0;
  color: var(--cp-text-3);
  font-size: 12px;
  line-height: 1.5;
}/* @canonical-block:003048 */
.p10-corporate-platform .enterprise-topbar-actions { align-items: center; gap: 14px; }/* @canonical-block:003049 */
.p10-corporate-platform .enterprise-quick-link {
  min-height: 38px;
  padding: 0 13px;
  border: 1px solid var(--cp-line-strong);
  border-radius: 9px;
  background: linear-gradient(145deg, rgba(212,180,131,.16), rgba(212,180,131,.055));
  color: var(--cp-gold-hi);
  font-size: 11px;
  font-weight: 850;
}/* @canonical-block:003050 */
.p10-corporate-platform .enterprise-quick-link:hover { background: rgba(212,180,131,.20); }/* @canonical-block:003051 */
.p10-corporate-platform .enterprise-topbar-account { color: var(--cp-text); }/* @canonical-block:003052 */
.p10-corporate-platform .enterprise-topbar-account > div { min-width: 0; display: grid; gap: 2px; }/* @canonical-block:003053 */
.p10-corporate-platform .enterprise-topbar-account strong { color: var(--cp-text); font-size: 12px; }/* @canonical-block:003054 */
.p10-corporate-platform .enterprise-topbar-account small { color: var(--cp-text-3); }/* @canonical-block:003055 */
.p10-corporate-platform .enterprise-org-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--cp-line-strong);
  border-radius: 10px;
  background: rgba(212,180,131,.08);
  color: var(--cp-gold);
}/* @canonical-block:003056 */
.p10-corporate-platform .enterprise-topbar-account select,
.p10-corporate-platform select {
  border-color: var(--cp-line-strong);
  background: #191612;
