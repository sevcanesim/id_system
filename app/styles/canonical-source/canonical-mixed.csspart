.p11-networking-actions button,
.p11-networking-form button:not(.ds-button),
.p11-networking-event button:not(.ds-button) { min-height:40px; padding:0 12px; border:1px solid var(--border-gold); border-radius:10px; background:var(--gold-dim); color:var(--ink); font-weight:750; }/* @canonical-block:001250 */

/* responsive corporate card editor */

@media (max-width: 1100px) {
  .p8-corporate-editor { grid-template-columns:1fr; }
  .p8-corporate-editor > .enterprise-sidebar { position:fixed; left:0; top:0; bottom:0; width:270px; z-index:90; transform:translateX(-105%); transition:transform var(--motion-standard) var(--ease-standard); box-shadow:var(--shadow); }
  .p8-corporate-editor > .enterprise-sidebar.is-mobile-open { transform:none; }
  .p8-corporate-editor .enterprise-sidebar-mobile-close { display:grid; place-items:center; align-self:flex-end; width:34px; height:34px; border:1px solid var(--border); border-radius:9px; background:transparent; color:var(--ink); }
  .p8-editor-grid { grid-template-columns:minmax(0,1fr); }
  .p8-preview-column { position:static; grid-row:1; }
  .p8-form { grid-row:2; }
  .p8-corporate-content { width:min(calc(100% - 32px),1180px); }
}/* @canonical-block:001256 */
