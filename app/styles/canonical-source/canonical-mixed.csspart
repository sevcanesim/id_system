  .corporate-single-cta-actions > * { flex: 1 1 160px; }
}/* @canonical-block:002820 */

h1, h2, h3, h4, h5, h6,
.yi-header,
.yi-footer,
.yi-btn,
.yi-hero__eyebrow,
.section-kicker,
.home-mockup__kicker,
.how-step-number,
.how-premium-badge {
  font-family: var(--font-ui);
}/* @canonical-block:002822 */

/* One sticky chrome layer. Nested sticky headers create visual jump/overlap
   during route transitions, so the public shell owns the sticky behavior. */
.public-site-chrome {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(251,250,247,.96);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}/* @canonical-block:002823 */

.public-site-chrome .yi-header {
  position: relative;
  top: auto;
  z-index: 1;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}/* @canonical-block:002836 */

.home-mockup__phone .yi-product-ui--profile {
  min-height: 0;
  aspect-ratio: 9 / 17.5;
}/* @canonical-block:002837 */

.home-mockup__card .yi-product-ui--card {
  aspect-ratio: 1.585 / 1;
}/* @canonical-block:002851 */

/* --------------------------- Product detail ------------------------------- */

.products-single-page,
.product-one-page {
  min-height: 0;
  height: auto;
  overflow: visible;
}/* @canonical-block:002852 */

.products-single-hero__inner,
.product-one-page__hero-inner {
  min-width: 0;
  align-items: center;
}/* @canonical-block:002853 */

.products-single-copy,
.product-one-page__copy {
  min-width: 0;
}/* @canonical-block:002854 */

.products-single-copy h2,
.product-one-page__copy h1 {
  font-family: var(--font-display);
  font-size: clamp(42px, 5vw, 68px);
  line-height: .98;
  text-wrap: balance;
}/* @canonical-block:002855 */

.products-single-copy > p,
.product-one-page__copy > p {
  max-width: 58ch;
  font-family: var(--font-ui);
  font-size: 17px;
  line-height: 1.68;
}/* @canonical-block:002856 */

.products-single-visual,
.product-one-page__visual {
  min-width: 0;
  width: 100%;
  height: auto;
  min-height: 0;
  display: grid;
  place-items: center;
}/* @canonical-block:002857 */

.products-single-visual .yi-product-visual,
.product-one-page__visual .yi-product-visual {
  width: 100%;
  max-width: 620px;
  aspect-ratio: 1.55 / 1;
  height: auto;
  max-height: none;
}/* @canonical-block:002876 */

.how-step-visual .yi-product-ui {
  width: min(92%, 330px);
  max-width: 330px;
  max-height: 100%;
}/* @canonical-block:002878 */

.how-step-visual--02 .yi-product-ui--profile {
  width: min(72%, 210px);
  min-height: 0;
  max-height: 100%;
  height: 100%;
  align-self: end;
}/* @canonical-block:002879 */

.how-step-visual--01 .yi-product-ui--card,
.how-step-visual--03 .yi-product-ui--card {
  width: min(96%, 330px);
}/* @canonical-block:002915 */

/* --------------------------- Product mockups -------------------------------- */

.yi-product-ui--card,
.yi-product-ui--profile,
.yi-product-ui--dashboard {
  contain: layout;
}/* @canonical-block:002916 */

.yi-product-ui--card {
  aspect-ratio: 1.585 / 1;
  min-height: 0;
  border-radius: 20px;
  padding: clamp(18px, 3%, 26px);
}/* @canonical-block:002917 */

.yi-card-brand {
  font-family: var(--font-mono);
  font-size: 10px;
}/* @canonical-block:002918 */

.yi-card-title {
  font-family: var(--font-display);
  font-size: clamp(19px, 2.4vw, 24px);
  letter-spacing: -.04em;
}/* @canonical-block:002919 */

.yi-card-bottom {
  font-family: var(--font-mono);
}/* @canonical-block:002920 */

.yi-product-ui--profile {
  min-height: 0;
  aspect-ratio: 9 / 17.5;
  border-radius: 30px;
}/* @canonical-block:002921 */

.yi-profile-body {
  font-family: var(--font-ui);
}/* @canonical-block:002922 */

.yi-profile-body strong {
  font-family: var(--font-display);
  font-size: 17px;
}/* @canonical-block:002923 */

.yi-profile-body > span {
  font-family: var(--font-ui);
  font-size: 12px;
}/* @canonical-block:002924 */

.yi-profile-save {
  min-height: 40px;
  display: grid;
  place-items: center;
  font-family: var(--font-ui);
  font-size: 12px;
}/* @canonical-block:002925 */

.yi-product-ui--dashboard {
  min-height: 0;
  aspect-ratio: 1.55 / 1;
}/* @canonical-block:002926 */

/* ------------------------------ Footer ----------------------------------- */

.yi-footer--new .yi-footer__brand p,
.yi-footer--new .yi-footer__layer p,
.yi-footer--new .yi-footer__base a,
.yi-footer--new .yi-footer__base span {
  font-family: var(--font-ui);
}/* @canonical-block:002927 */

.yi-footer__layer strong {
  font-family: var(--font-display);
}/* @canonical-block:002928 */

/* --------------------------- Responsive auto-layout ----------------------- */

@media (max-width: 1100px) {
  .home-mockup__hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 64px;
  }

  .home-mockup__copy {
    justify-self: center;
    text-align: center;
  }

  .home-mockup__copy > p {
    margin-inline: auto;
  }

  .home-mockup__actions,
  .home-mockup__meta {
    justify-content: center;
  }

  .home-mockup__visual {
    width: min(760px, 100%);
    min-height: 500px;
    margin-inline: auto;
  }

  .corporate-single-hero {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  }

  .corporate-dashboard-stage {
    aspect-ratio: auto;
    min-height: 360px;
  }

  .how-step-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .how-step-card {
    min-height: 0;
  }
}/* @canonical-block:002929 */

@media (max-width: 760px) {
  html {
    scroll-padding-top: 92px;
  }

  main[id="main-content"],
  section[id],
  article[id] {
    scroll-margin-top: 92px;
  }

  .home-mockup__hero {
    padding: 48px 20px 42px;
  }

  .home-mockup__copy {
    text-align: left;
  }

  .home-mockup__copy h1 {
    font-size: clamp(42px, 12vw, 56px);
    line-height: 1;
  }

  .home-mockup__copy > p {
    font-size: 16px;
  }

  .home-mockup__actions,
  .home-mockup__meta {
    justify-content: flex-start;
  }

  .home-mockup__visual {
    min-height: 410px;
  }

  .home-mockup__phone {
    width: 36%;
    min-width: 150px;
    right: 40%;
    top: 3%;
  }

  .home-mockup__card {
    width: 72%;
    right: 0;
    bottom: 5%;
  }

  .home-premium__proof,
  .home-premium__journey {
    padding-inline: 20px;
  }

  .home-premium__proof-head,
  .home-premium__journey-head {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .home-premium__proof-head h2,
  .home-premium__journey-head h2,
  .home-premium__final h2 {
    font-size: clamp(38px, 11vw, 52px);
  }

  .home-premium__principles,
  .home-premium__journey-steps {
    grid-template-columns: 1fr;
  }

  .home-premium__principles article {
    border-right: 0;
    border-bottom: 1px solid rgba(36,29,22,.10);
  }

  .home-premium__principles article:last-child {
    border-bottom: 0;
  }

  .home-premium__journey-action {
    align-items: flex-start;
    flex-direction: column;
  }

  .products-single-hero__inner {
    grid-template-columns: 1fr;
  }

  .products-single-visual {
    order: -1;
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .products-single-visual .yi-product-visual,
  .product-one-page__visual .yi-product-visual {
    max-width: 520px;
  }

  .products-single-benefits {
    grid-template-columns: 1fr;
  }

  .how-hero {
    padding: 52px 0 40px;
  }

  .how-hero h1 {
    font-size: clamp(40px, 11vw, 54px);
  }

  .how-steps {
    width: min(calc(100% - 32px), var(--wide));
    padding-top: 40px;
  }

  .how-step-grid {
    grid-template-columns: 1fr;
  }

  .how-step-card {
    grid-template-rows: auto auto auto minmax(240px, auto) auto;
    padding: 20px;
  }

  .how-step-visual {
    width: calc(100% + 40px);
    min-height: 250px;
  }

  .how-benefits {
    width: min(calc(100% - 32px), var(--wide));
    margin-bottom: 48px;
  }

  .how-benefits-grid {
    grid-template-columns: 1fr;
  }

  .corporate-single-hero {
    width: min(calc(100% - 32px), var(--wide));
    min-height: 0;
    grid-template-columns: 1fr;
    padding: 48px 0 28px;
  }

  .corporate-single-copy h1 {
    max-width: 14ch;
    font-size: clamp(42px, 11vw, 58px);
  }

  .corporate-single-proof {
    grid-template-columns: 1fr;
  }

  .corporate-dashboard-stage {
    min-height: 300px;
  }

  .corporate-capability-bar,
  .corporate-single-cta {
    width: min(calc(100% - 32px), var(--wide));
  }

  .corporate-single-cta {
    align-items: flex-start;
    flex-direction: column;
    padding: 22px;
  }

  .corporate-single-cta-actions {
    width: 100%;
  }

  .corporate-single-cta-actions > * {
    flex: 1 1 0;
  }

  .corporate-single-details {
    padding-top: 64px;
  }

  .corporate-pricing-grid {
    grid-template-columns: 1fr;
  }

  .corporate-lead-section {
    grid-template-columns: 1fr;
  }

  .corporate-lead-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .corporate-lead-actions > * {
    width: 100%;
  }
}/* @canonical-block:002941 */
.product-one-page__fallback-cta{min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:0 20px;border-radius:11px;background:#17131c;color:#f8f4ec;text-decoration:none;font-size:13px;font-weight:800;white-space:nowrap;transition:transform 160ms ease,background 160ms ease}/* @canonical-block:002942 */
.product-one-page__fallback-cta:hover{transform:translateY(-1px);background:#2a2230}/* @canonical-block:002943 */
@media (max-width:760px){.product-one-page__fallback-cta{width:100%}}/* @canonical-block:002956 */.ds-product-option-group{border:0;margin:0;padding:0}/* @canonical-block:002957 */.ds-product-option-group__label{padding:0;margin-bottom:9px;color:#5e565d;font-size:12px;font-weight:800}/* @canonical-block:002958 */
.ds-product-option-group__options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}/* @canonical-block:002959 */.ds-product-option{position:relative;min-height:62px;display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid #ddd6cc;border-radius:12px;background:rgba(255,255,255,.65);cursor:pointer;transition:border-color 160ms ease,background 160ms ease,transform 160ms ease}/* @canonical-block:002960 */.ds-product-option:hover{transform:translateY(-1px);border-color:#c6a25e}/* @canonical-block:002961 */.ds-product-option--selected{border-color:#a9812f;background:#fffaf0;box-shadow:0 0 0 1px rgba(169,129,47,.15)}/* @canonical-block:002962 */.ds-product-option__input{position:absolute;opacity:0;pointer-events:none}/* @canonical-block:002963 */.ds-product-option__swatch{width:18px;height:18px;flex:0 0 18px;border-radius:50%;border:1px solid rgba(0,0,0,.16)}/* @canonical-block:002964 */.ds-product-option__swatch--black{background:#17131c}/* @canonical-block:002965 */.ds-product-option__swatch--white{background:#fff}/* @canonical-block:002966 */.ds-product-option__swatch--purple{background:linear-gradient(135deg,#27133f,#8954c8)}/* @canonical-block:002967 */.ds-product-option__copy{display:grid;gap:2px}/* @canonical-block:002968 */.ds-product-option__copy strong{font-size:12px}/* @canonical-block:002969 */.ds-product-option__copy small{color:#8a8188;font-size:11px}/* @canonical-block:002970 */.ds-product-option__check{margin-left:auto;color:#a9812f;font-size:12px;opacity:0}/* @canonical-block:002971 */.ds-product-option--selected .ds-product-option__check{opacity:1}/* @canonical-block:002977 */.nfc-price-actions .ds-button{min-height:48px;padding:0 24px;border-radius:11px}/* @canonical-block:002980 */.nfc-trust-row .yi-icon{width:12px;height:12px;color:#a9812f}/* @canonical-block:003018 */
@media (max-width:760px) {
  .public-page-title { min-height: 220px; padding: 30px 20px 28px; }
  .public-page-title__back { position: static; margin-bottom: 20px; }
  .public-page-title h1 { font-size: clamp(34px, 10vw, 50px); }
  .public-page-title p { max-width: 620px; font-size: 15px; }
}/* @canonical-block:003019 */
@media (max-width:680px){.nfc-product-hero{padding:48px 0 64px}.nfc-product-hero h2{font-size:54px}.nfc-product-hero__lead{font-size:16px}.ds-product-option-group__options{grid-template-columns:1fr}.nfc-price-row{align-items:stretch;flex-direction:column}.nfc-price-actions .ds-button{width:100%}.nfc-benefits__grid{grid-template-columns:1fr}.nfc-benefits article{border-right:0;border-bottom:1px solid #e3ddd4}.nfc-benefits article:last-child{border-bottom:0}.nfc-story,.nfc-includes,.nfc-faq{padding:76px 0}.nfc-story h2,.nfc-includes h2,.nfc-faq h2,.nfc-final h2{font-size:48px}.nfc-final{padding:84px 0}}/* @canonical-block:003023 */
/* Canonical IDSidebar Architecture */
.id-sidebar{--sb-w:calc(var(--space-30)*2 + var(--space-5));width:var(--sb-w);min-width:var(--sb-w);height:100vh;position:sticky;top:0;display:flex;flex-direction:column;background:var(--surface);border-right:1px solid var(--border);transition:width var(--motion-standard) var(--ease-standard);z-index:40;box-sizing:border-box}/* @canonical-block:003024 */
.id-sidebar--collapsed{width:calc(var(--space-6)*3);min-width:calc(var(--space-6)*3)}/* @canonical-block:003025 */
.id-sidebar__backdrop,.id-sidebar__mobile-close,.id-sidebar--collapsed .id-sidebar__brand-copy,.id-sidebar--collapsed .id-sidebar__section-label,.id-sidebar--collapsed .id-sidebar__label,.id-sidebar--collapsed .id-sidebar__plan,.id-sidebar--collapsed .id-sidebar__user-info,.id-sidebar--collapsed .id-sidebar__logout,.id-sidebar--collapsed .id-sidebar__collapse-label{display:none}/* @canonical-block:003026 */
.id-sidebar__brand{padding:var(--space-4) var(--space-5);border-bottom:1px solid var(--border)}/* @canonical-block:003027 */
.id-sidebar__brand-link{display:flex;align-items:center;gap:var(--space-3);text-decoration:none;color:var(--text-primary)}/* @canonical-block:003028 */
.id-sidebar__brand-mark{width:var(--space-8);height:var(--space-8);flex-shrink:0;display:flex;align-items:center;justify-content:center}/* @canonical-block:003029 */
