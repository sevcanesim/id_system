  font-size: 14px;
  line-height: 1.55;
}/* @canonical-block:003994 */
.support-empty .home-mockup__link-secondary {
  font-size: 14px;
}/* @canonical-block:004035 */

@media (max-width: 760px) {
  .home-mockup__orbit {
    display: none;
  }
  .home-mockup__visual {
    overflow: visible;
    contain: none;
    min-height: 360px;
  }
  .home-mockup__phone {
    min-width: 0;
    width: min(42%, 150px);
  }
  .home-mockup__card {
    width: min(78%, 280px);
  }
}/* @canonical-block:004044 */
.home-mockup__meta {
  column-gap: 22px;
  row-gap: 8px;
}/* @canonical-block:004045 */
.home-mockup__meta > span + span {
  position: relative;
  padding-left: 14px;
}/* @canonical-block:004046 */
.home-mockup__meta > span + span::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: currentColor;
  opacity: .45;
  transform: translateY(-50%);
}/* @canonical-block:004085 */

.home-mockup__phone {
  padding: 7px;
  background:
    linear-gradient(180deg, #3a342e, #1c1916);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, .18) inset,
    0 22px 48px rgba(42, 34, 26, .22);
}/* @canonical-block:004119 */
.home-mockup__copy h1 {
  font-weight: 700;
}/* @canonical-block:004120 */

/* Hero mockup uses the stage box as the coordinate system, not the viewport. */
.home-mockup__visual {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 0.92;
  min-height: 0;
  height: auto;
  overflow: hidden;
  contain: layout;
}/* @canonical-block:004121 */
.home-mockup__phone {
  width: 28%;
  min-width: 0;
  max-width: 292px;
  right: 42%;
  top: 8%;
  aspect-ratio: 9 / 19;
}/* @canonical-block:004122 */
.home-mockup__card {
  width: 62%;
  max-width: 610px;
  right: 2%;
  bottom: 8%;
  aspect-ratio: 1.586 / 1;
}/* @canonical-block:004124 */

@media (max-width: 1050px) {
  .home-mockup__visual {
    width: min(100%, 680px);
    margin-inline: auto;
    min-height: 0;
    aspect-ratio: 1 / 0.92;
  }
}/* @canonical-block:004125 */

@media (max-width: 760px) {
  .home-mockup__visual {
    overflow: hidden;
    contain: layout;
    min-height: 0;
    aspect-ratio: 1 / 1.05;
  }
  .home-mockup__phone {
    width: 36%;
    min-width: 0;
  }
  .home-mockup__card {
    width: 72%;
  }
}/* @canonical-block:004130 */
.home-premium__path-grid article {
  height: 100%;
  gap: 14px;
}/* @canonical-block:004280 */
.home-premium__principles p {
  margin: 12px 0 0;
}