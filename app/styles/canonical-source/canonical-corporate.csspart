.corp-file-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }/* @canonical-block:001993 */
.corp-file-replace {
  min-height: 34px;
  padding: 0 10px;
  font-size: 12px;
}/* @canonical-block:001994 */
.corp-link-editor { display: grid; gap: 12px; }/* @canonical-block:001995 */
.corp-link-source-actions,
