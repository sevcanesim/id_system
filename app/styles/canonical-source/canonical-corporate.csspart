}/* @canonical-block:003238 */

.enterprise-mobile-bottom-nav { display:none; }/* @canonical-block:003240 */
@media (prefers-reduced-motion:reduce) {
  .enterprise-mobile-bottom-nav { transition:none; }
}/* @canonical-block:003241 */

/* ================================================================
   YENOMI ID — CORPORATE FLUID AUTO-LAYOUT
   Final shell contract: viewport-first, content-fluid, no centered
   1180px canvas. Domain components remain untouched.
   ================================================================ */
html:has(.p10-corporate-platform),
body:has(.p10-corporate-platform) {
  background: #F9F8F6;
}/* @canonical-block:003242 */

.business-console.p10-corporate-platform {
  width: 100%;
  max-width: none;
  min-height: 100svh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}/* @canonical-block:003243 */

.p10-corporate-platform .enterprise-dashboard-shell {
  width: 100%;
  max-width: none;
  min-height: 100svh;
  margin: 0;
  display: grid;
  grid-template-columns: minmax(224px, 248px) minmax(0, 1fr);
  align-items: stretch;
}/* @canonical-block:003244 */

.p10-corporate-platform .enterprise-sidebar {
  width: auto;
  min-width: 0;
  height: 100svh;
  min-height: 100svh;
  position: sticky;
  top: 0;
  align-self: stretch;
  box-sizing: border-box;
}/* @canonical-block:003245 */

.p10-corporate-platform .enterprise-dashboard-main {
  width: 100%;
  min-width: 0;
  min-height: 100svh;
  max-height: 100svh;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
}/* @canonical-block:003246 */

.p10-corporate-platform .enterprise-topbar {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-inline: clamp(20px, 2.2vw, 36px);
}/* @canonical-block:003247 */

.p10-corporate-platform .business-shell {
  width: 100%;
  min-width: 0;
  min-height: 0;
  overflow: auto;
  box-sizing: border-box;
  padding: 0 clamp(20px, 2.2vw, 36px) 72px;
  background: #F9F8F6;
}/* @canonical-block:003248 */

/* Content tracks grow/shrink from available space instead of fixed widths. */
.p10-corporate-platform .business-hero {
  grid-template-columns: minmax(0, 1fr) minmax(88px, 112px);
}/* @canonical-block:003263 */

/* ================================================================
   YENOMI ID — PANEL SIDEBAR / EMPLOYEE RESPONSIVE CONTRACT
   Light/Warm Premium canonical layer. This intentionally comes last so
   historical dark-gold panel overrides cannot leak back into the shell.
   ================================================================ */
.enterprise-sidebar {
  width: 250px;
  box-sizing: border-box;
  background: #FFFFFF;
  border-right: 1px solid #E6E2D8;
  color: #1A1918;
  overflow: hidden;
  padding-bottom: 16px;
  scrollbar-width: thin;
  scrollbar-color: #D8D2C4 transparent;
}/* @canonical-block:003264 */
.enterprise-side-brand {
  color: #1A1918;
  text-decoration: none;
}/* @canonical-block:003265 */
.enterprise-side-brand:focus-visible,
.enterprise-nav-entry a:focus-visible,
.enterprise-side-links a:focus-visible,
.enterprise-side-links button:focus-visible,
.enterprise-sidebar-collapse:focus-visible,
.enterprise-sidebar-mobile-close:focus-visible {
  outline: 2px solid #A37B2C;
  outline-offset: 3px;
}/* @canonical-block:003266 */
.enterprise-side-section-title {
  color: #A19D95;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
}/* @canonical-block:003267 */
.enterprise-nav-entry {
  position: relative;
  display: block;
  min-width: 0;
  min-height: 0;
  border: 0;
  border-radius: 10px;
  color: #68645D;
  background: transparent;
}/* @canonical-block:003268 */
.enterprise-nav-entry > .enterprise-side-section-title {
  display: block;
  padding: 16px 10px 7px;
  color: #A19D95;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: .12em;
  white-space: nowrap;
}/* @canonical-block:003269 */
.enterprise-nav-entry > a {
  min-width: 0;
}/* @canonical-block:003270 */
.enterprise-nav-entry:hover {
  background: #F9F8F6;
  color: #1A1918;
}/* @canonical-block:003273 */
.enterprise-nav-entry a {
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 10px;
  box-sizing: border-box;
  color: inherit;
  text-decoration: none;
}/* @canonical-block:003274 */
.enterprise-sidebar-collapse {
  flex: 0 0 auto;
  min-height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 10px;
  padding: 0 10px;
  border: 1px solid #E6E2D8;
  border-radius: 10px;
  background: #FFFFFF;
  color: #68645D;
  cursor: pointer;
  transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
}/* @canonical-block:003275 */
.enterprise-sidebar-collapse:hover {
  border-color: #D8D2C4;
  background: #F6F1E5;
  color: #1A1918;
}/* @canonical-block:003279 */

/* Employee mobile representation: the previous DOM already had a dedicated
   mobile list, but its presentation contract was missing. Keep the semantic
   table for desktop and switch to true cards below the tablet breakpoint. */
.p11-mobile-list { display: none; }/* @canonical-block:003280 */
.p11-mobile-list > article {
  display: grid;
  gap: 14px;
  padding: 16px;
  border: 1px solid #E6E2D8;
  border-radius: 14px;
  background: #FFFFFF;
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
}/* @canonical-block:003281 */
.p11-mobile-list > article + article { margin-top: 10px; }/* @canonical-block:003282 */
.p11-mobile-list > article > header {
  display: grid;
  grid-template-columns: auto 42px minmax(0,1fr) auto;
  gap: 10px;
  align-items: center;
}/* @canonical-block:003283 */
.p11-mobile-select {
  display: grid;
  place-items: center;
}/* @canonical-block:003284 */
.p11-mobile-select input {
  width: 16px;
  height: 16px;
}/* @canonical-block:003285 */
.p11-mobile-list > article > header > div { min-width: 0; display: grid; gap: 3px; }/* @canonical-block:003286 */
.p11-mobile-list > article > header strong,
.p11-mobile-list > article > header small { overflow-wrap: anywhere; }/* @canonical-block:003287 */
.p11-mobile-list > article > header strong { color: #1A1918; font-size: 14px; }/* @canonical-block:003288 */
.p11-mobile-list > article > header small { color: #68645D; font-size: 12px; line-height: 1.4; }/* @canonical-block:003289 */
.p11-mobile-avatar {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #F2EFE9;
  color: #9E7728;
  font-size: 12px;
  font-weight: 800;
}/* @canonical-block:003290 */
.p11-mobile-meta {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 10px;
}/* @canonical-block:003291 */
.p11-mobile-meta > span {
  min-width: 0;
  padding: 10px 12px;
  border: 1px solid #E6E2D8;
  border-radius: 10px;
  background: #F9F8F6;
}/* @canonical-block:003292 */
.p11-mobile-meta small { color: #8A857D; font-size: 11px; }/* @canonical-block:003293 */
.p11-mobile-meta b { color: #1A1918; font-size: 12px; margin-top: 3px; }/* @canonical-block:003294 */
.p11-mobile-list > article > footer {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 8px;
}/* @canonical-block:003295 */
.p11-mobile-list > article > footer button {
  min-height: 40px;
  border: 1px solid #E6E2D8;
  border-radius: 10px;
  background: #FFFFFF;
  color: #1A1918;
  font-size: 12px;
  font-weight: 750;
}/* @canonical-block:003296 */
.p11-mobile-list > article > footer button:last-child {
  border-color: #A37B2C;
  background: #A37B2C;
  color: #FFFFFF;
}/* @canonical-block:003298 */

@media (max-width: 760px) {
  .p11-table-wrap { display: none; }
  .p11-mobile-list { display: block; margin-top: 14px; }
  .p11-table-summary { margin-top: 14px; }
  .p11-kpis { grid-template-columns: repeat(2,minmax(0,1fr)); }
}/* @canonical-block:003299 */

@media (max-width: 520px) {
  .p11-kpis { grid-template-columns: 1fr; }
  .p11-mobile-list > article > header { grid-template-columns: auto 42px minmax(0,1fr); }
  .p11-mobile-list > article > header > .p11-status { grid-column: 3; justify-self: start; }
  .p11-mobile-meta { grid-template-columns: 1fr; }
}/* @canonical-block:003315 */

.p10-settings-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}/* @canonical-block:003316 */
.p10-settings-grid > button {
  min-width: 0;
  min-height: 148px;
  display: grid;
  align-content: start;
  justify-items: start;
  gap: 8px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  box-shadow: var(--shadow-xs);
  transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
