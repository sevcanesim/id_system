  padding:28px 24px;
  border-right:1px solid rgba(36,29,22,.10);
}/* @canonical-block:002492 */
.home-premium__principles article:first-child{padding-left:0}/* @canonical-block:002493 */
.home-premium__principles article:last-child{border-right:0}/* @canonical-block:002494 */
.home-premium__principles article>span{
  color:#8b6835;
  font:700 11px/1 var(--font-mono);
  letter-spacing:.12em;
}/* @canonical-block:002495 */
.home-premium__principles strong{
