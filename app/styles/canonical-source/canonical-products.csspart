  height: auto;
  overflow: visible;
}/* @canonical-block:002742 */
.products-single-main { min-height: 0; display: block; }/* @canonical-block:002743 */
.products-single-hero {
  min-height: 0;
  padding: clamp(52px, 7vw, 86px) 0 48px;
}/* @canonical-block:002744 */
.products-single-hero__inner {
  height: auto;
  grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr);
