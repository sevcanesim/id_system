.nfc-account-note{margin:12px 0;color:#7b7379;font-size:11px;line-height:1.5}/* @canonical-block:002973 */.nfc-price-row{display:flex;align-items:end;justify-content:space-between;gap:20px;padding:18px 0;border-top:1px solid #dcd5ca;border-bottom:1px solid #dcd5ca}/* @canonical-block:002974 */.nfc-price-tag{display:grid;gap:2px}/* @canonical-block:002975 */.nfc-price-tag strong{font-size:38px;line-height:1;letter-spacing:-.045em}/* @canonical-block:002976 */.nfc-price-tag small{color:#817980;font-size:11px}/* @canonical-block:002978 */.nfc-trust-row{display:flex;flex-wrap:wrap;gap:14px 20px;margin-top:14px;color:#736b72;font-size:12px;font-weight:700}/* @canonical-block:002979 */.nfc-trust-row span{display:inline-flex;align-items:center;gap:5px}/* @canonical-block:002981 */
