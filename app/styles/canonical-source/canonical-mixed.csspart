/* Turkish display copy: negative tracking also shrinks the space glyph, so
   words like "Bir sonraki" look glued. Keep modest tracking and restore word gap. */
.p4-display,
.public-page-title h1,
.home-mockup__copy h1,
.home-premium h1,
.home-premium h2,
.how-hero h1,
.corporate-single-copy h1,
.products-single-copy h2,
.nfc-product-hero h2,
.nfc-story h2,
.nfc-includes h2,
.nfc-faq h2,
.nfc-final h2,
.legal-page--premium .legal-shell h1,
.p6-auth-story h1,
.yi-hero h1,
.home-final h2,
.home-compact__hero-copy h1,
.home-compact__close h2,
.product-one-page__copy h1,
.product-one-page__statement h2,
.product-one-page__final h2 {
  letter-spacing: -0.02em;
  word-spacing: 0.1em;
}/* @canonical-block:003860 */

/* Public CRO: one primary, pinned catalog CTAs, sticky chrome, no fake KPIs. */
.public-site-chrome .yi-header__actions .yi-btn--ghost {
  min-height: 44px;
  padding: 0 12px;
  border-color: transparent;
  background: transparent;
  font-weight: 650;
}/* @canonical-block:003861 */
.public-site-chrome .yi-header__actions .yi-btn--ghost:hover {
  background: rgba(26, 25, 24, .04);
}/* @canonical-block:003865 */
.products-plan-card__cta .ds-button,
.products-plan-card__cta .yi-btn {
  width: 100%;
}/* @canonical-block:003868 */
.how-hero .section-kicker {
  color: #8b6835;
  letter-spacing: .12em;
  font-weight: 650;
}/* @canonical-block:003874 */

/* Post-purchase CRO: quiet chrome, one filled primary, gold as fill. */
.p6-auth-kicker,
.p6-auth-heading > span,
.p6-checkout-context span,
.p5-result-page .section-kicker,
.p6-activation-page .section-kicker,
.order-page .section-kicker {
