/* @canonical-block:000225 */

/* corporate light */
.corporate-resource-hero {
  width:min(calc(100% - 48px),var(--wide));
  min-height:720px;
  margin:auto;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(560px,1fr);
  gap:54px;
  align-items:center;
  padding:58px 0 72px;
}/* @canonical-block:000226 */
.corporate-resource-hero-copy { max-width:670px; }/* @canonical-block:000227 */
.corporate-resource-hero-copy h1 { max-width:680px; margin:16px 0 20px; color:#18151a; font-size:clamp(50px,5.4vw,76px); line-height:.99; }/* @canonical-block:000228 */
.corporate-resource-hero-copy h1 em { color:#7650b8; font-style:normal; }/* @canonical-block:000229 */
.corporate-resource-hero-copy > p { max-width:620px; margin-bottom:26px; color:#5c5650; font-size:16px; line-height:1.7; }/* @canonical-block:000230 */
.corporate-outcomes { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; margin-top:28px; }/* @canonical-block:000231 */
.corporate-outcomes div { min-height:78px; padding:14px; border:1px solid rgba(36,29,23,.1); border-radius:13px; background:rgba(255,255,255,.72); }/* @canonical-block:000232 */
.corporate-outcomes strong,.corporate-outcomes span { display:block; }/* @canonical-block:000233 */
.corporate-outcomes strong { color:#765b2e; font:700 18px var(--font-mono); }/* @canonical-block:000234 */
.corporate-outcomes span { margin-top:4px; color:#6b645d; font-size:12px; }/* @canonical-block:000235 */
.corporate-resource-visual {
  position:relative;
  min-height:590px;
  display:grid;
  place-items:center;
  isolation:isolate;
}/* @canonical-block:000236 */
.corporate-resource-visual::before {
  content:"";
  position:absolute;
  inset:7% 0;
  z-index:-2;
  border:1px solid rgba(153,117,57,.22);
  border-radius:34px;
  background:
    radial-gradient(circle at 52% 42%,rgba(109,61,224,.25),transparent 34%),
    linear-gradient(145deg,#18131f,#09080d 76%);
  box-shadow:0 28px 70px rgba(34,28,24,.18),inset 0 1px rgba(255,255,255,.08);
}/* @canonical-block:000237 */
.corporate-resource-visual::after {
  content:"";
  position:absolute;
  width:76%;
  height:76%;
  z-index:-1;
  border:1px solid rgba(212,180,131,.14);
  border-radius:50%;
  transform:rotate(-20deg) scaleY(.54);
}/* @canonical-block:000238 */
.corporate-resource-visual img { width:min(100%,690px); position:relative; z-index:2; filter:drop-shadow(0 25px 45px rgba(0,0,0,.4)); transform:translateY(-1%); }/* @canonical-block:000239 */
.corporate-art-glow { position:absolute; width:430px; height:430px; border-radius:50%; background:radial-gradient(circle,rgba(109,61,224,.18),transparent 68%); z-index:-1; }/* @canonical-block:000240 */
.corporate-art-note { position:absolute; z-index:3; right:4%; bottom:13%; padding:10px 13px; border:1px solid rgba(212,180,131,.25); border-radius:999px; background:rgba(18,14,25,.78); color:#e8d2a9; font-size:12px; box-shadow:0 12px 30px rgba(0,0,0,.22); }/* @canonical-block:000241 */
.corporate-art-note i { display:inline-block; width:7px; height:7px; margin-right:6px; border-radius:50%; background:#4ebd79; box-shadow:0 0 10px rgba(78,189,121,.5); }/* @canonical-block:000242 */
.corporate-buyer-section,.corporate-pricing-section,.corporate-workflow { width:min(calc(100% - 48px),var(--content)); margin:auto; padding:96px 0; }/* @canonical-block:000243 */
.corporate-section-heading { max-width:780px; margin-bottom:34px; }/* @canonical-block:000244 */
.corporate-section-heading h2 { margin:10px 0 12px; color:#1b1819; font-size:clamp(34px,4vw,52px); line-height:1.02; }/* @canonical-block:000245 */
.corporate-section-heading p { color:#625c55; }/* @canonical-block:000246 */
.corporate-benefits,.corporate-pricing-grid,.corporate-workflow-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }/* @canonical-block:000247 */
.corporate-benefits article,.corporate-pricing-grid article,.corporate-workflow-grid article { min-width:0; padding:25px; border:1px solid rgba(36,29,23,.11); border-radius:18px; background:rgba(255,255,255,.72); box-shadow:0 14px 38px rgba(58,48,38,.07); }/* @canonical-block:000248 */
.corporate-benefit-icon { width:42px; height:42px; display:grid; place-items:center; margin-bottom:24px; border:1px solid rgba(153,117,57,.25); border-radius:12px; color:#8a6b38; background:rgba(212,180,131,.10); }/* @canonical-block:000250 */
.corporate-benefits small,.corporate-workflow-grid small { color:#8d6b36; font:700 12px var(--font-mono); }/* @canonical-block:000251 */
.corporate-benefits h3,.corporate-pricing-grid h3,.corporate-workflow-grid h3 { margin:10px 0 7px; color:#1c1919; font-size:20px; }/* @canonical-block:000252 */
.corporate-benefits p,.corporate-pricing-grid p,.corporate-workflow-grid p { color:#625c56; font-size:14px; line-height:1.65; }/* @canonical-block:000253 */
.corporate-pricing-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }/* @canonical-block:000254 */
.corporate-pricing-grid article { display:flex; flex-direction:column; min-height:355px; }/* @canonical-block:000255 */
.corporate-pricing-grid article strong { display:block; margin:20px 0; color:#7d6031; font:700 24px var(--font-mono); }/* @canonical-block:000256 */
.corporate-pricing-grid article strong small { font-size:12px; }/* @canonical-block:000257 */
.corporate-pricing-grid ul { padding:0; margin:0 0 20px; list-style:none; display:grid; gap:7px; }/* @canonical-block:000258 */
.corporate-pricing-grid li { color:#5f5952; font-size:14px; }/* @canonical-block:000259 */
.corporate-pricing-grid li::before { content:"✓"; margin-right:7px; color:#8d6b36; }/* @canonical-block:000260 */
.corporate-plan-link { margin-top:auto; display:inline-flex; align-items:center; gap:7px; color:#7d6031; font-size:14px; font-weight:800; }/* @canonical-block:000261 */
.corporate-conversion,.corporate-lead-section { width:min(calc(100% - 48px),var(--content)); margin:20px auto 95px; padding:42px; display:grid; grid-template-columns:.75fr 1.25fr; gap:45px; align-items:center; border:1px solid rgba(36,29,23,.11); border-radius:24px; background:rgba(255,255,255,.72); box-shadow:0 18px 46px rgba(58,48,38,.08); }/* @canonical-block:000262 */
.corporate-conversion-art { min-height:300px; display:grid; place-content:center; border-radius:18px; background:linear-gradient(145deg,#191421,#2a2040); color:#f5eee1; text-align:center; }/* @canonical-block:000263 */
.corporate-conversion-art span { color:var(--gold-hi); font:700 11px var(--font-mono); letter-spacing:.14em; }/* @canonical-block:000264 */
.corporate-conversion-art strong { margin-top:14px; font-size:32px; line-height:1.05; }/* @canonical-block:000265 */
.corporate-conversion h2,.corporate-lead-copy h2 { margin:10px 0 12px; color:#1b1819; font-size:clamp(30px,3.5vw,44px); line-height:1.03; }/* @canonical-block:000266 */
.corporate-conversion p,.corporate-lead-copy p { color:#625c55; }/* @canonical-block:000267 */
.corporate-lead-section { grid-template-columns:.9fr 1.1fr; }/* @canonical-block:000268 */
.corporate-lead-copy ul { padding-left:20px; color:#625c55; }/* @canonical-block:000479 */
.p10-domain-panel,.p11-filter-control { padding:16px; }/* @canonical-block:000481 */
.v25-donut-wrap { display:grid; place-items:center; }/* @canonical-block:000485 */
.p14-p14-management-row-icon { width:38px; height:38px; display:grid; place-items:center; border-radius:10px; background:var(--gold-dim); color:var(--gold); }/* @canonical-block:000488 */
.enterprise-side-management { display:grid; gap:8px; }/* @canonical-block:000489 */
.enterprise-side-links,.enterprise-side-primary-links { display:grid; gap:4px; }/* @canonical-block:000490 */
.enterprise-side-links a,.enterprise-side-primary-links a { padding:10px 11px; border-radius:9px; color:var(--ink-2); font-size:14px; }/* @canonical-block:000491 */
.enterprise-side-links a:hover,.enterprise-side-primary-links a:hover,.corp-link-current { background:var(--glass); color:var(--ink); }/* @canonical-block:000493 */
.p14-card-main { min-width:0; display:grid; gap:14px; }/* @canonical-block:000500 */
.p14-status-group { display:flex; align-items:center; justify-content:space-between; gap:12px; }/* @canonical-block:000513 */
.p14-link-card { padding:18px; border:1px solid var(--border-gold); border-radius:var(--radius-card); background:linear-gradient(145deg,var(--surface),var(--surface-2)); box-shadow:var(--shadow-soft); }/* @canonical-block:000529 */
.p14-qr-placeholder { display:grid; place-items:center; width:min(100%,180px); aspect-ratio:1; margin:4px auto 0; border:1px dashed var(--border-gold); border-radius:12px; background:var(--surface-2); color:var(--ink-3); font:700 14px var(--font-mono); }/* @canonical-block:000540 */
.p14-message { padding:11px 13px; border:1px solid var(--border-gold); border-radius:12px; background:var(--gold-dim); color:var(--ink-2); font-size:12px; line-height:1.45; }/* @canonical-block:000692 */


/* corporate sales single-viewport composition */
.corporate-single-page { min-height:100svh; }/* @canonical-block:000693 */
.corporate-single-hero {
  width:min(calc(100% - 48px),var(--wide));
  min-height:clamp(455px,calc(100svh - 205px),575px);
  margin:0 auto;
  padding:34px 0 22px;
  display:grid;
  grid-template-columns:minmax(0,.88fr) minmax(500px,1.12fr);
  gap:34px;
  align-items:center;
}/* @canonical-block:000694 */
.corporate-single-copy { max-width:650px; }/* @canonical-block:000695 */
.corporate-single-copy h1 { max-width:650px; margin:13px 0 15px; color:#17151a; font-size:clamp(42px,4.7vw,68px); line-height:.97; letter-spacing:-.045em; }/* @canonical-block:000696 */
.corporate-single-copy h1 em { color:#1A1918; font-style:normal; }/* @canonical-block:000697 */
.corporate-single-copy > p { max-width:590px; margin:0 0 20px; color:#625c55; font-size:15px; line-height:1.6; }/* @canonical-block:000698 */
.corporate-single-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:18px; max-width:590px; }/* @canonical-block:000699 */
.corporate-single-proof div { min-height:58px; padding:10px 12px; border:1px solid rgba(36,29,23,.1); border-radius:11px; background:rgba(255,255,255,.72); }/* @canonical-block:000700 */
.corporate-single-proof strong,.corporate-single-proof span { display:block; }/* @canonical-block:000701 */
.corporate-single-proof strong { color:#765b2e; font:700 15px var(--font-mono); }/* @canonical-block:000702 */
.corporate-single-proof span { margin-top:3px; color:#6b645d; font-size:11px; }/* @canonical-block:000703 */
.corporate-dashboard-stage { position:relative; min-height:410px; display:grid; place-items:center; }/* @canonical-block:000704 */
.corporate-dashboard-glow { position:absolute; width:520px; height:380px; border-radius:50%; background:radial-gradient(circle,rgba(212,180,131,.28),rgba(141,107,54,.12) 42%,transparent 70%); filter:blur(16px); pointer-events:none; }/* @canonical-block:000705 */
.corporate-dashboard-window { position:relative; width:min(100%,640px); overflow:hidden; border:1px solid rgba(212,175,55,.32); border-radius:20px; background:linear-gradient(165deg, #1a171d 0%, #110f14 60%, #0b090d 100%); box-shadow:0 32px 80px rgba(8,6,4,.45), 0 0 0 1px rgba(212,180,131,.15), inset 0 1px 0 rgba(255,255,255,.08); transform:perspective(1300px) rotateY(-2.5deg) rotateX(1deg); transition:transform 0.3s ease, box-shadow 0.3s ease; }/* @canonical-block:000706 */
.corporate-dashboard-window:hover { transform:perspective(1300px) rotateY(0deg) rotateX(0deg); box-shadow:0 36px 90px rgba(8,6,4,.55), 0 0 0 1px rgba(212,180,131,.3); }/* @canonical-block:000707 */
.corporate-dashboard-topbar { min-height:44px; padding:0 18px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(212,180,131,.16); color:#f3ece0; font:700 10px var(--font-mono); letter-spacing:.1em; background:rgba(255,255,255,.02); }/* @canonical-block:000708 */
.corporate-dashboard-topbar > div { display:flex; align-items:center; gap:8px; }/* @canonical-block:000709 */
.corporate-dashboard-topbar small { color:#968c81; font:500 9px var(--font-mono); letter-spacing:0; }/* @canonical-block:000710 */
.corporate-dashboard-dot { width:8px; height:8px; border-radius:50%; background:#d4b483; box-shadow:0 0 12px rgba(212,180,131,.65); }/* @canonical-block:000711 */
.corporate-dashboard-live { color:#7fcf9a; font-size:11px; font-weight:600; display:flex; align-items:center; gap:5px; }/* @canonical-block:000712 */
.corporate-dashboard-body { display:grid; grid-template-columns:56px minmax(0,1fr); min-height:340px; }/* @canonical-block:000713 */
.corporate-dashboard-sidebar { padding:22px 0; display:grid; align-content:start; justify-items:center; gap:14px; border-right:1px solid rgba(255,255,255,.08); background:#110f13; }/* @canonical-block:000714 */
.corporate-dashboard-sidebar span { width:20px; height:20px; border:1px solid rgba(212,180,131,.25); border-radius:6px; opacity:.5; transition:all 0.2s ease; }/* @canonical-block:000716 */
.corporate-dashboard-content { padding:20px; min-width:0; }/* @canonical-block:000717 */
.corporate-dashboard-heading { display:flex; align-items:flex-start; justify-content:space-between; color:#f8f4ec; }/* @canonical-block:000718 */
.corporate-dashboard-heading small { display:block; color:#d4b483; font:700 9px var(--font-mono); letter-spacing:.16em; }/* @canonical-block:000719 */
.corporate-dashboard-heading strong { display:block; margin-top:4px; font-size:16px; font-weight:700; }/* @canonical-block:000720 */
.corporate-dashboard-heading > span { color:#8f867b; }/* @canonical-block:000721 */
.corporate-dashboard-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:14px; }/* @canonical-block:000722 */
.corporate-dashboard-kpis div { padding:12px; border:1px solid rgba(212,180,131,.16); border-radius:12px; background:rgba(255,255,255,.04); backdrop-filter:blur(4px); }/* @canonical-block:000723 */
.corporate-dashboard-kpis small { display:block; color:#9c948a; font-size:11px; }/* @canonical-block:000724 */
.corporate-dashboard-kpis strong { display:block; margin:4px 0 2px; color:#f8f4ec; font:700 19px var(--font-mono); }/* @canonical-block:000725 */
.corporate-dashboard-kpis span { color:#7fcf9a; font-size:11px; font-weight:600; }/* @canonical-block:000726 */
.corporate-dashboard-grid { display:grid; grid-template-columns:1.35fr .9fr; gap:10px; margin-top:10px; }/* @canonical-block:000727 */
.corporate-dashboard-chart,.corporate-dashboard-team { min-height:130px; padding:12px; border:1px solid rgba(212,180,131,.16); border-radius:12px; background:rgba(255,255,255,.035); }/* @canonical-block:000728 */
.corporate-dashboard-chart > small,.corporate-dashboard-team > small { color:#9c948a; font:700 8px var(--font-mono); letter-spacing:.1em; }/* @canonical-block:000729 */
.corporate-bars { height:94px; display:flex; align-items:flex-end; gap:8px; padding-top:14px; }/* @canonical-block:000730 */
.corporate-bars i { flex:1; min-width:8px; border-radius:4px 4px 1px 1px; background:linear-gradient(180deg,#e0c598,#8e6c35); box-shadow:0 0 16px rgba(212,180,131,.18); }/* @canonical-block:000731 */
.corporate-bars i:nth-child(1){height:34%}/* @canonical-block:000732 */.corporate-bars i:nth-child(2){height:52%}/* @canonical-block:000733 */.corporate-bars i:nth-child(3){height:43%}/* @canonical-block:000734 */.corporate-bars i:nth-child(4){height:68%}/* @canonical-block:000735 */.corporate-bars i:nth-child(5){height:57%}/* @canonical-block:000736 */.corporate-bars i:nth-child(6){height:84%}/* @canonical-block:000737 */.corporate-bars i:nth-child(7){height:72%}/* @canonical-block:000738 */
.corporate-dashboard-team > div { display:flex; align-items:center; gap:8px; margin-top:12px; color:#b0a89e; font-size:12px; }/* @canonical-block:000739 */
.corporate-dashboard-team b { width:7px; height:7px; border-radius:50%; background:#6fca91; box-shadow:0 0 8px rgba(111,202,145,.4); }/* @canonical-block:000740 */
.corporate-dashboard-team div:nth-of-type(2) b { background:#d4b483; box-shadow:0 0 8px rgba(212,180,131,.4); }/* @canonical-block:000741 */.corporate-dashboard-team div:nth-of-type(3) b { background:#9a8f86; }/* @canonical-block:000742 */
.corporate-dashboard-team strong { margin-left:auto; color:#f3ece0; font:700 11px var(--font-mono); }/* @canonical-block:000743 */
.corporate-dashboard-footer { display:flex; gap:8px; margin-top:10px; padding-top:10px; border-top:1px solid rgba(255,255,255,.08); color:#9c948a; font-size:11px; }/* @canonical-block:000744 */
.corporate-dashboard-footer span { flex:1; padding:8px; border-radius:8px; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.04); text-align:center; font-weight:500; }/* @canonical-block:000745 */
.corporate-dashboard-badge { position:absolute; right:3%; bottom:4%; padding:9px 14px; border:1px solid rgba(212,180,131,.35); border-radius:999px; background:rgba(25,21,17,.92); color:#e6d3b3; font-size:12px; font-weight:700; box-shadow:0 12px 30px rgba(0,0,0,.35); backdrop-filter:blur(8px); }/* @canonical-block:000746 */
.corporate-dashboard-badge span { display:inline-block; width:7px; height:7px; margin-right:7px; border-radius:50%; background:#6fca91; box-shadow:0 0 10px rgba(111,202,145,.6); }/* @canonical-block:000747 */
.corporate-capability-bar { width:min(calc(100% - 48px),var(--wide)); margin:0 auto 18px; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border:1px solid rgba(36,29,23,.11); border-radius:17px; background:rgba(255,255,255,.78); box-shadow:0 14px 34px rgba(58,48,38,.07); overflow:hidden; }/* @canonical-block:000748 */
.corporate-capability-bar article { min-width:0; padding:15px 18px; display:flex; align-items:center; gap:11px; }/* @canonical-block:000749 */
.corporate-capability-bar article + article { border-left:1px solid rgba(36,29,23,.09); }/* @canonical-block:000750 */
.corporate-capability-icon { width:38px; height:38px; flex:0 0 38px; display:grid; place-items:center; border:1px solid rgba(153,117,57,.25); border-radius:11px; color:#8a6b38; background:rgba(212,180,131,.09); }/* @canonical-block:000752 */
.corporate-capability-bar h2 { margin:0 0 3px; color:#1c1919; font-size:14px; }/* @canonical-block:000753 */
.corporate-capability-bar p { margin:0; color:#706960; font-size:11px; line-height:1.4; }/* @canonical-block:000754 */
.corporate-single-cta { width:min(calc(100% - 48px),var(--wide)); margin:0 auto; padding:18px 22px; display:flex; align-items:center; justify-content:space-between; gap:20px; border:1px solid rgba(153,117,57,.2); border-radius:16px; background:linear-gradient(110deg,rgba(255,255,255,.82),rgba(250,246,238,.94)); }/* @canonical-block:000755 */
.corporate-single-cta h2 { margin:5px 0 3px; color:#1b1819; font-size:20px; letter-spacing:-.02em; }/* @canonical-block:000756 */
.corporate-single-cta p { margin:0; color:#696159; font-size:12px; }/* @canonical-block:000757 */
.corporate-single-cta-actions { display:flex; flex:0 0 auto; gap:8px; }/* @canonical-block:000758 */
.corporate-single-cta .corporate-cta,.corporate-single-cta .corporate-secondary-cta { min-height:42px; font-size:12px; }/* @canonical-block:000759 */
.corporate-single-details { padding-top:90px; }/* @canonical-block:000764 */

@media (max-width:1100px) and (min-width:761px) {
  .corporate-single-hero { min-height:calc(100svh - 210px); grid-template-columns:.85fr 1.15fr; gap:20px; padding-top:24px; }
  .corporate-single-copy h1 { font-size:clamp(38px,4.6vw,54px); }
  .corporate-dashboard-stage { min-height:330px; }
  .corporate-dashboard-window { width:100%; }
  .corporate-dashboard-body { min-height:285px; }
  .corporate-dashboard-content { padding:13px; }
  .corporate-dashboard-kpis strong { font-size:15px; }
  .corporate-dashboard-chart,.corporate-dashboard-team { min-height:105px; }
  .corporate-bars { height:70px; }
  .corporate-capability-bar { grid-template-columns:repeat(2,1fr); }
  .corporate-capability-bar article:nth-child(3) { border-left:0; border-top:1px solid rgba(36,29,23,.09); }
  .corporate-capability-bar article:nth-child(4) { border-top:1px solid rgba(36,29,23,.09); }
}/* @canonical-block:000765 */
@media (max-width:760px) {
  .corporate-single-hero { width:min(calc(100% - 32px),var(--wide)); min-height:auto; grid-template-columns:1fr; padding:44px 0 22px; gap:14px; }
  .corporate-single-copy h1 { font-size:clamp(40px,11vw,58px); }
  .corporate-single-copy > p { font-size:15px; }
  .corporate-single-proof { grid-template-columns:1fr; }
  .corporate-dashboard-stage { min-height:280px; }
  .corporate-dashboard-window { transform:none; border-radius:15px; }
  .corporate-dashboard-body { grid-template-columns:38px minmax(0,1fr); min-height:250px; }
  .corporate-dashboard-content { padding:10px; }
  .corporate-dashboard-kpis strong { font-size:13px; }
  .corporate-dashboard-grid { grid-template-columns:1fr; }
  .corporate-dashboard-team { display:none; }
  .corporate-dashboard-chart { min-height:92px; }
  .corporate-bars { height:55px; }
  .corporate-dashboard-footer { display:none; }
  .corporate-dashboard-badge { right:1%; bottom:-4px; }
  .corporate-capability-bar { width:min(calc(100% - 32px),var(--wide)); grid-template-columns:1fr; margin-bottom:16px; }
  .corporate-capability-bar article + article { border-left:0; border-top:1px solid rgba(36,29,23,.09); }
  .corporate-single-cta { width:min(calc(100% - 32px),var(--wide)); flex-direction:column; align-items:flex-start; padding:20px; }
  .corporate-single-cta-actions { width:100%; }
  .corporate-single-cta-actions a { flex:1; }
  .corporate-single-details { padding-top:70px; }
}/* @canonical-block:000782 */
.enterprise-sidebar { position:sticky; top:0; height:100vh; z-index:50; display:flex; flex-direction:column; padding:22px 14px 18px; border-right:1px solid var(--border); background:#fff; }/* @canonical-block:000783 */
.enterprise-side-brand { display:flex; align-items:center; gap:10px; min-height:52px; padding:5px 8px 18px; margin-bottom:12px; border-bottom:1px solid var(--border); }/* @canonical-block:000784 */
.enterprise-yenomi-mark { width:36px; height:36px; display:grid; place-items:center; overflow:hidden; border:1px solid var(--border-gold); border-radius:50%; background:#140d20; }/* @canonical-block:000785 */
.enterprise-yenomi-mark img { width:100%; height:100%; object-fit:contain; padding:5px; }/* @canonical-block:000786 */
.enterprise-yenomi-copy { display:grid; gap:2px; }/* @canonical-block:000787 */
.enterprise-yenomi-copy strong { color:var(--ink); font-size:15px; }/* @canonical-block:000788 */
.enterprise-yenomi-copy small { color:var(--ink-3); font-size:11px; letter-spacing:.12em; text-transform:uppercase; }/* @canonical-block:000789 */
.enterprise-canonical-nav { display:grid; gap:3px; flex:1 1 auto; min-height:0; overflow-y:auto; }/* @canonical-block:000790 */
.enterprise-side-section-title { padding:14px 9px 6px; color:#70695f; font:700 11px var(--font-mono); letter-spacing:.12em; }/* @canonical-block:000791 */
.enterprise-nav-entry { min-height:42px; display:flex; align-items:center; gap:10px; padding:0 10px; border:1px solid transparent; border-radius:10px; color:var(--ink-2); font-size:14px; }/* @canonical-block:000793 */
.enterprise-nav-entry:hover { background:var(--glass); color:var(--ink); }/* @canonical-block:000796 */
.enterprise-side-links { margin-top:auto; display:grid; gap:4px; padding-top:12px; border-top:1px solid var(--border); }/* @canonical-block:000797 */
.enterprise-side-links.enterprise-side-management { margin-top:0; padding-top:4px; border-top:0; }/* @canonical-block:000798 */
.enterprise-side-links a { display:flex; align-items:center; gap:8px; min-height:38px; padding:0 9px; border-radius:9px; color:var(--ink-3); font-size:12px; }/* @canonical-block:000799 */
.enterprise-side-links a:hover { background:var(--glass); color:var(--ink); }/* @canonical-block:000801 */
.enterprise-sidebar-mobile-close { display:none; }/* @canonical-block:000802 */
.enterprise-dashboard-main,.enterprise-dashboard-shell { min-width:0; }/* @canonical-block:000803 */
.enterprise-dashboard-shell { display:grid; grid-template-columns:250px minmax(0,1fr); align-items:start; }/* @canonical-block:000804 */
.enterprise-mobile-commandbar,.enterprise-mobile-drawer-backdrop { display:none; }/* @canonical-block:000805 */
.enterprise-topbar { min-height:68px; display:flex; align-items:center; justify-content:space-between; padding:0 28px; border-bottom:1px solid var(--border); }/* @canonical-block:000806 */
.enterprise-topbar-actions { display:flex; gap:8px; }/* @canonical-block:000807 */
.enterprise-topbar-account { display:flex; align-items:center; gap:9px; }/* @canonical-block:000808 */
.enterprise-topbar-account > div { min-width:0; display:grid; gap:2px; }/* @canonical-block:000809 */
.enterprise-topbar-account strong,
.enterprise-topbar-account small { display:block; min-width:0; overflow-wrap:anywhere; }/* @canonical-block:000810 */
.enterprise-dashboard-main > * { min-width:0; }/* @canonical-block:000811 */
.business-shell { min-height:100vh; background:radial-gradient(760px 520px at 82% 8%,rgba(109,61,224,.05),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); }/* @canonical-block:000812 */
.business-console { width:min(calc(100% - 56px),1180px); margin:auto; padding:30px 0 90px; }/* @canonical-block:000813 */
.business-hero { display:grid; grid-template-columns:1fr auto; align-items:center; gap:24px; margin-bottom:24px; }/* @canonical-block:000814 */
.business-hero h1 { margin:6px 0; font-size:clamp(28px,4vw,46px); }/* @canonical-block:000815 */
.business-hero-art { width:150px; aspect-ratio:1; display:grid; place-items:center; border-radius:20px; border:1px solid var(--border-gold); background:radial-gradient(circle at 50% 40%,rgba(109,61,224,.28),transparent 60%),var(--glass); }/* @canonical-block:000818 */
.business-kpis strong { display:block; color:var(--gold-hi); font:700 22px var(--font-mono); }/* @canonical-block:000819 */
.business-kpis span { color:var(--ink-3); font-size:12px; }/* @canonical-block:000825 */
.v25-quick-actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:000850 */
.business-seat-pack-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }/* @canonical-block:001237 */
.p11-networking-message { margin:0 0 12px; color:var(--ink-2); }/* @canonical-block:001238 */
.p11-networking-list,
.p11-networking-form { display:grid; gap:12px; }/* @canonical-block:001239 */
.p11-networking-list article,
.p11-networking-event { display:grid; gap:8px; padding:16px; border:1px solid var(--border); border-radius:16px; background:#fff; }/* @canonical-block:001240 */
.p11-networking-list strong { display:block; }/* @canonical-block:001241 */
.p11-networking-actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:001243 */
.p11-networking-form label,
.p11-networking-event label { display:grid; gap:6px; font-size:12px; color:var(--ink-2); }/* @canonical-block:001244 */
.p11-networking-form input,
.p11-networking-event select { min-height:40px; padding:8px 10px; border:1px solid var(--border); border-radius:10px; }/* @canonical-block:001248 */

/* corporate dashboard — canonical visual layer */
.p10-corporate-platform {
  width:100%;
  max-width:none;
  margin:0;
  padding:0 28px 72px;
}/* @canonical-block:001249 */
.p10-corporate-platform .enterprise-dashboard-shell {
  width:min(100%,1440px);
  margin-inline:auto;
}/* @canonical-block:001250 */
.p10-corporate-platform .enterprise-dashboard-main {
  min-width:0;
  overflow:hidden;
}/* @canonical-block:001251 */
.p10-corporate-platform .enterprise-mobile-commandbar { margin:0 -28px; }/* @canonical-block:001411 */

/* Corporate console composition — Phase 3 */
.p10-corporate-platform .business-shell {
  min-height:0;
  padding:0 0 8px;
  background:transparent;
}/* @canonical-block:001413 */
.p10-corporate-platform .business-hero {
  grid-template-columns:minmax(0,1fr) 112px;
  gap:24px;
  padding:26px 0 22px;
  margin:0;
  border-bottom:1px solid var(--border);
}/* @canonical-block:001414 */
.p10-corporate-platform .business-hero > div:first-child { min-width:0; }/* @canonical-block:001415 */
.p10-corporate-platform .business-hero > div:first-child > span {
  display:inline-flex;
  align-items:center;
  min-height:24px;
  padding:0 8px;
  border:1px solid var(--border-gold);
  border-radius:999px;
  background:var(--gold-dim);
  color:var(--gold-hi);
  font:800 11px var(--font-mono);
  letter-spacing:.12em;
}/* @canonical-block:001416 */
.p10-corporate-platform .business-hero h2 {
  max-width:720px;
  margin:10px 0 8px;
  color:var(--ink);
  font-size:clamp(28px,3.2vw,42px);
  line-height:1.05;
  letter-spacing:-.04em;
}/* @canonical-block:001417 */
.p10-corporate-platform .business-hero p {
  max-width:680px;
  margin:0;
  color:var(--ink-3);
  font-size:14px;
  line-height:1.65;
}/* @canonical-block:001418 */
.p10-corporate-platform .business-hero-art {
  width:112px;
  display:grid;
  place-items:center;
  color:var(--gold-hi);
  background:radial-gradient(circle at 50% 40%,rgba(109,61,224,.12),transparent 62%),#fff;
  box-shadow:var(--shadow-soft);
}/* @canonical-block:001420 */
.p10-corporate-platform .business-company-picker {
  display:flex;
  align-items:center;
  gap:12px;
  margin:18px 0 10px;
  padding:12px 14px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
}/* @canonical-block:001421 */
.p10-corporate-platform .business-company-picker label {
  width:min(100%,420px);
  display:grid;
  grid-template-columns:auto minmax(0,1fr);
  align-items:center;
  gap:12px;
  color:var(--ink-3);
  font-size:12px;
  font-weight:800;
}/* @canonical-block:001422 */
.p10-corporate-platform .business-company-picker select {
  min-width:0;
  min-height:38px;
  padding:0 10px;
  border:1px solid var(--border);
  border-radius:9px;
  background:#fff;
  color:var(--ink);
  font-size:12px;
}/* @canonical-block:001423 */
.p10-corporate-platform .business-account-strip {
  display:grid;
  grid-template-columns:minmax(0,1.3fr) minmax(220px,.7fr);
  gap:1px;
  margin-bottom:14px;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:12px;
  background:var(--border);
}/* @canonical-block:001424 */
.p10-corporate-platform .business-account-strip > div {
  min-width:0;
  display:grid;
  gap:3px;
  padding:13px 15px;
  background:#fff;
}/* @canonical-block:001425 */
.p10-corporate-platform .business-account-strip small {
  color:var(--ink-3);
  font-size:11px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.06em;
}/* @canonical-block:001426 */
.p10-corporate-platform .business-account-strip strong {
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:var(--ink);
  font-size:14px;
}/* @canonical-block:001427 */
.p10-corporate-platform .business-account-strip span {
  color:var(--ink-3);
  font-size:12px;
}/* @canonical-block:001428 */
.p10-corporate-platform .business-kpis { grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-bottom:16px; }/* @canonical-block:001429 */
.p10-corporate-platform .business-kpis > article {
  display:flex;
  align-items:flex-start;
  gap:10px;
  min-width:0;
  min-height:104px;
  padding:14px;
  border:1px solid var(--border);
  border-radius:13px;
  background:#fff;
  box-shadow:none;
}/* @canonical-block:001430 */
.p10-corporate-platform .business-kpis > article > i {
  width:32px;
  height:32px;
  min-width:32px;
  display:grid;
  place-items:center;
  border-radius:9px;
  font-style:normal;
}/* @canonical-block:001431 */
.p10-corporate-platform .business-kpis > article > div { min-width:0; display:grid; }/* @canonical-block:001432 */
.p10-corporate-platform .business-kpis small { color:var(--ink-3); font-size:11px; font-weight:750; }/* @canonical-block:001433 */
.p10-corporate-platform .business-kpis b { margin-top:3px; color:var(--ink); font:800 20px/1.1 var(--font-mono); }/* @canonical-block:001434 */
.p10-corporate-platform .business-kpis span { margin-top:4px; color:var(--ink-3); font-size:11px; line-height:1.4; }/* @canonical-block:001439 */
.p10-corporate-platform .business-seat-packs { margin-top:4px; }/* @canonical-block:001440 */
.p10-corporate-platform .enterprise-loading-shell { min-height:320px; display:grid; place-items:center; padding:30px 0; }/* @canonical-block:001441 */
.p10-corporate-platform .enterprise-loading-slow { margin:14px 0; padding:14px 16px; border:1px solid var(--border-gold); border-radius:12px; background:var(--gold-dim); }/* @canonical-block:001442 */
.p10-corporate-platform .enterprise-loading-slow strong { font-size:12px; }/* @canonical-block:001443 */
.p10-corporate-platform .enterprise-loading-slow p { margin:5px 0 9px; color:var(--ink-3); font-size:12px; line-height:1.5; }/* @canonical-block:001444 */
.p10-corporate-platform .enterprise-loading-slow button { min-height:34px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:#fff; color:var(--ink); font-size:12px; font-weight:800; }/* @canonical-block:001445 */

@media (max-width:1100px) {
  .p10-corporate-platform .business-kpis { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .p10-corporate-platform .business-account-strip { grid-template-columns:1fr 1fr; }
}/* @canonical-block:001446 */
@media (max-width:760px) {
  .p10-corporate-platform .business-hero { grid-template-columns:1fr; padding-top:20px; }
  .p10-corporate-platform .business-hero-art { width:100%; height:74px; min-height:74px; }
  .p10-corporate-platform .business-hero h2 { font-size:30px; }
  .p10-corporate-platform .business-company-picker { align-items:stretch; }
  .p10-corporate-platform .business-company-picker label { width:100%; grid-template-columns:1fr; gap:6px; }
  .p10-corporate-platform .business-account-strip { grid-template-columns:1fr; }
  .p10-corporate-platform .business-kpis { grid-template-columns:1fr; }
  .p10-corporate-platform .business-kpis > article { min-height:88px; }
}/* @canonical-block:001691 */

/* P0 Corporate route/data resilience */
.enterprise-route-loading { min-height:100svh; }/* @canonical-block:001692 */
.enterprise-route-loading-sidebar { min-height:100svh; padding:24px 16px; border-right:1px solid var(--border); background:rgba(255,255,255,.72); }/* @canonical-block:001693 */
.enterprise-route-loading-brand { display:flex; align-items:center; gap:10px; margin:4px 8px 34px; }/* @canonical-block:001694 */
.enterprise-route-loading-brand span { width:30px; height:30px; border-radius:50%; background:linear-gradient(145deg,#18151b,#6d3de0); }/* @canonical-block:001695 */
.enterprise-route-loading-brand i { width:96px; height:10px; border-radius:999px; background:var(--surface-muted); }/* @canonical-block:001696 */
.enterprise-route-loading-nav { display:grid; gap:12px; }/* @canonical-block:001697 */
.enterprise-route-loading-nav span { display:block; height:40px; border-radius:10px; background:linear-gradient(90deg,rgba(24,21,27,.06),rgba(24,21,27,.12),rgba(24,21,27,.06)); background-size:200% 100%; animation:yi-route-shimmer 1.4s ease-in-out infinite; }/* @canonical-block:001698 */
.enterprise-route-loading-topbar { min-height:88px; padding:20px 32px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:rgba(255,255,255,.58); }/* @canonical-block:001699 */
.enterprise-route-loading-topbar > div:first-child { display:grid; gap:8px; }/* @canonical-block:001700 */
.enterprise-route-loading-topbar span:first-child { width:220px; height:16px; border-radius:999px; background:var(--surface-muted); }/* @canonical-block:001701 */
.enterprise-route-loading-topbar span:last-child { width:150px; height:10px; border-radius:999px; background:var(--surface-muted); }/* @canonical-block:001702 */
.enterprise-route-loading-account { width:42px; height:42px; border:1px solid var(--border); border-radius:50%; display:grid; place-items:center; color:var(--ink-3); background:#fff; }/* @canonical-block:001703 */
.enterprise-route-loading-content { width:min(calc(100% - 48px),var(--content)); margin-inline:auto; padding:32px 0 64px; }/* @canonical-block:001704 */
.enterprise-route-loading-title { display:grid; gap:10px; margin-bottom:24px; }/* @canonical-block:001705 */
.enterprise-route-loading-title span:first-child { width:min(360px,60%); height:30px; border-radius:999px; background:var(--surface-muted); }/* @canonical-block:001706 */
.enterprise-route-loading-title span:last-child { width:min(520px,75%); height:12px; border-radius:999px; background:var(--surface-muted); }/* @canonical-block:001707 */
.enterprise-route-loading-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }/* @canonical-block:001708 */
.enterprise-route-loading-grid span { min-height:150px; border:1px solid var(--border); border-radius:16px; background:linear-gradient(90deg,rgba(24,21,27,.04),rgba(24,21,27,.09),rgba(24,21,27,.04)); background-size:200% 100%; animation:yi-route-shimmer 1.4s ease-in-out infinite; }/* @canonical-block:001709 */
.enterprise-data-error { margin:14px 0 18px; padding:14px 16px; border:1px solid rgba(180,63,45,.28); border-left:3px solid #b43f2d; border-radius:12px; background:rgba(180,63,45,.07); color:var(--ink); display:flex; align-items:center; gap:14px; flex-wrap:wrap; }/* @canonical-block:001710 */
.enterprise-data-error strong { font-size:13px; }/* @canonical-block:001711 */
.enterprise-data-error p { margin:0; color:var(--ink-2); font-size:13px; flex:1 1 320px; }/* @canonical-block:001712 */
.enterprise-data-error button { min-height:36px; padding:0 14px; border:1px solid rgba(180,63,45,.32); border-radius:9px; background:#fff; color:var(--ink); font-size:12px; font-weight:800; cursor:pointer; }/* @canonical-block:001713 */
.enterprise-route-error { width:min(calc(100% - 48px),720px); margin:10vh auto; padding:40px; border:1px solid var(--border); border-radius:20px; background:#fff; box-shadow:var(--shadow-soft); }/* @canonical-block:001714 */
.enterprise-route-error > span { color:var(--gold); font:700 11px/1 var(--font-mono); letter-spacing:.12em; }/* @canonical-block:001715 */
.enterprise-route-error h1 { margin:10px 0 8px; font-size:clamp(28px,4vw,42px); letter-spacing:-.04em; }/* @canonical-block:001716 */
.enterprise-route-error p { margin:0 0 22px; color:var(--ink-2); line-height:1.6; }/* @canonical-block:001717 */
.enterprise-route-error button { min-height:44px; padding:0 18px; border:0; border-radius:10px; background:var(--ink); color:#fff; font-weight:800; cursor:pointer; }/* @canonical-block:001719 */
@media (max-width: 900px) {
  .enterprise-route-loading-sidebar { display:none; }
  .enterprise-route-loading-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .enterprise-route-loading-topbar { padding-inline:20px; }
}/* @canonical-block:001720 */
@media (prefers-reduced-motion: reduce) {
  .enterprise-route-loading-nav span, .enterprise-route-loading-grid span { animation:none; }
}/* @canonical-block:001727 */
.p10-corporate-platform .business-account-strip strong,
.p10-corporate-platform .business-account-strip span {
  display: block;
}/* @canonical-block:001728 */
.p10-corporate-platform .business-account-strip span { margin-top: 2px; }/* @canonical-block:001731 */

/* Corporate account avatar: never fall back to an unstyled initial. */
.enterprise-side-user > span,
.enterprise-mobile-account-button > span {
  width: 34px;
  height: 34px;
  min-width: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border-gold);
  border-radius: 50%;
  background: var(--gold-dim);
  color: var(--gold-hi);
  font: 800 11px/1 var(--font-mono);
}/* @canonical-block:001732 */
.enterprise-side-user > div { min-width: 0; }/* @canonical-block:001733 */
.enterprise-side-user > div > strong,
.enterprise-side-user > div > small { display: block; }/* @canonical-block:001734 */
.enterprise-side-user > div > small { margin-top: 2px; }/* @canonical-block:001735 */

/* Pricing typography: all corporate plans use the same numeric treatment. */
.corporate-pricing-grid article strong {
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
}/* @canonical-block:001736 */
.corporate-pricing-grid article strong small { font-family: inherit; }/* @canonical-block:001741 */

/* Phase 26 — typography separation + auth social controls */
.p10-settings-grid button strong,
.p10-settings-grid button span,
.p10-settings-grid button small,
.p11-table-summary strong,
.p11-table-summary span,
.p11-table-summary small,
.p11-person i strong,
.p11-person i small,
.p11-mobile-meta span,
.p11-mobile-meta small,
.p11-mobile-meta b {
  display: block;
}/* @canonical-block:001742 */

.p10-settings-grid button strong,
.p11-person i strong,
.p11-table-summary strong { margin-bottom: 4px; }/* @canonical-block:001743 */

.p10-settings-grid button span,
.p11-person i small,
.p11-mobile-meta small,
.p11-table-summary small { line-height: 1.45; }/* @canonical-block:001771 */

/* Persistent panel shell: prevent a route transition from flashing an empty
   document background while the nested route resolves. */
.enterprise-panel-shell { min-height:100svh; background:var(--surface-2,#f7f5f0); }/* @canonical-block:001772 */
.enterprise-panel-shell > header,
.enterprise-panel-shell > aside { visibility:visible; }/* @canonical-block:001823 */


/* -------------------------------------------------------------------------
   Corporate route presentation — canonical surface layer
   These rules intentionally style the existing domain components without
   changing their data/API contracts. No route-specific stylesheet is used.
   ------------------------------------------------------------------------- */

.p11-employees {
  display: grid;
  gap: 20px;
  min-width: 0;
}/* @canonical-block:001824 */
.p11-cards {
  min-height: calc(100svh - 160px);
  align-content: stretch;
  grid-template-rows: auto auto minmax(0, 1fr);
}/* @canonical-block:001825 */
.p11-cards > .p11-employee-card {
  display: flex;
  flex-direction: column;
  min-height: 0;
}/* @canonical-block:001826 */
.p11-cards .p11-table-wrap {
  flex: 1 1 auto;
  min-height: 280px;
}/* @canonical-block:001827 */
.p11-cards .p11-unassigned-cards {
  display: grid;
  gap: 12px;
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
}/* @canonical-block:001828 */
.p11-cards .p11-mobile-list > article > header {
  grid-template-columns: 42px minmax(0, 1fr) auto;
}/* @canonical-block:001829 */
.p11-card-relation { display: grid; gap: 12px; min-width: 0; }/* @canonical-block:001830 */
.p11-card-flow-copy {
  margin: 0;
  color: var(--ink-2);
  font-size: 15px;
  line-height: 1.5;
}/* @canonical-block:001831 */
.p11-card-flow-copy strong {
  color: var(--ink);
  font: 700 18px/1.2 var(--font-mono);
  font-variant-numeric: tabular-nums;
}/* @canonical-block:001832 */
.p11-card-flow {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
  gap: 10px;
  align-items: stretch;
}/* @canonical-block:001833 */
.p11-card-flow > article {
  min-width: 0;
  min-height: 118px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8px;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
