/* V40 — Homepage rebuilt from the supplied visual mockup.
   Intent: one premium hero scene + one concise platform section.
   The public shell/header/footer remain shared and persistent. */
.home-mockup{
  background:#f6f3ec;
  color:#17131c;
  overflow:clip;
}/* @canonical-block:002443 */
.home-mockup__hero{
  position:relative;
  min-height:0;
  display:grid;
  grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
  align-items:center;
  gap:clamp(20px,4vw,70px);
  padding:clamp(16px,2.6vw,28px) max(6vw,32px) clamp(20px,3vw,32px);
  isolation:isolate;
  background:
    radial-gradient(circle at 76% 48%,rgba(212,180,131,.10),transparent 25%),
    linear-gradient(115deg,#faf9f5 0%,#f5f1e8 58%,#f1ece2 100%);
}/* @canonical-block:002444 */
.home-mockup__copy{
  position:relative;
  z-index:4;
  width:min(640px,100%);
  justify-self:end;
}/* @canonical-block:002445 */
.home-mockup__kicker{
  display:inline-flex;
  align-items:center;
  gap:12px;
  color:#8b6835;
  font:650 12px/1.2 var(--font-ui);
  letter-spacing:.12em;
  text-transform:uppercase;
}/* @canonical-block:002446 */
.home-mockup__kicker:before{
  content:"";
  width:38px;
  height:1px;
  background:#a47b28;
}/* @canonical-block:002447 */
.home-mockup__copy h1{
  margin:var(--space-4) 0 0;
  max-width:650px;
  font-size:clamp(52px,5.5vw,78px);
  line-height:.96;
  letter-spacing:-.052em;
  font-weight:750;
}/* @canonical-block:002448 */
.home-mockup__copy h1 em,
.home-mockup__platform h2 em{
  color:#1A1918;
  font-style:normal;
}/* @canonical-block:002449 */
.home-mockup__copy>p{
  max-width:590px;
  margin:var(--space-5) 0 0;
  color:#5f5a55;
  font:400 18px/1.7 var(--font-ui);
}/* @canonical-block:002450 */
.home-mockup__actions{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  justify-content:flex-start;
  gap:22px;
  margin-top:var(--space-5);
}/* @canonical-block:002451 */
.home-mockup__button{
  min-height:44px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:0 20px;
  border-radius:12px;
  text-decoration:none;
  font-size:14px;
  font-weight:700;
  transition:transform var(--motion-standard) var(--ease-standard),box-shadow var(--motion-standard) var(--ease-standard),background var(--motion-standard) var(--ease-standard);
}/* @canonical-block:002452 */
.home-mockup__button--primary:hover{transform:translateY(-1px)}/* @canonical-block:002453 */
.home-mockup__button--primary:active{transform:translateY(0)}/* @canonical-block:002454 */
.home-mockup__button--gold{
  color:#17110a;
  background:linear-gradient(135deg,var(--gold-hi),var(--gold));
  box-shadow:0 9px 24px rgba(164,123,40,.17);
}/* @canonical-block:002455 */
.home-mockup__button--gold:hover{box-shadow:0 14px 34px rgba(164,123,40,.26)}/* @canonical-block:002456 */
.home-mockup__link-secondary{
  display:inline-flex;
  align-items:center;
  gap:6px;
  color:#3f3a35;
  font-size:13px;
  font-weight:700;
  text-decoration:none;
  border-bottom:1px solid transparent;
  transition:color var(--motion-fast) var(--ease-standard),border-color var(--motion-fast) var(--ease-standard),gap var(--motion-fast) var(--ease-standard);
}/* @canonical-block:002457 */
.home-mockup__link-secondary:hover{
  color:#a47b28;
  border-color:rgba(164,123,40,.4);
  gap:9px;
}/* @canonical-block:002458 */
.home-mockup__meta{
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-start;
  gap:16px;
  margin-top:var(--space-4);
  color:#7b7369;
  font:600 11px/1.45 var(--font-ui);
}/* @canonical-block:002459 */
.home-mockup__guest{
  display:block;
  max-width:42ch;
  margin:12px 0 0;
  color:#71695f;
  font:400 13px/1.5 var(--font-ui);
}/* @canonical-block:002460 */
.home-mockup__visual{
  position:relative;
  min-height:min(560px,62svh);
  display:block;
}/* @canonical-block:002461 */
.home-mockup__halo{
  position:absolute;
  width:min(47vw,590px);
  aspect-ratio:1;
  left:50%;
  top:50%;
  transform:translate(-42%,-50%);
  border-radius:50%;
  background:radial-gradient(circle,rgba(176,132,49,.13),rgba(176,132,49,.045) 43%,transparent 68%);
  filter:blur(1px);
}/* @canonical-block:002462 */
.home-mockup__visual:after{
  content:"";
  position:absolute;
  width:min(55vw,720px);
  height:min(24vw,310px);
  right:-20%;
  top:18%;
  border:1px solid rgba(164,123,40,.20);
  border-radius:50%;
  transform:rotate(-20deg);
  pointer-events:none;
}/* @canonical-block:002463 */
.home-mockup__phone{
  position:absolute;
  z-index:4;
  width:min(28%,300px);
  min-width:220px;
  right:42%;
