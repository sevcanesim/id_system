.job-title-add-form input,
.job-title-add-form button {
  min-height: 44px;
}/* @canonical-block:003332 */
.job-title-add-form button { padding-inline: 16px; white-space: nowrap; }/* @canonical-block:003333 */
.job-title-list,
.title-request-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }/* @canonical-block:003334 */
.job-title-list li,
.title-request-list li {
