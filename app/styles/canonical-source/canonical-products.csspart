.products-single-price-card li { font-size: 14px; }/* @canonical-block:002754 */
.products-single-benefits p { font-size: 13px; line-height: 1.55; }/* @canonical-block:002755 */
.products-single-proof { padding: 0 0 42px; }/* @canonical-block:002756 */

/* How it works: restore real document scrolling and readable visual cards */
html:has(.how-it-works-page),
body:has(.how-it-works-page) {
  overflow-x: clip;
  overflow-y: auto;
}/* @canonical-block:002757 */
.how-it-works-page {
  height: auto;
  min-height: 100vh;
  display: block;
  overflow: visible;
  background: #f7f5ef;
}/* @canonical-block:002758 */
.how-hero {
  min-height: 290px;
  height: auto;
  padding: 64px 0 48px;
}/* @canonical-block:002759 */
.how-hero-inner {
  width: min(calc(100% - 48px), var(--wide));
  padding: 0;
}/* @canonical-block:002760 */
