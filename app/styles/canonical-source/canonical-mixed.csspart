html:has(.p10-corporate-platform),
body:has(.p10-corporate-platform),
html:has(.p8-corporate-editor),
body:has(.p8-corporate-editor) {
  background: #F9F8F6;
}/* @canonical-block:003303 */

/* ================================================================
   YENOMI ID — PANEL LAYOUT CONTRACT
   Viewport-first columns. Stack before a child can squeeze to 1ch.
   Dashboard is always a single shrinking column; only inner rows split.
   Breakpoints: 1440+ spacious / 1200 compressed 4-col / 1024 tablet /
   768 stacked / <768 mobile.
   ================================================================ */
.p10-corporate-platform .enterprise-dashboard-main,
.p10-corporate-platform .business-shell,
.p10-corporate-platform .v25-overview,
.p10-corporate-platform .v26-reference-dashboard,
.p10-corporate-platform .p11-org-workspace,
.p10-corporate-platform .p10-settings-hub {
  min-width: 0;
}/* @canonical-block:003304 */

.v26-reference-dashboard {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
}/* @canonical-block:003305 */
.v26-reference-dashboard > * { min-width: 0; }/* @canonical-block:003306 */
.v26-reference-kpis,
.p11-overview-today {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}/* @canonical-block:003307 */
.v26-reference-main-row {
  grid-template-columns: minmax(0, 1.4fr) minmax(0, .6fr);
}/* @canonical-block:003308 */
.v26-reference-main-row > * { min-width: 0; }/* @canonical-block:003309 */
.v26-reference-bottom {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}/* @canonical-block:003310 */

.v26-reference-chart > header,
.v26-reference-activity > header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}/* @canonical-block:003311 */
.v26-reference-chart > header > div:first-child,
.v26-reference-activity > header > h3 {
  flex: 1 1 14rem;
  min-width: min(100%, 14rem);
}/* @canonical-block:003312 */
.v26-reference-chart h3,
.v26-reference-activity h3,
.v26-reference-bottom h3 {
  overflow-wrap: normal;
  word-break: normal;
  hyphens: none;
}/* @canonical-block:003313 */
.v26-reference-kpis small,
.v26-reference-kpis em,
.p11-overview-today span,
.p11-overview-today em {
  overflow: hidden;
  text-overflow: ellipsis;
}/* @canonical-block:003314 */

.p10-corporate-platform .v26-hero-capabilities {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}/* @canonical-block:003318 */
.p10-settings-grid > button .yi-icon {
  width: 20px;
  height: 20px;
  color: var(--gold-hi);
}/* @canonical-block:003323 */
.p11-org-workspace .business-company-settings,
.p11-org-workspace .job-titles-panel {
  min-height: 0;
}/* @canonical-block:003324 */
.job-titles-panel {
  min-width: 0;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}/* @canonical-block:003325 */
.job-titles-panel > header { display: grid; gap: 6px; }/* @canonical-block:003326 */
.job-titles-panel > header span {
  color: var(--gold-hi);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}/* @canonical-block:003327 */
.job-titles-panel h2 {
  margin: 0;
  font-size: clamp(22px, 2.4vw, 30px);
  letter-spacing: -.03em;
}/* @canonical-block:003328 */
.job-titles-panel > header p {
  max-width: 680px;
  margin: 0;
  color: var(--ink-2);
  font-size: 14px;
  line-height: 1.6;
}/* @canonical-block:003329 */
.job-title-add-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  align-items: end;
  margin: 18px 0 16px;
}/* @canonical-block:003330 */
.job-title-add-form label {
