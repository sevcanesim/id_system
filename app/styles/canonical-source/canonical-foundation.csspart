/* @canonical-block:000008 */

/* Typography: local Inter for deterministic rendering; SF Pro / system UI as resilient fallbacks.
 * Body copy stays at 16px+ for comfortable reading; display type is reserved for hierarchy. */
/* Yenomi ID — canonical UI system
 * One source of truth. No legacy cascade and no route CSS.
 */

:root {
  /* Premium light — universal default. Dark is now an intentional accent
   * (product cards, mockups, the login panel), never a full-page theme. */
  --void: #f7f5f0;
  --deep: #efece4;
  --surface: #ffffff;
  --surface-2: #faf8f3;
  --surface-3: #f1eee6;
  --ink: #18151b;
  --ink-2: #514c46;
  --ink-3: #5f5850;
  --gold: #a9812f;
  --gold-hi: #8a6a26;
  --gold-dim: rgba(169,129,47,.12);
  --violet: #6d3de0;
  --violet-hi: #5b2fc7;
  --green: #2f9e5f;
  --red: #d1453b;
  --amber: #b3821f;
  --blue: #3a6bc4;
  --border: rgba(24,19,13,.12);
  --border-gold: rgba(153,117,57,.34);
  --glass: rgba(255,255,255,.72);
  --glass-strong: rgba(255,255,255,.92);
  --shadow: 0 24px 60px rgba(40,34,28,.13);
  --shadow-soft: 0 10px 28px rgba(40,34,28,.09);
  --glow: 0 0 48px rgba(169,129,47,.14);
  --space-unit: 8px;
  /* Motion system — every transition on the site references one of these
     three durations + two easings. Movement communicates state, hierarchy
     or feedback; nothing animates purely for decoration. */
  --motion-fast: 140ms;      /* hover/focus micro-feedback: links, icons, small toggles */
  --motion-standard: 220ms;  /* buttons, cards, inputs, most state changes */
  --motion-emphasis: 380ms;  /* modals, drawers, page-level reveals */
  --ease-standard: cubic-bezier(.4,0,.2,1);
  --ease-emphasis: cubic-bezier(.2,.8,.2,1);
  --radius-sm: 10px;
  --radius-button: 10px;
  --radius-md: 14px;
  --radius-card: 16px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --content: 1180px;
  --wide: 1320px;
  /* Typography — one scale for every public, individual and enterprise surface. */
  --font-ui: "Yenomi Inter", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-display: "Yenomi Inter Display", "Yenomi Inter", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", "PT Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --type-xs: 11px;
  --type-sm: 12px;
  --type-body-sm: 14px;
  --type-body: 16px;
  --type-body-lg: 18px;
  --type-h4: 20px;
  --type-h3: 24px;
  --type-h2: clamp(28px, 3vw, 40px);
  --type-h1: clamp(40px, 4.8vw, 64px);
  --type-display: clamp(48px, 6vw, 76px);
  --type-metric: 24px;
}/* @canonical-block:000011 */

* { box-sizing: border-box; }/* @canonical-block:000012 */
html { scroll-behavior: smooth; background: var(--void); }/* @canonical-block:000013 */
body { margin: 0; min-width: 320px; overflow-x: clip; background: var(--void); color: var(--ink); font-family: var(--font-ui); font-size: var(--type-body); line-height: 1.6; letter-spacing: -0.008em; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }/* @canonical-block:000014 */
body, button, input, select, textarea { font: inherit; }/* @canonical-block:000015 */
img, svg { display: block; max-width: 100%; }/* @canonical-block:000016 */
button, a { -webkit-tap-highlight-color: transparent; }/* @canonical-block:000017 */
a { color: inherit; text-decoration: none; }/* @canonical-block:000018 */
button { cursor: pointer; }/* @canonical-block:000019 */
button:disabled { cursor: not-allowed; opacity: .55; }/* @canonical-block:000020 */
h1,h2,h3,h4,h5,h6,p,ul,ol { margin-top: 0; }/* @canonical-block:000021 */
h1,h2,h3,h4 { color: var(--ink); font-family: var(--font-display); font-weight:700; line-height:1.1; letter-spacing:-.02em; word-spacing:.08em; }/* @canonical-block:000022 */
h1 { font-size: var(--type-h1); }/* @canonical-block:000023 */
h2 { font-size: var(--type-h2); }/* @canonical-block:000024 */
h3 { font-size: var(--type-h3); }/* @canonical-block:000025 */
h4 { font-size: var(--type-h4); }/* @canonical-block:000026 */
p,li,dd { font-size: var(--type-body); }/* @canonical-block:000029 */
p,li,dd { color: var(--ink-2); }/* @canonical-block:000030 */
::selection { background: rgba(212,180,131,.26); color: var(--ink); }/* @canonical-block:000031 */
:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }/* @canonical-block:000777 */
.ds-page-header__eyebrow,.ds-admin-page-header__eyebrow { color:var(--gold); font:700 12px var(--font-mono); letter-spacing:.14em; text-transform:uppercase; }/* @canonical-block:000780 */
.ds-page-header__actions,.ds-admin-page-header__actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:000861 */
.ds-button--sm { min-height:34px; padding-inline:10px; }/* @canonical-block:000865 */
.ds-help { color:var(--ink-3); font-size:12px; }/* @canonical-block:000866 */
.ds-error { color:#ffaaaa; font-size:12px; }/* @canonical-block:000878 */
.ds-dialog-header { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:18px 20px; border-bottom:1px solid var(--border); }/* @canonical-block:000880 */
.ds-empty__icon { width:56px; height:56px; display:grid; place-items:center; margin:auto; border:1px solid var(--border-gold); border-radius:16px; color:var(--gold); background:var(--gold-dim); }/* @canonical-block:000881 */
.ds-page-loading { min-height:55vh; display:grid; place-items:center; padding:40px; }/* @canonical-block:000882 */
.ds-page-loading__surface { width:min(100%,520px); padding:30px; border:1px solid var(--border); border-radius:18px; background:var(--glass); text-align:center; }/* @canonical-block:000884 */
.ds-page-loading__hint { color:var(--ink-3); font-size:12px; }/* @canonical-block:000885 */

/* ---- P0 FIX: ds-* temel form / layout / feedback primitifleri hiç
   stillenmemişti (Field, Input, Select, Textarea, Container, Grid, Stack,
   Alert, Badge, StatusBadge, Checkbox, Switch, Card__header/body/footer,
   Pagination, Empty, AdminPageHeader). Bu, panel genelinde görülen
   üst üste binen kart grid'i, taşan form etiketleri ve çıplak input'ların
   asıl kaynağıydı. ---- */
.ds-container { width:min(calc(100% - 48px),1180px); margin:0 auto; }/* @canonical-block:000886 */
.ds-container--dashboard { width:min(calc(100% - 56px),1280px); }/* @canonical-block:000887 */
.ds-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }/* @canonical-block:000893 */

.ds-card__header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }/* @canonical-block:000894 */
.ds-card__body { display:grid; gap:10px; }/* @canonical-block:000895 */
.ds-card__footer { display:flex; align-items:center; justify-content:flex-end; gap:10px; margin-top:16px; padding-top:14px; border-top:1px solid var(--border); }/* @canonical-block:000914 */

.ds-badge { display:inline-flex; align-items:center; min-height:24px; padding:0 9px; border-radius:999px; background:var(--surface-3); color:var(--ink-2); font-size:11px; font-weight:750; }/* @canonical-block:000915 */
.ds-badge--success,.ds-status-badge--success { background:rgba(87,213,139,.14); color:var(--green,#2f9e5f); }/* @canonical-block:000916 */
.ds-badge--warning,.ds-status-badge--warning { background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000917 */
.ds-badge--error,.ds-status-badge--error { background:rgba(224,138,138,.14); color:#c24545; }/* @canonical-block:000918 */
.ds-badge--info,.ds-status-badge--info { background:rgba(109,61,224,.12); color:var(--violet,#6d3de0); }/* @canonical-block:000925 */
.ds-alert--success { border-color:rgba(87,213,139,.35); background:rgba(87,213,139,.08); color:#2f7d4f; }/* @canonical-block:000926 */
.ds-alert--warning { border-color:var(--border-gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000927 */
.ds-alert--info { border-color:rgba(109,61,224,.3); background:rgba(109,61,224,.07); }/* @canonical-block:000932 */

.ds-pagination { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:18px; }/* @canonical-block:000933 */
.ds-pagination__pages { display:flex; gap:4px; }/* @canonical-block:000944 */
.yi-faq-trigger { width:100%; min-height:56px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:0 18px; border:0; background:transparent; color:var(--ink); font-size:14px; font-weight:700; text-align:left; cursor:pointer; }/* @canonical-block:000945 */
.yi-faq-icon { flex:0 0 auto; width:26px; height:26px; display:grid; place-items:center; border-radius:50%; background:var(--gold-dim); color:var(--gold-hi); font-size:15px; line-height:1; }/* @canonical-block:000979 */
.yi-header--dark{background:rgba(255,255,255,.82);color:var(--ink);border-color:var(--border)}/* @canonical-block:001003 */
.yi-btn--dark{background:#151119;color:#fff}/* @canonical-block:001008 */
.yi-section--dark{background:var(--void);color:var(--ink)}/* @canonical-block:001009 */
.yi-section--light{background:#f7f5ef;color:#17131c}/* @canonical-block:001015 */
.yi-product-visual--light{background:#f1eee6;border-color:rgba(24,18,30,.08)}/* @canonical-block:001018 */
.yi-orbit--one{width:76%;height:58%}/* @canonical-block:001019 */.yi-orbit--two{width:52%;height:78%;transform:rotate(24deg)}/* @canonical-block:001035 */
.yi-app__main{min-width:0}/* @canonical-block:001050 */
.yi-hero__copy{max-width:560px;color:var(--ink-3);font-size:18px;line-height:1.65;margin:28px 0 0}/* @canonical-block:001060 */
.yi-corporate__copy{color:var(--ink-3);line-height:1.7;max-width:540px}/* @canonical-block:001066 */
.yi-corporate__stats{height:120px;margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:10px}/* @canonical-block:001072 */
.yi-product-visual--corporate{min-height:430px}/* @canonical-block:001073 */

.yi-buybox{padding:28px;border:1px solid var(--border);border-radius:22px;background:rgba(255,255,255,.045)}/* @canonical-block:001718 */
@keyframes yi-route-shimmer { 0% { background-position:100% 0; } 100% { background-position:-100% 0; } }/* @canonical-block:001752 */
@keyframes yi-home-product-float {
  0%,100% { transform:translate3d(0,0,0); }
  50% { transform:translate3d(0,-8px,0); }
}/* @canonical-block:001819 */
@keyframes yi-skeleton-shimmer { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }/* @canonical-block:002341 */
@keyframes yi-home-card-float{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-12px) rotate(-2deg)}}/* @canonical-block:002342 */
@keyframes yi-home-phone-float{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-10px) rotate(-3deg)}}/* @canonical-block:002343 */
@keyframes yi-home-step-in{from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:none}}/* @canonical-block:002396 */
@keyframes yi-card-shine{0%,45%{transform:translateX(-80%)}65%,100%{transform:translateX(80%)}}/* @canonical-block:002476 */
@keyframes yi-v40-phone{
  0%,100%{transform:translateY(0) rotate(-5deg)}
  50%{transform:translateY(-10px) rotate(-3deg)}
}/* @canonical-block:002477 */
@keyframes yi-v40-card{
  0%,100%{transform:translateY(0) rotate(-7deg)}
  50%{transform:translateY(-9px) rotate(-5deg)}
}/* @canonical-block:002517 */

/* V44 — Premium Product Framework
 * System rhythm: 4 / 8 / 12 / 16 / 24 / 32 / 48 / 64 / 96 / 128.
 * Typography is semantic rather than route-specific wherever possible.
 */
:root {
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
  --space-8: 64px;
  --space-9: 96px;
  --space-10: 128px;
  --space-section: clamp(64px, 8vw, 96px);
  --space-section-lg: clamp(80px, 10vw, 128px);
  --content-readable: 62ch;
  --content-narrow: 48ch;
  --type-label: 11px;
  --type-caption: 12px;
  --type-body: 16px;
  --type-body-lg: 18px;
  --type-title-sm: clamp(24px, 2.2vw, 32px);
  --type-title: clamp(32px, 4vw, 52px);
  --type-display: clamp(46px, 6.2vw, 80px);
}/* @canonical-block:002518 */

/* Premium reading rhythm — calm body copy, decisive headings. */
body {
  font-size: var(--type-body);
  line-height: 1.62;
  letter-spacing: -0.012em;
}/* @canonical-block:002519 */

h1, h2, h3, h4 {
  line-height: 1.02;
  letter-spacing: -0.055em;
}/* @canonical-block:002520 */

p, li, dd {
  line-height: 1.62;
}/* @canonical-block:002610 */

@keyframes ds-skeleton-shimmer { to { background-position:-200% 0; } }/* @canonical-block:002611 */
@keyframes ds-modal-in { from { opacity:0; transform:translate(-50%,-48%) scale(.985); } to { opacity:1; transform:translate(-50%,-50%) scale(1); } }/* @canonical-block:002612 */
@keyframes ds-drawer-in { from { opacity:.7; transform:translateX(3%); } to { opacity:1; transform:none; } }/* @canonical-block:002613 */
@keyframes ds-overlay-in { from { opacity:0; } to { opacity:1; } }/* @canonical-block:002614 */
@keyframes ds-toast-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }/* @canonical-block:002615 */
@keyframes ds-pulse { 0%,100% { transform:scale(.94); opacity:.65; } 50% { transform:scale(1); opacity:1; } }/* @canonical-block:002618 */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior:auto; }
  *, *::before, *::after { animation-duration:.01ms ; animation-iteration-count:1 ; transition-duration:.01ms ; }
}/* @canonical-block:002707 */


/* V46 — Premium visual QA pass
   Rules:
   - natural document flow: no public marketing page is trapped in a viewport
   - local Inter typography: readable at normal desktop/mobile viewing
   - Auto Layout: minmax + flex/grid, content drives height
   - visuals are contained by aspect-ratio/max-width rather than hard coordinates
   - no horizontal overflow, no viewport-height clipping
*/

/* Global readable type scale */
html { overflow-x: clip; }/* @canonical-block:002708 */
body {
  font-family: var(--font-ui);
  font-size: 16px;
  line-height: 1.65;
  letter-spacing: -0.006em;
}/* @canonical-block:002709 */
h1,h2,h3,h4 { font-family: var(--font-display); }/* @canonical-block:002710 */
p,li,dd { font-size: 16px; }/* @canonical-block:002813 */


/* ==========================================================================
   V48 — PREMIUM VISUAL QA / AUTO-LAYOUT CONSOLIDATION
   Source: 2026-08-19 screen recording review.
   Goals: readable typography, true document scrolling, no clipped content,
   deterministic auto-layout, consistent visual assets, and calmer density.
   ========================================================================== */

:root {
  --font-ui: "Yenomi Inter", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-display: "Yenomi Inter Display", "Yenomi Inter", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "Yenomi Inter", Inter, ui-monospace, SFMono-Regular, Menlo, monospace;
  --type-body: 16px;
  --type-body-lg: 18px;
  --type-display: clamp(46px, 5.4vw, 72px);
  --content: 1180px;
  --wide: 1320px;
}/* @canonical-block:002814 */

html {
  scroll-padding-top: 116px;
}/* @canonical-block:002815 */

body {
  font-family: var(--font-ui);
  font-size: 16px;
  line-height: 1.62;
  letter-spacing: -0.012em;
}/* @canonical-block:002817 */

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
}/* @canonical-block:002820 */

main[id="main-content"],
section[id],
article[id] {
  scroll-margin-top: 116px;
}/* @canonical-block:003156 */


/* -------------------------------------------------------------------------- */
/* YENOMI ID — WARM PREMIUM PANEL THEME                                      */
/* Canonical reference: logged-out / landing experience.                     */
/* Scope: individual + corporate panel surfaces.                             */
/* -------------------------------------------------------------------------- */

:root {
  --void: #F9F8F6;
  --deep: #F5F4F0;
  --surface: #FFFFFF;
  --surface-2: #F2EFE9;
  --surface-3: #F6F4EF;
  --ink: #1A1918;
  --ink-2: #68645D;
  --ink-3: #8A857D;
  --gold: #A37B2C;
  --gold-hi: #9E7728;
  --gold-dim: #F6F1E5;
  --border: #E6E2D8;
  --border-gold: #D8D2C4;
  --glass: rgba(255,255,255,.72);
  --glass-strong: rgba(255,255,255,.94);
  --shadow: 0 14px 38px rgba(40,34,28,.08);
  --shadow-soft: 0 2px 8px rgba(0,0,0,.04);
}/* @canonical-block:003157 */

html { background:#F9F8F6; }/* @canonical-block:003158 */
body { background:#F9F8F6; color:#1A1918; }/* @canonical-block:003408 */
@keyframes yi-brand-marquee {
  to { transform: translateX(-50%); }
}/* @canonical-block:003431 */

main[id="main-content"],
section[id],
article[id] {
  scroll-margin-top: 124px;
}/* @canonical-block:003639 */
#seat-pack-grid {
  scroll-margin-top: 88px;
}/* @canonical-block:003859 */

html[data-sensitive-obscured] body {
  filter: blur(28px);
  pointer-events: none;
  user-select: none;
}/* @canonical-block:004030 */
@keyframes yi-brand-marquee {
  to { transform: translateX(-50%); }
}/* @canonical-block:004117 */

/* Headings: Inter files are 400/500/600/700. Word-spacing is a font metric. */
h1, h2, h3, h4 {
  word-spacing: normal;
}/* @canonical-block:004419 */

@keyframes p6FloatScene {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-7px); }
}/* @canonical-block:004443 */










