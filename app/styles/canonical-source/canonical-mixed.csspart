.yi-app--individual .yi-page-head{padding-bottom:22px}/* @canonical-block:001666 */.yi-app--individual .yi-page-head>span{color:var(--gold-hi);font:700 11px var(--font-mono);letter-spacing:.14em}/* @canonical-block:001667 */.yi-app--individual .yi-page-head h1{font-size:clamp(30px,3.2vw,48px);letter-spacing:-.045em;margin-top:7px}/* @canonical-block:001668 */.yi-app--individual .yi-page-head p{max-width:680px;font-size:15px;color:var(--ink-3)}/* @canonical-block:001669 */
.yi-dashboard-grid{max-width:1180px}/* @canonical-block:001670 */.yi-dashboard-hero{grid-template-columns:minmax(300px,.8fr) minmax(360px,1.2fr);gap:30px;padding:24px;border-radius:20px}/* @canonical-block:001671 */.yi-dashboard-card{min-height:300px;position:relative;overflow:hidden;background:linear-gradient(145deg,#26221e 0%,#141210 70%,#0f0d0b 100%);color:#f7f3eb;border-color:rgba(212,180,131,.32);box-shadow:0 24px 60px rgba(25,20,12,.16)}/* @canonical-block:001672 */.yi-dashboard-card:after{content:"";position:absolute;width:220px;height:220px;right:-90px;top:-80px;border:1px solid rgba(212,180,131,.25);border-radius:50%;box-shadow:0 0 0 28px rgba(212,180,131,.035),0 0 0 58px rgba(212,180,131,.02)}/* @canonical-block:001673 */.yi-dashboard-card strong{position:relative;z-index:1;font-size:30px}/* @canonical-block:001674 */.yi-dashboard-card small{position:relative;z-index:1;color:#c9c0b3}/* @canonical-block:001675 */.yi-dashboard-card span{position:relative;z-index:1}/* @canonical-block:001676 */
.yi-dashboard-hero>div:last-child{padding:8px 12px}/* @canonical-block:001677 */.yi-dashboard-hero h2{font-size:clamp(28px,3vw,38px);max-width:520px}/* @canonical-block:001678 */.yi-dashboard-hero p{max-width:520px}/* @canonical-block:001679 */.yi-dashboard-hero progress{display:block;margin:18px 0 20px;height:7px;border:0;border-radius:999px;overflow:hidden;background:#ece7de}/* @canonical-block:001680 */.yi-dashboard-hero progress::-webkit-progress-bar{background:#ece7de;border-radius:999px}/* @canonical-block:001681 */.yi-dashboard-hero progress::-webkit-progress-value{background:linear-gradient(90deg,#a9812f,#d4b483);border-radius:999px}/* @canonical-block:001682 */.yi-dashboard-hero progress::-moz-progress-bar{background:linear-gradient(90deg,#a9812f,#d4b483);border-radius:999px}/* @canonical-block:001683 */
.yi-metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}/* @canonical-block:001684 */.yi-metric-grid>div{padding:17px 18px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.72);box-shadow:0 8px 28px rgba(30,25,18,.05)}/* @canonical-block:001685 */.yi-metric-grid small{display:block;color:var(--ink-3);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}/* @canonical-block:001686 */.yi-metric-grid strong{display:block;margin-top:6px;color:var(--ink);font:700 25px var(--font-mono)}/* @canonical-block:001687 */.yi-metric-grid span{display:block;margin-top:4px;color:var(--ink-3);font-size:12px}/* @canonical-block:001688 */
.yi-next-step{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 22px}/* @canonical-block:001689 */.yi-next-step>div:first-child span{color:var(--gold-hi);font:700 10px var(--font-mono);letter-spacing:.12em}/* @canonical-block:001690 */.yi-next-step h2{margin:5px 0 3px;font-size:21px}/* @canonical-block:001691 */.yi-next-step p{margin:0;color:var(--ink-3);font-size:14px}/* @canonical-block:001692 */.yi-next-step .yi-actions{flex-wrap:wrap;justify-content:flex-end}/* @canonical-block:001693 */
@media(max-width:900px){.yi-dashboard-hero{grid-template-columns:1fr}.yi-next-step{align-items:flex-start;flex-direction:column}.yi-next-step .yi-actions{justify-content:flex-start}}/* @canonical-block:001694 */
@media(max-width:640px){.yi-app--individual .yi-app__top{padding-inline:16px}.yi-top-account__label{display:none}.yi-top-actions{gap:12px}.yi-top-actions a:first-child{display:none}.yi-dashboard-hero{padding:16px}.yi-dashboard-card{min-height:240px}.yi-metric-grid{grid-template-columns:1fr}.yi-next-step{padding:18px}.yi-page-head h1{font-size:30px}}/* @canonical-block:001725 */

/* Corporate panel typography QA: keep title/description pairs structurally separated. */
.p10-corporate-platform .business-company-settings > header > div,
.p10-corporate-platform .template-reference-heading > div,
.p10-corporate-platform .settings-tristate > span,
.p10-corporate-platform .template-preview-note,
.p10-corporate-platform .business-account-strip > div {
  display: grid;
  gap: 4px;
  min-width: 0;
}/* @canonical-block:001726 */
.p10-corporate-platform .business-company-settings > header > div > span,
.p10-corporate-platform .template-reference-heading > div > span,
.p10-corporate-platform .business-account-strip small {
  display: block;
}/* @canonical-block:001727 */
.p10-corporate-platform .business-company-settings h2,
.p10-corporate-platform .template-reference-heading h2 {
  margin: 2px 0 0;
}/* @canonical-block:001728 */
.p10-corporate-platform .business-company-settings header p,
.p10-corporate-platform .template-reference-heading p {
  margin: 2px 0 0;
  line-height: 1.55;
}/* @canonical-block:001729 */
.p10-corporate-platform .settings-tristate > span > strong,
.p10-corporate-platform .settings-tristate > span > small {
  display: block;
}/* @canonical-block:001730 */
.p10-corporate-platform .settings-tristate > span > small {
  margin-top: 3px;
  line-height: 1.45;
}/* @canonical-block:001741 */

/* Prevent dense corporate card metadata from collapsing into inline text. */
.p10-corporate-platform .business-kpis article > div,
.p10-corporate-platform .business-seat-packs .license-reference-proofs span,
.p10-corporate-platform .license-reference-features span {
  display: grid;
  gap: 3px;
}/* @canonical-block:001743 */
.p6-auth-business-note .yi-icon { width:16px; height:16px; color:var(--gold); }/* @canonical-block:001750 */

/* Phase 26 — shared title/description rhythm */
.p6-auth-features > li,
.p6-auth-security,
.p12-row-copy,
.compact-link-copy,
.primary-save > span:not(.primary-save-icon),
.enterprise-yenomi-copy,
.p9-session-row > div,
.p11-person i {
  min-width: 0;
}/* @canonical-block:001751 */

.p6-auth-features > li > span,
.p6-auth-security > span,
.p12-row-copy,
.compact-link-copy,
.primary-save > span:not(.primary-save-icon),
.enterprise-yenomi-copy,
.p9-session-row > div,
.p11-person i {
  display: flex;
  flex-direction: column;
  gap: 4px;
}/* @canonical-block:001752 */

.p6-auth-features > li > span > strong,
.p6-auth-security > span > strong,
.p12-row-copy > strong,
.compact-link-copy > strong,
.primary-save > span:not(.primary-save-icon) > strong,
.enterprise-yenomi-copy > strong,
.p9-session-row > div > strong,
.p11-person i > strong {
  line-height: 1.25;
  overflow-wrap: anywhere;
}/* @canonical-block:001753 */

.p6-auth-features > li > span > small,
.p6-auth-security > span > small,
.p12-row-copy > small,
.compact-link-copy > small,
.primary-save > span:not(.primary-save-icon) > small,
.enterprise-yenomi-copy > small,
.p9-session-row > div > span,
.p11-person i > small {
  line-height: 1.45;
  overflow-wrap: anywhere;
}/* @canonical-block:001772 */

/* Corporate pricing: all price values share the same numeric treatment. */
.corporate-price,
.corporate-pricing-card .price,
.corporate-pricing-card .pricing-price,
.corporate-pricing-card [data-price] {
  font-family:var(--font-sans,Inter,sans-serif);
  font-variant-numeric:tabular-nums;
}/* @canonical-block:001773 */
.corporate-pricing-card .price-mono,
.corporate-pricing-card .enterprise-price { font-family:var(--font-sans,Inter,sans-serif); }/* @canonical-block:001774 */

/* Cart CTA: never expose a dead product path. */
.yi-cart-empty .yi-btn[href="/urunler/nfc-kart"],
.yi-cart-empty .yi-btn[href="/urunler/nfc-kart/"] { min-width:180px; }/* @canonical-block:001777 */

/* P2 completion — stable admin metrics and individual route loading shell. */
.admin-shell { width:min(calc(100% - 48px),var(--content)); margin-inline:auto; padding:34px 0 80px; }/* @canonical-block:001778 */
.admin-heading { max-width:760px; margin-bottom:22px; }/* @canonical-block:001779 */
.admin-heading h1 { margin:6px 0 8px; font-size:clamp(30px,4vw,48px); line-height:1.04; }/* @canonical-block:001780 */
.admin-heading p { margin:0; color:var(--ink-3); }/* @canonical-block:001781 */
.admin-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin:22px 0; }/* @canonical-block:001782 */
.admin-stats article { min-width:0; min-height:112px; height:auto; padding:18px; display:flex; flex-direction:column; justify-content:space-between; gap:12px; border:1px solid var(--border); border-radius:14px; background:var(--surface); box-shadow:var(--shadow-soft); }/* @canonical-block:001783 */
.admin-stats article small { color:var(--ink-3); font-size:12px; line-height:1.35; }/* @canonical-block:001784 */
.admin-stats article b { display:block; min-width:0; overflow-wrap:anywhere; color:var(--ink); font:800 clamp(22px,2.2vw,30px)/1.05 var(--font-mono); font-variant-numeric:tabular-nums; }/* @canonical-block:001785 */
.admin-tabs { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 18px; }/* @canonical-block:001786 */
.admin-tabs button { min-height:40px; padding:0 14px; border:1px solid var(--border); border-radius:10px; background:var(--surface); font:700 13px inherit; }/* @canonical-block:001787 */
.admin-tabs button.active { border-color:var(--border-gold); background:#fff; }/* @canonical-block:001788 */
.admin-filter { display:flex; flex-wrap:wrap; gap:12px; margin:0 0 18px; }/* @canonical-block:001790 */
.admin-order { display:grid; gap:16px; min-width:0; padding:18px; border:1px solid var(--border); border-radius:16px; background:var(--surface); box-shadow:var(--shadow-soft); }/* @canonical-block:001791 */
.admin-order-top { display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; }/* @canonical-block:001792 */
.admin-order-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; min-width:0; }/* @canonical-block:001793 */
.admin-order-grid > div { display:grid; align-content:start; gap:4px; min-width:0; }/* @canonical-block:001794 */
.admin-order-grid small { display:block; color:var(--ink-3); font-size:11px; letter-spacing:.06em; text-transform:uppercase; }/* @canonical-block:001795 */
.admin-order-grid b { display:block; color:var(--ink); font-size:15px; line-height:1.35; overflow-wrap:anywhere; }/* @canonical-block:001796 */
.admin-order-grid span { display:block; color:var(--ink-3); font-size:13px; line-height:1.4; overflow-wrap:anywhere; }/* @canonical-block:001797 */
.admin-status-controls { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }/* @canonical-block:001799 */
.admin-order-actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:001824 */
@media (max-width:900px) { .admin-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .admin-order-grid,.payment-retry { grid-template-columns:1fr; } .p7-loading-sidebar { width:220px; } .p7-loading-grid { grid-template-columns:1fr 1fr; } }/* @canonical-block:001825 */
@media (max-width:640px) { .admin-shell { width:min(calc(100% - 32px),var(--content)); padding-top:24px; } .admin-stats { grid-template-columns:1fr 1fr; } .admin-stats article { min-height:96px; padding:14px; } .p7-loading-sidebar { display:none; } .p7-loading-grid { grid-template-columns:1fr; } }/* @canonical-block:001844 */
.p11-cards .p10-card-list .ds-button {
  min-height: 40px;
  padding: 0 14px;
  font-size: 13px;
}/* @canonical-block:001890 */
.p11-search .yi-icon {
  position: absolute;
  left: 13px;
  top: 50%;
  width: 17px;
  height: 17px;
  color: var(--ink-3);
  transform: translateY(-50%);
}/* @canonical-block:001897 */
.p11-secondary,
.p11-invite-actions a,
.p11-invite-actions label,
.corp-link-actions button.secondary,
.corp-link-upload {
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--ink);
}/* @canonical-block:001913 */
.p11-table td.actions { white-space: nowrap; }/* @canonical-block:001914 */
.p11-table td.actions button {
  min-height: 32px;
  margin-right: 6px;
  padding: 0 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface);
  color: var(--ink);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}/* @canonical-block:001915 */
.p11-table td.actions button:hover { border-color: var(--gold); }/* @canonical-block:001924 */
.p11-form-grid label,
.company-settings-grid label,
.business-template-fields label {
  display: grid;
  gap: 7px;
  color: var(--ink-2);
  font-size: 12px;
  font-weight: 700;
}/* @canonical-block:001930 */
.p11-capacity-warning > span .yi-icon {
  flex: 0 0 auto;
  margin-top: 2px;
  color: var(--gold-hi);
}/* @canonical-block:001939 */
.p11-bulk-bar-actions button.danger {
  border-color: color-mix(in srgb, var(--red) 35%, var(--border));
  color: var(--red);
}/* @canonical-block:001944 */
.company-settings-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18px;
  margin-top: 18px;
}/* @canonical-block:001945 */
.company-settings-grid.single { grid-template-columns: 1fr; }/* @canonical-block:001946 */
.company-settings-grid > section {
  min-width: 0;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--surface-2);
}/* @canonical-block:001947 */
.company-settings-grid h3 { margin: 0 0 12px; color: var(--ink); font-size: 15px; }/* @canonical-block:001948 */
.company-settings-grid p { margin: 0 0 14px; color: var(--ink-3); font-size: 12px; line-height: 1.6; }/* @canonical-block:001949 */
.company-settings-grid textarea { min-height: 96px; resize: vertical; }/* @canonical-block:001950 */
.settings-tristate {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  padding: 13px 0;
  border-top: 1px solid var(--border);
}/* @canonical-block:001951 */
.settings-tristate > span { display: grid; gap: 3px; min-width: 0; }/* @canonical-block:001952 */
.settings-tristate strong { color: var(--ink); font-size: 13px; }/* @canonical-block:001953 */
.settings-tristate small { color: var(--ink-3); font-size: 11px; line-height: 1.45; }/* @canonical-block:001954 */
.settings-tristate-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) repeat(3, 38px);
  gap: 8px;
  margin-bottom: 4px;
  color: var(--ink-3);
  font-size: 11px;
  text-align: center;
}/* @canonical-block:001955 */
.settings-tristate-control { display: flex; gap: 6px; }/* @canonical-block:001956 */
.settings-tristate-control button {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface);
  color: var(--ink-3);
}/* @canonical-block:001957 */
.settings-tristate-control button.active {
  border-color: var(--gold);
  background: var(--gold-dim);
  color: var(--gold-hi);
}/* @canonical-block:001960 */
.template-reference-heading > strong {
  align-self: flex-start;
  padding: 7px 10px;
  border: 1px solid var(--border-gold);
  border-radius: 999px;
  background: var(--gold-dim);
  color: var(--gold-hi);
  font-size: 11px;
  letter-spacing: .08em;
}/* @canonical-block:001963 */
.template-color-control { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 8px; align-items: center; }/* @canonical-block:001964 */
.template-color-control input[type="color"] { width: 52px; min-height: 44px; padding: 4px; }/* @canonical-block:001965 */
.template-preview-note {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 12px;
  border-radius: 11px;
  background: var(--gold-dim);
  color: var(--ink-2);
  font-size: 12px;
  line-height: 1.5;
}/* @canonical-block:001985 */
.corp-link-status dd.published { color: var(--green); }/* @canonical-block:001986 */
.corp-link-status dd.draft { color: var(--amber); }/* @canonical-block:001987 */
.corp-link-status dd.scheduled { color: var(--gold-hi); }/* @canonical-block:001988 */
.corp-link-status dd.empty { color: var(--ink-3); font-weight: 650; }/* @canonical-block:001990 */
.corp-link-current.empty { color: var(--ink-3); font-style: italic; }/* @canonical-block:002003 */
.corp-link-publication.published { background: rgba(47,158,95,.12); color: var(--green); }/* @canonical-block:002010 */
.corp-link-history summary .yi-icon { color: var(--gold-hi); }/* @canonical-block:002012 */
.corp-link-history[open] summary > .yi-icon:last-child { transform: rotate(180deg); }/* @canonical-block:002019 */
@media (max-width: 1000px) {
  .p11-toolbar .p11-filter-control { max-width: none; }
  .p11-toolbar .p11-primary,
  .p11-toolbar .p11-secondary { width: auto; flex: 1 1 160px; }
  .business-template-workbench,
  .company-settings-grid,
  .corp-links-list > li { grid-template-columns: 1fr; }
  .corp-link-status { grid-template-columns: 1fr; }
  .corp-file { grid-template-columns: auto minmax(0, 1fr); }
  .corp-file-actions { grid-column: 1 / -1; justify-content: flex-start; }
  .corp-link-actions { grid-template-columns: 1fr 1fr; }
  .corp-link-schedule { grid-column: 1 / -1; }
  .p11-card-flow { grid-template-columns: minmax(0, 1fr); }
  .p11-card-flow-join { height: 20px; transform: rotate(90deg); }
}/* @canonical-block:002021 */
@media (max-width: 520px) {
  .p11-kpis { grid-template-columns: 1fr; }
  .p11-overview-org,
  .p11-overview-today,
  .p11-analytics-compare { grid-template-columns: 1fr; }
  .settings-tristate { grid-template-columns: 1fr; }
  .settings-tristate-head { display: none; }
  .corp-link-actions { grid-template-columns: 1fr; }
  .corp-link-schedule { grid-column: auto; }
}/* @canonical-block:002022 */

/* P31 — route presentation hardening: public profile, corporate domain views */
.p12-public-card a:focus-visible,
.p12-public-card button:focus-visible,
.p10-corporate-platform button:focus-visible,
.p10-corporate-platform a:focus-visible,
.p10-corporate-platform select:focus-visible,
.v25-employee-drawer button:focus-visible,
.v25-employee-drawer input:focus-visible,
.v25-employee-drawer select:focus-visible,
.v25-employee-drawer a:focus-visible {
  outline: 2px solid var(--gold-hi);
  outline-offset: 3px;
}/* @canonical-block:002023 */

/* Employee detail: overlay workspace, not an in-flow native HTML slab. */
.ds-drawer.v25-employee-drawer {
  width: min(1080px, 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surface);
}/* @canonical-block:002024 */
.v25-drawer-identity {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  gap: 12px 14px;
  padding: 12px 20px;
  border-bottom: 1px solid var(--border);
  flex: 0 0 auto;
}/* @canonical-block:002025 */
.v25-drawer-identity > div { min-width: 0; display: grid; gap: 2px; }/* @canonical-block:002026 */
.v25-drawer-identity strong { color: var(--ink); font-size: 15px; }/* @canonical-block:002027 */
.v25-drawer-identity small,
.v25-drawer-identity span { color: var(--ink-3); font-size: 12px; }/* @canonical-block:002028 */
.v25-status-summary {
  display: grid;
  gap: 10px;
  padding: 12px 20px 14px;
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
  flex: 0 0 auto;
}/* @canonical-block:002029 */
.v25-status-summary header small,
.v25-drawer-manage-label {
  display: block;
  margin: 0;
  color: var(--gold-hi);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}/* @canonical-block:002030 */
.v25-drawer-manage-label { margin: 0 0 8px; }/* @canonical-block:002031 */
.v25-status-summary dl {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
}/* @canonical-block:002032 */
.v25-status-summary dl > div {
  min-width: 0;
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
}/* @canonical-block:002033 */
.v25-status-summary dt {
  color: var(--ink-3);
  font-size: 11px;
  font-weight: 700;
}/* @canonical-block:002034 */
.v25-status-summary dd {
  margin: 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 750;
}/* @canonical-block:002035 */
.v25-drawer-workspace {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 360px);
  overflow: hidden;
}/* @canonical-block:002036 */
.v25-drawer-main,
.v25-drawer-preview {
  min-width: 0;
  overflow: auto;
  padding: 16px 20px 24px;
}/* @canonical-block:002037 */
.v25-drawer-preview {
  border-left: 1px solid var(--border);
  background: var(--surface-2);
}/* @canonical-block:002038 */
.v25-employee-drawer .ds-tabs { margin-bottom: 16px; }/* @canonical-block:002039 */
.v25-employee-drawer .v25-section-heading {
  align-items: flex-start;
  margin-bottom: 14px;
}/* @canonical-block:002040 */
.v25-employee-drawer .v25-section-heading h3 { margin: 4px 0 0; color: var(--ink); font-size: 16px; }/* @canonical-block:002041 */
.v25-employee-drawer .v25-section-heading p { margin: 4px 0 0; color: var(--ink-3); font-size: 12px; line-height: 1.5; }/* @canonical-block:002042 */
.v25-employee-drawer .v25-section-heading small {
  color: var(--gold-hi);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
}/* @canonical-block:002043 */
.v25-employee-drawer .v25-section-heading .yi-icon { color: var(--gold-hi); }/* @canonical-block:002044 */
.v25-employee-form,
.v25-invite-detail,
.v25-card-drawer,
.v25-lifecycle { display: grid; gap: 14px; }/* @canonical-block:002045 */
.v25-readonly-role,
.v25-complete-state,
.v25-inline-warning,
.v25-empty-line,
.v25-danger-zone,
.v25-identity-audit,
.v25-physical-control-row {
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
}/* @canonical-block:002046 */
.v25-readonly-role,
.v25-complete-state,
.v25-inline-warning { display: grid; gap: 4px; }/* @canonical-block:002047 */
.v25-readonly-role small,
.v25-identity-audit small { color: var(--ink-3); font-size: 11px; font-weight: 700; }/* @canonical-block:002048 */
.v25-readonly-role span,
.v25-danger-zone p,
.v25-identity-audit p { color: var(--ink-3); font-size: 12px; line-height: 1.5; }/* @canonical-block:002049 */
.v25-inline-warning { grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 10px; background: var(--gold-dim); border-color: var(--border-gold); }/* @canonical-block:002050 */
.v25-complete-state { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 10px; }/* @canonical-block:002051 */
.v25-drawer-actions { display: flex; flex-wrap: wrap; gap: 8px; }/* @canonical-block:002052 */
.v25-invite-detail dl { display: grid; gap: 8px; margin: 0; }/* @canonical-block:002053 */
.v25-invite-detail dl > div {
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr);
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
}/* @canonical-block:002054 */
.v25-invite-detail dt { color: var(--ink-3); font-size: 12px; }/* @canonical-block:002055 */
.v25-invite-detail dd { margin: 0; color: var(--ink); font-size: 13px; }/* @canonical-block:002056 */
.v25-lifecycle ol { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }/* @canonical-block:002057 */
.v25-lifecycle li {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
}/* @canonical-block:002058 */
.v25-lifecycle li > i {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-3);
  font: 700 11px var(--font-mono);
  font-style: normal;
}/* @canonical-block:002059 */
.v25-lifecycle li.done > i { background: var(--gold-dim); color: var(--gold-hi); }/* @canonical-block:002060 */
.v25-lifecycle li strong { display: block; font-size: 13px; }/* @canonical-block:002061 */
.v25-lifecycle li span { color: var(--ink-3); font-size: 12px; }/* @canonical-block:002062 */
.v25-identity-audit { display: grid; gap: 12px; }/* @canonical-block:002063 */
.v25-identity-audit ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }/* @canonical-block:002064 */
.v25-identity-audit li {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: start;
}/* @canonical-block:002065 */
.v25-identity-audit-empty { margin: 0; color: var(--ink-3); font-size: 12px; }/* @canonical-block:002066 */
.v25-physical-control-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}/* @canonical-block:002067 */
.v25-physical-control-row > div { min-width: 0; display: grid; gap: 2px; }/* @canonical-block:002068 */
.v25-physical-control-row strong { font-size: 13px; }/* @canonical-block:002069 */
.v25-physical-control-row span,
.v25-physical-control-row small { color: var(--ink-3); font-size: 12px; }/* @canonical-block:002070 */
.v25-card-preview-wrap { min-width: 0; }/* @canonical-block:002071 */
.v25-employee-drawer .p8-preview-stage { max-width: 320px; margin: 0 auto; }/* @canonical-block:002072 */
.v25-employee-drawer .ds-empty { width: 100%; padding: 24px 8px; }/* @canonical-block:002073 */

@media (max-width: 860px) {
  .v25-drawer-workspace { grid-template-columns: minmax(0, 1fr); }
  .v25-drawer-preview { border-left: 0; border-top: 1px solid var(--border); }
  .v25-status-summary dl { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}/* @canonical-block:002074 */
@media (max-width: 520px) {
  .v25-status-summary dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}/* @canonical-block:002113 */
.business-seat-pack-grid > article.recommended {
  border-color: var(--border-gold);
  box-shadow: var(--shadow-soft);
  padding-top: 42px;
}/* @canonical-block:002114 */
.seat-pack-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  padding: 5px 9px;
  border-radius: 999px;
  background: var(--gold);
  color: #17120c;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}/* @canonical-block:002115 */
.seat-pack-guide {
  margin: 0 0 8px;
  max-width: 760px;
  color: var(--ink-2);
  font-size: 14px;
  line-height: 1.65;
}/* @canonical-block:002116 */
.seat-pack-fit {
  margin: 0;
  color: var(--gold-hi);
  font-size: 12px;
  font-weight: 750;
}/* @canonical-block:002119 */
.business-seat-pack-grid .seat-pack-price {
  display: grid;
  gap: 4px;
  padding: 14px;
  color: inherit;
  font: inherit;
}/* @canonical-block:002120 */
.business-seat-pack-grid .seat-pack-price strong {
  display: block;
  color: var(--gold-hi);
  font: 700 28px/1.1 var(--font-mono);
  font-variant-numeric: tabular-nums;
}/* @canonical-block:002121 */
.business-seat-pack-grid .seat-pack-price span,
.business-seat-pack-grid .seat-pack-price small {
  display: block;
  color: var(--ink-3);
  font: 650 12px/1.4 var(--font-ui);
}/* @canonical-block:002122 */
.seat-pack-cta {
  width: 100%;
  min-height: 48px;
  margin-top: auto;
  font-size: 14px;
  font-weight: 800;
}/* @canonical-block:002124 */
@media (max-width: 480px) {
  .p10-metric-grid { grid-template-columns:1fr; }
  .p12-contact-list a,
  .p12-managed-links a { min-height: 68px; }
}/* @canonical-block:002241 */


/* V34-PRODUCT-SINGLE-PAGE
   Product detail follows the public single-page narrative pattern.
   Product data and checkout remain database-driven. */
.product-one-page{background:#f7f5ef;color:#17131c;overflow:hidden}/* @canonical-block:002242 */
.product-one-page__hero{padding:82px 0 112px;background:linear-gradient(180deg,#fbfaf7,#f1eee7)}/* @canonical-block:002243 */
.product-one-page__hero-inner{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:70px;align-items:center}/* @canonical-block:002244 */
.product-one-page__copy h1{margin:16px 0 0;font-size:clamp(52px,6.5vw,88px);line-height:.9;letter-spacing:-.06em}/* @canonical-block:002245 */
.product-one-page__copy h1 em,.product-one-page__statement h2 em,.product-one-page__final h2 em{font-style:normal;color:#a9812f}/* @canonical-block:002246 */
.product-one-page__copy>p{max-width:600px;margin:26px 0 0;color:#716a72;font-size:18px;line-height:1.7}/* @canonical-block:002247 */
.product-one-page__buy{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-top:32px;padding:20px;border:1px solid #e1dbd1;border-radius:18px;background:rgba(255,255,255,.72)}/* @canonical-block:002248 */
.product-one-page__price{display:grid;gap:4px;min-width:0}/* @canonical-block:002249 */
.product-one-page__price span{color:#a9812f;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}/* @canonical-block:002250 */
.product-one-page__price strong{font-size:38px;line-height:1;letter-spacing:-.05em}/* @canonical-block:002251 */
.product-one-page__price small{color:#777078;font-size:11px;line-height:1.45}/* @canonical-block:002252 */
.product-one-page__buy form,.product-one-page__buy>div:last-child{min-width:180px}/* @canonical-block:002253 */
.product-one-page__trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:18px;color:#777078;font-size:12px}/* @canonical-block:002254 */
.product-one-page__trust span{display:inline-flex;align-items:center;gap:6px}/* @canonical-block:002255 */
.product-one-page__trust .yi-icon{width:13px;height:13px;min-width:13px;color:#a47b28}/* @canonical-block:002256 */
.product-one-page__visual{min-height:560px;display:grid;place-items:center}/* @canonical-block:002257 */
.product-one-page__statement{padding:120px 0;background:#fff}/* @canonical-block:002258 */
.product-one-page__statement-inner{max-width:900px}/* @canonical-block:002259 */
.product-one-page__statement h2{margin:16px 0 20px;font-size:clamp(46px,6vw,78px);line-height:.92;letter-spacing:-.06em}/* @canonical-block:002260 */
.product-one-page__statement p{max-width:600px;margin:0;color:#716a72;font-size:18px;line-height:1.7}/* @canonical-block:002261 */
.product-one-page__reasons{padding:112px 0;background:#f7f5ef}/* @canonical-block:002262 */
.product-one-page__section-head{max-width:650px;margin-bottom:42px}/* @canonical-block:002263 */
.product-one-page__section-head h2{margin:14px 0 0;font-size:clamp(40px,5vw,64px);line-height:.95;letter-spacing:-.055em}/* @canonical-block:002264 */
.product-one-page__reason-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}/* @canonical-block:002265 */
.product-one-page__reason-grid article{min-height:300px;padding:26px;background:#fff;border:1px solid #e2ddd5;border-radius:22px;display:flex;flex-direction:column}/* @canonical-block:002266 */
.product-one-page__reason-grid article>span{color:#a9812f;font-family:"IBM Plex Mono",monospace;font-size:12px}/* @canonical-block:002267 */
.product-one-page__reason-grid h3{margin:58px 0 12px;font-size:24px;letter-spacing:-.025em}/* @canonical-block:002268 */
.product-one-page__reason-grid p{margin:0;color:#716a72;line-height:1.65;font-size:14px}/* @canonical-block:002269 */
.product-one-page__journey{padding:112px 0;background:#17131c;color:#f7f4ee}/* @canonical-block:002270 */
.product-one-page__journey-inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}/* @canonical-block:002271 */
.product-one-page__journey-copy h2{margin:14px 0 20px;font-size:clamp(40px,5vw,64px);line-height:.95;letter-spacing:-.055em}/* @canonical-block:002272 */
.product-one-page__journey-copy>p{max-width:570px;color:#b8b0a7;line-height:1.7;font-size:16px}/* @canonical-block:002273 */
.product-one-page__journey-list{display:grid;gap:0;margin-top:30px}/* @canonical-block:002274 */
.product-one-page__journey-list div{display:grid;gap:5px;padding:16px 0;border-top:1px solid rgba(255,255,255,.1)}/* @canonical-block:002275 */
.product-one-page__journey-list strong{font-size:14px}/* @canonical-block:002276 */.product-one-page__journey-list span{color:#a79f98;font-size:13px;line-height:1.5}/* @canonical-block:002277 */
.product-one-page__mini-card{min-height:430px;border:1px solid rgba(212,180,131,.16);border-radius:26px;overflow:hidden}/* @canonical-block:002278 */
.product-one-page__final{padding:130px 24px;background:#f7f5ef;text-align:center}/* @canonical-block:002279 */
.product-one-page__final-inner{max-width:850px;margin:auto}/* @canonical-block:002280 */
.product-one-page__final h2{margin:16px 0 20px;font-size:clamp(52px,7vw,90px);line-height:.9;letter-spacing:-.06em}/* @canonical-block:002281 */
.product-one-page__final p{max-width:580px;margin:auto;color:#716a72;font-size:17px;line-height:1.7}/* @canonical-block:002282 */
.product-one-page__final-action{display:grid;justify-items:center;gap:12px;margin-top:30px}/* @canonical-block:002283 */
.product-one-page__final-action form{width:min(100%,320px)}/* @canonical-block:002284 */
.product-one-page__final-action button{width:100%}/* @canonical-block:002285 */
.product-one-page__final-action>span{color:#716a72;font:600 11px/1.4 var(--font-mono)}/* @canonical-block:002286 */
.product-one-page__hero--soon{min-height:70vh;display:grid;align-items:center}/* @canonical-block:002287 */
@media(max-width:1000px){
 .product-one-page__hero-inner,.product-one-page__journey-inner{grid-template-columns:1fr}
 .product-one-page__visual{min-height:470px}
 .product-one-page__reason-grid{grid-template-columns:1fr}
 .product-one-page__reason-grid article{min-height:240px}
 .product-one-page__reason-grid h3{margin-top:38px}
}/* @canonical-block:002288 */
@media(max-width:620px){
 .product-one-page__hero{padding:58px 0 76px}
 .product-one-page__hero-inner{width:min(calc(100% - 32px),1180px);gap:28px}
 .product-one-page__copy h1{font-size:50px}
 .product-one-page__copy>p{font-size:16px}
 .product-one-page__buy{display:grid;gap:18px}
 .product-one-page__buy form,.product-one-page__buy>div:last-child{width:100%;min-width:0}
 .product-one-page__trust{gap:10px}
 .product-one-page__visual{min-height:340px}
 .product-one-page__statement,.product-one-page__reasons,.product-one-page__journey{padding:78px 0}
 .product-one-page__statement h2,.product-one-page__journey-copy h2{font-size:45px}
 .product-one-page__mini-card{min-height:330px}
 .product-one-page__final{padding:90px 16px}
 .product-one-page__final h2{font-size:52px}
}/* @canonical-block:002289 */
@media(prefers-reduced-motion:reduce){
 .product-one-page *{scroll-behavior:auto;animation:none;transition:none}
}/* @canonical-block:002351 */


/* V36-PRODUCT-VISUALS
   Marketing surfaces use product UI mockups instead of a real person's portrait.
   This keeps the brand system consistent and avoids turning a personal demo profile
   into the default product illustration. */
.yi-product-ui{position:relative;width:100%;height:100%;font-family:var(--font-ui)}/* @canonical-block:002352 */
.yi-product-ui--profile{border:8px solid #28231f;border-radius:34px;overflow:hidden;background:#f8f5ee;box-shadow:0 28px 55px rgba(35,26,20,.22);min-height:420px}/* @canonical-block:002353 */
.yi-profile-cover{height:36%;min-height:130px;background:radial-gradient(circle at 72% 35%,#9b72df 0,#422267 32%,#17121e 72%);padding:16px;color:#e8d8bc;display:flex;justify-content:space-between;font:700 9px "IBM Plex Mono",monospace;letter-spacing:.08em}/* @canonical-block:002354 */
.yi-profile-cover b{color:#9de0c1}/* @canonical-block:002355 */
.yi-profile-avatar{position:absolute;top:25%;left:22px;width:70px;height:70px;border:4px solid #f8f5ee;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#d4b483,#8a6733);color:#241b14;font:800 22px "IBM Plex Mono",monospace;box-shadow:0 8px 20px rgba(0,0,0,.22)}/* @canonical-block:002356 */
.yi-profile-body{padding:48px 20px 20px;display:grid;gap:6px;color:#201b19}/* @canonical-block:002357 */
.yi-profile-body strong{font-size:17px}/* @canonical-block:002358 */.yi-profile-body>span{font-size:11px;color:#82776d}/* @canonical-block:002359 */
.yi-profile-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:14px}/* @canonical-block:002360 */.yi-profile-actions i{height:34px;border:1px solid #ddd2c2;border-radius:10px;display:grid;place-items:center;font-style:normal;font-size:11px;color:#725a36;background:#fff}/* @canonical-block:002361 */
.yi-profile-save{margin-top:8px;border-radius:999px;background:#211b18;color:#fff;padding:10px;text-align:center;font-size:11px}/* @canonical-block:002362 */
.yi-product-ui--card{aspect-ratio:1.55/1;border-radius:18px;padding:24px;color:#e7d7ba;background:radial-gradient(circle at 70% 20%,#51326f 0,#17121e 45%,#0c0a10 100%);box-shadow:0 28px 45px rgba(25,16,31,.25);overflow:hidden}/* @canonical-block:002363 */
.yi-product-ui--card:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.08) 47%,transparent 64%);transform:translateX(-80%);animation:yi-card-shine 6s ease-in-out infinite}/* @canonical-block:002364 */
.yi-card-brand{font:800 10px "IBM Plex Mono",monospace;letter-spacing:.16em}/* @canonical-block:002365 */.yi-card-title{position:absolute;left:24px;bottom:54px;font:800 22px/1 "IBM Plex Mono",monospace;letter-spacing:-.05em}/* @canonical-block:002366 */.yi-card-nfc{position:absolute;right:25px;top:52px;font:800 24px "IBM Plex Mono",monospace;letter-spacing:-.15em;transform:rotate(-15deg);opacity:.85}/* @canonical-block:002367 */.yi-card-bottom{position:absolute;left:24px;right:24px;bottom:20px;display:flex;justify-content:space-between;align-items:end;font:600 8px/1.35 "IBM Plex Mono",monospace}/* @canonical-block:002368 */.yi-card-bottom b{display:grid;grid-template-columns:repeat(3,6px);gap:2px}/* @canonical-block:002369 */.yi-card-bottom i{width:6px;height:6px;background:#d4b483}/* @canonical-block:002370 */.yi-product-ui--dashboard{border-radius:18px;padding:18px;background:#211d19;color:#f3eee4;box-shadow:0 24px 45px rgba(20,15,12,.22);min-height:330px}/* @canonical-block:002371 */.yi-ui-top{display:flex;align-items:center;gap:6px;font:700 10px "IBM Plex Mono",monospace}/* @canonical-block:002372 */.yi-ui-top span{margin-left:auto;color:#bda987}/* @canonical-block:002373 */.yi-ui-top i{width:4px;height:4px;border-radius:50%;background:#8e806f}/* @canonical-block:002374 */.yi-ui-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:18px 0}/* @canonical-block:002375 */.yi-ui-metrics div{padding:9px;border:1px solid rgba(212,180,131,.2);border-radius:8px;background:rgba(255,255,255,.025)}/* @canonical-block:002376 */.yi-ui-metrics small{display:block;color:#9d958c;font-size:7px}/* @canonical-block:002377 */.yi-ui-metrics b{display:block;margin-top:4px;color:#d4b483;font:700 14px "IBM Plex Mono",monospace}/* @canonical-block:002378 */.yi-ui-dashboard-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:9px}/* @canonical-block:002379 */.yi-ui-chart{height:150px;border-radius:10px;background:#302a24;padding:15px 10px;display:flex;align-items:end;gap:7px}/* @canonical-block:002380 */.yi-ui-chart i{flex:1;border-radius:3px 3px 0 0;background:linear-gradient(180deg,#d4b483,#72542c)}/* @canonical-block:002381 */.yi-ui-chart i:nth-child(1){height:35%}/* @canonical-block:002382 */.yi-ui-chart i:nth-child(2){height:58%}/* @canonical-block:002383 */.yi-ui-chart i:nth-child(3){height:43%}/* @canonical-block:002384 */.yi-ui-chart i:nth-child(4){height:76%}/* @canonical-block:002385 */.yi-ui-chart i:nth-child(5){height:52%}/* @canonical-block:002386 */.yi-ui-list{padding:15px;border-radius:10px;background:#302a24;display:grid;align-content:center;gap:9px}/* @canonical-block:002387 */.yi-ui-list i{height:8px;border-radius:5px;background:#5d554c}/* @canonical-block:002388 */.yi-product-ui--compact.yi-product-ui--profile{min-height:280px;border-width:5px;border-radius:25px}/* @canonical-block:002389 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-cover{min-height:85px;padding:10px}/* @canonical-block:002390 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-avatar{width:48px;height:48px;top:23%;left:13px;font-size:14px;border-width:3px}/* @canonical-block:002391 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-body{padding:31px 12px 12px}/* @canonical-block:002392 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-body strong{font-size:12px}/* @canonical-block:002393 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-actions{margin-top:7px}/* @canonical-block:002394 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-actions i{height:24px;font-size:8px}/* @canonical-block:002395 */.yi-product-ui--compact.yi-product-ui--profile .yi-profile-save{padding:7px;font-size:8px}/* @canonical-block:002396 */.yi-product-ui--compact.yi-product-ui--card{padding:16px;border-radius:14px}/* @canonical-block:002397 */.yi-product-ui--compact.yi-product-ui--card .yi-card-title{left:16px;bottom:38px;font-size:15px}/* @canonical-block:002398 */.yi-product-ui--compact.yi-product-ui--card .yi-card-brand{font-size:7px}/* @canonical-block:002399 */.yi-product-ui--compact.yi-product-ui--card .yi-card-bottom{left:16px;right:16px;bottom:12px;font-size:6px}/* @canonical-block:002403 */
.home-compact__hero-visual .home-compact__card .yi-product-ui--card{box-shadow:0 30px 45px rgba(25,16,31,.25)}/* @canonical-block:002406 */
.how-step-visual .yi-product-ui{width:88%;max-width:330px}/* @canonical-block:002407 */
.how-step-visual--02 .yi-product-ui--profile{min-height:0;max-height:100%;height:100%}/* @canonical-block:002408 */
.how-step-visual--01 .yi-product-ui--card,.how-step-visual--03 .yi-product-ui--card{width:100%;max-width:340px}/* @canonical-block:002409 */
.p4-proof-visual .yi-product-ui{max-width:480px;margin:auto}/* @canonical-block:002410 */
@media(max-width:700px){
 .home-compact__hero-visual .home-compact__phone{width:38%;height:330px}
 .home-compact__hero-visual .home-compact__card{width:68%;right:2%}
 .yi-product-ui--profile{min-height:350px}
}/* @canonical-block:002411 */


/* V37 — canonical marketing page heading + compact layered footer */
.how-hero-inner .section-kicker{
  margin-bottom:2px;
  color:#a47b28;
  font-family:var(--font-ui);
  font-size:13px;
  letter-spacing:.22em;
  font-weight:700;
}/* @canonical-block:002415 */

/* Public site chrome: announcement + navigation remain visible until a panel surface takes over. */
.public-site-chrome{
  position:sticky;
  top:0;
  z-index:1000;
  isolation:isolate;
  background:rgba(251,250,247,.96);
  box-shadow:0 1px 0 rgba(36,29,22,.08);
}/* @canonical-block:002416 */
.public-site-chrome .p4-announcement,
.public-site-chrome .yi-header{
  position:relative;
  top:auto;
}/* @canonical-block:002417 */
.public-site-chrome .yi-header{
  z-index:1;
}/* @canonical-block:002418 */
@media(max-width:760px){
  .public-site-chrome{
    position:sticky;
    top:0;
  }
}/* @canonical-block:002419 */

/* Footer: product architecture, not a generic corporate sitemap */
.yi-footer--new{
  width:100%;
  max-width:none;
  margin:0;
  padding:28px 0 18px;
  border-top:1px solid rgba(36,29,22,.12);
  background:linear-gradient(180deg,#fbfaf7,#f3efe7);
}/* @canonical-block:002420 */
.yi-footer--new .yi-container{
  width:min(calc(100% - 48px),var(--wide));
  margin:0 auto;
}/* @canonical-block:002421 */
.yi-footer__identity{
  display:grid;
  grid-template-columns:minmax(220px,.8fr) minmax(0,1.8fr);
  gap:clamp(32px,6vw,90px);
  padding-bottom:22px;
}/* @canonical-block:002422 */
.yi-footer__brand .yi-brand{margin-bottom:10px}/* @canonical-block:002423 */
.yi-footer__brand p{
  max-width:320px;
  margin:0;
  color:#71695f;
  font-family:var(--font-ui);
  font-size:12px;
  line-height:1.5;
}/* @canonical-block:002424 */
.yi-footer__layers{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}/* @canonical-block:002425 */
.yi-footer__layer{
  padding-left:18px;
  border-left:1px solid rgba(164,123,40,.38);
}/* @canonical-block:002426 */
.yi-footer__layer span{
  display:block;
  margin-bottom:5px;
  color:#a47b28;
  font:700 10px/1.2 var(--font-mono);
  letter-spacing:.13em;
  text-transform:uppercase;
}/* @canonical-block:002427 */
.yi-footer__layer strong{
  display:block;
  margin-bottom:5px;
  color:#1d1916;
  font-size:18px;
  letter-spacing:-.03em;
}/* @canonical-block:002428 */
.yi-footer__layer p{
  max-width:420px;
  margin:0;
  color:#756d63;
  font-family:var(--font-ui);
  font-size:12px;
  line-height:1.5;
}/* @canonical-block:002429 */
.yi-footer__base a,.yi-footer__base span{
  color:#71695f;
  font-family:var(--font-ui);
  font-size:11px;
  text-decoration:none;
}/* @canonical-block:002430 */
.yi-footer__base a:hover{color:#a47b28}/* @canonical-block:002431 */
.yi-footer__base{
  display:flex;
  align-items:center;
  gap:20px;
  padding-top:14px;
}/* @canonical-block:002432 */
.yi-footer__base>span{
  color:#211c18;
  font-weight:700;
}/* @canonical-block:002433 */
.yi-footer__base nav{
  margin-left:auto;
  display:flex;
  flex-wrap:wrap;
  gap:16px;
}/* @canonical-block:002434 */
.yi-footer__trust{
  display:flex;
  flex-wrap:wrap;
  gap:20px;
  margin-top:18px;
  padding-top:18px;
  border-top:1px solid rgba(36,29,22,.08);
}/* @canonical-block:002435 */
.yi-footer__trust span{
  display:inline-flex;
  align-items:center;
  gap:7px;
  color:#71695f;
  font:600 11px/1 "IBM Plex Mono",monospace;
  letter-spacing:.01em;
}/* @canonical-block:002436 */
.yi-footer__trust .yi-icon{
  width:13px;
  height:13px;
  min-width:13px;
  color:#a47b28;
}/* @canonical-block:002437 */
.yi-footer--compact{
  padding:16px 0 12px;
}/* @canonical-block:002438 */
.yi-footer--compact .yi-footer__layers{
  display:none;
}/* @canonical-block:002439 */
.yi-footer--compact .yi-footer__identity{
  grid-template-columns:minmax(0,1fr);
  gap:10px;
  padding-bottom:12px;
}/* @canonical-block:002440 */
.yi-footer--compact .yi-footer__brand p{
  max-width:42ch;
}/* @canonical-block:002441 */
@media(max-width:760px){
  .how-hero h1{font-size:clamp(38px,11vw,58px)}
  .how-hero p{font-size:15px}
  .yi-footer__identity{grid-template-columns:1fr;gap:22px}
  .yi-footer__layers{grid-template-columns:1fr}
  .yi-footer__base{flex-wrap:wrap}
  .yi-footer__base nav{width:100%;margin-left:0}
  .yi-footer__trust{gap:12px 18px}
}/* @canonical-block:002464 */
.home-mockup__phone .yi-product-ui--profile{
  min-height:500px;
}/* @canonical-block:002466 */
.home-mockup__card .yi-product-ui--card{
  border-radius:22px;
}/* @canonical-block:002483 */
@media(max-width:700px){
  .home-mockup__hero{padding:28px 18px 24px}
  .home-mockup__copy h1{font-size:44px;line-height:1.02;letter-spacing:-.045em}
  .home-mockup__copy>p{font-size:16px;line-height:1.65}
  .home-mockup__kicker{font-size:11px}
  .home-mockup__visual{min-height:430px;margin-top:10px}
  .home-mockup__phone{width:35%;min-width:145px;right:38%;top:4%;padding:5px;border-radius:25px}
  .home-mockup__phone .yi-product-ui--profile{min-height:350px}
  .home-mockup__card{width:70%;right:0;bottom:7%}
  .home-mockup__meta{gap:10px 14px;font-size:11px}
  .home-mockup__platform{padding:64px 18px}
  .home-mockup__platform h2{font-size:46px}
  .home-mockup__layers{grid-template-columns:1fr}
  .home-mockup__layers article{min-height:auto;padding:24px 0}
  .home-mockup__layers article+article{
    border-left:0;
    border-top:1px solid rgba(164,123,40,.35);
  }
}/* @canonical-block:002517 */

.yi-footer__layer-link{
  display:inline-block;
  margin:-1px 0 7px;
  color:#8b7040;
  font:600 9px/1 var(--font-mono);
  letter-spacing:.05em;
  text-decoration:none;
}/* @canonical-block:002518 */
.yi-footer__layer-link:hover{color:#a47b28}/* @canonical-block:002525 */

/* Shared public-page rhythm */
.p4-section,
.reference-section,
.corporate-buyer-section,
.corporate-pricing-section,
.corporate-workflow,
.products-public-v2-model,
.products-public-v2-compare,
.products-public-v2-package,
.products-public-v2-addon,
.products-public-v2-final {
  padding-block: var(--space-section-lg);
}/* @canonical-block:002526 */

.p4-section-head,
.reference-section-heading {
  gap: var(--space-8);
  margin-bottom: var(--space-7);
}/* @canonical-block:002527 */

.p4-section-head h2,
.p4-proof-copy h2,
.p4-pack-copy h2,
.reference-section-heading h2,
.products-public-v2 h2,
.corporate-sales-page h2 {
  font-size: var(--type-title);
}/* @canonical-block:002528 */

.p4-copy,
.products-public-v2-lead,
.reference-hero > div > p:not(.section-kicker),
.corporate-resource-hero-copy > p {
  max-width: var(--content-readable);
  font-size: var(--type-body-lg);
  line-height: 1.7;
}/* @canonical-block:002529 */

.section-kicker,
.p4-kicker,
.products-public-v2-kicker {
  gap: var(--space-2);
  font-size: var(--type-label);
  line-height: 1.2;
  letter-spacing: .18em;
}/* @canonical-block:002530 */

.p4-button,
.corporate-cta,
.corporate-secondary-cta,
.products-public-v2-button {
  min-height: 48px;
  padding-inline: var(--space-5);
  gap: var(--space-2);
  border-radius: var(--radius-button);
  font-size: 13px;
  letter-spacing: -.005em;
}/* @canonical-block:002531 */

/* Product/commerce typography: prices remain tabular, but not visually detached. */
.p4-pack-price strong,
.products-public-v2-price strong,
.products-public-v2-package-card strong,
.corporate-pricing-grid article strong,
.cart-item-price,
.cart-summary-total b,
.checkout-summary-total b {
  font-family: var(--font-ui);
  font-variant-numeric: tabular-nums;
  letter-spacing: -.035em;
}/* @canonical-block:002535 */

/* Shared chrome is part of the product experience, not disposable decoration. */
.global-app-header {
  position: sticky;
  top: 0;
  width: 100%;
  margin: 0;
  background: rgba(255,255,255,.94);
}/* @canonical-block:002536 */

.global-app-header-inner {
  min-height: 76px;
  padding-inline: max(24px, calc((100vw - var(--wide)) / 2));
}/* @canonical-block:002537 */

.global-main-nav { gap: var(--space-7); }/* @canonical-block:002538 */
.global-main-nav a { font-size: 13px; }/* @canonical-block:002539 */
.global-header-link,
.global-header-cta,
.global-signout-button { min-height: 42px; padding-inline: var(--space-4); font-size: 13px; }/* @canonical-block:002540 */

/* Avoid the 'everything is a card' effect. Cards use one consistent radius and one density. */
.p4-benefit,
.p4-step,
.reference-topic,
.reference-step,
.products-public-v2-compare-card,
.products-public-v2-package-card,
.corporate-benefit,
.corporate-pricing-grid article {
  padding: var(--space-6);
  border-radius: var(--radius-card);
}/* @canonical-block:002541 */

.p4-benefit-grid,
.reference-topic-grid,
.reference-step-grid,
.products-public-v2-compare-grid,
.corporate-benefits,
.corporate-pricing-grid {
  gap: var(--space-4);
}/* @canonical-block:002542 */

/* Public footer follows the same vertical rhythm and remains present on every public route. */
.yi-footer:not(.yi-footer--new) {
  padding-block: var(--space-section) var(--space-5);
}/* @canonical-block:002550 */

@media (max-width: 760px) {
  :root {
    --space-section: 64px;
    --space-section-lg: 80px;
  }

  body { font-size: 15px; }
  .p4-section-head { gap: var(--space-5); margin-bottom: var(--space-6); }
  .p4-copy,
  .products-public-v2-lead,
  .reference-hero > div > p:not(.section-kicker),
  .corporate-resource-hero-copy > p,
  .home-premium .home-mockup__copy > p { font-size: 16px; }
  .global-app-header-inner { min-height: 64px; padding-inline: 16px; }
}/* @canonical-block:002551 */


/* V45 premium component contract + intentional micro-interactions.
 * Interaction is restrained: movement communicates state, hierarchy or feedback.
 */
.ds-button, .yi-btn, .global-header-link, .global-header-cta, .global-signout-button,
.ds-tab, .ds-pagination__page, .global-cart-link {
  transition: transform var(--motion-standard) var(--ease-standard), box-shadow var(--motion-standard) var(--ease-standard), border-color var(--motion-standard) var(--ease-standard), background-color var(--motion-standard) var(--ease-standard), color var(--motion-standard) var(--ease-standard), opacity var(--motion-standard) var(--ease-standard);
}/* @canonical-block:002552 */
.ds-button:not(:disabled):hover, .yi-btn:not(:disabled):hover { transform: translateY(-1px); }/* @canonical-block:002553 */
.ds-button:not(:disabled):active, .yi-btn:not(:disabled):active { transform: translateY(0) scale(.985); }/* @canonical-block:002554 */
.ds-button--primary:not(:disabled):hover, .yi-btn--primary:not(:disabled):hover, .global-header-cta:hover { box-shadow: 0 10px 28px rgba(169,129,47,.22); }/* @canonical-block:002555 */
.ds-button:focus-visible, .yi-btn:focus-visible, .ds-tab:focus-visible, .ds-pagination__page:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }/* @canonical-block:002556 */
.ds-card, .ds-product-card, .ds-pricing-card { transition: transform var(--motion-standard) var(--ease-standard), box-shadow var(--motion-standard) var(--ease-standard), border-color var(--motion-standard) var(--ease-standard); }/* @canonical-block:002557 */
.ds-card--interactive:hover, .ds-product-card:hover, .ds-pricing-card:hover { transform: translateY(-3px); border-color: var(--border-gold); box-shadow: var(--shadow-soft); }/* @canonical-block:002558 */
.ds-product-card__visual { overflow:hidden; border-radius: calc(var(--radius-card) - 2px); }/* @canonical-block:002559 */
.ds-product-card__visual > * { transition: transform var(--motion-emphasis) var(--ease-emphasis); }/* @canonical-block:002560 */
.ds-product-card:hover .ds-product-card__visual > * { transform: scale(1.018); }/* @canonical-block:002561 */
.ds-avatar { display:inline-grid; place-items:center; flex:0 0 auto; overflow:hidden; border:1px solid var(--border-gold); border-radius:50%; background:linear-gradient(145deg,var(--gold-dim),var(--surface-3)); color:var(--gold-hi); font-weight:800; line-height:1; }/* @canonical-block:002562 */
.ds-avatar img { width:100%; height:100%; object-fit:cover; }/* @canonical-block:002563 */
.ds-avatar--sm { width:32px; height:32px; font-size:11px; }/* @canonical-block:002564 */
.ds-avatar--md { width:40px; height:40px; font-size:13px; }/* @canonical-block:002565 */
.ds-avatar--lg { width:56px; height:56px; font-size:16px; }/* @canonical-block:002566 */
.ds-breadcrumbs { margin-bottom:18px; color:var(--ink-3); font-size:12px; }/* @canonical-block:002567 */
.ds-breadcrumbs ol { display:flex; flex-wrap:wrap; align-items:center; gap:7px; margin:0; padding:0; list-style:none; }/* @canonical-block:002568 */
.ds-breadcrumbs li { display:flex; align-items:center; gap:7px; }/* @canonical-block:002569 */
.ds-breadcrumbs a:hover { color:var(--ink); }/* @canonical-block:002570 */
.ds-breadcrumbs__separator { color:var(--gold); }/* @canonical-block:002571 */
.ds-tooltip { position:relative; display:inline-flex; }/* @canonical-block:002572 */
.ds-tooltip__content { position:absolute; z-index:120; width:max-content; max-width:240px; padding:7px 9px; border:1px solid rgba(255,255,255,.12); border-radius:8px; background:#1c1820; color:#fff; box-shadow:var(--shadow-soft); font-size:11px; line-height:1.35; opacity:0; pointer-events:none; transform:translateY(3px); transition:opacity var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard); }/* @canonical-block:002573 */
.ds-tooltip:hover .ds-tooltip__content, .ds-tooltip:focus-within .ds-tooltip__content { opacity:1; transform:none; }/* @canonical-block:002574 */
.ds-tooltip--top .ds-tooltip__content { left:50%; bottom:calc(100% + 8px); transform:translate(-50%,3px); }/* @canonical-block:002575 */
.ds-tooltip--top:hover .ds-tooltip__content, .ds-tooltip--top:focus-within .ds-tooltip__content { transform:translate(-50%,0); }/* @canonical-block:002576 */
.ds-tooltip--right .ds-tooltip__content { left:calc(100% + 8px); top:50%; transform:translate(3px,-50%); }/* @canonical-block:002577 */
.ds-tooltip--right:hover .ds-tooltip__content, .ds-tooltip--right:focus-within .ds-tooltip__content { transform:translate(0,-50%); }/* @canonical-block:002578 */
.ds-tooltip--bottom .ds-tooltip__content { left:50%; top:calc(100% + 8px); transform:translate(-50%,-3px); }/* @canonical-block:002579 */
.ds-tooltip--bottom:hover .ds-tooltip__content, .ds-tooltip--bottom:focus-within .ds-tooltip__content { transform:translate(-50%,0); }/* @canonical-block:002580 */
.ds-tooltip--left .ds-tooltip__content { right:calc(100% + 8px); top:50%; transform:translate(-3px,-50%); }/* @canonical-block:002581 */
.ds-tooltip--left:hover .ds-tooltip__content, .ds-tooltip--left:focus-within .ds-tooltip__content { transform:translate(0,-50%); }/* @canonical-block:002582 */
.ds-product-card { padding:12px; border:1px solid var(--border); border-radius:var(--radius-card); background:var(--glass); }/* @canonical-block:002583 */
.ds-product-card__visual { margin-bottom:16px; background:var(--surface-3); }/* @canonical-block:002584 */
.ds-product-card__body { padding:2px 6px 6px; }/* @canonical-block:002585 */
.ds-product-card__badge { margin-bottom:8px; }/* @canonical-block:002586 */
.ds-product-card__body h3 { margin-bottom:6px; font-size:20px; }/* @canonical-block:002587 */
.ds-product-card__body p { margin-bottom:12px; max-width:48ch; font-size:14px; }/* @canonical-block:002588 */
.ds-product-card__price { margin-bottom:14px; color:var(--ink); font:700 20px/1.1 var(--font-ui); font-variant-numeric:tabular-nums; }/* @canonical-block:002589 */
.ds-product-card__action { display:flex; align-items:center; gap:8px; }/* @canonical-block:002590 */
.ds-pricing-card { display:flex; flex-direction:column; min-height:100%; padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface); }/* @canonical-block:002591 */
.ds-pricing-card--featured { border-color:var(--border-gold); box-shadow:0 12px 36px rgba(169,129,47,.1); }/* @canonical-block:002592 */
.ds-pricing-card__head { display:flex; align-items:center; justify-content:space-between; gap:12px; }/* @canonical-block:002593 */
.ds-pricing-card__head h3 { margin:0; font-size:22px; }/* @canonical-block:002594 */
.ds-pricing-card__description { min-height:46px; margin:10px 0 18px; font-size:13px; }/* @canonical-block:002595 */
.ds-pricing-card__price { display:flex; align-items:baseline; gap:7px; margin-bottom:20px; }/* @canonical-block:002596 */
.ds-pricing-card__price strong { color:var(--ink); font:800 clamp(28px,3vw,38px)/1 var(--font-display); font-variant-numeric:tabular-nums; letter-spacing:-.04em; }/* @canonical-block:002597 */
.ds-pricing-card__price span { color:var(--ink-3); font-size:12px; }/* @canonical-block:002598 */
.ds-pricing-card ul { display:grid; gap:10px; margin:0 0 22px; padding:0; list-style:none; }/* @canonical-block:002599 */
.ds-pricing-card li { display:flex; gap:9px; color:var(--ink-2); font-size:13px; }/* @canonical-block:002600 */
.ds-pricing-card li span { color:var(--gold-hi); font-weight:800; }/* @canonical-block:002601 */
.ds-pricing-card__action { margin-top:auto; }/* @canonical-block:002602 */
.ds-pricing-card__action > * { width:100%; }/* @canonical-block:002603 */
.ds-error-state { display:flex; align-items:center; gap:14px; padding:14px 16px; border:1px solid rgba(209,69,59,.25); border-radius:12px; background:rgba(209,69,59,.055); color:var(--ink); }/* @canonical-block:002604 */
.ds-error-state__icon { width:32px; height:32px; display:grid; place-items:center; flex:0 0 32px; border-radius:50%; background:rgba(209,69,59,.12); color:var(--red); font-weight:800; }/* @canonical-block:002605 */
.ds-error-state h2 { margin:0 0 2px; font-size:14px; letter-spacing:-.02em; }/* @canonical-block:002606 */
.ds-error-state p { margin:0; font-size:12px; }/* @canonical-block:002607 */
.ds-error-state > .ds-button { margin-left:auto; flex:0 0 auto; }/* @canonical-block:002608 */
.ds-skeleton { display:block; overflow:hidden; border-radius:6px; background:linear-gradient(90deg,var(--surface-3) 20%,var(--surface) 38%,var(--surface-3) 56%); background-size:200% 100%; animation:ds-skeleton-shimmer 1.5s ease-in-out infinite; }/* @canonical-block:002609 */
.ds-modal { animation:ds-modal-in var(--motion-emphasis) var(--ease-emphasis) both; }/* @canonical-block:002610 */
.ds-drawer { animation:ds-drawer-in var(--motion-emphasis) var(--ease-emphasis) both; }/* @canonical-block:002611 */
.ds-overlay { animation:ds-overlay-in var(--motion-standard) ease both; }/* @canonical-block:002612 */
.ds-toast { animation:ds-toast-in var(--motion-standard) var(--ease-emphasis) both; }/* @canonical-block:002613 */
.ds-page-loading__mark { animation:ds-pulse 1.5s ease-in-out infinite; }/* @canonical-block:002620 */

body:has(.ds-drawer.v25-employee-drawer) .ds-overlay {
  animation: none;
  opacity: 1;
  z-index: 95;
}/* @canonical-block:002621 */
.ds-drawer.v25-employee-drawer {
  z-index: 100;
}/* @canonical-block:002623 */

/* ==========================================================================
   P0 FIX — Kurumsal kart şablonları (ESSENTIAL / PROFESSIONAL / EXECUTIVE)
   CardTemplate.tsx içindeki corp-* sınıfları daha önce hiç stillenmemişti;
   bu da /[slug], /p/[publicId], /c/[cardCode] ve şablon önizlemelerinde
   üst üste binen, tarayıcı varsayılanıyla render edilen metinlere yol
   açıyordu. Bu blok, mevcut p12-* dil ve token setiyle tutarlı şekilde
   üç kurumsal varyantı da tam olarak stiller.
   ========================================================================== */

.corporate-card-shell { width:min(100%,520px); margin:0 auto; }/* @canonical-block:002624 */
.corporate-card-shell.embedded-card-preview { width:100%; }/* @canonical-block:002632 */
.corp-main-actions .yi-icon { width:16px; height:16px; min-width:16px; }/* @canonical-block:002642 */
.corp-social-strip .yi-icon,.corp-professional-socials .yi-icon,.corp-executive-socials .yi-icon { width:14px; height:14px; min-width:14px; }/* @canonical-block:002650 */
.corp-contact-table .yi-icon,.corp-professional-contact .yi-icon,.corp-executive-info .yi-icon,
.corp-resource-section .yi-icon,.corp-company-grid .yi-icon { width:34px; height:34px; min-width:34px; display:grid; place-items:center; border-radius:10px; background:var(--surface-3); color:var(--gold-hi); }/* @canonical-block:002665 */
.corp-employee-badge .yi-icon { width:12px; height:12px; min-width:12px; }/* @canonical-block:002689 */
.corp-professional-copy .yi-icon { width:12px; height:12px; min-width:12px; }/* @canonical-block:002715 */
small,.text-caption,.caption { font-size: 12px; }/* @canonical-block:002716 */

/* Shared shell alignment */
.p4-shell,
.yi-container,
.home-premium__proof,
.home-premium__journey,
.corporate-single-hero,
.corporate-capability-bar,
.corporate-single-cta,
.corporate-single-details {
  min-width: 0;
}/* @canonical-block:002748 */
.products-single-visual .yi-product-visual {
  height: auto;
  min-height: 0;
  max-height: 380px;
  aspect-ratio: 1.55 / 1;
}/* @canonical-block:002770 */
.how-step-visual .yi-product-visual {
  width: min(100%, 360px);
  height: auto;
  max-height: 100%;
  object-fit: contain;
}/* @canonical-block:002815 */

/* Tablet */
@media (max-width: 1100px) {
  .home-mockup__hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .home-mockup__copy {
    width: min(760px, 100%);
    margin-inline: auto;
    justify-self: center;
    text-align: center;
  }
  .home-mockup__copy > p { margin-inline: auto; }
  .home-mockup__actions,
  .home-mockup__meta { justify-content: center; }
  .home-mockup__visual {
    width: min(760px, 100%);
    margin-inline: auto;
    min-height: 560px;
  }
  .home-mockup__phone { right: 48%; }
  .home-mockup__card { right: 0; width: min(64%, 580px); }
  .products-single-hero__inner,
  .corporate-single-hero {
    grid-template-columns: 1fr;
  }
  .products-single-visual { min-height: 340px; }
  .corporate-dashboard-stage { min-height: 420px; }
  .corporate-capability-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .corporate-capability-bar article:nth-child(odd) { border-left: 0; }
  .corporate-capability-bar article:nth-child(n+3) { border-top: 1px solid rgba(36,29,23,.09); }
  .how-step-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .how-benefits-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}/* @canonical-block:002816 */

/* Mobile: stack, preserve readable 16px body copy and comfortable targets */
@media (max-width: 760px) {
  .p4-shell,
  .products-single-hero__inner,
  .support-main,
  .support-contact,
  .how-steps,
  .how-benefits {
    width: min(calc(100% - 32px), var(--content));
  }
  .home-mockup__hero {
    padding: 48px 16px 56px;
  }
  .home-mockup__copy h1 {
    font-size: clamp(40px, 12vw, 54px);
    line-height: 1;
  }
  .home-mockup__copy > p { font-size: 16px; }
  .home-mockup__actions { gap: 12px; }
  .home-mockup__button { min-height: 52px; }
  .home-mockup__visual {
    min-height: 430px;
    margin-top: 12px;
  }
  .home-mockup__phone {
    width: 38%;
    min-width: 150px;
    right: 38%;
    top: 3%;
  }
  .home-mockup__card {
    width: 74%;
    right: -2%;
    bottom: 7%;
  }
  .home-premium__proof,
  .home-premium__journey { padding-inline: 16px; }
  .home-premium__proof-head,
  .home-premium__journey-head {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .home-premium__proof-head h2,
  .home-premium__journey-head h2,
  .home-premium__final h2 { font-size: clamp(38px, 11vw, 52px); }
  .home-premium__principles,
  .home-premium__journey-steps {
    grid-template-columns: 1fr;
  }
  .home-premium__principles article {
    min-height: 0;
    border-right: 0;
    border-bottom: 1px solid rgba(36,29,22,.10);
  }
  .home-premium__principles article:last-child { border-bottom: 0; }
  .home-premium__journey-action {
    align-items: flex-start;
    flex-direction: column;
  }
  .products-single-hero { padding: 46px 0 28px; }
  .products-single-copy h2 { font-size: clamp(42px, 12vw, 58px); }
  .products-single-copy > p { font-size: 16px; }
  .products-single-visual { min-height: 270px; }
  .products-single-visual .yi-product-visual {
    max-height: 270px;
    aspect-ratio: 1.4;
  }
  .products-single-price-card,
  .products-single-benefits { min-height: 0; }
  .products-single-price-card__body { grid-template-columns: 1fr; }
  .products-single-price-card li { font-size: 14px; }
  .products-single-benefits { grid-template-columns: 1fr; }
  .products-single-benefits article {
    min-height: 110px;
    border-right: 0;
    border-bottom: 1px solid rgba(24,19,13,.09);
  }
  .products-single-benefits article:last-child { border-bottom: 0; }
  .how-hero { min-height: 250px; padding: 48px 0 36px; }
  .how-hero h1 { font-size: clamp(38px, 11vw, 54px); }
  .how-hero p { font-size: 16px; }
  .how-steps { padding: 40px 0 24px; }
  .how-step-grid { grid-template-columns: 1fr; }
  .how-step-card { min-height: 0; padding: 20px; }
  .how-step-card h3 { font-size: 22px; }
  .how-step-card > p { font-size: 15px; }
  .how-step-visual {
    min-height: 260px;
    height: 260px;
    margin: 24px -20px -20px;
  }
  .how-benefits { margin-bottom: 48px; }
  .how-benefits-grid { grid-template-columns: 1fr; }
  .support-hero { min-height: 250px; padding: 48px 0 34px; }
  .support-hero h1 { font-size: clamp(38px, 11vw, 54px); }
  .support-hero p { font-size: 15px; }
  .support-main { grid-template-columns: 1fr; padding: 36px 0; }
  .support-topics,
  .support-faq { padding: 20px; }
  .support-topic-grid { grid-template-columns: 1fr; }
  .support-topic-card { min-height: 92px; }
  .support-topic-card h3 { font-size: 16px; }
  .support-topic-card p,
  .support-faq details p { font-size: 14px; }
  .support-contact { grid-template-columns: 1fr; margin-bottom: 36px; }
  .support-contact-cta { justify-self: start; }
  .corporate-single-hero { padding: 48px 0 32px; }
  .corporate-single-copy h1 { font-size: clamp(40px, 11vw, 56px); }
  .corporate-single-copy > p { font-size: 16px; }
  .corporate-single-proof { grid-template-columns: 1fr; }
  .corporate-dashboard-stage { min-height: 330px; }
  .corporate-dashboard-window { width: 100%; transform: none; }
  .corporate-dashboard-body { min-height: 290px; grid-template-columns: 42px minmax(0,1fr); }
  .corporate-dashboard-sidebar { gap: 10px; }
  .corporate-dashboard-kpis { grid-template-columns: 1fr; }
  .corporate-dashboard-grid { grid-template-columns: 1fr; }
  .corporate-dashboard-footer { display: grid; grid-template-columns: repeat(2,1fr); }
  .corporate-dashboard-badge { right: 4%; bottom: 1%; }
  .corporate-capability-bar { grid-template-columns: 1fr; }
  .corporate-capability-bar article + article { border-left: 0; border-top: 1px solid rgba(36,29,23,.09); }
  .corporate-single-cta { flex-direction: column; align-items: flex-start; }
