/* Live public UI: root causes visible from yenomi-id.vercel.app.
   1) Mobile menu used position:fixed + top:100%, so 100% was the viewport
      and the drawer opened below the fold.
   2) Header kept desktop nav until 900px while Turkish labels + gold CTA
      already collide around 1100px.
   3) Catalog CRO capped the pair visual at 280px and clipped the cards.
   4) Ticker used 3 copies with a -50% loop, so the strip jumped. */
.public-site-chrome {
  position: sticky;
}/* @canonical-block:004029 */
.yi-brand-marquee__track {
  animation-name: yi-brand-marquee;
}/* @canonical-block:004031 */
@media (prefers-reduced-motion: reduce) {
  .yi-brand-marquee__track {
    animation: none;
    width: 100%;
    justify-content: center;
    transform: none;
  }
  .yi-brand-marquee__unit:not(:first-child) {
    display: none;
  }
}/* @canonical-block:004033 */
.products-single-visual .yi-product-visual,
.products-single-visual .yi-product-visual--pair {
  height: auto;
  max-height: none;
}/* @canonical-block:004034 */

@media (max-width: 1180px) {
  .public-site-chrome .yi-menu {
    display: block;
    pointer-events: auto;
  }
  .public-site-chrome .yi-header__actions .yi-btn {
    display: none;
  }
  .public-site-chrome .yi-nav {
    position: absolute;
    display: none;
    flex-direction: column;
    align-items: stretch;
    inset: auto 16px;
    top: calc(100% + 8px);
    z-index: 20;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #fff;
    box-shadow: var(--shadow);
    pointer-events: none;
  }
  .public-site-chrome .yi-nav.is-open {
    display: flex;
    pointer-events: auto;
  }
}/* @canonical-block:004036 */

/* Geometry: ticker clip, mismatched CTA row, drawer covering content,
