  .enterprise-sidebar.is-collapsed .enterprise-sidebar-collapse > span {
    display: none;
  }
  .enterprise-sidebar.is-collapsed .enterprise-canonical-nav { gap: 5px; }
  .enterprise-sidebar.is-collapsed .enterprise-nav-entry,
  .enterprise-sidebar.is-collapsed .enterprise-nav-entry a,
  .enterprise-sidebar.is-collapsed .enterprise-side-links a,
  .enterprise-sidebar.is-collapsed .enterprise-side-links button {
    justify-content: center;
    padding-inline: 0;
  }
  .enterprise-sidebar.is-collapsed .enterprise-side-user {
    justify-content: center;
    padding-inline: 0;
  }
  .enterprise-sidebar.is-collapsed .enterprise-sidebar-collapse {
    padding-inline: 0;
  }
}/* @canonical-block:003278 */

.canonical-sidebar-backdrop { display: none; }/* @canonical-block:003297 */

@media (max-width: 1100px) {
  .canonical-sidebar-backdrop {
    display: block;
