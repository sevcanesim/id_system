  border-radius: 20px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
}/* @canonical-block:004234 */
.corporate-pack-table-wrap {
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
}/* @canonical-block:004239 */

/* YENOMI BUSINESS — PREMIUM SALES + ACCESSIBILITY OVERHAUL V1 */
.corporate-sales-page {
  --corp-text: #1A1918;
  --corp-text-secondary: #514C46;
  --corp-text-muted: #6B655D;
  --corp-gold: #A37B2C;
  --corp-gold-hover: #896420;
  --corp-gold-soft: #8B6835;
  --corp-gold-label: #765B2E;
  --corp-border: #E6E2D8;
  --corp-border-strong: #D8D2C4;
  overflow-x: clip;
  color: var(--corp-text);
  background:
    radial-gradient(circle at 12% -8%, rgba(163,123,44,0.09), transparent 34%),
    radial-gradient(circle at 88% 0%, rgba(163,123,44,0.05), transparent 28%),
    var(--warm-cream, #F9F8F6);
}/* @canonical-block:004240 */

.corporate-sales-page h1#corporate-single-title,
.corporate-sales-page .corporate-single-copy h1 {
  display: grid;
  gap: .08em;
  max-width: min(16.5ch, 100%);
  margin: 16px 0 0;
  color: var(--corp-text);
  font-size: clamp(36px, 5.2vw, 64px);
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -.04em;
  word-spacing: normal;
  text-wrap: balance;
  overflow-wrap: break-word;
  hyphens: none;
}/* @canonical-block:004241 */
.corporate-hero-line {
  display: block;
  max-width: min(18ch, 100%);
  text-wrap: balance;
}/* @canonical-block:004242 */
.corporate-hero-line--accent {
  color: var(--corp-text);
}/* @canonical-block:004243 */
.corporate-sales-page .corporate-single-cta h2,
.corporate-sales-page .corporate-section-heading h2,
.corporate-sales-page .corporate-lead-copy h2,
.corporate-sales-page .corporate-pack-picker h3,
.corporate-sales-page .corporate-addon-grid h3,
.corporate-sales-page .corporate-capability-bar h2 {
  letter-spacing: -.025em;
  word-spacing: normal;
  text-wrap: balance;
}/* @canonical-block:004245 */
.corporate-sales-page .corporate-pack-picker__kicker,
.corporate-sales-page .corporate-pack-table thead th,
.corporate-sales-page .corporate-pack-badge,
.corporate-sales-page .corporate-addon-grid article > span {
  color: var(--corp-gold-soft);
  font-size: 12px;
}/* @canonical-block:004246 */
.corporate-sales-page .corporate-single-copy > p,
.corporate-sales-page .corporate-section-heading p,
.corporate-sales-page .corporate-single-cta p,
.corporate-sales-page .corporate-lead-copy p,
.corporate-sales-page .corporate-lead-copy li {
  color: var(--corp-text-secondary);
}/* @canonical-block:004247 */
.corporate-sales-page .corporate-capability-bar p,
.corporate-sales-page .corporate-single-proof span,
.corporate-sales-page .corporate-pack-picker__price > span,
.corporate-sales-page .corporate-pack-picker__price small,
.corporate-sales-page .corporate-pack-picker__features li,
.corporate-sales-page .corporate-pack-picker__meta span,
.corporate-sales-page .corporate-pack-note,
.corporate-sales-page .corporate-lead-note,
.corporate-sales-page .corporate-lead-privacy,
.corporate-sales-page .corporate-addon-grid p,
.corporate-sales-page .corporate-addon-grid li {
  color: #3f3a35;
}/* @canonical-block:004249 */

.corporate-sales-page .corporate-pack-picker {
  padding: 28px;
  gap: 20px;
}/* @canonical-block:004250 */
.corporate-sales-page .corporate-pack-picker__tick {
  min-width: 44px;
  min-height: 44px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: var(--corp-text-secondary);
}/* @canonical-block:004253 */
.corporate-sales-page .corporate-pack-picker__badge {
  align-self: center;
  min-height: 24px;
}/* @canonical-block:004254 */
.corporate-sales-page .corporate-pack-picker input[type="range"] {
  display: block;
  width: 100%;
  height: 44px;
  margin: 0;
  accent-color: var(--corp-gold);
}/* @canonical-block:004255 */
.corporate-sales-page .corporate-pack-picker__tick:focus-visible,
.corporate-sales-page .corporate-pack-picker input[type="range"]:focus-visible {
  outline: 2px solid #6a4e1c;
  outline-offset: 2px;
}/* @canonical-block:004256 */

.corporate-sales-page .corporate-pack-table-wrap {
  overflow-x: auto;
  overscroll-behavior-x: contain;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}/* @canonical-block:004260 */

.corporate-sales-page .corporate-addon-grid {
  align-items: stretch;
}/* @canonical-block:004261 */
.corporate-sales-page .corporate-addon-grid article {
  min-height: 280px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}/* @canonical-block:004265 */

.corporate-sales-page .corporate-single-cta {
  gap: 24px;
  padding: 24px;
  border: 1px solid var(--corp-border);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .94), rgba(250, 248, 243, .96));
  box-shadow: 0 10px 28px rgba(58, 48, 38, .05);
}/* @canonical-block:004266 */
.corporate-sales-page .corporate-single-cta h2 {
  max-width: 22ch;
}/* @canonical-block:004267 */
.corporate-sales-page .corporate-single-cta .corporate-secondary-cta {
  min-height: 44px;
  padding: 0 16px;
}/* @canonical-block:004268 */

.corporate-lead-form {
  padding: 24px;
  border: 1px solid rgba(212, 180, 131, 0.28);
  border-radius: 20px;
  background: #FAF8F3;
  box-shadow: 0 16px 40px rgba(58, 48, 38, .08), 0 0 0 1px rgba(212, 180, 131, .1);
}/* @canonical-block:004276 */

@media (min-width: 1101px) {
  .corporate-sales-page .corporate-single-hero {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 56px);
  }
  .corporate-sales-page .corporate-lead-section {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  }
}/* @canonical-block:004277 */

@media (max-width: 1100px) and (min-width: 761px) {
  .corporate-sales-page .corporate-single-hero {
    min-height: calc(100svh - 210px);
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: 20px;
    padding-top: 24px;
  }
  .corporate-sales-page .corporate-single-copy h1 {
    font-size: clamp(34px, 4.4vw, 52px);
  }
  .corporate-sales-page .corporate-lead-section,
  .corporate-sales-page .corporate-single-cta {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
  }
  .corporate-sales-page .corporate-capability-bar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .corporate-sales-page .corporate-addon-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .corporate-sales-page .corporate-pack-table thead th:first-child,
  .corporate-sales-page .corporate-pack-table tbody th[scope="row"] {
    position: sticky;
    left: 0;
    z-index: 2;
    background: #fff;
    box-shadow: 1px 0 0 rgba(36, 29, 23, .08);
  }
}/* @canonical-block:004410 */
.corp-logo-lockup img {
  flex-shrink: 0;
  display: block;
  object-fit: cover;
  image-rendering: -webkit-optimize-contrast;
}