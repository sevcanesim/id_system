  border-radius:35px;
  background:#2b2722;
  box-shadow:0 34px 70px rgba(38,28,19,.25);
  animation:yi-v40-phone 7s ease-in-out infinite;
}/* @canonical-block:002465 */
.home-mockup__card{
  position:absolute;
  z-index:3;
  width:min(62%,610px);
  right:2%;
  bottom:9%;
  transform:rotate(-7deg);
  filter:drop-shadow(0 32px 35px rgba(24,17,12,.20));
  animation:yi-v40-card 8s ease-in-out 1s infinite;
}/* @canonical-block:002467 */
.home-mockup__orbit{
  position:absolute;
  border:1px solid rgba(164,123,40,.17);
  border-radius:50%;
  pointer-events:none;
}/* @canonical-block:002468 */
.home-mockup__orbit--left{
  width:52vw;
  height:22vw;
  left:-30vw;
  top:12%;
  transform:rotate(-13deg);
}/* @canonical-block:002469 */
.home-mockup__orbit--right{
  width:54vw;
  height:22vw;
  right:-24vw;
  bottom:7%;
  transform:rotate(-17deg);
}/* @canonical-block:002470 */
.home-mockup__platform{
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(0,1.85fr);
  gap:clamp(35px,7vw,110px);
  align-items:center;
  padding:clamp(72px,8vw,110px) max(6vw,32px);
  background:#fbfaf7;
  border-top:1px solid rgba(35,28,21,.10);
}/* @canonical-block:002471 */
.home-mockup__platform-copy{max-width:600px}/* @canonical-block:002472 */
.home-mockup__platform h2{
  margin:14px 0 16px;
  font-size:clamp(46px,5vw,76px);
  line-height:.9;
  letter-spacing:-.065em;
}/* @canonical-block:002473 */
.home-mockup__platform-copy>p{
  max-width:520px;
  margin:0;
  color:#756d64;
  font:400 16px/1.7 var(--font-ui);
}/* @canonical-block:002474 */
.home-mockup__layers{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  border-top:1px solid rgba(164,123,40,.35);
  border-bottom:1px solid rgba(164,123,40,.35);
}/* @canonical-block:002475 */
.home-mockup__layers article{
  min-height:190px;
  padding:28px 30px;
}/* @canonical-block:002476 */
.home-mockup__layers article+article{
  border-left:1px solid rgba(164,123,40,.35);
}/* @canonical-block:002477 */
.home-mockup__layers span{
  display:block;
  margin-bottom:10px;
  color:#a47b28;
  font:700 10px/1.2 "IBM Plex Mono",monospace;
  letter-spacing:.15em;
}/* @canonical-block:002478 */
.home-mockup__layers strong{
  display:block;
  margin-bottom:8px;
  font-size:25px;
  letter-spacing:-.035em;
}/* @canonical-block:002479 */
.home-mockup__layers p{
  margin:0;
  color:#766e64;
  font:400 14px/1.6 var(--font-ui);
}/* @canonical-block:002482 */
@media(max-width:1050px){
  .home-mockup__hero{
    grid-template-columns:1fr;
    min-height:auto;
    padding-top:28px;
  }
  .home-mockup__copy{
    justify-self:center;
    text-align:center;
  }
  .home-mockup__copy>p{margin-left:auto;margin-right:auto}
