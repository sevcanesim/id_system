.products-single-visual{height:100%;min-height:0;display:grid;place-items:center}/* @canonical-block:001631 */
.products-single-offer{flex:1 1 auto;min-height:0;padding:12px 0 10px}/* @canonical-block:001632 */
.products-single-offer__inner{height:100%;min-height:0;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:14px}/* @canonical-block:001633 */
.products-single-price-card,.products-single-benefits{border:1px solid rgba(24,19,13,.11);border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 12px 34px rgba(58,48,38,.06)}/* @canonical-block:001634 */
.products-single-price-card{padding:18px 20px;display:flex;flex-direction:column;justify-content:space-between;min-height:0}/* @canonical-block:001635 */
.products-single-price-card__head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}/* @canonical-block:001636 */
.products-single-kicker{font:700 10px var(--font-mono);letter-spacing:.12em;color:#8b6835}/* @canonical-block:001637 */
.products-single-price-card h2{margin:6px 0 0;font-size:clamp(20px,2vw,26px);letter-spacing:-.03em}/* @canonical-block:001638 */
.products-single-price{font:700 clamp(24px,2.5vw,34px) var(--font-ui);color:var(--ink);white-space:nowrap;font-variant-numeric:tabular-nums}/* @canonical-block:001639 */
.products-single-price-card__body{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:flex-end;margin-top:16px}/* @canonical-block:001640 */
.products-single-price-card ul{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 16px}/* @canonical-block:001641 */
.products-single-price-card li{font-size:13px;color:var(--ink-2)}/* @canonical-block:001642 */
.products-single-price-card li::before{content:"✓";margin-right:7px;color:#8d6b36;font-weight:700}/* @canonical-block:001643 */
.products-single-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:0;overflow:hidden}/* @canonical-block:001644 */
.products-single-benefits article{padding:18px 15px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(24,19,13,.09)}/* @canonical-block:001645 */
.products-single-benefits article:last-child{border-right:0}/* @canonical-block:001646 */
.products-single-benefits span{font:700 10px var(--font-mono);color:#9d7b43;margin-bottom:8px}/* @canonical-block:001647 */
.products-single-benefits strong{font-size:14px}/* @canonical-block:001648 */
.products-single-benefits p{margin:5px 0 0;font-size:11px;line-height:1.45;color:var(--ink-3)}/* @canonical-block:001649 */
.products-single-proof{flex:0 0 auto;padding:10px 0 12px}/* @canonical-block:001650 */
.products-single-proof__grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(24,19,13,.1);border-radius:14px;background:rgba(255,255,255,.65);overflow:hidden}/* @canonical-block:001651 */
.products-single-proof__grid span{padding:10px 12px;text-align:center;font-size:11px;color:var(--ink-2);border-right:1px solid rgba(24,19,13,.08)}/* @canonical-block:001652 */
