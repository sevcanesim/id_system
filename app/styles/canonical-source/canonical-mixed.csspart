/* Desktop collapse uses the parent grid's remaining width instead of
   forcing a second fixed canvas. Modern browsers support :has(), which lets
   the shared child component own its persisted state without prop-drilling
   layout state through every page controller. */
@media (min-width: 1101px) {
  .p7-shell:has(.enterprise-sidebar.is-collapsed) { grid-template-columns: 76px minmax(0, 1fr); }
  .enterprise-dashboard-shell:has(.enterprise-sidebar.is-collapsed) { grid-template-columns: 76px minmax(0, 1fr); }
  .p10-corporate-platform .enterprise-dashboard-shell:has(.enterprise-sidebar.is-collapsed) { grid-template-columns: 76px minmax(0, 1fr); }

  .enterprise-sidebar.is-collapsed {
    width: 76px;
    padding-inline: 10px;
  }
  .enterprise-sidebar.is-collapsed .enterprise-side-brand {
    justify-content: center;
    padding-inline: 0;
  }
  .enterprise-sidebar.is-collapsed .enterprise-yenomi-copy,
