  gap: 7px;
}/* @canonical-block:002104 */
.p10-settings-grid button strong,
.p10-settings-grid button span { display:block; }/* @canonical-block:002105 */
.p10-settings-grid button strong { line-height:1.2; }/* @canonical-block:002106 */
.p10-settings-grid button span { line-height:1.45; }/* @canonical-block:002107 */

.business-seat-pack-grid {
  grid-template-columns: repeat(auto-fit, minmax(196px, 1fr));
}/* @canonical-block:002108 */
.business-seat-pack-grid > article {
