/* @canonical-block:000001 *//* Yenomi typography assets — bundled locally for deterministic rendering. */
@font-face { font-family:"Yenomi Inter";
  src: url("/fonts/Inter-Regular.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000002 */
@font-face { font-family:"Yenomi Inter";
  src: url("/fonts/Inter-Medium.woff2") format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000003 */
@font-face { font-family:"Yenomi Inter";
  src: url("/fonts/Inter-SemiBold.woff2") format("woff2");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000004 */
@font-face { font-family:"Yenomi Inter";
  src: url("/fonts/Inter-Bold.woff2") format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000005 */
@font-face {
  font-family:"Yenomi Inter Display";
  src: url("/fonts/InterDisplay-SemiBold.woff2") format("woff2");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000006 */
@font-face {
  font-family:"Yenomi Inter Display";
  src: url("/fonts/InterDisplay-Bold.woff2") format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000007 */
@font-face {
  font-family:"Yenomi Inter Display";
  src: url("/fonts/InterDisplay-ExtraBold.woff2") format("woff2");
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}/* @canonical-block:000009 */

/* Opt-in dark surface for accent elements only (login panel, product mockups,
 * card renders). Never applied to a full page. */
.theme-dark,
.theme-dark * {
  --void: #090711;
  --deep: #100c1d;
  --surface: #171225;
  --surface-2: #201a31;
  --surface-3: #28213b;
  --ink: #f7f3eb;
  --ink-2: #d0c9be;
  --ink-3: #928a80;
  --gold: #d4b483;
  --gold-hi: #efd3a3;
  --gold-dim: rgba(212,180,131,.16);
  --violet: #6d3de0;
  --violet-hi: #9b7bf0;
  --border: rgba(255,255,255,.105);
  --border-gold: rgba(212,180,131,.28);
  --glass: rgba(255,255,255,.045);
  --glass-strong: rgba(255,255,255,.075);
  --shadow: 0 22px 70px rgba(0,0,0,.34);
  --shadow-soft: 0 12px 36px rgba(0,0,0,.22);
  --glow: 0 0 48px rgba(212,180,131,.16);
}/* @canonical-block:000010 */

/* Back-compat: some routes still pass .theme-light explicitly — it is now
 * the default, so this is a harmless no-op alias. */
.theme-light,
.theme-light * {
  --void: #f7f5f0;
  --deep: #efece4;
  --surface: #ffffff;
  --surface-2: #faf8f3;
  --surface-3: #f1eee6;
  --ink: #18151b;
  --ink-2: #514c46;
  --ink-3: #7a746c;
  --border: rgba(24,19,13,.12);
  --border-gold: rgba(153,117,57,.34);
  --glass: rgba(255,255,255,.72);
  --glass-strong: rgba(255,255,255,.92);
  --shadow: 0 24px 60px rgba(40,34,28,.13);
  --shadow-soft: 0 10px 28px rgba(40,34,28,.09);
}/* @canonical-block:000027 */
small,.text-caption,.caption { font-size: var(--type-xs); }/* @canonical-block:000028 */
code,pre,kbd,samp,.mono,.metric,.price,.order-number { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }/* @canonical-block:000032 */

.yi-skip-link { position: fixed; top: 10px; left: 10px; z-index: 1000; transform: translateY(-160%); padding: 10px 14px; border-radius: 10px; background: var(--gold); color: #17120c; font-weight: 800; }/* @canonical-block:000033 */
.yi-skip-link:focus { transform: none; }/* @canonical-block:000034 */
.yi-icon { width: 1.25rem; height: 1.25rem; min-width: 1.25rem; flex: 0 0 1.25rem; stroke: currentColor; }/* @canonical-block:000035 */
button .yi-icon, a .yi-icon { pointer-events: none; }/* @canonical-block:000039 */
.theme-dark .p4-announcement { background:#0b0910; border-bottom-color:rgba(212,180,131,.12); color:#bcb4a8; }/* @canonical-block:000040 */

.global-app-header { position:relative; z-index:40; width:min(calc(100% - 40px), var(--wide)); margin:0 auto; min-height:76px; border-bottom:1px solid var(--border); background:rgba(255,255,255,.82); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); }/* @canonical-block:000041 */
.global-app-header-inner { width:100%; min-height:76px; display:grid; grid-template-columns:minmax(190px,1fr) auto minmax(270px,1fr); align-items:center; gap:28px; padding:0 4px; }/* @canonical-block:000042 */
.theme-dark .global-app-header { background:rgba(9,7,17,.78); }/* @canonical-block:000043 */
.global-brand-group { display:flex; align-items:center; gap:11px; min-width:0; }/* @canonical-block:000044 */
.global-brand-mark-link { display:flex; }/* @canonical-block:000045 */
.global-brand-mark { width:38px; height:38px; overflow:hidden; display:grid; place-items:center; border:1px solid var(--border-gold); border-radius:50%; background:#120d1e; }/* @canonical-block:000046 */
.global-brand-mark img { width:100%; height:100%; object-fit:cover; }/* @canonical-block:000047 */
.global-brand-copy { display:grid; gap:1px; min-width:0; }/* @canonical-block:000048 */
.global-brand-copy strong { font-size:15px; color:var(--ink); letter-spacing:-.02em; }/* @canonical-block:000049 */
.global-brand-copy small { color:var(--ink-3); font-size:11px; text-transform:uppercase; letter-spacing:.16em; }/* @canonical-block:000050 */
.global-header-center { display:flex; justify-content:center; min-width:0; }/* @canonical-block:000051 */
.global-main-nav { display:flex; align-items:center; gap:28px; white-space:nowrap; }/* @canonical-block:000052 */
.global-main-nav a { position:relative; padding:28px 0; color:var(--ink-2); font-size:14px; font-weight:650; }/* @canonical-block:000053 */
.global-main-nav a:hover, .global-main-nav a[aria-current="page"] { color:var(--ink); }/* @canonical-block:000054 */
.global-main-nav a[aria-current="page"]::after { content:""; position:absolute; left:0; right:0; bottom:19px; height:2px; border-radius:99px; background:var(--gold); }/* @canonical-block:000055 */
.global-header-actions { display:flex; align-items:center; justify-content:flex-end; gap:10px; min-width:0; }/* @canonical-block:000056 */
.global-cart-link { position:relative; display:grid; place-items:center; width:40px; height:40px; color:var(--ink-2); border:1px solid transparent; border-radius:10px; }/* @canonical-block:000057 */
.global-cart-link:hover { color:var(--gold-hi); border-color:var(--border); background:var(--glass); }/* @canonical-block:000058 */
.global-cart-badge { position:absolute; top:2px; right:1px; min-width:16px; height:16px; padding:0 4px; display:grid; place-items:center; border-radius:99px; background:var(--gold); color:#17120c; font:700 11px/1 var(--font-mono); }/* @canonical-block:000059 */
.global-header-link,.global-header-cta,.global-signout-button { min-height:40px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 14px; border:1px solid var(--border-gold); border-radius:11px; font-size:14px; font-weight:700; white-space:nowrap; }/* @canonical-block:000060 */
.global-header-link,.global-signout-button { background:transparent; color:var(--ink); }/* @canonical-block:000061 */
.global-header-link:hover,.global-signout-button:hover { background:var(--gold-dim); border-color:var(--gold); }/* @canonical-block:000062 */
.global-header-cta { background:linear-gradient(135deg,var(--gold),var(--gold-hi)); color:#17120c; border-color:transparent; box-shadow:0 8px 24px rgba(212,180,131,.14); }/* @canonical-block:000063 */
.global-header-cta:hover { transform:translateY(-1px); box-shadow:var(--glow); }/* @canonical-block:000064 */
.global-account-identity { display:grid; max-width:150px; gap:1px; overflow:hidden; }/* @canonical-block:000065 */
.global-account-identity small { color:var(--ink-3); font-size:11px; }/* @canonical-block:000066 */
.global-account-identity strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-2); font-size:12px; }/* @canonical-block:000067 */
.global-menu-button { display:none; width:42px; height:42px; border:1px solid var(--border); border-radius:11px; background:transparent; color:var(--ink); }/* @canonical-block:000068 */
.global-menu-lines { display:grid; gap:4px; width:18px; margin:auto; }/* @canonical-block:000069 */
.global-menu-lines i { display:block; height:1.5px; background:currentColor; }/* @canonical-block:000070 */
.global-mobile-panel { display:none; }/* @canonical-block:000071 */

/* common page frame */
.p4-shell,.products-public-v2 > section > *, .corporate-sales-page > section:not(.corporate-lead-section), .public-reference-page > section:not(.reference-hero), .cart-shell,.checkout-shell { width:min(calc(100% - 48px),var(--content)); margin-inline:auto; }/* @canonical-block:000072 */
.section-kicker,.p4-kicker,.products-public-v2-kicker { display:inline-flex; align-items:center; gap:8px; color:var(--gold); font-size:12px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }/* @canonical-block:000073 */
.section-kicker::before,.p4-kicker::before,.products-public-v2-kicker::before { content:""; width:22px; height:1px; background:currentColor; opacity:.7; }/* @canonical-block:000081 */
.p4-actions,.reference-actions,.corporate-hero-actions { display:flex; flex-wrap:wrap; gap:12px; }/* @canonical-block:000082 */
.p4-button,.corporate-cta,.corporate-secondary-cta,.products-public-v2-button { min-height:48px; display:inline-flex; align-items:center; justify-content:center; gap:9px; padding:0 19px; border:1px solid var(--border-gold); border-radius:12px; font-size:14px; font-weight:750; }/* @canonical-block:000083 */
.p4-button-primary,.corporate-cta,.products-public-v2-button.primary { background:linear-gradient(135deg,var(--gold),var(--gold-hi)); color:#17120c; border-color:transparent; box-shadow:0 12px 30px rgba(212,180,131,.14); }/* @canonical-block:000084 */
.p4-button.secondary,.corporate-secondary-cta,.products-public-v2-button.secondary { background:rgba(255,255,255,.035); color:var(--ink); }/* @canonical-block:000085 */
.p4-button:hover,.corporate-cta:hover,.corporate-secondary-cta:hover,.products-public-v2-button:hover { transform:translateY(-1px); }/* @canonical-block:000088 */
.p4-hero-note .yi-icon { width:15px; height:15px; min-width:15px; color:var(--gold); }/* @canonical-block:000099 */
.p4-phone-actions .yi-icon { width:14px; height:14px; min-width:14px; }/* @canonical-block:000142 */
.p4-pack-list .yi-icon { width:17px; height:17px; min-width:17px; color:var(--gold); }/* @canonical-block:000147 */

/* reference pages */
.public-reference-page { min-height:100vh; background:radial-gradient(760px 520px at 82% 8%,rgba(109,61,224,.05),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); overflow:hidden; }/* @canonical-block:000148 */
.reference-hero { width:min(calc(100% - 48px),var(--wide)); min-height:560px; margin:auto; display:grid; grid-template-columns:1fr .85fr; align-items:center; gap:50px; padding:80px 0 60px; }/* @canonical-block:000149 */
.reference-hero h1 { max-width:680px; margin:16px 0 20px; font-size:clamp(46px,5.5vw,76px); }/* @canonical-block:000150 */
.reference-hero h1 em { color:var(--gold); font-style:normal; }/* @canonical-block:000151 */
.reference-hero > div > p:not(.section-kicker) { max-width:620px; font-size:16px; color:var(--ink-2); }/* @canonical-block:000152 */
.reference-hero-art { position:relative; min-height:430px; display:grid; place-items:center; }/* @canonical-block:000153 */
.reference-hero-art img { width:min(100%,560px); filter:drop-shadow(0 35px 70px rgba(0,0,0,.6)); }/* @canonical-block:000154 */
.reference-hero-art::before { content:""; position:absolute; width:430px; height:430px; border-radius:50%; background:radial-gradient(circle,rgba(109,61,224,.2),transparent 68%); }/* @canonical-block:000155 */
.reference-section,.reference-contact { width:min(calc(100% - 48px),var(--content)); margin:auto; padding:90px 0; }/* @canonical-block:000156 */
.reference-section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; margin-bottom:32px; }/* @canonical-block:000157 */
.reference-section-heading h2,.reference-contact h2 { margin:10px 0 0; font-size:clamp(30px,4vw,48px); }/* @canonical-block:000158 */
.reference-step-grid,.reference-topic-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }/* @canonical-block:000159 */
.reference-step-grid article,.reference-topic-grid article { min-height:220px; padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018)); box-shadow:var(--shadow-soft); }/* @canonical-block:000160 */
.reference-step-grid article:hover,.reference-topic-grid article:hover { border-color:var(--border-gold); transform:translateY(-2px); }/* @canonical-block:000161 */
.reference-step-grid h3,.reference-topic-grid h3 { margin:16px 0 8px; font-size:20px; }/* @canonical-block:000162 */
.reference-band,.reference-contact { border:1px solid var(--border); border-radius:var(--radius-xl); background:linear-gradient(135deg,rgba(255,255,255,.055),rgba(255,255,255,.015)); }/* @canonical-block:000163 */
.reference-contact { display:flex; align-items:center; justify-content:space-between; gap:40px; padding:42px; margin-bottom:90px; }/* @canonical-block:000164 */

/* light luxury: products + corporate sales
 * These two routes use the light reference composition: quiet ivory canvas,
 * dark product stage, champagne accents, generous editorial spacing.
 */
.products-public-v2,
.corporate-sales-page {
  min-height:100vh;
  background:
    radial-gradient(760px 520px at 82% 10%,rgba(109,61,224,.055),transparent 68%),
    linear-gradient(180deg,#f8f7f4 0%,#f1efeb 52%,#ebe8e2 100%);
  color:#17151a;
}/* @canonical-block:000165 */
.theme-light .global-app-header { width:min(calc(100% - 48px),var(--wide)); margin-inline:auto; border-bottom-color:rgba(28,23,18,.1); }/* @canonical-block:000166 */
.theme-light .global-main-nav a,.theme-light .global-cart-link { color:#514c47; }/* @canonical-block:000167 */
.theme-light .global-main-nav a:hover,.theme-light .global-main-nav a[aria-current="page"] { color:#17151a; }/* @canonical-block:000168 */
.theme-light .global-header-link { color:#29241f; }/* @canonical-block:000169 */
.theme-light .global-header-link:hover { background:rgba(212,180,131,.12); }/* @canonical-block:000170 */
.theme-light .global-mobile-panel { background:#fff; border-color:rgba(28,23,18,.12); }/* @canonical-block:000171 */
.theme-light .global-mobile-panel a,.theme-light .global-mobile-panel button { color:#201c1a; }/* @canonical-block:000184 */
.products-public-v2-button.secondary { border-color:rgba(38,30,22,.18); background:#fff; color:#28231e; }/* @canonical-block:000187 */
.products-public-v2-microproof .yi-icon { width:15px; height:15px; min-width:15px; color:#8f6d39; }/* @canonical-block:000203 */
.products-public-v2-flow article .yi-icon { color:#8e6c39; }/* @canonical-block:000209 */
.products-public-v2-choice.is-primary { border-color:rgba(153,117,57,.4); box-shadow:0 22px 52px rgba(94,71,34,.12); }/* @canonical-block:000249 */
.corporate-benefit-icon .yi-icon { width:20px; height:20px; min-width:20px; }/* @canonical-block:000277 */
.p6-auth-visual-card .yi-product-ui--card { width:100%; }/* @canonical-block:000279 */
.p6-auth-mini-phone .yi-product-ui--profile { min-height:176px; border-width:5px; border-radius:22px; }/* @canonical-block:000294 */
.p6-auth-portal-tabs button.active { background:var(--gold); color:#17120c; }/* @canonical-block:000304 */
.p6-auth-input .yi-icon { width:16px; height:16px; color:var(--ink-3); }/* @canonical-block:000320 */
.p6-auth-message.info { border:1px solid var(--border); background:var(--surface-2, #F5F4F0); color:var(--ink-2); }/* @canonical-block:000321 */
.p6-auth-message.success { border:1px solid #c9decc; background:#f3f8f4; color:#2a5a34; }/* @canonical-block:000322 */
.p6-auth-message.error { border:1px solid #e8c4c4; background:#fdf4f4; color:#8a2f2f; }/* @canonical-block:000325 */
.p6-auth-password-rules span.valid { color:#2a5a34; background:#f3f8f4; }/* @canonical-block:000333 */
.p6-auth-security .yi-icon { width:16px; height:16px; margin-top:2px; color:var(--gold-hi); }/* @canonical-block:000334 */

/* cart / checkout */
.cart-page,.checkout-page,.order-page,.activation-page { min-height:100vh; background:radial-gradient(760px 520px at 82% 8%,rgba(163,123,44,.08),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); }/* @canonical-block:000367 */
.checkout-progress button.active,
.checkout-progress button.done,
.checkout-progress > div.done { border-color:var(--border-gold); color:var(--ink); }/* @canonical-block:000369 */
.checkout-progress button.active i,
.checkout-progress button.done i,
.checkout-progress > div.done i { background:var(--gold); color:#17120c; }/* @canonical-block:000379 */
.field-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:13px; }/* @canonical-block:000380 */
.field-grid label,.checkout-step-body label { display:grid; gap:6px; color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:000381 */
.field-grid input,.field-grid select,.checkout-step-body input,.checkout-step-body select,.checkout-step-body textarea { width:100%; min-height:44px; padding:0 12px; border:1px solid var(--border); border-radius:10px; background:#fff; color:var(--ink); }/* @canonical-block:000399 */
.checkout-summary-thumb.digital-renewal { display:grid; place-items:center; background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000401 */
.checkout-summary-thumb-card.back { background:rgba(255,255,255,.06); transform:translate(3px,3px); }/* @canonical-block:000402 */
.checkout-summary-thumb-card.front { display:grid; place-items:center; background:linear-gradient(155deg,#2a1f42,#0a0612); color:var(--gold-hi); font:800 6px var(--font-mono); letter-spacing:.06em; }/* @canonical-block:000406 */
.checkout-summary-benefits .yi-icon { width:14px; height:14px; min-width:14px; color:var(--green,#2f9e5f); }/* @canonical-block:000412 */
.checkout-pay-button .yi-icon { width:15px; height:15px; }/* @canonical-block:000415 */
.checkout-secure-list .yi-icon { width:13px; height:13px; min-width:13px; color:var(--gold-hi); }/* @canonical-block:000423 */
.premium-order-shell { width:min(calc(100% - 48px),var(--wide)); margin:auto; padding:55px 0 100px; }/* @canonical-block:000424 */
.premium-product-stage { display:grid; grid-template-columns:.9fr 1.1fr; gap:55px; align-items:center; margin-bottom:45px; }/* @canonical-block:000425 */
.product-stage-copy h1 { margin:14px 0; font-size:clamp(42px,5vw,70px); }/* @canonical-block:000426 */
.product-stage-copy p { max-width:560px; color:var(--ink-2); font-size:16px; }/* @canonical-block:000427 */
.stacked-card-preview { position:relative; min-height:420px; display:grid; place-items:center; }/* @canonical-block:000428 */
.stacked-card-front,.stacked-card-back { position:absolute; width:min(76%,430px); aspect-ratio:1.585; border-radius:20px; box-shadow:var(--shadow); }/* @canonical-block:000429 */
.stacked-card-front { z-index:2; transform:rotate(-7deg); }/* @canonical-block:000430 */
.stacked-card-back { transform:rotate(7deg) translate(35px,35px); opacity:.65; }/* @canonical-block:000431 */
.product-trust-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }/* @canonical-block:000432 */
.product-trust-grid > * { padding:14px; border:1px solid var(--border); border-radius:12px; background:var(--glass); }/* @canonical-block:000433 */
.premium-checkout-card { border:1px solid var(--border-gold); border-radius:22px; background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.015)); overflow:hidden; box-shadow:var(--shadow); }/* @canonical-block:000434 */
.premium-checkout-head { display:flex; justify-content:space-between; gap:20px; padding:26px; border-bottom:1px solid var(--border); }/* @canonical-block:000435 */
.premium-checkout-head h2 { margin:8px 0; font-size:28px; }/* @canonical-block:000436 */
.step-counter { color:var(--gold); font:700 13px var(--font-mono); }/* @canonical-block:000437 */
.premium-checkout-card .checkout-progress { padding:14px 20px; margin:0; }/* @canonical-block:000438 */
.wizard-pane { padding:26px; border-top:1px solid var(--border); }/* @canonical-block:000439 */
.pane-heading { display:flex; gap:13px; align-items:flex-start; margin-bottom:20px; }/* @canonical-block:000440 */
.pane-heading > span { width:34px; height:34px; display:grid; place-items:center; border:1px solid var(--border-gold); border-radius:50%; color:var(--gold); font:700 12px var(--font-mono); }/* @canonical-block:000441 */
.pane-heading h3 { margin:0; font-size:20px; }/* @canonical-block:000442 */
.pane-heading p { margin:3px 0 0; color:var(--ink-3); font-size:12px; }/* @canonical-block:000443 */
.premium-color-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }/* @canonical-block:000444 */
.premium-color-grid button { position:relative; padding:12px; border:1px solid var(--border); border-radius:14px; background:var(--glass); color:var(--ink); text-align:left; }/* @canonical-block:000445 */
.premium-color-grid button.selected { border-color:var(--gold); box-shadow:0 0 0 2px rgba(212,180,131,.10); }/* @canonical-block:000446 */
.premium-color-grid i { display:flex; justify-content:space-between; align-items:center; height:105px; padding:14px; border-radius:10px; background:#111; color:#d4b483; font-style:normal; }/* @canonical-block:000447 */
.premium-color-grid .white i { background:#f0eee9; color:#302c29; }/* @canonical-block:000448 */
.premium-color-grid .purple i { background:linear-gradient(145deg,#3b1d67,#120d1c); color:#e8d2f0; }/* @canonical-block:000449 */
.premium-color-grid strong,.premium-color-grid small { display:block; margin-top:8px; }/* @canonical-block:000450 */
.premium-color-grid small { color:var(--ink-3); font-size:12px; }/* @canonical-block:000451 */
.quantity-premium,.smart-location-row,.identity-toggle,.payment-privacy-note,.identity-heads-up { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:15px; margin-top:15px; border:1px solid var(--border); border-radius:12px; background:var(--glass); }/* @canonical-block:000452 */
.quantity-premium small { display:block; color:var(--ink-3); font-size:12px; }/* @canonical-block:000453 */
.quantity-premium > div:last-child { display:flex; align-items:center; gap:10px; }/* @canonical-block:000454 */
.quantity-premium button { width:34px; height:34px; border:1px solid var(--border); border-radius:8px; background:transparent; color:var(--ink); }/* @canonical-block:000455 */
.quantity-premium b { min-width:24px; text-align:center; font-family:var(--font-mono); }/* @canonical-block:000456 */
.identity-toggle { justify-content:flex-start; }/* @canonical-block:000457 */
.identity-toggle button { padding:9px 12px; border:1px solid var(--border); border-radius:9px; background:transparent; color:var(--ink-2); }/* @canonical-block:000458 */
.identity-toggle button.active { background:var(--gold); border-color:var(--gold); color:#17120c; font-weight:800; }/* @canonical-block:000459 */
.identity-preview-card { max-width:540px; margin:auto; padding:20px; border:1px solid var(--border-gold); border-radius:18px; background:var(--glass); }/* @canonical-block:000460 */
.stripe-summary { margin-top:18px; padding:14px; border:1px solid var(--border); border-radius:12px; }/* @canonical-block:000461 */
.stripe-summary div { display:flex; justify-content:space-between; padding:8px 0; color:var(--ink-2); }/* @canonical-block:000462 */
.stripe-summary .total { margin-top:8px; padding-top:13px; border-top:1px solid var(--border); color:var(--ink); font-weight:800; }/* @canonical-block:000463 */
.stripe-summary .total b { color:var(--gold-hi); font:700 18px var(--font-mono); }/* @canonical-block:000464 */

/* dashboard / corporate application — restrained, information first */
.admin-page,.p7-dashboard,.p8-page,.p9-page,.p10-page,.p11-page,.p14-page,.business-role-panel { min-height:100vh; background:radial-gradient(760px 520px at 82% 8%,rgba(109,61,224,.05),transparent 68%),linear-gradient(180deg,#f8f7f4 0%,#f2f0eb 55%,#ece9e2 100%); }/* @canonical-block:000465 */
.v25-panel,.v26-overview-hero,.p8-section-card,.p14-management-row,.enterprise-side-plan,.enterprise-side-user,.p10-domain-panel,.p11-filter-control,.compact-card { border:1px solid var(--border); border-radius:16px; background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.016)); box-shadow:var(--shadow-soft); }/* @canonical-block:000466 */
.p8-section-card,.v25-panel { padding:22px; }/* @canonical-block:000467 */
.p8-section-heading,.v25-section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:18px; }/* @canonical-block:000468 */
.p8-section-heading h2,.v25-section-heading h2 { margin:5px 0 0; font-size:24px; }/* @canonical-block:000469 */
.p8-field-grid,.company-settings-grid,.p10-metric-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }/* @canonical-block:000470 */



.p8-message,.auth-message,.p9-message { margin:12px 0; padding:10px 12px; border-radius:9px; background:var(--glass); border:1px solid var(--border); font-size:12px; }/* @canonical-block:000471 */
.p8-message--error,.auth-message.error { border-color:rgba(239,119,119,.35); color:#ffb0b0; background:rgba(239,119,119,.07); }/* @canonical-block:000472 */

.p9-metric,.p10-metric,.p7-metric { padding:18px; border:1px solid var(--border); border-radius:14px; background:var(--glass); }/* @canonical-block:000473 */
.p9-metric strong,.p10-metric strong,.p7-metric strong { display:block; color:var(--gold-hi); font:700 24px var(--font-mono); }/* @canonical-block:000474 */
.p9-metric span,.p10-metric span,.p7-metric span { color:var(--ink-3); font-size:12px; }/* @canonical-block:000476 */
.v25-analytics-breakdown,.v25-distribution { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }/* @canonical-block:000477 */
.v25-donut-wrap { display:grid; place-items:center; }/* @canonical-block:000478 */
.v25-donut { width:150px; aspect-ratio:1; border-radius:50%; background:conic-gradient(var(--gold) 0 38%,var(--violet) 38% 70%,#5f6470 70% 100%); box-shadow:0 0 30px rgba(212,180,131,.08); }/* @canonical-block:000479 */
.v25-donut::after { content:""; display:block; width:64%; height:64%; margin:18%; border-radius:50%; background:var(--deep); }/* @canonical-block:000480 */
.p14-management-row { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:14px; padding:13px 15px; }/* @canonical-block:000481 */
.p14-p14-management-row-icon { width:38px; height:38px; display:grid; place-items:center; border-radius:10px; background:var(--gold-dim); color:var(--gold); }/* @canonical-block:000482 */
.p14-action { display:inline-flex; align-items:center; gap:7px; min-height:36px; padding:0 11px; border:1px solid var(--border); border-radius:9px; background:transparent; color:var(--ink); font-size:12px; }/* @canonical-block:000483 */
.p14-action:hover { border-color:var(--gold); color:var(--gold-hi); }/* @canonical-block:000488 */


/* individual digital card workspace — light canonical surface */
.p14-card-shell { width:min(calc(100% - 48px),var(--content)); margin-inline:auto; display:grid; grid-template-columns:minmax(0,1.35fr) minmax(330px,.65fr); gap:18px; padding:30px 0 80px; align-items:start; }/* @canonical-block:000489 */
.p14-card-main { min-width:0; display:grid; gap:14px; }/* @canonical-block:000490 */
.p14-preview-col { position:sticky; top:24px; min-width:0; }/* @canonical-block:000491 */
.p14-preview-label { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 2px 9px; color:var(--ink-3); font-size:11px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }/* @canonical-block:000492 */
.p14-preview-label a { color:var(--gold-hi); font-size:12px; letter-spacing:0; text-transform:none; }/* @canonical-block:000493 */
.p14-preview-label a:hover { text-decoration:underline; text-underline-offset:3px; }/* @canonical-block:000494 */
.p14-preview-phone { display:grid; place-items:center; min-height:620px; padding:26px 18px; overflow:hidden; border:1px solid var(--border); border-radius:24px; background:linear-gradient(145deg,var(--surface-2),var(--surface)); box-shadow:var(--shadow); }/* @canonical-block:000495 */
.p14-preview-phone > * { width:min(100%,420px); }/* @canonical-block:000496 */
.p14-status-group { display:flex; align-items:center; justify-content:space-between; gap:12px; }/* @canonical-block:000497 */
.p14-status-pill { display:inline-flex; align-items:center; gap:7px; min-height:28px; padding:0 10px; border:1px solid var(--border); border-radius:999px; background:var(--surface-2); color:var(--ink-2); font-size:12px; font-weight:800; }/* @canonical-block:000498 */
.p14-status-pill i { width:7px; height:7px; border-radius:50%; background:var(--ink-3); }/* @canonical-block:000499 */
.p14-status-pill.online { border-color:rgba(47,158,95,.28); background:rgba(47,158,95,.08); color:#247c4b; }/* @canonical-block:000500 */
.p14-status-pill.online i { background:var(--green); }/* @canonical-block:000501 */
.p14-status-pill.offline { border-color:rgba(179,130,31,.25); background:rgba(179,130,31,.08); color:#846019; }/* @canonical-block:000502 */
.p14-preview-link { color:var(--gold-hi); font-size:12px; font-weight:750; }/* @canonical-block:000503 */
.p14-preview-link:hover { text-decoration:underline; text-underline-offset:3px; }/* @canonical-block:000509 */
.p14-link-card { padding:18px; border:1px solid var(--border-gold); border-radius:var(--radius-card); background:linear-gradient(145deg,var(--surface),var(--surface-2)); box-shadow:var(--shadow-soft); }/* @canonical-block:000510 */
.p14-link-head { display:flex; align-items:center; justify-content:space-between; gap:14px; }/* @canonical-block:000511 */
.p14-link-head small { display:block; color:var(--ink-3); font-size:11px; font-weight:800; letter-spacing:.09em; }/* @canonical-block:000512 */
.p14-link-head strong { display:block; margin-top:6px; overflow:hidden; color:var(--ink); font:600 13px var(--font-mono); text-overflow:ellipsis; white-space:nowrap; }/* @canonical-block:000513 */
.p14-copy-btn { display:inline-flex; align-items:center; gap:6px; min-height:36px; padding:0 11px; flex:none; border:1px solid var(--border-gold); border-radius:var(--radius-button); background:var(--gold-dim); color:var(--gold-hi); font-size:12px; font-weight:800; }/* @canonical-block:000514 */
.p14-copy-btn:hover { border-color:var(--gold); box-shadow:var(--glow); }/* @canonical-block:000515 */
.p14-link-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:13px; }/* @canonical-block:000516 */
.p14-action.primary { border-color:var(--gold); background:var(--gold); color:#17120c; font-weight:850; }/* @canonical-block:000517 */
.p14-action.primary:hover { color:#17120c; box-shadow:var(--glow); }/* @canonical-block:000518 */
.p14-action:disabled { opacity:.45; cursor:not-allowed; }/* @canonical-block:000519 */
.p14-card-grid { display:grid; grid-template-columns:minmax(220px,.72fr) minmax(0,1.28fr); gap:14px; }/* @canonical-block:000520 */
.p14-panel { min-width:0; padding:18px; border:1px solid var(--border); border-radius:var(--radius-card); background:var(--surface); box-shadow:var(--shadow-soft); }/* @canonical-block:000521 */
.p14-panel > small { color:var(--ink-3); font-size:11px; font-weight:800; letter-spacing:.1em; }/* @canonical-block:000522 */
.p14-panel h2 { margin:7px 0 14px; font-size:20px; line-height:1.05; letter-spacing:-.03em; }/* @canonical-block:000523 */
.p14-panel > p { margin:11px 0 0; color:var(--ink-3); font-size:12px; line-height:1.55; }/* @canonical-block:000524 */
.p14-panel > img { display:block; width:min(100%,180px); aspect-ratio:1; margin:4px auto 0; padding:8px; border:1px solid var(--border); border-radius:12px; background:#fff; }/* @canonical-block:000525 */
.p14-qr-placeholder { display:grid; place-items:center; width:min(100%,180px); aspect-ratio:1; margin:4px auto 0; border:1px dashed var(--border-gold); border-radius:12px; background:var(--surface-2); color:var(--ink-3); font:700 14px var(--font-mono); }/* @canonical-block:000526 */
.p14-panel.is-disabled { opacity:.72; }/* @canonical-block:000527 */
.p14-management-panel { display:grid; align-content:start; gap:7px; }/* @canonical-block:000528 */
.p14-management-panel h2 { margin-bottom:8px; }/* @canonical-block:000529 */
.p14-management-row { width:100%; min-width:0; text-decoration:none; }/* @canonical-block:000530 */
.p14-management-row span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:000531 */
.p14-management-row:hover span { color:var(--ink); }/* @canonical-block:000532 */
.p14-management-row.danger { color:var(--red); cursor:pointer; }/* @canonical-block:000533 */
.p14-management-row.danger:hover { border-color:rgba(209,69,59,.35); background:rgba(209,69,59,.04); }/* @canonical-block:000534 */
.p14-p14-management-row-wrap { min-width:0; }/* @canonical-block:000535 */
.p14-p14-management-row-wrap .p14-management-row { background:transparent; }/* @canonical-block:000536 */
.p14-message { padding:11px 13px; border:1px solid var(--border-gold); border-radius:12px; background:var(--gold-dim); color:var(--ink-2); font-size:12px; line-height:1.45; }/* @canonical-block:000537 */
@media (max-width:980px) {
  .p14-card-shell { grid-template-columns:1fr; }
  .p14-preview-col { position:relative; top:auto; }
  .p14-preview-phone { min-height:0; }
}/* @canonical-block:000538 */
@media (max-width:760px) {
  .p14-card-shell { width:min(calc(100% - 32px),var(--content)); padding:22px 0 60px; }
  .p7-card-health { grid-template-columns:1fr; }
  .p14-card-grid { grid-template-columns:1fr; }
  .p14-link-head { align-items:flex-start; flex-direction:column; }
  .p14-copy-btn { width:100%; justify-content:center; }
  .p14-link-actions { display:grid; grid-template-columns:1fr; }
  .p14-action { width:100%; justify-content:center; }
  .p14-management-row { grid-template-columns:auto minmax(0,1fr); }
  .p14-row-chevron { display:none; }
}/* @canonical-block:000539 */
@media (prefers-reduced-motion:reduce) {
  .p14-copy-btn,.p14-action,.p14-management-row { transition:none; }
}/* @canonical-block:000540 */

/* public card */
.profile-state-page { min-height:100vh; display:grid; place-items:center; padding:30px; background:#f7f5f0; }/* @canonical-block:000541 */
.profile-state-page > section { width:min(100%,560px); padding:40px; border:1px solid var(--border); border-radius:20px; background:var(--glass); text-align:center; }/* @canonical-block:000542 */

/* Shared public page title — every public route starts with the same centered editorial header. */
.public-page-title {
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  min-height: 250px;
  padding: 34px 24px 32px;
  border-bottom: 1px solid rgba(24,19,13,.08);
  background:
    radial-gradient(560px 240px at 50% 55%, rgba(169,129,47,.10), transparent 68%),
    linear-gradient(180deg, #faf9f5 0%, #f3f0e9 100%);
  text-align: center;
}/* @canonical-block:000543 */
.public-page-title::before,
.public-page-title::after {
  content: "";
  position: absolute;
  pointer-events: none;
  border: 1px solid rgba(169,129,47,.14);
  border-radius: 50%;
  transform: rotate(-16deg);
}/* @canonical-block:000544 */
.public-page-title::before { width: 880px; height: 250px; left: -300px; top: 8px; }/* @canonical-block:000545 */
.public-page-title::after { width: 760px; height: 210px; right: -290px; bottom: -110px; }/* @canonical-block:000546 */
.public-page-title__inner {
  position: relative;
  z-index: 2;
  width: min(100%, var(--wide));
  display: flex;
  flex-direction: column;
  align-items: center;
}/* @canonical-block:000547 */
.public-page-title__back {
  position: static;
  margin: 0 0 14px;
  color: var(--gold-hi);
  font-size: 13px;
  font-weight: 700;
}/* @canonical-block:000548 */
.public-page-title__kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #8b6835;
  font: 650 12px/1.2 var(--font-ui);
  letter-spacing: .12em;
  text-transform: uppercase;
}/* @canonical-block:000549 */
.public-page-title__kicker::before,
.public-page-title__kicker::after {
  content: "";
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: .7;
}/* @canonical-block:000550 */
.public-page-title h1 {
  max-width: 980px;
  margin: 14px 0 10px;
  font-size: clamp(40px, 5.2vw, 68px);
  line-height: .98;
  letter-spacing: -.055em;
}/* @canonical-block:000551 */
.public-page-title h1 em {
  color: #1A1918;
  font-style: normal;
}/* @canonical-block:000552 */
.public-page-title p {
  max-width: 760px;
  margin: 0;
  color: var(--ink-2);
  font-size: clamp(16px, 1.5vw, 19px);
  line-height: 1.55;
  text-wrap: balance;
}/* @canonical-block:000553 */
.public-page-title--product {
  min-height: 270px;
}/* @canonical-block:000554 */
.public-page-title--catalog { min-height: 270px; }/* @canonical-block:000555 */
.public-page-title--product h1 { font-size: clamp(44px, 5.8vw, 74px); }/* @canonical-block:000571 */

/* footer */
.yi-footer { width:min(calc(100% - 48px),var(--wide)); margin:0 auto; padding:70px 0 25px; border-top:1px solid var(--border); }/* @canonical-block:000572 */
.yi-footer-main { display:grid; grid-template-columns:1.5fr repeat(3,1fr); gap:45px; padding-bottom:45px; }/* @canonical-block:000573 */
.yi-footer-brand > div { display:flex; align-items:center; gap:10px; }/* @canonical-block:000574 */
.yi-footer-brand img { width:42px; height:42px; border-radius:50%; }/* @canonical-block:000575 */
.yi-footer-brand span { display:grid; gap:1px; }/* @canonical-block:000576 */
.yi-footer-brand strong { color:var(--ink); font-size:15px; }/* @canonical-block:000577 */
.yi-footer-brand small { color:var(--ink-3); font-size:11px; text-transform:uppercase; letter-spacing:.12em; }/* @canonical-block:000578 */
.yi-footer-brand p { max-width:360px; margin-top:16px; color:var(--ink-3); font-size:14px; }/* @canonical-block:000579 */
.yi-footer-main > div:not(.yi-footer-brand) { display:grid; align-content:start; gap:9px; }/* @canonical-block:000580 */
.yi-footer-main b { margin-bottom:4px; color:var(--ink); font-size:12px; }/* @canonical-block:000581 */
.yi-footer-main a { color:var(--ink-3); font-size:12px; }/* @canonical-block:000582 */
.yi-footer-main a:hover { color:var(--gold-hi); }/* @canonical-block:000583 */
.yi-footer-bottom,.yi-footer-compact { display:flex; align-items:center; justify-content:space-between; gap:20px; padding-top:18px; border-top:1px solid var(--border); color:var(--ink-3); font-size:12px; }/* @canonical-block:000584 */
.yi-footer-social { display:flex; gap:6px; }/* @canonical-block:000585 */
.yi-footer-social a { width:32px; height:32px; display:grid; place-items:center; border:1px solid var(--border); border-radius:9px; color:var(--ink-2); }/* @canonical-block:000586 */
.yi-footer-social .yi-icon { width:15px; height:15px; min-width:15px; }/* @canonical-block:000587 */
.yi-footer-compact { width:min(calc(100% - 48px),var(--wide)); margin:0 auto; padding:18px 0; }/* @canonical-block:000588 */
.yi-footer-compact nav { display:flex; flex-wrap:wrap; gap:16px; }/* @canonical-block:000589 */
.yi-footer-compact a:hover { color:var(--gold-hi); }/* @canonical-block:000590 */

/* utility / common states */
.result-empty,.order-success,.activation-shell { width:min(calc(100% - 48px),720px); margin:70px auto; padding:48px; border:1px solid var(--border); border-radius:22px; background:var(--glass); text-align:center; box-shadow:var(--shadow-soft); }/* @canonical-block:000591 */
.result-empty h1,.order-success h1,.activation-shell h1 { margin:10px 0; font-size:clamp(32px,4vw,50px); }/* @canonical-block:000593 */
.order-success-actions a,.secondary { min-height:42px; display:inline-flex; align-items:center; justify-content:center; padding:0 14px; border:1px solid var(--border-gold); border-radius:10px; background:var(--gold); color:#17120c; font-size:14px; font-weight:800; }/* @canonical-block:000594 */
.order-success-actions a.secondary,.secondary { background:transparent; color:var(--ink); }/* @canonical-block:000595 */
.activation-shell { text-align:left; }/* @canonical-block:000596 */
.activation-shell form { display:grid; gap:12px; }/* @canonical-block:000597 */
.activation-shell label { display:grid; gap:6px; color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:000598 */
.activation-shell input { min-height:44px; padding:0 12px; border:1px solid var(--border); border-radius:9px; background:#fff; color:var(--ink); }/* @canonical-block:000599 */

.p5-result-icon {
  width:52px;
  height:52px;
  margin:0 auto 8px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--gold-dim);
  color:var(--gold-hi);
}/* @canonical-block:000600 */
.p5-result-icon .yi-icon { width:22px; height:22px; }/* @canonical-block:000601 */
.p18-review-notice {
  display:grid;
  gap:6px;
  margin:18px auto 0;
  max-width:520px;
  padding:14px 16px;
  border:1px solid var(--border-gold);
  border-radius:14px;
  background:var(--gold-dim);
  text-align:left;
}/* @canonical-block:000602 */
.p18-review-notice strong { color:var(--ink); font-size:14px; }/* @canonical-block:000603 */
.p18-review-notice span { color:var(--ink-2); font-size:13px; line-height:1.5; }/* @canonical-block:000604 */
.p5-next-steps {
  display:grid;
  gap:10px;
  margin:22px auto 0;
  max-width:520px;
  text-align:left;
}/* @canonical-block:000605 */
.p5-next-steps > div {
  display:grid;
  grid-template-columns:28px minmax(0,1fr);
  gap:12px;
  align-items:start;
  padding:12px 14px;
  border:1px solid var(--border);
  border-radius:14px;
  background:var(--glass);
}/* @canonical-block:000606 */
.p5-next-steps > div.done { border-color:var(--border-gold); }/* @canonical-block:000607 */
.p5-next-steps b {
  width:28px;
  height:28px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--gold);
  color:#17120c;
  font:700 12px var(--font-mono);
}/* @canonical-block:000608 */
.p5-next-steps strong { display:block; color:var(--ink); font-size:14px; }/* @canonical-block:000609 */
.p5-next-steps small { display:block; margin-top:3px; color:var(--ink-3); font-size:12px; line-height:1.45; }/* @canonical-block:000610 */
.activation-callout {
  display:grid;
  gap:10px;
  margin:22px auto 0;
  max-width:520px;
  padding:18px 18px 16px;
  border:1px solid var(--border);
  border-radius:16px;
  background:var(--surface-2);
  text-align:left;
}/* @canonical-block:000611 */
.activation-callout h2 { margin:0; font-size:20px; line-height:1.25; }/* @canonical-block:000612 */
.activation-callout p { margin:0; color:var(--ink-2); font-size:14px; line-height:1.55; }/* @canonical-block:000613 */
.activation-callout form { display:grid; gap:10px; margin-top:6px; }/* @canonical-block:000614 */
.activation-callout label { display:grid; gap:6px; color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:000615 */
.activation-callout input {
  width:100%;
  min-height:44px;
  padding:0 12px;
  border:1px solid var(--border);
  border-radius:9px;
  background:#fff;
  color:var(--ink);
}/* @canonical-block:000616 */
.activation-callout button {
  min-height:44px;
  padding:0 14px;
  border:1px solid var(--border-gold);
  border-radius:10px;
  background:var(--gold);
  color:#17120c;
  font-size:14px;
  font-weight:800;
  cursor:pointer;
}/* @canonical-block:000617 */
.activation-callout button:disabled {
  background:#ece8e0;
  color:#5c564e;
  border-color:var(--border);
  cursor:not-allowed;
}/* @canonical-block:000618 */
.activation-callout a { color:var(--gold-hi); font-size:14px; font-weight:700; }/* @canonical-block:000619 */
.activation-callout a:hover { text-decoration:underline; }/* @canonical-block:000620 */

/* broad grid normalization for existing application surfaces */
.p5-order-success,.p5-result-page,.p7-home-status,.p8-shell,.p9-stack,.p10-shell,.p11-shell,.p14-shell { width:min(calc(100% - 48px),var(--content)); margin-inline:auto; }/* @canonical-block:000621 */
.p9-stack,.p8-shell,.p10-shell,.p11-shell,.p14-shell { display:grid; gap:16px; padding:35px 0 90px; }/* @canonical-block:000622 */
.p9-form-grid,.company-settings-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }/* @canonical-block:000623 */
.p9-feature,.p9-service-fact,.business-role-summary,.business-company-settings { padding:18px; border:1px solid var(--border); border-radius:14px; background:var(--glass); }/* @canonical-block:000624 */
.quick-actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:000625 */
.quick-actions a,.compact-link { min-height:38px; display:inline-flex; align-items:center; gap:7px; padding:0 11px; border:1px solid var(--border); border-radius:9px; background:var(--glass); color:var(--ink-2); font-size:12px; }/* @canonical-block:000626 */
.quick-actions a:hover,.compact-link:hover { color:var(--gold-hi); border-color:var(--gold); }/* @canonical-block:000630 */
.p8-corporate-editor > .enterprise-sidebar {
  min-width:0;
}/* @canonical-block:000694 */












.p8-note > .yi-icon { flex:0 0 18px; color:var(--gold-hi); }/* @canonical-block:000719 */
.corporate-dashboard-sidebar span.active { border-color:#d4b483; background:rgba(212,180,131,.22); box-shadow:0 0 14px rgba(212,180,131,.25); opacity:1; }/* @canonical-block:000755 */
.corporate-capability-icon .yi-icon { width:18px; height:18px; }/* @canonical-block:000764 */

/* mobile */
@media (max-width: 1100px) {
  .global-app-header-inner { grid-template-columns:1fr auto; }
  .global-header-center { display:none; }
  .global-header-actions > .global-header-link,.global-header-actions > .global-header-cta,.global-header-actions > .global-account-identity,.global-header-actions > .global-signout-button { display:none; }
  .global-menu-button { display:block; }
  .global-mobile-panel { position:absolute; top:calc(100% + 8px); left:0; right:0; display:grid; gap:4px; padding:10px; border:1px solid var(--border); border-radius:16px; background:#fff; box-shadow:var(--shadow); opacity:0; visibility:hidden; transform:translateY(-6px); pointer-events:none; }
  .global-mobile-panel.open { opacity:1; visibility:visible; transform:none; pointer-events:auto; }
  .global-mobile-panel a,.global-mobile-panel button { min-height:46px; display:flex; align-items:center; padding:0 13px; border:0; border-radius:9px; background:transparent; color:var(--ink); text-align:left; }
  .global-mobile-panel a:hover,.global-mobile-panel button:hover { background:var(--glass); }
  .theme-dark .global-mobile-panel { background:#0c0914; }
  .theme-dark .global-mobile-panel a,.theme-dark .global-mobile-panel button { color:#f7f3eb; }
  .p4-hero-grid,.products-public-v2-hero,.corporate-resource-hero,.premium-product-stage,.p6-auth-shell { grid-template-columns:1fr; }
  .p4-hero-copy { padding-bottom:20px; }
  .p4-product-demo { min-height:500px; }
  .p4-phone { right:30%; }
  .p4-physical-card { left:28%; }
  .p4-benefit-grid { grid-template-columns:repeat(2,1fr); }
  .p4-proof-card,.p4-pack-grid { grid-template-columns:1fr; }
  .p4-proof-visual { order:2; }
  .products-public-v2-hero-art { min-height:500px; }
  .corporate-resource-visual { min-height:460px; }
  .corporate-pricing-grid { grid-template-columns:repeat(2,1fr); }
  .cart-layout,.checkout-layout { grid-template-columns:1fr; }
  .cart-summary-panel,.checkout-summary { position:static; }
  .p6-auth-form-side { order:-1; justify-content:stretch; }
  .p6-auth-form-card { width:min(100%,470px); margin:0 auto; }
  .yi-footer-main { grid-template-columns:1.5fr 1fr 1fr; }
  .yi-footer-main > :last-child { grid-column:2 / -1; }
}/* @canonical-block:000765 */

@media (max-width: 760px) {
  .global-app-header { width:100%; margin:0; }
  .global-app-header-inner { min-height:64px; padding:0 16px; }
  .global-brand-mark { width:34px; height:34px; }
  .global-brand-copy strong { font-size:15px; }
  .global-brand-copy small { font-size:11px; }
  .p4-shell,.products-public-v2 > section > *, .corporate-sales-page > section:not(.corporate-lead-section), .public-reference-page > section:not(.reference-hero), .cart-shell,.checkout-shell { width:min(calc(100% - 32px),var(--content)); }
  .p4-hero,.reference-hero,.products-public-v2-hero,.corporate-resource-hero { min-height:auto; padding:58px 0 45px; }
  .p4-display,.reference-hero h1,.products-public-v2-hero h1,.corporate-resource-hero-copy h1 { font-size:clamp(38px,11vw,56px); }
  .p4-lead,.products-public-v2-lead,.reference-hero > div > p:not(.section-kicker),.corporate-resource-hero-copy > p { font-size:15px; }
  .p4-product-demo { min-height:390px; transform:scale(.86); transform-origin:center; margin:-20px 0; }
  .p4-phone { right:25%; width:210px; }
  .p4-physical-card { left:20%; width:250px; }
  .p4-flow-chip { top:5%; right:0; }
  .p4-section,.reference-section,.corporate-buyer-section,.corporate-pricing-section,.corporate-workflow,.products-public-v2-model,.products-public-v2-compare,.products-public-v2-package,.products-public-v2-addon,.products-public-v2-final { padding:70px 0; }
  .p4-section-head,.reference-section-heading,.reference-contact,.products-public-v2-final { grid-template-columns:1fr; display:grid; gap:18px; align-items:flex-start; }
  .p4-benefit-grid,.reference-step-grid,.reference-topic-grid,.products-public-v2-compare-grid,.corporate-benefits,.corporate-pricing-grid,.corporate-workflow-grid { grid-template-columns:1fr; }
  .p4-how-grid,.products-public-v2-flow { grid-template-columns:1fr; }
  .p4-step-arrow,.products-public-v2-flow-arrow { transform:rotate(90deg); }
  .p4-proof-card,.corporate-conversion,.corporate-lead-section { width:min(calc(100% - 32px),var(--content)); padding:24px; }
  .p4-proof-card { gap:25px; }
  .p4-pack-grid,.products-public-v2-package,.products-public-v2-addon { grid-template-columns:1fr; gap:30px; }
  .p4-pack-visual { min-height:280px; transform:scale(.82); }
  .products-public-v2-price { min-width:0; width:100%; }
  .products-public-v2-price div { flex-direction:column; gap:3px; }
  .products-public-v2-hero-art { min-height:330px; }
  .products-public-v2-art-label { top:2%; }
  .corporate-outcomes { grid-template-columns:1fr; }
  .corporate-conversion,.corporate-lead-section { grid-template-columns:1fr; margin-bottom:60px; }
  .reference-hero { grid-template-columns:1fr; }
  .reference-hero-art { min-height:300px; }
  .reference-contact { display:grid; padding:24px; }
  .p6-auth-shell { width:min(calc(100% - 32px),var(--content)); padding:28px 0 56px; gap:28px; }
  .p6-auth-story h1 { font-size:34px; }
  .p6-auth-product-flow { min-height:0; transform:none; }
  .p6-auth-features { grid-template-columns:1fr; }
  .p6-auth-form-card { padding:22px; }
  .p6-auth-socials { grid-template-columns:1fr; }
  .field-grid,.p8-field-grid,.p9-form-grid,.company-settings-grid,.v25-analytics-breakdown,.v25-distribution { grid-template-columns:1fr; }
  .cart-shell,.checkout-shell { padding-top:40px; }
  .cart-item-row { grid-template-columns:70px minmax(0,1fr); gap:12px; }
  .cart-item-qty,.cart-item-price,.cart-item-remove { grid-column:2; }
  .cart-item-thumb { width:70px; }
  .checkout-progress { grid-template-columns:1fr 1fr; }
  .result-empty,.order-success,.activation-shell { width:min(calc(100% - 32px),720px); margin:40px auto; padding:28px 18px; }
  .premium-checkout-head { align-items:flex-start; }
  .premium-color-grid { grid-template-columns:1fr; }
  .stacked-card-preview { min-height:300px; transform:scale(.78); }
  .yi-footer { width:min(calc(100% - 32px),var(--wide)); padding-top:55px; }
  .yi-footer-main { grid-template-columns:1fr 1fr; gap:28px 20px; }
  .yi-footer-main > :last-child { grid-column:auto; }
  .yi-footer-bottom,.yi-footer-compact { align-items:flex-start; flex-direction:column; }
  .legal-shell { width:min(calc(100% - 32px),820px); padding:50px 0 70px; }
  .legal-toc { grid-template-columns:1fr; }
}/* @canonical-block:000766 */

@media (max-width: 1100px) {
  .products-public-v2-hero,.corporate-resource-hero { grid-template-columns:1fr; gap:26px; min-height:auto; padding-top:54px; }
  .products-public-v2-hero-copy,.corporate-resource-hero-copy { max-width:760px; }
  .products-public-v2-hero-art,.corporate-resource-visual { min-height:560px; }
  .products-public-v2-hero-art::before,.corporate-resource-visual::before { inset:4% 5%; }
  .corporate-resource-visual img,.products-public-v2-hero-art img { width:min(100%,680px); }
  .corporate-pricing-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}/* @canonical-block:000767 */
@media (max-width: 760px) {
  .theme-light .global-app-header { width:100%; margin:0; }
  .products-public-v2-notice { width:min(calc(100% - 32px),var(--content)); align-items:flex-start; flex-direction:column; gap:3px; }
  .products-public-v2-hero,.corporate-resource-hero { width:min(calc(100% - 32px),var(--wide)); padding:46px 0 38px; }
  .products-public-v2-hero h1,.corporate-resource-hero-copy h1 { font-size:clamp(40px,11vw,58px); }
  .products-public-v2-lead,.corporate-resource-hero-copy > p { font-size:15px; }
  .products-public-v2-hero-art,.corporate-resource-visual { min-height:390px; margin-top:4px; }
  .products-public-v2-hero-art::before,.corporate-resource-visual::before { inset:2% 0; border-radius:24px; }
  .products-public-v2-hero-art img,.corporate-resource-visual img { width:calc(100% + 18px); max-width:none; }
  .products-public-v2-art-label { top:4%; right:4%; }
  .products-public-v2-flow { grid-template-columns:1fr; }
  .products-public-v2-flow-arrow { transform:rotate(90deg); min-height:22px; }
  .products-public-v2-compare-grid,.corporate-benefits,.corporate-pricing-grid,.corporate-workflow-grid { grid-template-columns:1fr; }
  .products-public-v2-package,.products-public-v2-addon,.products-public-v2-final,.corporate-conversion,.corporate-lead-section { grid-template-columns:1fr; gap:28px; }
  .corporate-outcomes { grid-template-columns:1fr; }
  .corporate-resource-visual { min-height:390px; }
  .corporate-art-note { right:2%; bottom:8%; }
}/* @canonical-block:000780 */
.p7-content > header,.ds-page-header { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:26px; }/* @canonical-block:000781 */
.ds-page-header__eyebrow,.ds-admin-page-header__eyebrow { color:var(--gold); font:700 12px var(--font-mono); letter-spacing:.14em; text-transform:uppercase; }/* @canonical-block:000782 */
.ds-type-page-title,.ds-page-header h1 { margin:6px 0 7px; font-size:clamp(28px,4vw,46px); }/* @canonical-block:000783 */
.ds-page-header p,.ds-page-header__copy p,.ds-admin-page-header__copy p { margin:0; max-width:650px; color:var(--ink-3); font-size:14px; }/* @canonical-block:000784 */
.ds-page-header__actions,.ds-admin-page-header__actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:000796 */
.enterprise-nav-entry .yi-icon { width:16px; height:16px; min-width:16px; color:var(--ink-3); }/* @canonical-block:000798 */
.enterprise-nav-entry.active { border-color:var(--border-gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000799 */
.enterprise-nav-entry.active .yi-icon { color:var(--gold); }/* @canonical-block:000804 */
.enterprise-side-links .yi-icon { width:15px; height:15px; min-width:15px; }/* @canonical-block:000820 */
.business-kpis,.v25-kpi-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }/* @canonical-block:000821 */
.business-kpis > *, .v25-kpi-grid > * { min-width:0; padding:18px; border:1px solid var(--border); border-radius:14px; background:var(--glass); }/* @canonical-block:000824 */
.v25-dashboard-core { display:grid; gap:14px; }/* @canonical-block:000825 */
/* Tek kullanıcı: Kurumsal Panel Genel Bakış (içerik + yan panel).
   12 kolonluk eski değer, .p10-corporate-platform ata class'ı her nedenle
   (hydration anı, yeniden kullanım vb.) devrede olmadığında grid'in 2
   widget'ı 12 dar sütuna böldüğü çökme bugının kaynağıydı. Varsayılanı
   doğrudan doğru 2-kolonlu düzen yapıyoruz; aşağıdaki .p10-corporate-platform
   kuralı aynı değeri tekrar vererek ek güvence sağlamaya devam ediyor. */
.v25-dashboard-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,340px); gap:14px; }/* @canonical-block:000826 */
.v25-dashboard-grid > * { min-width:0; }/* @canonical-block:000827 */
.v25-two-col { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }/* @canonical-block:000828 */
.v25-three-col { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }/* @canonical-block:000829 */
.v25-quick-actions { display:flex; flex-wrap:wrap; gap:8px; }/* @canonical-block:000830 */
.v25-task-list,.v25-card-strip,.p10-card-list,.p10-ranking,.corp-links-list { display:grid; gap:7px; }/* @canonical-block:000831 */
.v25-task-list > *, .p10-card-list > *, .p10-ranking > *, .corp-links-list > * { min-height:38px; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 10px; border:1px solid var(--border); border-radius:9px; background:rgba(255,255,255,.025); color:var(--ink-2); font-size:12px; }/* @canonical-block:000832 */
.v25-health-dot { width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 12px rgba(87,213,139,.35); }/* @canonical-block:000833 */
.v25-sparkline,.v26-chart-canvas { min-height:140px; border-radius:12px; background:linear-gradient(180deg,rgba(109,61,224,.07),rgba(212,180,131,.02)); }/* @canonical-block:000834 */
.v25-license-meter,.enterprise-plan-meter { height:8px; overflow:hidden; border-radius:99px; background:rgba(255,255,255,.07); }/* @canonical-block:000835 */
.v25-license-meter::before,.enterprise-plan-meter::before { content:""; display:block; width:68%; height:100%; border-radius:inherit; background:linear-gradient(90deg,var(--violet),var(--gold)); }/* @canonical-block:000836 */
.v26-overview-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(156px,188px); gap:18px; padding:22px 24px; }/* @canonical-block:000837 */
.v26-overview-copy h2 { margin:5px 0 8px; font-size:clamp(24px,2.4vw,34px); }/* @canonical-block:000838 */
.v26-hero-capabilities { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:8px; }/* @canonical-block:000839 */
.v26-reference-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }/* @canonical-block:000840 */
.v26-hero-capabilities > button { min-width:0; min-height:52px; display:grid; grid-template-columns:18px minmax(0,1fr) auto; align-items:center; gap:8px; padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:var(--glass); color:var(--ink); text-align:left; cursor:pointer; }/* @canonical-block:000841 */
.v26-reference-kpis > * { min-width:0; padding:12px; border:1px solid var(--border); border-radius:10px; background:var(--glass); }/* @canonical-block:000842 */
.v26-card-stage { min-height:0; display:grid; align-content:start; }/* @canonical-block:000843 */
.v26-card-stage > * { max-width:100%; }/* @canonical-block:000844 */
.v26-stage-glow { display:none; }/* @canonical-block:000845 */
/* Genel Bakış: KPI şeridi, grafik satırı ve alt özetler dikey istiflenir.
   .v26-reference-dashboard ile .v26-reference-main-row aynı 1.2fr/.8fr
   kuralını paylaşırsa KPI kartları grafik+aktivite ile yan yana sıkışır
   ve başlıklar harf harf dikey kırılır. */
.v26-reference-dashboard { display:grid; grid-template-columns:minmax(0,1fr); gap:16px; }/* @canonical-block:000846 */
.v26-reference-dashboard > * { min-width:0; }/* @canonical-block:000847 */
.v26-reference-main-row { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,.6fr); gap:14px; }/* @canonical-block:000848 */
.v26-reference-main-row > * { min-width:0; }/* @canonical-block:000849 */
.v26-reference-bottom { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }/* @canonical-block:000850 */
.v26-chart-tabs { display:flex; gap:5px; }/* @canonical-block:000851 */
.v26-chart-tabs button { min-height:32px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:transparent; color:var(--ink-3); font-size:12px; }/* @canonical-block:000852 */
.v26-chart-tabs button.active { border-color:var(--border-gold); color:var(--gold-hi); background:var(--gold-dim); }/* @canonical-block:000853 */
.v26-ring { width:180px; aspect-ratio:1; border:1px solid rgba(212,180,131,.25); border-radius:50%; box-shadow:0 0 0 20px rgba(212,180,131,.03),0 0 0 40px rgba(109,61,224,.025); }/* @canonical-block:000855 */
.seat-pack-count,.seat-pack-price { padding:14px; border:1px solid var(--border); border-radius:12px; background:var(--glass); }/* @canonical-block:000856 */
.seat-pack-price { color:var(--gold-hi); font:700 18px var(--font-mono); }/* @canonical-block:000857 */
.settings-tristate { padding:14px; border:1px solid var(--border); border-radius:12px; background:var(--glass); }/* @canonical-block:000858 */
.settings-tristate-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }/* @canonical-block:000859 */
.settings-tristate-control { display:flex; gap:5px; margin-top:10px; }/* @canonical-block:000860 */
.settings-tristate-control button { min-height:34px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:transparent; color:var(--ink-3); font-size:12px; }/* @canonical-block:000861 */
.settings-tristate-control button.active { border-color:var(--gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000862 */

/* design-system primitives */
.ds-button,.ds-button--primary,.ds-button--secondary { min-height:40px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 13px; border:1px solid var(--border); border-radius:10px; background:var(--glass); color:var(--ink); font-size:12px; font-weight:750; }/* @canonical-block:000863 */
.ds-button--primary { border-color:transparent; background:var(--gold); color:#17120c; }/* @canonical-block:000864 */
.ds-button--accent { border-color:transparent; background:linear-gradient(135deg,var(--violet),var(--violet-hi)); color:#fff; }/* @canonical-block:000865 */
.ds-button--sm { min-height:34px; padding-inline:10px; }/* @canonical-block:000866 */
.ds-button--secondary:hover,.ds-button:hover { border-color:var(--gold); }/* @canonical-block:000867 */
.ds-card { padding:18px; border:1px solid var(--border); border-radius:14px; background:var(--glass); }/* @canonical-block:000868 */
.ds-label { color:var(--ink-3); font-size:12px; font-weight:700; }/* @canonical-block:000869 */
.ds-help { color:var(--ink-3); font-size:12px; }/* @canonical-block:000870 */
.ds-error { color:#ffaaaa; font-size:12px; }/* @canonical-block:000871 */
.ds-table-wrap { width:100%; overflow:auto; border:1px solid var(--border); border-radius:14px; }/* @canonical-block:000872 */
.ds-table { width:100%; min-width:680px; border-collapse:collapse; }/* @canonical-block:000873 */
.ds-table th,.ds-table td { padding:11px 13px; border-bottom:1px solid var(--border); text-align:left; color:var(--ink-2); font-size:12px; }/* @canonical-block:000874 */
.ds-table th { color:var(--ink); background:rgba(255,255,255,.025); font-weight:800; }/* @canonical-block:000875 */
.ds-tabs { display:flex; gap:4px; padding:4px; border:1px solid var(--border); border-radius:10px; background:var(--surface-3); }/* @canonical-block:000876 */
.ds-tab { min-height:34px; padding:0 11px; border:0; border-radius:7px; background:transparent; color:var(--ink-3); font-size:12px; }/* @canonical-block:000877 */
.ds-tab[aria-selected="true"] { background:var(--gold); color:#17120c; font-weight:800; }/* @canonical-block:000878 */
.ds-overlay { position:fixed; inset:0; z-index:80; background:rgba(0,0,0,.62); backdrop-filter:blur(3px); }/* @canonical-block:000879 */
.ds-modal,.ds-drawer { position:fixed; z-index:90; background:#fff; border:1px solid var(--border-gold); box-shadow:var(--shadow); }/* @canonical-block:000880 */
.ds-modal { left:50%; top:50%; width:min(calc(100% - 32px),680px); max-height:calc(100vh - 32px); overflow:auto; transform:translate(-50%,-50%); border-radius:20px; }/* @canonical-block:000881 */
.ds-drawer { top:0; right:0; bottom:0; width:min(520px,100%); overflow:auto; }/* @canonical-block:000882 */
.ds-dialog-header { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:18px 20px; border-bottom:1px solid var(--border); }/* @canonical-block:000883 */
.ds-toast { position:fixed; right:20px; bottom:20px; z-index:100; max-width:360px; padding:13px 15px; border:1px solid var(--border-gold); border-radius:12px; background:#fff; color:var(--ink); box-shadow:var(--shadow); }/* @canonical-block:000884 */
.ds-empty__icon { width:56px; height:56px; display:grid; place-items:center; margin:auto; border:1px solid var(--border-gold); border-radius:16px; color:var(--gold); background:var(--gold-dim); }/* @canonical-block:000885 */
.ds-page-loading { min-height:55vh; display:grid; place-items:center; padding:40px; }/* @canonical-block:000886 */
.ds-page-loading__surface { width:min(100%,520px); padding:30px; border:1px solid var(--border); border-radius:18px; background:var(--glass); text-align:center; }/* @canonical-block:000887 */
.ds-page-loading__mark { width:48px; height:48px; margin:0 auto 15px; border-radius:50%; border:1px solid var(--border-gold); }/* @canonical-block:000888 */
.ds-page-loading__hint { color:var(--ink-3); font-size:12px; }/* @canonical-block:000889 */

/* ---- P0 FIX: ds-* temel form / layout / feedback primitifleri hiç
   stillenmemişti (Field, Input, Select, Textarea, Container, Grid, Stack,
   Alert, Badge, StatusBadge, Checkbox, Switch, Card__header/body/footer,
   Pagination, Empty, AdminPageHeader). Bu, panel genelinde görülen
   üst üste binen kart grid'i, taşan form etiketleri ve çıplak input'ların
   asıl kaynağıydı. ---- */
.ds-container { width:min(calc(100% - 48px),1180px); margin:0 auto; }/* @canonical-block:000890 */
.ds-container--dashboard { width:min(calc(100% - 56px),1280px); }/* @canonical-block:000891 */
.ds-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }/* @canonical-block:000892 */
.ds-stack { display:grid; gap:16px; }/* @canonical-block:000893 */
.ds-stack[data-gap="2"] { gap:8px; }/* @canonical-block:000894 */
.ds-stack[data-gap="3"] { gap:12px; }/* @canonical-block:000895 */
.ds-stack[data-gap="6"] { gap:24px; }/* @canonical-block:000896 */
.ds-stack[data-gap="8"] { gap:32px; }/* @canonical-block:000897 */

.ds-card__header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }/* @canonical-block:000898 */
.ds-card__body { display:grid; gap:10px; }/* @canonical-block:000899 */
.ds-card__footer { display:flex; align-items:center; justify-content:flex-end; gap:10px; margin-top:16px; padding-top:14px; border-top:1px solid var(--border); }/* @canonical-block:000900 */
.ds-card--interactive { transition:border-color var(--motion-standard) var(--ease-standard),transform var(--motion-standard) var(--ease-standard); }/* @canonical-block:000901 */
.ds-card--interactive:hover { border-color:var(--border-gold); transform:translateY(-1px); }/* @canonical-block:000902 */

.ds-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }/* @canonical-block:000903 */
.ds-field { min-width:0; display:grid; gap:6px; }/* @canonical-block:000904 */
.ds-field .ds-label { display:block; }/* @canonical-block:000905 */
.ds-field[data-invalid="true"] .ds-input,.ds-field[data-invalid="true"] .ds-select,.ds-field[data-invalid="true"] .ds-textarea { border-color:#e08a8a; }/* @canonical-block:000906 */
.corporate-lead-full,.ds-field.corporate-lead-full { grid-column:1 / -1; }/* @canonical-block:000907 */

.ds-input,.ds-select,.ds-textarea { width:100%; min-height:44px; padding:0 13px; border:1px solid var(--border); border-radius:11px; background:var(--surface); color:var(--ink); font-size:14px; font-family:inherit; transition:border-color var(--motion-fast) var(--ease-standard),box-shadow var(--motion-fast) var(--ease-standard); }/* @canonical-block:000908 */
.ds-textarea { min-height:96px; padding:11px 13px; resize:vertical; line-height:1.55; }/* @canonical-block:000909 */
.ds-input:focus,.ds-select:focus,.ds-textarea:focus { outline:none; border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-dim); }/* @canonical-block:000910 */
.ds-input::placeholder,.ds-textarea::placeholder { color:var(--ink-3); }/* @canonical-block:000911 */

.ds-checkbox,.ds-switch { display:inline-flex; align-items:center; gap:9px; color:var(--ink-2); font-size:13px; cursor:pointer; }/* @canonical-block:000912 */
.ds-checkbox input[type="checkbox"] { width:18px; height:18px; accent-color:var(--gold); }/* @canonical-block:000913 */
.ds-switch input[type="checkbox"] { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }/* @canonical-block:000914 */
.ds-switch__track { position:relative; width:38px; height:22px; border-radius:99px; background:var(--surface-3); border:1px solid var(--border); transition:background var(--motion-fast) var(--ease-standard),border-color var(--motion-fast) var(--ease-standard); }/* @canonical-block:000915 */
.ds-switch__thumb { position:absolute; top:2px; left:2px; width:16px; height:16px; border-radius:50%; background:#fff; box-shadow:var(--shadow-soft); transition:transform var(--motion-fast) var(--ease-standard); }/* @canonical-block:000916 */
.ds-switch input:checked ~ .ds-switch__track { background:var(--gold); border-color:var(--gold); }/* @canonical-block:000917 */
.ds-switch input:checked ~ .ds-switch__track .ds-switch__thumb { transform:translateX(16px); }/* @canonical-block:000918 */

.ds-badge { display:inline-flex; align-items:center; min-height:24px; padding:0 9px; border-radius:999px; background:var(--surface-3); color:var(--ink-2); font-size:11px; font-weight:750; }/* @canonical-block:000919 */
.ds-badge--success,.ds-status-badge--success { background:rgba(87,213,139,.14); color:var(--green,#2f9e5f); }/* @canonical-block:000920 */
.ds-badge--warning,.ds-status-badge--warning { background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000921 */
.ds-badge--error,.ds-status-badge--error { background:rgba(224,138,138,.14); color:#c24545; }/* @canonical-block:000922 */
.ds-badge--info,.ds-status-badge--info { background:rgba(109,61,224,.12); color:var(--violet,#6d3de0); }/* @canonical-block:000923 */
.ds-status-badge { display:inline-flex; align-items:center; gap:6px; min-height:26px; padding:0 10px; border-radius:999px; background:var(--surface-3); color:var(--ink-2); font-size:11px; font-weight:800; }/* @canonical-block:000924 */
.ds-status-badge::before { content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }/* @canonical-block:000925 */

.ds-alert { display:grid; gap:4px; padding:14px 16px; border:1px solid var(--border); border-radius:13px; background:var(--surface-2); color:var(--ink-2); font-size:13px; line-height:1.55; }/* @canonical-block:000926 */
.ds-alert strong { color:var(--ink); font-size:13px; }/* @canonical-block:000927 */
.ds-alert--error { border-color:rgba(224,138,138,.4); background:rgba(224,138,138,.08); color:#a13a3a; }/* @canonical-block:000928 */
.ds-alert--error strong { color:#a13a3a; }/* @canonical-block:000929 */
.ds-alert--success { border-color:rgba(87,213,139,.35); background:rgba(87,213,139,.08); color:#2f7d4f; }/* @canonical-block:000930 */
.ds-alert--warning { border-color:var(--border-gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000931 */
.ds-alert--info { border-color:rgba(109,61,224,.3); background:rgba(109,61,224,.07); }/* @canonical-block:000932 */

.ds-empty { display:grid; justify-items:center; gap:8px; padding:48px 20px; text-align:center; }/* @canonical-block:000933 */
.ds-empty h2 { margin:0; font-size:17px; }/* @canonical-block:000934 */
.ds-empty p { margin:0; max-width:42ch; color:var(--ink-3); font-size:13px; line-height:1.6; }/* @canonical-block:000935 */
.ds-empty-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:8px; }/* @canonical-block:000936 */

.ds-pagination { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:18px; }/* @canonical-block:000937 */
.ds-pagination__pages { display:flex; gap:4px; }/* @canonical-block:000938 */
.ds-pagination__page { min-width:34px; min-height:34px; border:1px solid var(--border); border-radius:9px; background:var(--surface); color:var(--ink-2); font-size:12px; font-weight:700; }/* @canonical-block:000939 */
.ds-pagination__page[aria-current="page"] { border-color:var(--gold); background:var(--gold-dim); color:var(--gold-hi); }/* @canonical-block:000940 */

.ds-admin-page-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:24px; }/* @canonical-block:000941 */
.ds-admin-page-header h1 { margin:4px 0 0; font-size:clamp(24px,3vw,32px); }/* @canonical-block:000942 */
.ds-admin-page-header p { margin:8px 0 0; max-width:60ch; color:var(--ink-2); font-size:14px; line-height:1.6; }/* @canonical-block:000943 */

@media (max-width:720px) {
  .ds-form-grid { grid-template-columns:1fr; }
  .ds-admin-page-header { flex-direction:column; }
}/* @canonical-block:000944 */

/* ---- P0 FIX: FAQList bileşeni (anasayfa "Sık sorulan sorular") hiç
   stillenmemişti — .yi-faq-* sınıflarının canonical.css'te karşılığı
   yoktu. ---- */
.p4-faq-layout { display:grid; grid-template-columns:.85fr 1.15fr; gap:32px; align-items:start; }/* @canonical-block:000945 */
.p4-faq-grid,.yi-faq-list { display:grid; gap:8px; }/* @canonical-block:000946 */
.yi-faq-item { border:1px solid var(--border); border-radius:14px; background:var(--surface); overflow:hidden; transition:border-color var(--motion-standard) var(--ease-standard); }/* @canonical-block:000947 */
.yi-faq-item.is-open { border-color:var(--border-gold); }/* @canonical-block:000948 */
.yi-faq-trigger { width:100%; min-height:56px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:0 18px; border:0; background:transparent; color:var(--ink); font-size:14px; font-weight:700; text-align:left; cursor:pointer; }/* @canonical-block:000949 */
.yi-faq-icon { flex:0 0 auto; width:26px; height:26px; display:grid; place-items:center; border-radius:50%; background:var(--gold-dim); color:var(--gold-hi); font-size:15px; line-height:1; }/* @canonical-block:000950 */
.yi-faq-panel { padding:0 18px 18px; }/* @canonical-block:000951 */
.yi-faq-panel p { margin:0; color:var(--ink-2); font-size:13px; line-height:1.65; }/* @canonical-block:000952 */
.yi-faq-panel[hidden] { display:none; }/* @canonical-block:000954 */

@media (max-width: 1100px) {
  .p7-shell { grid-template-columns:1fr; }
  .enterprise-dashboard-shell { grid-template-columns:1fr; }
  .enterprise-sidebar { position:fixed; left:0; top:0; bottom:0; width:270px; z-index:90; transform:translateX(-105%); transition:transform var(--motion-standard) var(--ease-standard); box-shadow:var(--shadow); }
  .enterprise-sidebar.is-mobile-open { transform:none; }
  .enterprise-sidebar-mobile-close { display:grid; place-items:center; align-self:flex-end; width:34px; height:34px; border:1px solid var(--border); border-radius:9px; background:transparent; color:var(--ink); }
  .p7-menu-button { position:fixed; z-index:70; top:14px; left:14px; width:40px; height:40px; display:grid; place-content:center; gap:4px; border:1px solid var(--border-gold); border-radius:10px; background:#fff; box-shadow:var(--shadow-soft); }
  .p7-menu-button span { width:16px; height:1.5px; background:var(--ink); }
  .p7-backdrop,.enterprise-mobile-drawer-backdrop { position:fixed; inset:0; z-index:80; border:0; background:rgba(20,16,10,.45); }
  .p7-topbar { padding-left:68px; }
  .business-kpis,.v25-kpi-grid { grid-template-columns:repeat(2,1fr); }
  .v25-three-col,.v26-reference-main-row,.v26-overview-hero { grid-template-columns:minmax(0,1fr); }
  .enterprise-mobile-commandbar { position:sticky; top:0; z-index:40; display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:60px; padding:0 16px; border-bottom:1px solid var(--border); background:rgba(255,255,255,.9); backdrop-filter:blur(14px); }
  .enterprise-mobile-menu-button { display:flex; align-items:center; gap:6px; min-height:38px; padding:0 12px; border:1px solid var(--border); border-radius:10px; background:transparent; color:var(--ink); font-size:14px; }
  .enterprise-mobile-current { display:grid; text-align:center; }
  .enterprise-mobile-current small { color:var(--ink-3); font-size:11px; text-transform:uppercase; letter-spacing:.1em; }
  .enterprise-mobile-current strong { font-size:14px; }
  .enterprise-mobile-account-button { width:38px; height:38px; display:grid; place-items:center; border:1px solid var(--border-gold); border-radius:50%; background:var(--gold-dim); color:var(--gold-hi); font:700 11px var(--font-mono); }
  .enterprise-topbar { display:none; }
}/* @canonical-block:000955 */

@media (max-width: 760px) {
  .p7-content,.business-console { width:min(calc(100% - 32px),1180px); }
  .p7-topbar { min-height:62px; padding-right:16px; }
  .p7-content > header,.ds-page-header { align-items:flex-start; flex-direction:column; }
  .business-hero { grid-template-columns:1fr; }
  .business-hero-art { width:100%; min-height:120px; }
  .business-kpis,.v25-kpi-grid,.v26-hero-capabilities,.v26-reference-kpis,.business-seat-pack-grid,.v25-two-col,.v25-three-col,.v26-reference-bottom { grid-template-columns:1fr; }
  .p14-management-row { grid-template-columns:auto 1fr; }
  .p14-action { grid-column:2; justify-self:start; }
}/* @canonical-block:000958 */
.account-loading { min-height:60vh; display:grid; place-items:center; padding:48px 24px; }/* @canonical-block:000959 */
.admin-helper-copy { margin:-10px 0 6px; color:var(--ink-2); font-size:14px; }/* @canonical-block:000960 */
.admin-muted-copy { margin:4px 0 0; color:var(--ink-3); font-size:12px; }/* @canonical-block:000961 */
.admin-provision-button { margin-top:18px; }/* @canonical-block:000962 */
/* canonical physical card artwork */
.yenomi-card-art { position:relative; width:100%; aspect-ratio:1.585; overflow:hidden; padding:18px; border:1px solid rgba(212,180,131,.34); border-radius:18px; background:linear-gradient(145deg,#262129,#09080d 72%); color:#efd3a3; box-shadow:0 24px 55px rgba(0,0,0,.35); }/* @canonical-block:000963 */
.yenomi-card-art.physical-white { background:linear-gradient(145deg,#f5f1e8,#dcd5c8); color:#302a25; }/* @canonical-block:000964 */
.yenomi-card-art.physical-purple { background:linear-gradient(145deg,#4b2b73,#120d1d); color:#efd3a3; }/* @canonical-block:000965 */
.card-art-lines { position:absolute; border:1px solid rgba(212,180,131,.12); border-radius:50%; pointer-events:none; }/* @canonical-block:000966 */
.card-art-lines-a { width:150%; height:120%; left:-25%; top:-10%; transform:rotate(-18deg); }/* @canonical-block:000967 */
.card-art-lines-b { width:120%; height:90%; left:-10%; top:10%; transform:rotate(12deg); }/* @canonical-block:000968 */
.qr-first-badge { position:relative; z-index:2; font:700 11px var(--font-mono); letter-spacing:.12em; }/* @canonical-block:000969 */
.qr-first-code { position:absolute; right:18px; bottom:18px; width:68px; height:68px; display:grid; place-items:center; padding:5px; border-radius:8px; background:#f4eee2; color:#17120c; }/* @canonical-block:000970 */
.qr-first-code img { width:100%; height:100%; object-fit:contain; }/* @canonical-block:000971 */
.qr-fallback-icon { color:#17120c; }/* @canonical-block:000972 */
.qr-first-nfc { position:absolute; left:18px; bottom:18px; display:flex; align-items:center; gap:8px; color:#d0c9be; font-size:11px; }/* @canonical-block:000974 */
.nfc-symbol .yi-icon { width:16px; height:16px; min-width:16px; }/* @canonical-block:000975 */
.brand-back-content { position:absolute; inset:0; display:grid; place-content:center; text-align:center; z-index:2; }/* @canonical-block:000976 */
.brand-back-content strong { color:#efd3a3; font-size:20px; letter-spacing:.14em; }/* @canonical-block:000977 */
.yenomi-card-art.physical-white .qr-first-nfc { color:#5c5348; }/* @canonical-block:000978 */
.yenomi-card-art.physical-white .nfc-symbol { color:#8a6a26; border-color:rgba(153,117,57,.34); }/* @canonical-block:000979 */
.yenomi-card-art.physical-white .brand-back-content strong { color:#7f6333; }/* @canonical-block:000980 */
.brand-back-content span { margin-top:5px; color:var(--ink-3); font-size:11px; }/* @canonical-block:000981 */

/* consolidated public commerce components — migrated from app/ui/styles.css */
.yi-container{width:min(var(--wide),calc(100% - 48px));margin-inline:auto}/* @canonical-block:000982 */
.yi-header{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--border);backdrop-filter:blur(18px)}/* @canonical-block:000983 */
.yi-header--dark{background:rgba(255,255,255,.82);color:var(--ink);border-color:var(--border)}/* @canonical-block:000984 */
.yi-header--light{background:rgba(255,255,255,.82);color:var(--ink);border-color:var(--border)}/* @canonical-block:000985 */
.yi-header__inner{height:76px;display:flex;align-items:center;gap:28px}/* @canonical-block:000986 */
.yi-brand{display:inline-flex;align-items:center;gap:0;color:inherit;text-decoration:none}/* @canonical-block:000987 */
.yi-brand__mark{display:grid;place-items:center;flex:0 0 auto;width:56px;height:56px;overflow:hidden;border-radius:50%;border:1px solid rgba(212,180,131,.34);background:#0B0810;padding:3px}/* @canonical-block:000988 */
.yi-brand--compact .yi-brand__mark{width:44px;height:44px;padding:3px}/* @canonical-block:000989 */
.yi-brand img{width:100%;height:100%;object-fit:contain;border-radius:0;background:transparent}/* @canonical-block:000990 */
.yi-brand span{display:grid;line-height:1.05}/* @canonical-block:000991 */
.yi-brand strong{font-size:15px;font-weight:800;letter-spacing:-.02em}/* @canonical-block:000992 */
.yi-brand small{margin-top:4px;font-size:11px;opacity:.58;letter-spacing:.13em;text-transform:uppercase}/* @canonical-block:000993 */
.yi-brand--compact small{display:none}/* @canonical-block:000994 */
.yi-nav{display:flex;align-items:center;justify-content:center;gap:28px;flex:1}/* @canonical-block:000995 */
.yi-nav a,.yi-cart{font-size:14px;font-weight:800;text-decoration:none;color:inherit;opacity:.78;transition:opacity var(--motion-standard)}/* @canonical-block:000996 */
.yi-nav a:hover,.yi-nav a[aria-current=page],.yi-cart:hover{opacity:1}/* @canonical-block:000997 */
.yi-nav__funnel{display:none}/* @canonical-block:000998 */
.yi-header__actions{display:flex;align-items:center;gap:12px}/* @canonical-block:000999 */
.yi-cart{position:relative;padding:8px}/* @canonical-block:001000 */
.yi-cart b{position:absolute;top:-1px;right:-2px;min-width:17px;height:17px;padding:0 4px;border-radius:999px;background:var(--gold);color:#19130a;font-size:12px;display:grid;place-items:center}/* @canonical-block:001001 */
.yi-btn{min-height:44px;border-radius:12px;padding:0 19px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;font:inherit;font-size:14px;font-weight:650;text-decoration:none;cursor:pointer;transition:transform var(--motion-standard),background var(--motion-standard),border-color var(--motion-standard)}/* @canonical-block:001002 */
.yi-btn:hover{transform:translateY(-1px)}/* @canonical-block:001003 */
.yi-btn--primary{background:linear-gradient(135deg,var(--gold-hi),var(--gold));color:#17110a}/* @canonical-block:001004 */
.yi-btn--secondary{background:#fff;border-color:var(--border-interactive,#D8D2C4);color:inherit}/* @canonical-block:001005 */
.theme-dark .yi-btn--secondary{background:rgba(255,255,255,.06);border-color:var(--border);color:inherit}/* @canonical-block:001006 */
.yi-btn--ghost{background:transparent;border-color:transparent;color:inherit}/* @canonical-block:001007 */
.yi-btn--dark{background:#151119;color:#fff}/* @canonical-block:001008 */
.yi-btn:disabled{opacity:.45;cursor:not-allowed;transform:none}/* @canonical-block:001009 */
.yi-menu{position:relative;z-index:23;display:none;flex:0 0 44px;width:44px;height:44px;border:0;background:transparent;color:inherit;pointer-events:auto}/* @canonical-block:001010 */
.yi-menu span{display:block;width:20px;height:1px;background:currentColor;margin:5px auto;pointer-events:none}/* @canonical-block:001011 */
.yi-section{padding:110px 0}/* @canonical-block:001012 */
.yi-section--dark{background:var(--void);color:var(--ink)}/* @canonical-block:001013 */
.yi-section--light{background:#f7f5ef;color:#17131c}/* @canonical-block:001014 */
.yi-section__heading{max-width:720px;margin-bottom:42px}/* @canonical-block:001015 */
.yi-section__heading>span,.yi-page-head>span{display:block;margin-bottom:12px;color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}/* @canonical-block:001016 */
.yi-section__heading h2{margin:0;font-size:clamp(32px,4vw,56px);line-height:.98;letter-spacing:-.045em}/* @canonical-block:001017 */
.yi-section__heading p{max-width:640px;margin:18px 0 0;color:var(--ink-3);font-size:16px;line-height:1.65}/* @canonical-block:001018 */
.yi-product-visual{position:relative;min-height:520px;display:grid;place-items:center;border:1px solid var(--border);border-radius:32px;background:radial-gradient(circle at 50% 40%,rgba(163,123,44,.16),transparent 45%),linear-gradient(145deg,#2b2722,#1a1918);overflow:hidden;box-shadow:var(--shadow)}/* @canonical-block:001019 */
.yi-product-visual--light{background:#f1eee6;border-color:rgba(24,18,30,.08)}/* @canonical-block:001020 */
.yi-product-visual img{width:min(92%,800px);height:auto;object-fit:contain;filter:drop-shadow(0 28px 45px rgba(0,0,0,.38));position:relative;z-index:2}/* @canonical-block:001021 */
.yi-orbit{position:absolute;border:1px solid rgba(216,181,106,.24);border-radius:50%;transform:rotate(-18deg)}/* @canonical-block:001022 */
.yi-orbit--one{width:76%;height:58%}/* @canonical-block:001023 */.yi-orbit--two{width:52%;height:78%;transform:rotate(24deg)}/* @canonical-block:001024 */
.yi-footer{padding:72px 0 28px;background:var(--deep);color:var(--ink-3);border-top:1px solid var(--border)}/* @canonical-block:001025 */
.yi-footer__grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:48px}/* @canonical-block:001026 */
.yi-footer p{max-width:340px;line-height:1.7;font-size:15px}/* @canonical-block:001027 */
.yi-footer__grid>div:not(:first-child){display:grid;align-content:start;gap:10px}/* @canonical-block:001028 */
.yi-footer__grid strong{color:var(--ink);font-size:14px;text-transform:uppercase;letter-spacing:.1em}/* @canonical-block:001029 */
.yi-footer a{color:inherit;text-decoration:none;font-size:15px}/* @canonical-block:001030 */
.yi-footer a:hover{color:var(--gold)}/* @canonical-block:001031 */
.yi-footer__bottom{margin-top:70px;padding-top:18px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:12px}/* @canonical-block:001032 */
.yi-app{min-height:100vh;background:#f4f2ed;color:#17131c;display:grid;grid-template-columns:250px 1fr}/* @canonical-block:001033 */
.yi-app__sidebar{position:sticky;top:0;height:100vh;padding:28px 20px;background:#fff;border-right:1px solid var(--border);color:#17131c;display:flex;flex-direction:column}/* @canonical-block:001034 */
.yi-app__sidebar nav{display:grid;gap:5px;margin-top:44px}/* @canonical-block:001035 */
.yi-app__sidebar nav a{padding:12px 14px;border-radius:11px;color:#635d55;text-decoration:none;font-size:14px}/* @canonical-block:001036 */
.yi-app__sidebar nav a:hover,.yi-app__sidebar nav a[aria-current=page]{background:var(--deep);color:#17131c}/* @canonical-block:001037 */
.yi-app__support{margin-top:auto;display:grid;gap:8px;padding:14px;font-size:14px}/* @canonical-block:001038 */
.yi-app__support a{color:#8a837c;text-decoration:none}/* @canonical-block:001039 */
.yi-app__main{min-width:0}/* @canonical-block:001040 */
.yi-app__top{height:68px;background:#fff;border-bottom:1px solid #e7e2d9;display:flex;align-items:center;justify-content:flex-end;gap:22px;padding:0 40px;font-size:14px;color:#766f7b}/* @canonical-block:001041 */
.yi-app__top a{color:#17131c;text-decoration:none}/* @canonical-block:001042 */
.yi-app__content{padding:54px clamp(24px,5vw,72px)}/* @canonical-block:001043 */
.yi-page-head{margin-bottom:34px}/* @canonical-block:001044 */
.yi-page-head h1{margin:0;font-size:clamp(32px,4vw,48px);letter-spacing:-.045em}/* @canonical-block:001045 */
.yi-page-head p{max-width:680px;margin:12px 0 0;color:#716a76;line-height:1.6}/* @canonical-block:001046 */
@media(max-width:900px){
 .yi-nav{position:fixed;inset:76px 16px auto;background:#fff;color:#17131c;border:1px solid var(--border);border-radius:18px;padding:16px;display:none;flex-direction:column;align-items:stretch;box-shadow:var(--shadow)}
 .yi-nav.is-open{display:flex}
 .yi-nav.is-open .yi-nav__funnel{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:4px;padding:10px 14px;border:1px solid var(--border);border-radius:12px;font-size:14px;font-weight:750;opacity:1}
 .yi-nav.is-open .yi-nav__funnel--primary{border-color:transparent;background:var(--gold);color:#17120c}
 .yi-menu{display:block}
 .yi-header__actions .yi-btn{display:none}
 .yi-container{width:min(var(--wide),calc(100% - 32px))}
 .yi-footer__grid{grid-template-columns:1fr 1fr}
 .yi-app{grid-template-columns:1fr}
 .yi-app__sidebar{position:relative;height:auto;padding:18px 20px}
 .yi-app__sidebar nav{display:flex;overflow:auto;margin-top:18px}
 .yi-app__sidebar nav a{white-space:nowrap}
 .yi-app__support{display:none}
 .yi-app__top{padding:0 20px}
 .yi-app__content{padding:36px 20px}
}/* @canonical-block:001047 */
@media(max-width:620px){
 .yi-header__inner{height:68px;gap:10px}
 .yi-brand small{display:none}
 .yi-cart{font-size:14px}
 .yi-section{padding:76px 0}
 .yi-product-visual{min-height:340px;border-radius:24px}
 .yi-footer__grid{grid-template-columns:1fr}
 .yi-footer__bottom{margin-top:40px}
}/* @canonical-block:001048 */
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}.yi-btn{transition:none}.yi-btn:hover{transform:none}
}/* @canonical-block:001049 */

.yi-hero{padding:76px 0 110px}/* @canonical-block:001050 */
.yi-hero__grid{display:grid;grid-template-columns:1fr 1.05fr;gap:64px;align-items:center}/* @canonical-block:001051 */
.yi-hero__eyebrow{display:block;margin-bottom:24px;color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.16em}/* @canonical-block:001052 */
.yi-hero h1{font-size:clamp(48px,7vw,88px);line-height:.91;letter-spacing:-.055em;margin:0}/* @canonical-block:001053 */
.yi-hero h1 em{font-style:normal;color:var(--gold)}/* @canonical-block:001054 */
.yi-hero__copy{max-width:560px;color:var(--ink-3);font-size:18px;line-height:1.65;margin:28px 0 0}/* @canonical-block:001055 */
.yi-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}/* @canonical-block:001056 */
