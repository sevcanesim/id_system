/* V42 — Footer cleanup: legacy navigation row removed. Keep layered footer + base row only. */


/* V43 — Premium single-page home + Opsola industry layer.
   Design principles: one message, one primary CTA, restrained density,
   4/8-based spacing rhythm, and a clear product -> system narrative. */

.home-premium__proof{
  padding:clamp(24px,4vw,40px) max(6vw,32px);
  background:#fbfaf7;
  border-top:1px solid rgba(36,29,22,.08);
}/* @canonical-block:002486 */
.home-premium__proof-head{
  width:min(1180px,100%);
  margin:0 auto;
  display:grid;
  gap:12px;
  align-items:start;
}/* @canonical-block:002487 */
.home-premium__proof-head h2,
.home-premium__final h2{
  margin:10px 0 0;
  color:#17131c;
  font-size:clamp(42px,5vw,72px);
  line-height:.94;
  letter-spacing:-.065em;
  font-weight:850;
}/* @canonical-block:002488 */
.home-premium__proof-head h2 em,
.home-premium__final h2 em{
  color:#1A1918;
  font-style:normal;
}/* @canonical-block:002489 */
.home-premium__proof-head>p{
  max-width:62ch;
