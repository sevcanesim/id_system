.home-premium__final h2{
  max-width:760px;
  margin-inline:auto;
}/* @canonical-block:002500 */
.home-premium__final>p{
  margin:16px auto 22px;
  color:#70685f;
  font:400 16px/1.7 var(--font-ui);
}/* @canonical-block:002501 */

/* Homepage conversion bridge: the value proposition continues into a clear,
   low-friction purchase-to-activation journey instead of ending at the hero. */
.home-premium__journey{
  padding:clamp(24px,4vw,40px) max(6vw,32px);
  background:#f5f1e8;
  border-top:1px solid rgba(36,29,22,.08);
}/* @canonical-block:002502 */
.home-premium__journey-head{
  width:min(1180px,100%);
