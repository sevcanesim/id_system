.products-plg-corporate .yi-container {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 24px;
  border: 1px solid rgba(24, 19, 13, .11);
  border-radius: 18px;
  background: rgba(255, 255, 255, .86);
}/* @canonical-block:004390 */

/* Image display, avatar containment, and compact card preview visual stability */
.compact-wrap {
  width: min(100%, 420px);
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}/* @canonical-block:004391 */
.brand-top {
  display: flex;
  justify-content: center;
}/* @canonical-block:004392 */
.brand-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border: 1px solid var(--border-gold);
  border-radius: 999px;
  background: var(--gold-dim);
  color: var(--ink-2);
  font-size: 11px;
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease;
}/* @canonical-block:004393 */
.brand-pill:hover {
  border-color: var(--gold-hi);
  transform: translateY(-1px);
}/* @canonical-block:004394 */
.brand-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gold-hi);
}/* @canonical-block:004395 */
.compact-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--surface);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
}/* @canonical-block:004396 */
.compact-cover {
  position: relative;
  width: 100%;
  height: 220px;
  overflow: hidden;
  background: linear-gradient(135deg, #1f1b16 0%, #120e0b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}/* @canonical-block:004397 */
.compact-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  image-rendering: -webkit-optimize-contrast;
}/* @canonical-block:004398 */
.compact-cover-placeholder {
  color: var(--gold-hi);
  font: 800 36px var(--font-mono);
}/* @canonical-block:004399 */
.compact-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(20, 16, 13, 0.82) 0%, transparent 60%);
  pointer-events: none;
}/* @canonical-block:004400 */
.compact-identity {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  padding: 16px 18px;
  margin-top: -36px;
  position: relative;
  z-index: 2;
}/* @canonical-block:004401 */
.identity-copy {
  min-width: 0;
}/* @canonical-block:004402 */
.identity-copy h1 {
  margin: 0;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}/* @canonical-block:004403 */
.identity-copy p {
  margin: 4px 0 0;
  color: var(--gold-hi);
  font-size: 13px;
  font-weight: 600;
}/* @canonical-block:004404 */
.verified-pill {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border: 1px solid var(--border-gold);
  border-radius: 999px;
  background: var(--gold-dim);
  color: var(--gold-hi);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}/* @canonical-block:004405 */
.compact-links {
  display: grid;
  gap: 8px;
}/* @canonical-block:004406 */
.compact-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--ink-3);
  font-size: 11px;
  padding: 8px 4px;
}/* @canonical-block:004407 */
.compact-footer a {
  color: var(--ink-2);
  text-decoration: none;
}/* @canonical-block:004408 */
.compact-footer a:hover {
  color: var(--gold-hi);
}/* @canonical-block:004409 */

/* Avatar Image & Logo visual fixes across all card formats */
.p12-avatar,
.corp-essential-avatar,
.corp-professional-avatar,
.corp-executive-avatar {
  flex-shrink: 0;
  display: block;
  object-fit: cover;
  image-rendering: -webkit-optimize-contrast;
}/* @canonical-block:004411 */
.qr-first-code img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
}/* @canonical-block:004424 */

.p6-bento-icon .yi-icon {
  width: 16px;
  height: 16px;
}/* @canonical-block:004431 */

.p6-auth-portal-tabs a.active {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-hi) 100%);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 4px 14px rgba(169, 129, 47, 0.3);
}/* @canonical-block:004439 */

.p6-auth-submit .yi-icon {
  transition: transform var(--motion-fast) var(--ease-standard);
}/* @canonical-block:004440 */

.p6-auth-submit:hover:not(:disabled) .yi-icon {
  transform: translateX(3px);
}/* @canonical-block:004441 */

/* Button Active Micro-Feedback & Mobile Touch-Target Protection */
.p6-auth-submit:active:not(:disabled),
.yi-button:active:not(:disabled) {
  transform: scale(0.98);
}/* @canonical-block:004442 */

@media (max-width: 768px) {
  button,
  .p6-auth-portal-tabs a,
  .p6-auth-switch-tab-btn {
    min-height: 44px;
  }
  .yi-footer__base--responsive {
